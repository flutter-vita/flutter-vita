# FVM — the pinned Flutter version lives in .fvmrc (committed);
# the SDK itself is a symlink into the shared ~/fvm/versions cache.
.fvm/
.dart_tool/
build/
*.dill
*.snapshot

# Phase 0.5 spike outputs — regenerate with the scripts, don't commit binaries
spikes/**/out/

# Vendored third-party trees (Phase 2). Pinned in VERSIONS.md, patched via patches/.
# These are large; they are checked out by tooling, not committed.
third_party/

# Vita build artifacts
*.velf
*.self
eboot.bin
*.vpk

.DS_Store

# CMake build trees inside spikes
spikes/**/build/

# Link-check outputs
spikes/p1-link-check/out/
spikes/m1-snapshot/out/
spikes/m1-vpk/build/
spikes/m1-vpk/out/

# Packaged engine artifacts — 20 MB tarball plus a 1.1 GB staging tree.
# Built by tools/package-engine.sh and published as a release, not committed.
out/artifacts/

# What tools/deploy.sh has already sent to the console.
#
# One file per pushed asset, each holding a SHA-1, so a deploy can skip the
# 2.7 MiB of fonts and icudtl.dat that never change between builds. It
# describes the state of one physical Vita on one developer's desk — it is not
# reproducible, it is not shared, and it was being rewritten on every single
# deploy, so every commit picked up unrelated churn.
#
# A fresh clone has no stamps and re-pushes the data files once, which is the
# right answer: another machine cannot know what is on this console.
out/.pushed/

# The blessed engine the loader links against. 73 MB, reproduced by
# tools/bless-loader-engine.sh; loader/engine-pin.txt is the committed record.
out/artifacts/loader-engine/

# Crash dumps and framebuffer captures pulled off the device.
out/dumps/

# Benchmark run output. One run per invocation of tools/bench.sh, plus the
# deploy logs it writes on the way -- machine-specific, console-specific, and
# regenerated every time.
#
# Not to be confused with the committed baseline, which lives in
# apps/gallery/bench/ and is what the ADR-0017 gate compares against. Six of
# these were tracked by accident until 2026-08-29, so a benchmark run showed up
# as a dirty tree after every measurement.
out/bench/
loader/app/lib/build_info.dart

# Generated by `flutter pub get`, and its own first line says not to check it
# in. It embeds absolute paths into ~/.pub-cache, so tracking one publishes a
# home directory. See docs/open-sourcing.md.
.flutter-plugins-dependencies

# Generated on first run by tools/benchserver.py, thirty days, one host.
tools/bench.crt
tools/bench.key
