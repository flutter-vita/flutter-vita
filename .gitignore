# FVM — the pinned Flutter version lives in .fvmrc (committed);
# the SDK itself is a symlink into the shared ~/fvm/versions cache.
.fvm/
.dart_tool/
build/
*.dill
*.snapshot

# Phase 0.5 experiment outputs — regenerate with the scripts, don't commit binaries
experiments/**/out/

# Vendored third-party trees (Phase 2). Pinned in VERSIONS.md, patched via patches/.
# These are large; they are checked out by tooling, not committed.
third_party/

# Everything the tools write: packaged engines, crash dumps, benchmark runs,
# shader probes, screenshots, and the per-console record of what has already
# been pushed. All of it is regenerated, and most of it describes one console.
out/

# Vita build artifacts
*.velf
*.self
eboot.bin
*.vpk

.DS_Store

# CMake build trees inside experiments
experiments/**/build/

# Link-check outputs
experiments/p1-link-check/out/
experiments/m1-snapshot/out/
experiments/m1-vpk/build/
experiments/m1-vpk/out/





receiver/app/lib/build_info.dart

# Generated by `flutter pub get`, and its own first line says not to check it
# in. It embeds absolute paths into ~/.pub-cache, so tracking one publishes a
# home directory. See docs/open-sourcing.md.
.flutter-plugins-dependencies

# Generated on first run by tools/benchserver.py, thirty days, one host.
tools/bench.crt
tools/bench.key
build/vita-release/
