+++ b/sdk/lib/vita/vita.dart
@@ -0,0 +1,83 @@
+// The Vita embedder's Dart-side shim.
+//
+// This exists because several VM hooks are Dart closures, and an embedder
+// cannot synthesize a closure from C. `runtime/bin` gets its closures from
+// `dart:_builtin` and `dart:io`, which this port excludes; Flutter gets its own
+// from `dart:ui`. This is the equivalent for the Vita port.
+//
+// It is a real SDK library rather than code in the application's root library
+// so that the embedder can name it -- `Dart_LookupLibrary("dart:vita")` -- with
+// no dependency on where the app's source happened to live on the build
+// machine. The snapshot bakes absolute host paths into application libraries,
+// which made the earlier arrangement fragile.
+//
+// The natives below are resolved at runtime with `Dart_SetFfiNativeResolver`,
+// not `Dart_SetNativeResolver`: the latter runs inside gen_snapshot, and this
+// port uses a stock one. Handles are passed rather than pointers so there is no
+// malloc and no manual UTF-8 handling on the Dart side.
+library dart.vita;
+
+import 'dart:_internal' show VMLibraryHooks;
+import 'dart:ffi';
+import 'dart:isolate';
+
+// ------------------------------------------------------------------- print --
+
+@Native<Void Function(Handle)>(symbol: 'vita_dart_print')
+external void _vitaPrint(Object line);
+
+/// Install with `Dart_SetField(internal_lib, "_printClosure", ...)`.
+/// Until something does, `print()` throws.
+@pragma('vm:entry-point')
+void Function(String) getPrintClosure() => (String line) => _vitaPrint(line);
+
+// ------------------------------------------------------------------ timers --
+//
+// Nothing here implements a timer. `dart:isolate` already contains the whole
+// scheduler -- timer_impl.dart is `part` of isolate_patch.dart -- and is only
+// missing the two platform primitives below. `VMLibraryHooks.timerFactory`
+// itself is set by `dart:isolate`'s own `_setupHooks`.
+
+@Native<Int64 Function()>(symbol: 'vita_monotonic_ms')
+external int _vitaMonotonicMs();
+
+@Native<Void Function(Handle, Int64)>(symbol: 'vita_schedule_wakeup')
+external void _vitaScheduleWakeup(Object sendPort, int wakeupTime);
+
+/// Install as `VMLibraryHooks.timerMillisecondClock`. Must share an epoch with
+/// the `wakeupTime` values passed to the hook below -- `_Timer` derives one
+/// from the other.
+@pragma('vm:entry-point')
+int Function() getTimerClock() => () => _vitaMonotonicMs();
+
+/// Install as `VMLibraryHooks.eventHandlerSendData`. `_Timer` calls this to ask
+/// the platform to wake the isolate at [wakeupTime], or to cancel with -1.
+/// Zero-duration timers never arrive here: `dart:isolate` posts `_ZERO_EVENT`
+/// to its own port instead of asking the platform.
+@pragma('vm:entry-point')
+void Function(Object?, SendPort, int) getEventHandlerSendData() =>
+    (Object? sender, SendPort port, int wakeupTime) =>
+        _vitaScheduleWakeup(port, wakeupTime);
+
+// ----------------------------------------------------------- isolate spawn --
+//
+// Isolate.spawn does not fail in the embedder -- it refuses in Dart, here:
+//
+//   var script = VMLibraryHooks.platformScript;
+//   if (script == null) throw UnsupportedError("Isolate.spawn");
+//
+// It needs a script URI to hand the child isolate. runtime/bin supplies one
+// from dart:io's Platform._nativeScript; this port has no dart:io, so nothing
+// ever set it and spawn was refused with no further explanation.
+//
+// Being a real SDK library means this can import dart:_internal and assign the
+// field directly, rather than going through Dart_SetField on VMLibraryHooks
+// from C.
+//
+// The URI is nominal. Nothing resolves it -- the snapshot is already linked
+// into the binary and the child runs the same code -- but it must be non-null
+// and parseable.
+@pragma('vm:entry-point')
+void installPlatformScript() {
+  VMLibraryHooks.platformScript = (() => Uri.parse('vita:flutter-vita'));
+}
