+//                    mutex-guarded queue instead. The same measurement puts a
+//                    cross-thread sceKernelSetEventFlag at 0.03 ms, which is
+//                    the primitive message_loop_vita.cc already wakes the UI
+//                    thread on sixty times a second.
+//
+//   timerfd       -> absent, and not needed. TimeoutQueue already knows the
+//                    next deadline; it becomes poll()'s timeout argument.
+//
+// One hard limit to respect: **poll() fails with EINVAL when nfds > 255.**
+// VitaSDK checks this before doing anything else. An application holding more
+// than 255 sockets at once will not merely be slow, it will stop working, so
+// the implementation reports that case rather than silently truncating.
+static constexpr intptr_t kMaxPollDescriptors = 255;
+
+class DescriptorInfo : public DescriptorInfoBase {
+ public:
+  explicit DescriptorInfo(intptr_t fd) : DescriptorInfoBase(fd) {}
+
+  virtual ~DescriptorInfo() {}
+
+  intptr_t GetPollEvents();
+
+  virtual void Close() {
+    close(fd_);
+    fd_ = -1;
+  }
+
+ private:
+  DISALLOW_COPY_AND_ASSIGN(DescriptorInfo);
+};
+
+class DescriptorInfoSingle : public DescriptorInfoSingleMixin<DescriptorInfo> {
+ public:
+  explicit DescriptorInfoSingle(intptr_t fd) : DescriptorInfoSingleMixin(fd) {}
+  virtual ~DescriptorInfoSingle() {}
+
+ private:
+  DISALLOW_COPY_AND_ASSIGN(DescriptorInfoSingle);
+};
+
+class DescriptorInfoMultiple
+    : public DescriptorInfoMultipleMixin<DescriptorInfo> {
+ public:
+  explicit DescriptorInfoMultiple(intptr_t fd)
+      : DescriptorInfoMultipleMixin(fd) {}
+  virtual ~DescriptorInfoMultiple() {}
+
+ private:
+  DISALLOW_COPY_AND_ASSIGN(DescriptorInfoMultiple);
+};
+
+class EventHandlerImplementation {
+ public:
+  EventHandlerImplementation();
+  ~EventHandlerImplementation();
+
+  // Gets the socket data structure for a given file descriptor. Creates a new
+  // one if one is not found.
+  DescriptorInfo* GetDescriptorInfo(intptr_t fd, bool is_listening);
+  void SendData(intptr_t id, Dart_Port dart_port, int64_t data);
+  void Start(EventHandler* handler);
+  void Shutdown();
+
+ private:
+  // Rebuilds poll_fds_ from socket_map_. The Linux version instead edits a
+  // kernel-side epoll set incrementally; here the set is rebuilt each wait,
+  // because poll() takes the whole array anyway.
+  void BuildPollArray();
+  void HandleEvents();
+  static void Poll(uword args);
+  void WakeupHandler(intptr_t id, Dart_Port dart_port, int64_t data);
+  // Drains queue_ and acts on every message in it.
+  void HandleInterruptQueue();
+  // Blocks on event_flag_ for at most timeout_us, or indefinitely if it is
+  // negative. Only used when no socket is registered -- poll() cannot wait on
+  // an event flag, so when there are sockets the wait is sliced instead.
+  void WaitOnEventFlag(int64_t timeout_us);
+  void SetPort(intptr_t fd, Dart_Port dart_port, intptr_t mask);
+  intptr_t GetPollEvents(intptr_t events, DescriptorInfo* di);
+  static void* GetHashmapKeyFromFd(intptr_t fd);
+  static uint32_t GetHashmapHashFromFd(intptr_t fd);
+
+  SimpleHashMap socket_map_;
+  TimeoutQueue timeout_queue_;
+  bool shutdown_;
+
+  // The wakeup channel, in place of the socketpair every other POSIX backend
+  // uses. See the note above.
+  SceUID event_flag_;
+  dart::Mutex queue_mutex_;
+  MallocGrowableArray<InterruptMessage> queue_;
+
+  // Rebuilt on every wait, and it holds sockets only -- there is no interrupt
+  // descriptor to reserve a slot for any more.
+  struct pollfd* poll_fds_;
+  intptr_t poll_fds_capacity_;
+  intptr_t poll_fds_length_;
+
+  DISALLOW_COPY_AND_ASSIGN(EventHandlerImplementation);
+};
+
+}  // namespace bin
