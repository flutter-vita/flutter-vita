+
+// Deliberately *not* platform/signal_blocker.h, which every other POSIX backend
+// includes. VitaSDK has no pthread_sigmask, sigemptyset or sigaddset, so
+// ThreadSignalBlocker cannot be built and NO_RETRY_EXPECTED's siblings come
+// with it. There are no signals to block here either, so nothing is lost --
+// but the EINTR retry those macros provide still has to exist, because a
+// blocking call can return EINTR for reasons other than signals.
+#define VITA_RETRY_EINTR(expression)                                           \
+  ({                                                                           \
+    intptr_t __result;                                                         \
+    do {                                                                       \
+      __result = (expression);                                                 \
+    } while ((__result == -1L) && (errno == EINTR));                           \
+    __result;                                                                  \
+  })
+
+namespace dart {
+namespace bin {
+
+// The one bit of the event flag this handler uses. An event flag carries 32;
+// only "something is queued" is needed.
+static constexpr unsigned int kWakeBit = 1u;
+
+// Negative means "wait until something happens".
+static constexpr int64_t kWaitForever = -1;
+
+// How long the wait is allowed to run before the interrupt queue is checked
+// again, when there are sockets registered and poll() therefore owns the wait.
+//
+// poll() cannot wait on an event flag, so with even one socket open the queue
+// can only be noticed by coming back to look. This slice is therefore the
+// latency of *everything that arrives by queue* -- every timer, and every
+// async gap in Dart that a timer implements -- for as long as an app holds a
+// socket.
+//
+// Eight milliseconds, which is half a frame, and cheap to come back from -- a
+// poll() that times out with nothing ready is an epoll create and destroy
+// measured at under 0.05 ms in spikes/t1-timers.
+//
+// This constant was blamed, twice, for something it never did. A timer armed
+// while a socket was open cost 3731 us against 517 us with nothing open, and
+// the slice was the obvious suspect both times. It is not: dropping it to 1 ms
+// moved the number by 1%, and a zero-duration timer leaves timeout_us at 0, so
+// the slice never applied to the case being measured in the first place.
+//
+// The real cause was in socket_patch.dart. setListening sent its event mask
+// once and always asked for POLLOUT, which is harmless on an edge-triggered
+// backend and a storm on a level-triggered one: 2255 write events in two
+// seconds on an idle socket, each one a message to the root isolate. With the
+// mask following what the socket actually wants, a Timer(Duration.zero) costs
+// the same 200 us with eight sockets open as with none.
+//
+// So: do not "fix" this constant without a measurement that implicates it.
+// Two have now failed to.
+//
+// It does nothing to socket latency, which is the platform's ~200 ms tick
+// either way.
+static constexpr int64_t kInterruptSliceUs = 8 * 1000;
+
+intptr_t DescriptorInfo::GetPollEvents() {
+  // POLLERR and POLLHUP are reported whether or not they are requested, so
+  // asking for them explicitly would be redundant -- and POLLERR is not even a
+  // legal request flag.
+  intptr_t events = 0;
+  if ((Mask() & (1 << kInEvent)) != 0) {
+    events |= POLLIN;
+  }
+  if ((Mask() & (1 << kOutEvent)) != 0) {
+    events |= POLLOUT;
+  }
+  return events;
+}
+
+EventHandlerImplementation::EventHandlerImplementation()
+    : socket_map_(&SimpleHashMap::SamePointerValue, 16),
+      poll_fds_(nullptr),
+      poll_fds_capacity_(0),
+      poll_fds_length_(0) {
+  // An event flag and a queue in memory, where every other POSIX backend has a
+  // pipe or a socketpair. This is not a stylistic difference: a loopback socket
+  // on this console delivers on a ~200 ms tick, and using one here made every
+  // Dart timer in every app fire at 5 Hz. See the note in eventhandler_vita.h.
+  event_flag_ = sceKernelCreateEventFlag("dart_io_eventhandler", 0, 0, nullptr);
+  if (event_flag_ < 0) {
+    FATAL("sceKernelCreateEventFlag failed: 0x%08X",
+          static_cast<unsigned int>(event_flag_));
+  }
+  shutdown_ = false;
+}
+
+static void DeleteDescriptorInfo(void* info) {
+  DescriptorInfo* di = reinterpret_cast<DescriptorInfo*>(info);
+  di->Close();
+  delete di;
+}
+
+EventHandlerImplementation::~EventHandlerImplementation() {
+  socket_map_.Clear(DeleteDescriptorInfo);
+  if (event_flag_ >= 0) {
+    sceKernelDeleteEventFlag(event_flag_);
+    event_flag_ = -1;
+  }
+  ::free(poll_fds_);
+}
+
+DescriptorInfo* EventHandlerImplementation::GetDescriptorInfo(
+    intptr_t fd,
+    bool is_listening) {
+  ASSERT(fd >= 0);
+  SimpleHashMap::Entry* entry = socket_map_.Lookup(
+      GetHashmapKeyFromFd(fd), GetHashmapHashFromFd(fd), true);
+  ASSERT(entry != nullptr);
+  DescriptorInfo* di = reinterpret_cast<DescriptorInfo*>(entry->value);
+  if (di == nullptr) {
+    // If there is no data in the hash map for this file descriptor a
+    // new DescriptorInfo for the file descriptor is inserted.
+    if (is_listening) {
+      di = new DescriptorInfoMultiple(fd);
+    } else {
+      di = new DescriptorInfoSingle(fd);
+    }
+    entry->value = di;
+  }
+  ASSERT(fd == di->fd());
+  return di;
+}
+
+void EventHandlerImplementation::WakeupHandler(intptr_t id,
+                                               Dart_Port dart_port,
+                                               int64_t data) {
+  InterruptMessage msg;
+  msg.id = id;
+  msg.dart_port = dart_port;
+  msg.data = data;
+
+  // The Linux backend relies on a pipe write of less than PIPE_BUF being
+  // atomic, so it needs no lock. A queue in memory needs one, and gets one:
+  // this is called from whichever thread ran the Dart code, and the handler
+  // thread drains it.
+  {
+    MutexLocker locker(&queue_mutex_);
+    queue_.Add(msg);
+  }
+  sceKernelSetEventFlag(event_flag_, kWakeBit);
+}
+
+void EventHandlerImplementation::HandleInterruptQueue() {
+  // Swapped out under the lock rather than processed under it: handling a
+  // message can call back into code that sends another one, and holding the
+  // mutex across that would deadlock.
+  MallocGrowableArray<InterruptMessage> msg;
+  {
+    MutexLocker locker(&queue_mutex_);
+    msg.AddArray(queue_);
+    queue_.Clear();
+  }
+  for (intptr_t i = 0; i < msg.length(); i++) {
+    if (msg[i].id == kTimerId) {
+      // No timerfd to re-arm. The deadline is read straight out of
+      // timeout_queue_ when the wait's timeout is computed, so updating the
+      // queue is the whole job.
+      timeout_queue_.UpdateTimeout(msg[i].dart_port, msg[i].data);
+    } else if (msg[i].id == kShutdownId) {
+      shutdown_ = true;
+    } else {
+      ASSERT((msg[i].data & COMMAND_MASK) != 0);
+      Socket* socket = reinterpret_cast<Socket*>(msg[i].id);
+      RefCntReleaseScope<Socket> rs(socket);
+      if (socket->fd() == -1) {
+        continue;
+      }
+      DescriptorInfo* di =
+          GetDescriptorInfo(socket->fd(), IS_LISTENING_SOCKET(msg[i].data));
+      if (IS_COMMAND(msg[i].data, kShutdownReadCommand)) {
+        ASSERT(!di->IsListeningSocket());
+        shutdown(di->fd(), SHUT_RD);
+      } else if (IS_COMMAND(msg[i].data, kShutdownWriteCommand)) {
+        ASSERT(!di->IsListeningSocket());
+        shutdown(di->fd(), SHUT_WR);
+      } else if (IS_COMMAND(msg[i].data, kCloseCommand)) {
+        // Process::ClearSignalHandlerByFd has no counterpart here: there are no
+        // signals on this platform, so no socket can be a signal socket.
+        Dart_Port port = msg[i].dart_port;
+        if (port != ILLEGAL_PORT) {
+          di->RemovePort(port);
+        }
+        intptr_t new_mask = di->Mask();
+
+        intptr_t fd = di->fd();
+        ASSERT(fd == socket->fd());
+        if (di->IsListeningSocket()) {
+          // Only close the descriptor if no other Dart socket object is
+          // listening on the same (address, port).
+          ListeningSocketRegistry* registry =
+              ListeningSocketRegistry::Instance();
+
+          MutexLocker locker(registry->mutex());
+
+          if (registry->CloseSafe(socket)) {
+            ASSERT(new_mask == 0);
+            socket_map_.Remove(GetHashmapKeyFromFd(fd),
+                               GetHashmapHashFromFd(fd));
+            di->Close();
+            delete di;
+          }
+          socket->CloseFd();
+        } else {
+          ASSERT(new_mask == 0);
+          socket_map_.Remove(GetHashmapKeyFromFd(fd), GetHashmapHashFromFd(fd));
+          di->Close();
+          delete di;
+          socket->CloseFd();
+        }
+        DartUtils::PostInt32(port, 1 << kDestroyedEvent);
+      } else if (IS_COMMAND(msg[i].data, kReturnTokenCommand)) {
+        int count = TOKEN_COUNT(msg[i].data);
+        di->ReturnTokens(msg[i].dart_port, count);
+      } else if (IS_COMMAND(msg[i].data, kSetEventMaskCommand)) {
+        // `events` can only have kInEvent/kOutEvent flags set.
+        intptr_t events = msg[i].data & EVENT_MASK;
+        ASSERT(0 == (events & ~(1 << kInEvent | 1 << kOutEvent)));
+
+        di->SetPortAndMask(msg[i].dart_port, msg[i].data & EVENT_MASK);
+      } else {
+        UNREACHABLE();
+      }
+    }
+  }
+}
+
+void EventHandlerImplementation::BuildPollArray() {
+  // The Linux backend keeps a kernel-side epoll set and edits it incrementally,
+  // which is why it needs UpdateEpollInstance on every mask change. poll() is
+  // handed the whole array on each call, so there is nothing to keep in sync:
+  // the array is rebuilt from the masks each time round, and a mask change
+  // needs no bookkeeping at all.
+  intptr_t needed = 0;  // sockets only -- the interrupt is not a descriptor
+  for (SimpleHashMap::Entry* entry = socket_map_.Start(); entry != nullptr;
+       entry = socket_map_.Next(entry)) {
+    DescriptorInfo* di = reinterpret_cast<DescriptorInfo*>(entry->value);
+    if (di != nullptr && di->Mask() != 0) {
+      needed++;
+    }
+  }
+
+  if (needed > poll_fds_capacity_) {
+    intptr_t capacity = (poll_fds_capacity_ == 0) ? 16 : poll_fds_capacity_;
+    while (capacity < needed) {
+      capacity *= 2;
+    }
+    // dart::realloc, explicitly. Unqualified, this is ambiguous between
+    // platform/allocation.h's and the global one -- and dart::realloc is the
+    // one wanted, because it calls OUT_OF_MEMORY() itself rather than handing
+    // back a null that would need checking here.
+    poll_fds_ = reinterpret_cast<struct pollfd*>(dart::realloc(
+        poll_fds_, static_cast<size_t>(capacity) * sizeof(struct pollfd)));
+    poll_fds_capacity_ = capacity;
+  }
+
+  intptr_t n = 0;
+  for (SimpleHashMap::Entry* entry = socket_map_.Start(); entry != nullptr;
+       entry = socket_map_.Next(entry)) {
+    DescriptorInfo* di = reinterpret_cast<DescriptorInfo*>(entry->value);
+    if (di == nullptr || di->Mask() == 0) {
+      continue;
+    }
+    if (n >= kMaxPollDescriptors) {
+      // VitaSDK's poll() rejects nfds > 255 outright with EINVAL, so going over
+      // is not a slow path, it is a dead one. Say so rather than silently
+      // dropping sockets from the set and leaving them to hang for ever.
+      Syslog::PrintErr(
+          "dart:io: more than %" Pd " concurrent sockets; this platform's "
+          "poll() cannot wait on them all and the excess will not be "
+          "serviced\n",
+          kMaxPollDescriptors);
+      break;
+    }
+    poll_fds_[n].fd = di->fd();
+    poll_fds_[n].events = di->GetPollEvents();
+    poll_fds_[n].revents = 0;
+    n++;
+  }
+  poll_fds_length_ = n;
+}
+
+intptr_t EventHandlerImplementation::GetPollEvents(intptr_t events,
+                                                   DescriptorInfo* di) {
+  if ((events & POLLERR) != 0) {
+    // Mirrors the Linux backend: report an error only when there is also
+    // something to read, so that a pending error is delivered in order with the
+    // data that preceded it.
+    return ((events & POLLIN) != 0) ? (1 << kErrorEvent) : 0;
+  }
+  intptr_t event_mask = 0;
+  if ((events & POLLIN) != 0) {
+    event_mask |= (1 << kInEvent);
+  }
+  if ((events & POLLOUT) != 0) {
+    event_mask |= (1 << kOutEvent);
+  }
+  if ((events & POLLHUP) != 0) {
+    event_mask |= (1 << kCloseEvent);
+  }
+  // No POLLRDHUP on this platform. A half-close therefore arrives as a
+  // zero-length read rather than as an event, which dart:io already handles --
+  // it is how the macOS backend behaves too.
+  return event_mask;
+}
+
+void EventHandlerImplementation::HandleEvents() {
+  for (intptr_t i = 0; i < poll_fds_length_; i++) {
+    if (poll_fds_[i].revents == 0) {
+      continue;
+    }
+    SimpleHashMap::Entry* entry =
+        socket_map_.Lookup(GetHashmapKeyFromFd(poll_fds_[i].fd),
+                           GetHashmapHashFromFd(poll_fds_[i].fd), false);
+    if (entry == nullptr) {
+      // Closed while we were waiting.
+      continue;
+    }
+    DescriptorInfo* di = reinterpret_cast<DescriptorInfo*>(entry->value);
+    if (di == nullptr) {
+      continue;
+    }
+    const intptr_t event_mask = GetPollEvents(poll_fds_[i].revents, di);
+    if ((event_mask & (1 << kErrorEvent)) != 0) {
+      di->NotifyAllDartPorts(event_mask);
+    } else if (event_mask != 0) {
+      Dart_Port port = di->NextNotifyDartPort(event_mask);
+      ASSERT(port != 0);
+      DartUtils::PostInt32(port, event_mask);
+    }
+  }
+}
+
+void EventHandlerImplementation::WaitOnEventFlag(int64_t timeout_us) {
+  SceUInt storage = 0;
+  SceUInt* timeout = nullptr;  // nullptr means wait indefinitely.
+  if (timeout_us >= 0) {
+    // SceUInt is 32-bit, so a deadline more than ~71 minutes out would
+    // overflow. Cap it and wake early instead: the loop recomputes the deadline
+    // and waits again, so a spurious wakeup costs one cheap iteration where an
+    // overflowed timeout would cost a missed one.
+    constexpr int64_t kMaxTimeoutUs = 0x7FFFFFFF;
+    storage = static_cast<SceUInt>(
+        timeout_us > kMaxTimeoutUs ? kMaxTimeoutUs : timeout_us);
+    timeout = &storage;
+  }
+  unsigned int out_bits = 0;
+  const int result = sceKernelWaitEventFlag(event_flag_, kWakeBit,
+                                            SCE_EVENT_WAITOR, &out_bits,
+                                            timeout);
+  // A timeout is the ordinary case -- it means a deadline arrived -- so it is
+  // not an error.
+  if (result < 0 &&
+      static_cast<unsigned int>(result) != SCE_KERNEL_ERROR_WAIT_TIMEOUT) {
+    Syslog::PrintErr("dart:io: sceKernelWaitEventFlag failed: 0x%08X\n",
+                     static_cast<unsigned int>(result));
+  }
+}
+
+void EventHandlerImplementation::Poll(uword args) {
+  EventHandler* handler = reinterpret_cast<EventHandler*>(args);
+  EventHandlerImplementation* handler_impl = &handler->delegate_;
+  ASSERT(handler_impl != nullptr);
+
+  while (!handler_impl->shutdown_) {
+    // Clear before draining the queue, not after. If a WakeupHandler lands in
+    // the window between the two, the bit it sets survives into the wait below
+    // and returns from it immediately -- which is the correct outcome, because
+    // that message has not been seen yet. Clearing afterwards would swallow the
+    // wakeup and the handler would sleep through its own work.
+    sceKernelClearEventFlag(handler_impl->event_flag_, ~kWakeBit);
+    handler_impl->HandleInterruptQueue();
+    if (handler_impl->shutdown_) {
+      break;
+    }
+
+    // After the queue, because a message in it may have registered or closed a
+    // socket, or changed a mask.
+    handler_impl->BuildPollArray();
+
+    // timerfd's replacement. The queue holds absolute times in milliseconds on
+    // the same clock as GetCurrentMonotonicMillis, so the wait is the
+    // difference -- clamped at zero, because a deadline already in the past
+    // must not become a negative timeout, which both waits read as "for ever".
+    int64_t timeout_us = kWaitForever;
+    if (handler_impl->timeout_queue_.HasTimeout()) {
+      const int64_t millis = handler_impl->timeout_queue_.CurrentTimeout() -
+                             TimerUtils::GetCurrentMonotonicMillis();
+      timeout_us = (millis < 0) ? 0 : millis * 1000;
+    }
+
+    if (handler_impl->poll_fds_length_ == 0) {
+      // The common case, and the one that matters: an app with no sockets open
+      // waits on the event flag alone, which is both exact and interruptible.
+      // This is what puts Future.delayed(33 ms) back at 33 ms.
+      //
+      // A deadline already in the past skips the wait outright rather than
+      // asking for a zero timeout: nothing here needs sceKernelWaitEventFlag to
+      // have an opinion about that case, and the expired-timer drain below is
+      // the next thing that runs either way.
+      if (timeout_us != 0) {
+        handler_impl->WaitOnEventFlag(timeout_us);
+      }
+    } else {
+      // With sockets registered, poll() owns the wait and cannot be woken by
+      // the event flag, so the wait is sliced and the queue re-checked. See
+      // kInterruptSliceUs.
+      int64_t slice_us = kInterruptSliceUs;
+      if (timeout_us >= 0 && timeout_us < slice_us) {
+        slice_us = timeout_us;
+      }
+      // Rounded up: a sub-millisecond slice must not become a busy loop.
+      const int slice_ms = static_cast<int>((slice_us + 999) / 1000);
+      const intptr_t result = VITA_RETRY_EINTR(
+          poll(handler_impl->poll_fds_,
+               static_cast<unsigned int>(handler_impl->poll_fds_length_),
+               slice_ms));
+      if (result < 0) {
+        Syslog::PrintErr("dart:io: poll failed: %s\n", strerror(errno));
+      } else if (result > 0) {
+        handler_impl->HandleEvents();
+      }
+    }
+
+    // Fire every deadline that has come due, however the wait ended. More than
+    // one can expire in a single wait, so this drains rather than firing once.
+    while (handler_impl->timeout_queue_.HasTimeout() &&
+           handler_impl->timeout_queue_.CurrentTimeout() <=
+               TimerUtils::GetCurrentMonotonicMillis()) {
+      DartUtils::PostNull(handler_impl->timeout_queue_.CurrentPort());
+      handler_impl->timeout_queue_.RemoveCurrent();
+    }
+  }
+  DEBUG_ASSERT(ReferenceCounted<Socket>::instances() == 0);
+  handler->NotifyShutdownDone();
+}
+
+void EventHandlerImplementation::Start(EventHandler* handler) {
+  Thread::Start("dart:io EventHandler", &EventHandlerImplementation::Poll,
+                reinterpret_cast<uword>(handler));
+}
+
+void EventHandlerImplementation::Shutdown() {
+  SendData(kShutdownId, 0, 0);
+}
+
+void EventHandlerImplementation::SendData(intptr_t id,
+                                          Dart_Port dart_port,
+                                          int64_t data) {
+  WakeupHandler(id, dart_port, data);
+}
+
+void* EventHandlerImplementation::GetHashmapKeyFromFd(intptr_t fd) {
+  // The hashmap does not support keys with value 0.
+  return reinterpret_cast<void*>(fd + 1);
+}
+
+uint32_t EventHandlerImplementation::GetHashmapHashFromFd(intptr_t fd) {
+  // The hashmap does not support keys with value 0.
+  return dart::Utils::WordHash(fd + 1);
+}
+
+}  // namespace bin
+}  // namespace dart
+
+#endif  // defined(DART_HOST_OS_VITA)
