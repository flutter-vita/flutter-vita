 int Platform::NumberOfProcessors() {
+#if defined(DART_HOST_OS_VITA)
+  // sysconf(_SC_NPROCESSORS_ONLN) returns -1 here, and Dart sizes its thread
+  // pools from this, so -1 is not cosmetic.
+  //
+  // Asked rather than hardcoded: the affinity mask says which cores this
+  // thread may actually run on, which is the number that matters. The Vita has
+  // four Cortex-A9 cores and reserves the fourth -- psp2/kernel/cpu.h defines
+  // USER_0, USER_1, USER_2 and a separate SYSTEM -- so the expected answer is
+  // three, not the four a spec sheet gives.
+  const int mask = sceKernelGetThreadCpuAffinityMask(0);
+  if (mask > 0) {
+    int cores = 0;
+    for (int bit = 0; bit < 32; bit++) {
+      if ((mask & (1 << bit)) != 0) {
+        cores++;
+      }
+    }
+    if (cores > 0) {
+      return cores;
+    }
+  }
+  // A thread left on the default affinity reports the default mask rather than
+  // an expanded one, so fall back to the documented user-core count instead of
+  // to something that would look like a single-core machine.
