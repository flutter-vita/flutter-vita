new file mode 100644
index 00000000..18768363
--- /dev/null
+++ b/runtime/vm/virtual_memory_vita.cc
@@ -0,0 +1,222 @@
+// Copyright (c) 2012, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "vm/globals.h"
+#if defined(DART_HOST_OS_VITA)
+
+#include "vm/virtual_memory.h"
+
+#include <psp2/kernel/sysmem.h>
+
+#include "platform/assert.h"
+#include "platform/syslog.h"
+#include "vm/os.h"
+
+// Vita virtual memory, on sceKernelAllocMemBlock.
+//
+// This file is far smaller than virtual_memory_posix.cc because most of that
+// file serves paths that do not exist under AOT on 32-bit ARM. Established by
+// source analysis before writing it -- see docs/phase-1-workplan.md:
+//
+//   * No executable memory. Fresh executable pages come only from the heap's
+//     code space, which AOT never allocates into: code lives in the snapshot
+//     image, wrapped by the shared VirtualMemory::ForImagePage without any
+//     allocation. DuplicateRX is Mac-only and dual mapping is iOS-only.
+//
+//   * No Protect. Its three callers are all unreachable here -- code_patcher.cc
+//     is #if TARGET_ARCH_IA32, the freelist path needs is_executable which is
+//     always false, and the FFI path is behind a compile-time-false const on
+//     non-macOS. The Vita fixes protection at allocation via the memblock type
+//     and offers no runtime change, so this is fortunate rather than merely
+//     convenient.
+//
+//   * No Reserve/Commit/Decommit. They are private helpers, and every call site
+//     is inside #if defined(DART_COMPRESSED_POINTERS). Compressed pointers are
+//     a 64-bit-only feature and dart_use_compressed_pointers defaults to false.
+//
+// What is left is an aligned allocator. sceKernelAllocMemBlock commits
+// immediately and chooses its own address, which is exactly enough.
+
+namespace dart {
+
+extern void VitaTrace(const char* format, ...);
+
+// Vita memory blocks are allocated in 4 KiB pages.
+static constexpr intptr_t kVitaPageSize = 4096;
+
+uword VirtualMemory::page_size_ = 0;
+
+intptr_t VirtualMemory::CalculatePageSize() {
+  return kVitaPageSize;
+}
+
+void VirtualMemory::Init() {
+  VitaTrace("[vita] VirtualMemory::Init\n");
+  if (page_size_ == 0) {
+    page_size_ = CalculatePageSize();
+  }
+}
+
+void VirtualMemory::Cleanup() {
+  page_size_ = 0;
+}
+
+VirtualMemory* VirtualMemory::AllocateAligned(intptr_t size,
+                                              intptr_t alignment,
+                                              bool is_executable,
+                                              bool is_compressed,
+                                              const char* name) {
+  ASSERT(Utils::IsAligned(size, PageSize()));
+  ASSERT(Utils::IsPowerOfTwo(alignment));
+  ASSERT(Utils::IsAligned(alignment, PageSize()));
+  // Both are unreachable on this target; see the file comment. Asserting rather
+  // than silently ignoring means a future change upstream shows up here.
+  ASSERT(!is_executable);
+  ASSERT(!is_compressed);
+  if (name == nullptr) {
+    name = "dart-heap";
+  }
+
+  // Ask the kernel for the alignment directly rather than over-allocating and
+  // trimming the excess: sceKernelFreeMemBlock frees a whole block, so the
+  // POSIX trick of releasing the unaligned head and tail is not available.
+  SceKernelAllocMemBlockOpt opt;
+  memset(&opt, 0, sizeof(opt));
+  opt.size = sizeof(opt);
+  opt.attr = SCE_KERNEL_ALLOC_MEMBLOCK_ATTR_HAS_ALIGNMENT;
+  opt.alignment = static_cast<SceSize>(alignment);
+
+  VitaTrace("[vita] alloc '%s' size=%ld align=%ld\n", name,
+            static_cast<long>(size), static_cast<long>(alignment));
+  const SceUID uid =
+      sceKernelAllocMemBlock(name, SCE_KERNEL_MEMBLOCK_TYPE_USER_MAIN_RW,
+                             static_cast<SceSize>(size), &opt);
+  VitaTrace("[vita]   -> uid 0x%08X\n", uid);
+  if (uid < 0) {
+    // Loud on failure. Returning nullptr silently would surface far away as a
+    // crash inside whichever allocation happened to need it, and there is no
+    // debugger on device to walk back from there.
+    Syslog::PrintErr(
+        "virtual_memory_vita: sceKernelAllocMemBlock('%s', size=%ld, "
+        "align=%ld) failed -> 0x%08X\n",
+        name, static_cast<long>(size), static_cast<long>(alignment), uid);
+    return nullptr;
+  }
+
+  void* base = nullptr;
+  if (sceKernelGetMemBlockBase(uid, &base) < 0 || base == nullptr) {
+    sceKernelFreeMemBlock(uid);
+    return nullptr;
+  }
+  VitaTrace("[vita]   -> base %p aligned=%d\n", base,
+            Utils::IsAligned(reinterpret_cast<uword>(base), alignment) ? 1 : 0);
+
+  // SceKernelAllocMemBlockOpt.alignment is a request, not a guarantee, and the
+  // kernel does not report having ignored it -- the allocation simply succeeds
+  // at whatever address it liked. That is silently fatal for Dart: heap pages
+  // are found by masking an object address with ~(kPageSize - 1), so a page
+  // that is not truly kPageSize-aligned makes every object-to-page lookup
+  // return garbage. The ASSERT that would have caught it is compiled out in
+  // PRODUCT builds.
+  //
+  // If the kernel did not honour the request, fall back to over-allocating by
+  // one alignment and using an aligned address inside the block. A memblock
+  // cannot be partially freed, so the slack is simply carried; with 188 MiB
+  // contiguous available (Phase 0.5 Track A) that is affordable.
+  if (!Utils::IsAligned(reinterpret_cast<uword>(base), alignment)) {
+    VitaTrace("[vita]   alignment not honoured, retrying over-allocated\n");
+    sceKernelFreeMemBlock(uid);
+
+    const SceSize padded = static_cast<SceSize>(size + alignment);
+    const SceUID uid2 = sceKernelAllocMemBlock(
+        name, SCE_KERNEL_MEMBLOCK_TYPE_USER_MAIN_RW, padded, nullptr);
+    if (uid2 < 0) {
+      Syslog::PrintErr("virtual_memory_vita: padded alloc failed -> 0x%08X\n",
+                       uid2);
+      return nullptr;
+    }
+    void* raw = nullptr;
+    if (sceKernelGetMemBlockBase(uid2, &raw) < 0 || raw == nullptr) {
+      sceKernelFreeMemBlock(uid2);
+      return nullptr;
+    }
+    const uword aligned =
+        Utils::RoundUp(reinterpret_cast<uword>(raw), alignment);
+    VitaTrace("[vita]   raw %p -> aligned 0x%08x\n", raw,
+              static_cast<unsigned>(aligned));
+
+    // region_ is the aligned window Dart uses; reserved_ is the whole block so
+    // the destructor's sceKernelFindMemBlockByAddr frees all of it.
+    MemoryRegion region(reinterpret_cast<void*>(aligned), size);
+    MemoryRegion reserved(raw, padded);
+    return new VirtualMemory(region, reserved);
+  }
+
+  MemoryRegion region(base, size);
+  // reserved_ == region means vm_owns_region() is true, so the destructor frees
+  // it. The SceUID is not stored: it is recovered with
+  // sceKernelFindMemBlockByAddr, which avoids a side table keyed on address.
+  return new VirtualMemory(region, region);
+}
+
+VirtualMemory::~VirtualMemory() {
+  if (!vm_owns_region()) {
+    return;  // An image page owned by the embedder; see ForImagePage.
+  }
+  const SceUID uid = sceKernelFindMemBlockByAddr(
+      reinterpret_cast<void*>(reserved_.start()), reserved_.size());
+  if (uid < 0) {
+    FATAL("Failed to find memblock for %p", reserved_.pointer());
+  }
+  const int result = sceKernelFreeMemBlock(uid);
+  if (result < 0) {
+    FATAL("Failed to free memblock: 0x%08X", result);
+  }
+}
+
+bool VirtualMemory::FreeSubSegment(void* address, intptr_t size) {
+  // A memblock is freed whole or not at all. AllocateAligned asks the kernel
+  // for alignment instead of trimming, so nothing here needs partial frees.
+  // Returning false means "could not give it back", which callers tolerate.
+  return false;
+}
+
+void VirtualMemory::DontNeed(void* address, intptr_t size) {
+  // madvise(MADV_DONTNEED) has no Vita equivalent. It is purely an advisory
+  // hint to release physical pages, so ignoring it is correct, just less
+  // memory-efficient.
+}
+
+void VirtualMemory::Protect(void* address, intptr_t size, Protection mode) {
+  // A no-op, not an error.
+  //
+  // This was UNREACHABLE() until M1 run 3, on the analysis that its three known
+  // callers were all unreachable here. That analysis missed a fourth: the VM
+  // isolate's heap write-protection, reached during Dart_Initialize via
+  // WritableVMIsolateScope -> Heap::WriteProtect -> Page::WriteProtect, gated on
+  // FLAG_write_protect_vm_isolate rather than FLAG_write_protect_code. I checked
+  // one flag and concluded about both.
+  //
+  // OS::Init now clears both flags, so this should not be called. Keeping it a
+  // no-op rather than UNREACHABLE() is the defensive choice: the Vita cannot
+  // change protection at all, so quietly not doing so is always closer to right
+  // than aborting, and any remaining caller is one this analysis has not found.
+}
