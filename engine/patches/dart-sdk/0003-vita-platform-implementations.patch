+// Copyright (c) 2012, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "vm/globals.h"
+#if defined(DART_HOST_OS_VITA)
+
+#include "vm/os.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/time.h>
+#include <time.h>
+
+#include <psp2/kernel/processmgr.h>
+#include <psp2/kernel/threadmgr.h>
+
+#include "platform/assert.h"
+#include "vm/flags.h"
+#include "vm/image_snapshot.h"
+#include "vm/zone.h"
+
+// Time, sleep and printing for Vita.
+//
+// Most of this maps cleanly: newlib provides gettimeofday and clock_gettime,
+// and sceKernel provides a monotonic microsecond clock and a thread delay.
+// Two things are deliberately stubbed:
+//
+//   RegisterCodeObservers  -- the Linux implementation writes a perf jitdump
+//                             via mmap(PROT_EXEC) on a file descriptor. There
+//                             is no perf on Vita and nothing consumes it.
+//   GetCurrentThreadCPUMicros -- no per-thread CPU clock; returns -1, which is
+//                             the documented "unsupported" value.
+
+namespace dart {
+
+extern void VitaTrace(const char* format, ...);
+
+// Verbatim from os_linux.cc: pure string parsing with no OS dependency, but
+// Dart declares it per-platform so every port carries its own copy.
+bool OS::ParseInitialInt64(const char* str, int64_t* value, char** end) {
+  ASSERT(str != nullptr && strlen(str) > 0 && value != nullptr &&
+         end != nullptr);
+  int32_t base = 10;
+  int i = 0;
+  if (str[0] == '-') {
+    i = 1;
+  } else if (str[0] == '+') {
+    i = 1;
+  }
+  if ((str[i] == '0') && (str[i + 1] == 'x' || str[i + 1] == 'X') &&
+      (str[i + 2] != '\0')) {
+    base = 16;
+  }
+  errno = 0;
+  if (base == 16) {
+    // Unsigned 64-bit hexadecimal integer literals are allowed but
+    // immediately interpreted as signed 64-bit integers.
+    *value = static_cast<int64_t>(strtoull(str, end, base));
+  } else {
+    *value = strtoll(str, end, base);
+  }
+  return (errno == 0) && (*end != str);
+}
+
+intptr_t OS::ProcessId() {
+  return static_cast<intptr_t>(sceKernelGetProcessId());
+}
+
+const char* OS::GetTimeZoneName(int64_t seconds_since_epoch) {
+  // The Vita exposes a timezone offset through SceAppUtil, but not an IANA
+  // name. Reporting UTC is honest; the offset below is the useful part.
+  return "UTC";
+}
+
+int OS::GetTimeZoneOffsetInSeconds(int64_t seconds_since_epoch) {
+  // newlib's localtime honours the TZ environment variable, which the Vita does
+  // not set. Without SceAppUtil (which would drag in a system-config dependency
+  // the runtime should not have), UTC is the truthful answer.
+  return 0;
+}
+
+int64_t OS::GetCurrentTimeMillis() {
+  return GetCurrentTimeMicros() / 1000;
+}
+
+int64_t OS::GetCurrentTimeMicros() {
+  struct timeval tv;
+  if (gettimeofday(&tv, nullptr) < 0) {
+    FATAL("gettimeofday returned an error (%s)", strerror(errno));
+    return 0;
+  }
+  return (static_cast<int64_t>(tv.tv_sec) * 1000000) + tv.tv_usec;
+}
+
+int64_t OS::GetCurrentMonotonicTicks() {
+  // sceKernelGetProcessTimeWide is already microseconds, so ticks and micros
+  // share a unit and GetCurrentMonotonicFrequency is 1000000.
+  return static_cast<int64_t>(sceKernelGetProcessTimeWide());
+}
+
+int64_t OS::GetCurrentMonotonicFrequency() {
+  return 1000000;
+}
+
+int64_t OS::GetCurrentMonotonicMicros() {
+  ASSERT(GetCurrentMonotonicFrequency() == 1000000);
+  return GetCurrentMonotonicTicks();
+}
+
+int64_t OS::GetCurrentThreadCPUMicros() {
+  // No per-thread CPU clock; -1 is the "unsupported" contract.
+  return -1;
+}
+
+int64_t OS::GetCurrentMonotonicMicrosForTimeline() {
+#if defined(SUPPORT_TIMELINE)
+  return GetCurrentMonotonicMicros();
+#else
+  return -1;
+#endif
+}
+
+intptr_t OS::ActivationFrameAlignment() {
+  // AAPCS requires 8-byte stack alignment at public interfaces, and VitaSDK
+  // follows the standard ARM EABI here.
+  return 8;
+}
+
+uintptr_t OS::CurrentRSS() {
+  // No process memory accounting exposed to homebrew. 0 means "unknown"; it is
+  // only used for reporting.
+  return 0;
+}
+
+void OS::Sleep(int64_t millis) {
+  SleepMicros(millis * 1000);
+}
+
+void OS::SleepMicros(int64_t micros) {
+  ASSERT(micros >= 0);
+  sceKernelDelayThread(static_cast<SceUInt>(micros));
+}
+
+void OS::DebugBreak() {
+  UNIMPLEMENTED();
+}
+
+void OS::NotifyBeforeGC() {}
+void OS::NotifyAfterGC() {}
+
+DART_NOINLINE uintptr_t OS::GetProgramCounter() {
+  return reinterpret_cast<uintptr_t>(
+      __builtin_extract_return_addr(__builtin_return_address(0)));
+}
+
+void OS::Print(const char* format, ...) {
+  va_list args;
+  va_start(args, format);
+  VFPrint(stdout, format, args);
+  va_end(args);
+}
+
+void OS::VFPrint(FILE* stream, const char* format, va_list args) {
+  vfprintf(stream, format, args);
+  fflush(stream);
+}
+
+char* OS::SCreate(Zone* zone, const char* format, ...) {
+  va_list args;
+  va_start(args, format);
+  char* buffer = VSCreate(zone, format, args);
+  va_end(args);
+  return buffer;
+}
+
+char* OS::VSCreate(Zone* zone, const char* format, va_list args) {
+  // Measure with a copy: vsnprintf consumes the va_list.
+  va_list measure_args;
+  va_copy(measure_args, args);
+  intptr_t len = vsnprintf(nullptr, 0, format, measure_args);
+  va_end(measure_args);
+
+  char* buffer;
+  if (zone != nullptr) {
+    buffer = zone->Alloc<char>(len + 1);
+  } else {
+    buffer = reinterpret_cast<char*>(malloc(len + 1));
+  }
+  ASSERT(buffer != nullptr);
+
+  va_list print_args;
+  va_copy(print_args, args);
+  vsnprintf(buffer, len + 1, format, print_args);
+  va_end(print_args);
+  return buffer;
+}
+
+void OS::PrintErr(const char* format, ...) {
+  va_list args;
+  va_start(args, format);
+  VFPrint(stderr, format, args);
+  va_end(args);
+}
+
+DECLARE_FLAG(bool, write_protect_code);
+DECLARE_FLAG(bool, write_protect_vm_isolate);
+
+void OS::Init() {
+  VitaTrace("[vita] OS::Init\n");
+  // The Vita fixes page protection at allocation via the memblock type and has
+  // no runtime equivalent of mprotect, so anything that toggles protection has
+  // to be switched off rather than emulated.
+  //
+  // write_protect_vm_isolate defaults to true and is what M1 run 3 tripped over:
+  // WritableVMIsolateScope -> Heap::WriteProtect -> Page::WriteProtect ->
+  // VirtualMemory::Protect, during Dart_Initialize. Note this is the
+  // *non-executable* branch, so it fires regardless of is_executable.
+  //
+  // os_linux.cc does exactly this when writing a perf jitdump, for the same
+  // reason -- calling mprotect there is unhelpful -- so the mechanism is
+  // upstream-sanctioned rather than invented here.
+  //
+  // Both flags are debugging aids: they catch stray writes to memory that
+  // should be read-only. Losing them costs a safety net, not correctness.
+  FLAG_write_protect_code = false;
+  FLAG_write_protect_vm_isolate = false;
+}
+
+void OS::Cleanup() {}
+
+void OS::PrepareToAbort() {}
+
+void OS::Abort() {
+  PrepareToAbort();
+  abort();
+}
+
+void OS::Exit(int code) {
+  sceKernelExitProcess(code);
+  // OS::Exit is declared [[noreturn]], but sceKernelExitProcess is not marked
+  // as such in the VitaSDK headers, so the compiler cannot see that control
+  // never reaches here. UNREACHABLE() satisfies it without inventing control
+  // flow -- if the kernel ever did return, aborting is the right answer.
+  UNREACHABLE();
+}
+
+void OS::RegisterCodeObservers() {
+  // The Linux implementation registers a perf jitdump writer, which needs
+  // mmap(PROT_EXEC) on a file descriptor. There is no perf on Vita and nothing
+  // would read the output, so there are no observers to register.
+}
+
+OS::BuildId OS::GetAppBuildId(const uint8_t* snapshot_instructions) {
+  // Only the build id carried inside the instructions image is available.
+  //
+  // The Linux implementation falls back to walking the host ELF's PT_NOTE
+  // headers for NT_GNU_BUILD_ID. That has no analogue here: the running program
+  // is a Sony SELF, not an ELF mapped at a walkable base, and there is no
+  // dl_iterate_phdr. Under ADR-0005 the snapshot is loaded from app0: into a VM
+  // domain block by the embedder, so if a build id exists it is in the image.
+  const Image instructions_image(snapshot_instructions);
+  if (auto* const image_build_id = instructions_image.build_id()) {
+    return {instructions_image.build_id_length(), image_build_id};
+  }
+  return {0, nullptr};
+}
+
+}  // namespace dart
+
+#endif  // defined(DART_HOST_OS_VITA)
