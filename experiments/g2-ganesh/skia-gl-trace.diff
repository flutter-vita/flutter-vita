     do {                                                        \
+        fvita_gl_trace(__FILE__, __LINE__);                     \
         GR_GL_CALL_NOERRCHECK(IFACE, X);                        \
         GR_GL_CHECK_ERROR_IMPL(IFACE, X);                       \
     } while (false)
