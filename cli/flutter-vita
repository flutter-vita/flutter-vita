#!/usr/bin/env bash
# Thin launcher, so the CLI is one command rather than a dart invocation.
#
# Runs on the Dart inside the tools' own Flutter SDK, which tools/flutter-sdk.sh
# downloads the first time; FLUTTER_ROOT, when set, names another one. Exported
# as FLUTTER_ROOT, so the CLI and every build script it starts use the same SDK.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"

FLUTTER_ROOT="$("$ROOT/tools/flutter-sdk.sh")" || exit 1
export FLUTTER_ROOT

exec "$FLUTTER_ROOT/bin/cache/dart-sdk/bin/dart" run "$HERE/bin/flutter_vita.dart" "$@"
