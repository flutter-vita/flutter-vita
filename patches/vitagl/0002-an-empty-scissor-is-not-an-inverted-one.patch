diff --git a/source/misc.c b/source/misc.c
index 1a27d55..10f2c12 100644
--- a/source/misc.c
+++ b/source/misc.c
@@ -327,6 +327,15 @@ void glViewport(GLint x, GLint y, GLsizei width, GLsizei height) {
 	}
 #endif
 
+	// Same reasoning as the scissor clamp in tests.c: Skia passes a zero-sized
+	// viewport while a route animates, and a viewport with no area gives
+	// sceGxmSetViewport a scale of zero and an offset that is not the centre of
+	// anything. One pixel is the smallest thing that is still a rectangle.
+	if (width <= 0)
+		width = 1;
+	if (height <= 0)
+		height = 1;
+
 	x_scale = width >> 1;
 	x_port = x + x_scale;
 	y_scale = -(height >> 1);
diff --git a/source/tests.c b/source/tests.c
index aad6b0e..de03338 100644
--- a/source/tests.c
+++ b/source/tests.c
@@ -33,6 +33,16 @@ GLboolean dirty_scissor_state = GL_FALSE; // Flag for when scissor test update m
 
 // Scissor Test
 scissor_region region; // Current scissor test region setup
+
+// How many glScissor calls have arrived with no area, or with an origin past
+// the end of the display, since launch. Non-zero means the clamps below are
+// load-bearing rather than theoretical.
+//
+// A counter and not a log line: vgl_log is sceClibPrintf, which needs a kernel
+// plugin this port deliberately does without, and a line per call here would be
+// thousands a second. The embedder prints the count instead, the same
+// arrangement as vgl_oom_count in patch 0001.
+unsigned int vgl_degenerate_scissor = 0;
 GLboolean scissor_test_state = GL_FALSE; // Current state for GL_SCISSOR_TEST
 SceGxmFragmentProgram *scissor_test_fragment_program; // Scissor test fragment program
 vector4f *scissor_test_vertices = NULL; // Scissor test region vertices
@@ -284,6 +294,29 @@ void update_scissor_test() {
 	if (region.y + region.h > active_h)
 		region.h = active_h - region.y;
 
+	// A scissor can be empty, and the two clamps above can make it negative.
+	//
+	// Skia asks for both constantly -- a popup menu animating open passes
+	// through every width from zero, and a list row clipped off-screen leaves
+	// region.x past active_w, at which point `active_w - region.x` is below
+	// zero. Neither is an error in GL; glScissor(x, y, 0, 0) means "draw
+	// nothing".
+	//
+	// What happens next is not fine. region.w and region.h reach
+	// sceGxmSetRegionClip as `region.x + region.w - 1`, and that function's
+	// parameters are **unsigned**: a width of zero makes xMax one below xMin,
+	// and a negative width makes it a number near 2^32. GXM computes tile
+	// ranges from those without checking them.
+	//
+	// flutter-vita took a data abort at SceGxm+0x1e638 three times -- 08-30,
+	// 08-31 and 09-01 -- always on the raster thread, always with the same
+	// registers, and on 09-01 reproducibly, one tap on an overflow menu. See
+	// docs/results/localsend-gxm-abort-2026-08-31.md.
+	if (region.w < 0)
+		region.w = 0;
+	if (region.h < 0)
+		region.h = 0;
+
 #ifndef DISABLE_TILE_CLIPPER
 	// Invalidating internal tile based region clip
 	sceGxmSetRegionClip(gxm_context, SCE_GXM_REGION_CLIP_OUTSIDE, 0, 0, active_w - 1, active_h - 1);
@@ -341,7 +374,12 @@ void update_scissor_test() {
 
 #ifndef DISABLE_TILE_CLIPPER
 	// Reducing GPU workload by performing tile granularity clipping
-	if (scissor_test_state) {
+	//
+	// Only for a region with area. The tile clipper is an optimisation on top
+	// of the stencil the rest of this function writes, so skipping it for an
+	// empty scissor costs a little GPU time on a draw that is fully clipped
+	// away anyway -- and the stencil still rejects every pixel.
+	if (scissor_test_state && region.w > 0 && region.h > 0) {
 #ifndef HAVE_UNFLIPPED_FBOS
 		if (!is_rendering_display) {
 			uint32_t y = region.gl_y > 0 ? region.gl_y : 0;
@@ -386,6 +424,8 @@ void glScissor(GLint x, GLint y, GLsizei width, GLsizei height) {
 	region.gl_y = y;
 	region.gl_w = width;
 	region.gl_h = height;
+	if (width <= 0 || height <= 0 || x > DISPLAY_WIDTH || y > DISPLAY_HEIGHT)
+		vgl_degenerate_scissor++;
 
 	if (scissor_test_state)
 		dirty_scissor_state = GL_TRUE;
