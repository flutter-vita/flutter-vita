diff --git a/source/textures.c b/source/textures.c
index 27e8a6c..2a2b532 100644
--- a/source/textures.c
+++ b/source/textures.c
@@ -1000,10 +1000,25 @@ static inline __attribute__((always_inline)) void _glTexSubImage2D(texture *tex,
 			size = orig_h * VGL_ALIGN(orig_w, 8) * bpp;
 		}
 		void *texture_data = gpu_alloc_mapped_for_gpu(size);
-		vgl_fast_memcpy(texture_data, tex->data, size);
-		gpu_free_texture_data(tex);
-		sceGxmTextureSetData(&tex->gxm_tex, texture_data);
-		tex->data = texture_data;
+		// The allocation above CAN fail -- every pool is finite and the
+		// unsafe allocator gives up after FRAME_PURGE_FREQ collection cycles.
+		// Copying into the NULL it returns is a data abort, which on a Vita
+		// takes the whole console down rather than the app: nothing releases
+		// the GXM context, so the PS button stops responding and only the
+		// power button recovers it. Seen on 2026-08-24 with a 4 MB glyph
+		// atlas.
+		//
+		// Skipping the clone writes into the buffer the GPU may still be
+		// reading this frame. That is a tear on one frame of one texture.
+		extern unsigned int vgl_oom_count;
+		if (!texture_data)
+			vgl_oom_count++;
+		else {
+			vgl_fast_memcpy(texture_data, tex->data, size);
+			gpu_free_texture_data(tex);
+			sceGxmTextureSetData(&tex->gxm_tex, texture_data);
+			tex->data = texture_data;
+		}
 		tex->last_frame = OBJ_NOT_USED;
 #ifdef HAVE_TEX_CACHE
 		mark_as_cacheable(tex)
