+// GLSL spells texture-coordinate swizzles .s/.t where Cg only knows .x/.y.
+// The translator header used to bridge that with `#define s x` and friends,
+// but Cg's preprocessor has no notion of scope, so those defines renamed every
+// identifier called s or t in the shader too. Skia's colour transfer function
+// is `float s = sign(x)` inside a function taking `x`, which came out as a
+// redeclaration of the parameter; libshacccg rejected the link and gave no
+// info log for it. Rewrite the swizzles here instead, where we can insist on a
+// leading `.` and an identifier to its left. Lengths match, so this is in
+// place and cannot fail.
+static inline GLboolean glsl_is_ident_char(char c) {
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
+}
+
+static void glsl_rewrite_st_swizzles(char *src) {
+	for (char *p = src; *p; p++) {
+		if (*p != '.')
+			continue;
+		char prev = (p == src) ? 0 : p[-1];
+		if (!glsl_is_ident_char(prev) && prev != ')' && prev != ']')
+			continue;
+		char *q = p + 1;
+		while (*q == 's' || *q == 't')
+			q++;
+		if (q == p + 1 || (q - p - 1) > 4 || glsl_is_ident_char(*q))
+			continue;
+		for (char *w = p + 1; w < q; w++)
+			*w = (*w == 's') ? 'x' : 'y';
+		p = q - 1;
+	}
+}
+
