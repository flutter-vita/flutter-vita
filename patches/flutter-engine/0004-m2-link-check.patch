+  g_hud_on = flutter_vita_debug_overlay == 1;
+  const bool force_software =
+      flutter_vita_force_software != 0 ||
+      DevSwitchOn("ux0:data/flutter-vita/software.on");
+  if (force_software) {
+    VLog("flutter-vita: software path (%s)\n",
+         flutter_vita_force_software != 0 ? "built in" : "software.on");
+  } else {
+    g_gl_enabled = InitGl();
+    if (!g_gl_enabled) {
+      VLog("flutter-vita: GL unavailable, falling back to software\n");
+    }
+  }
+
+  if (!g_gl_enabled && !InitDisplay()) {
+    VLog("flutter-vita: display init failed\n");
+    return 1;
+  }
+  if (!g_gl_enabled && flutter_vita_debug_overlay != 0) HudTitle("software");
+
+  FlutterRendererConfig config = {};
+  if (g_gl_enabled) {
+    config.type = kOpenGL;
+    config.open_gl.struct_size = sizeof(FlutterOpenGLRendererConfig);
+    config.open_gl.make_current = GlMakeCurrent;
+    config.open_gl.clear_current = GlClearCurrent;
+    config.open_gl.present = GlPresent;
+    config.open_gl.fbo_callback = GlFboCallback;
+    config.open_gl.gl_proc_resolver = VitaGlProcResolver;
+    // The default framebuffer stays bound across the layer's swap, so there
