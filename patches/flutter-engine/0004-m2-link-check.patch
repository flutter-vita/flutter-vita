+    {0x3F, 0x40, 0x40, 0x40, 0x3F},  // U
+    {0x1F, 0x20, 0x40, 0x20, 0x1F},  // V
+    {0x3F, 0x40, 0x38, 0x40, 0x3F},  // W
+    {0x63, 0x14, 0x08, 0x14, 0x63},  // X
+    {0x07, 0x08, 0x70, 0x08, 0x07},  // Y
+    {0x61, 0x51, 0x49, 0x45, 0x43},  // Z
+    {0x00, 0x60, 0x60, 0x00, 0x00},  // .
+    {0x23, 0x13, 0x08, 0x64, 0x62},  // %
+    {0x00, 0x36, 0x36, 0x00, 0x00},  // :
+    {0x08, 0x08, 0x08, 0x08, 0x08},  // -
+    {0x20, 0x10, 0x08, 0x04, 0x02},  // /
+};
+
+// -1 for anything with no glyph, including space, which draws as nothing.
+int GlyphIndex(char c) {
+  if (c >= '0' && c <= '9') return c - '0';
+  if (c >= 'A' && c <= 'Z') return 10 + (c - 'A');
+  if (c >= 'a' && c <= 'z') return 10 + (c - 'a');
+  switch (c) {
+    case '.': return 36;
+    case '%': return 37;
+    case ':': return 38;
+    case '-': return 39;
+    case '/': return 40;
+    default:  return -1;
+  }
+}
+
+constexpr int kHudScale = 2;              // 5x7 becomes 10x14
+constexpr int kHudAdvance = 6 * kHudScale;  // one blank column between glyphs
+constexpr int kHudLineH = 8 * kHudScale;
+constexpr int kHudPad = 4;
+// Four, since raster time was added: it is the number the GPU decision turns
+// on, and reading it off the panel next to the screen that is slow is worth
+// more than the 28 extra pixels of height the box costs.
+constexpr int kHudLines = 4;
+constexpr int kHudCols = 21;
+constexpr uint32_t kHudInk = 0xFF00FF00u;   // A8B8G8R8: opaque green
+constexpr uint32_t kHudBack = 0xFF000000u;  // opaque black
+
+// The box, in display pixels. Fixed rather than computed at each call so the
+// blit can ask whether it just overwrote the HUD.
+constexpr int kHudW = kHudCols * kHudAdvance + kHudPad * 2;
+constexpr int kHudH = kHudLines * kHudLineH + kHudPad * 2;
+constexpr int kHudX = kWidth - kHudW - kHudPad;
+constexpr int kHudY = kHudPad;
+
+
+
+// Pre-filled, so the very first paint is legible. Without this the box appears
+// before HudUpdate has ever run -- twenty frames in -- and an app that dies
+// during startup leaves an empty black rectangle in the corner that reads as a
+// rendering bug.
+char g_hud_text[kHudLines][kHudCols + 1] = {
+    "-- FPS", "RAS --", "DMG --", "HEAP --"};
+
+// A solid backing box. Write-only, and both halves of that matter.
+//
+// The first version halved each channel instead, to let the app show through.
+// It was wrong twice over. It read the framebuffer, and this framebuffer is in
+// CDRAM, where reads are far slower than writes -- 16,000 of them cost 2.4 ms
+// a frame, which is more than the blit and a seventh of a 60 fps budget, for an
+// instrument. And because partial repaint means nothing restores these pixels
+// on a frame that damages elsewhere, it darkened *its own previous output*
+// sixty times a second, so the box faded to black within a second anyway.
+void HudFill(uint32_t* fb, int x, int y, int w, int h) {
+  for (int row = y; row < y + h; row++) {
+    uint32_t* p = fb + static_cast<size_t>(row) * kPitch + x;
+    for (int col = 0; col < w; col++) p[col] = kHudBack;
+  }
+}
+
+void HudDrawText(uint32_t* fb, int x, int y, const char* text) {
+  for (int i = 0; text[i] != '\0'; i++) {
+    const int glyph = GlyphIndex(text[i]);
+    if (glyph < 0) continue;
+    const unsigned char* cols = kFont[glyph];
+    for (int gx = 0; gx < 5; gx++) {
+      for (int gy = 0; gy < 7; gy++) {
+        if ((cols[gx] & (1u << gy)) == 0) continue;
+        const int px = x + (i * kHudAdvance) + gx * kHudScale;
+        const int py = y + gy * kHudScale;
+        for (int sy = 0; sy < kHudScale; sy++) {
+          uint32_t* p = fb + static_cast<size_t>(py + sy) * kPitch + px;
+          for (int sx = 0; sx < kHudScale; sx++) p[sx] = kHudInk;
+        }
+      }
+    }
+  }
+}
+
+// A second, shorter accumulation window, for the HUD only.
+//
+// Deliberately not the same window as the FRAMES line. Sixty frames is the
+// right size for a number somebody is going to quote in a commit message and
+// far too slow for one somebody is watching while they scroll -- at 13 fps it
+// updates once every four and a half seconds. Twenty frames updates three times
+// a second at 60 fps and still often enough to follow at 13. The log stays
+// authoritative; the HUD is for steering.
+constexpr unsigned kHudWindow = 20;
+unsigned g_hud_frames = 0;
+unsigned g_hud_active = 0;
+uint64_t g_hud_active_us = 0;
+uint64_t g_hud_blit_us = 0;
+uint64_t g_hud_damage_px = 0;
+uint64_t g_hud_max_gap_us = 0;
+
+// How much of the C heap is in use, in MiB.
+//
+// This is the number the free-memory line above cannot see and the one that has
+// actually been killing long runs. `_newlib_heap_size_user` carves a fixed
+// arena out of the process budget at startup, so `sceKernelGetFreeMemorySize`
+// can report tens of megabytes free while the arena is completely full -- which
+// is exactly what happened before the arena was raised to 160 MB, and is the
+// first thing to check when a run dies with the budget looking healthy.
+//
+// mallinfo walks the free list, so this is not free. Called once per HUD window
+// and once per logged frame, never per frame.
+unsigned HeapUsedMb() {
+  const struct mallinfo mi = mallinfo();
+  return static_cast<unsigned>(mi.uordblks / (1024 * 1024));
+}
+
+unsigned HeapArenaMb() {
+  const struct mallinfo mi = mallinfo();
+  return static_cast<unsigned>(mi.arena / (1024 * 1024));
+}
+
+void HudUpdate() {
+  const unsigned active_us =
+      g_hud_active != 0 ? static_cast<unsigned>(g_hud_active_us / g_hud_active)
+                        : 0;
+  const unsigned fps = active_us != 0 ? 1000000u / active_us : 0;
+  const unsigned fps_frac = active_us != 0 ? (10000000u / active_us) % 10 : 0;
+  const unsigned blit_us = static_cast<unsigned>(g_hud_blit_us / g_hud_frames);
+  const unsigned raster_us =
+      static_cast<unsigned>(g_hud_raster_us / g_hud_frames);
+  const unsigned dmg_pct = static_cast<unsigned>(
+      g_hud_damage_px / g_hud_frames * 100 / (kWidth * kHeight));
+
+  SceKernelFreeMemorySizeInfo mem;
+  mem.size = sizeof(mem);
+  const unsigned free_mb =
+      sceKernelGetFreeMemorySize(&mem) >= 0
+          ? static_cast<unsigned>(mem.size_user / (1024 * 1024))
+          : 0;
+
+  std::snprintf(g_hud_text[0], sizeof g_hud_text[0], "%u.%u FPS  %u MS", fps,
+                fps_frac, active_us / 1000);
+  // Raster and blit on one line and their share of the frame beside them,
+  // because the useful reading is not either number but what is left over --
+  // frame time minus these two is the UI thread, and a GPU backend does
+  // nothing for it.
+  // No " MS" suffix: kHudCols is 21, and a three-digit raster figure with it
+  // would truncate exactly when the number is most interesting.
+  std::snprintf(g_hud_text[1], sizeof g_hud_text[1], "RAS %u.%u BLT %u.%u",
+                raster_us / 1000, (raster_us / 100) % 10, blit_us / 1000,
+                (blit_us / 100) % 10);
+  std::snprintf(g_hud_text[2], sizeof g_hud_text[2], "DMG %u%%  RAS %u%%",
+                dmg_pct, active_us != 0 ? raster_us * 100 / active_us : 0);
+  // Heap before the budget, because the budget has never yet been the thing
+  // that ran out and the heap has.
+  std::snprintf(g_hud_text[3], sizeof g_hud_text[3], "HEAP %uM  MEM %uM",
+                HeapUsedMb(), free_mb);
+
+  g_hud_dirty = true;
+
+  g_hud_frames = 0;
+  g_hud_active = 0;
+  g_hud_active_us = 0;
+  g_hud_blit_us = 0;
+  g_hud_raster_us = 0;
+  g_hud_damage_px = 0;
+  g_hud_max_gap_us = 0;
+}
+
+void HudPaint(void* base) {
+  if (kHudX < 0 || kHudY + kHudH > kHeight) return;
+
+  uint32_t* fb = static_cast<uint32_t*>(base);
+  HudFill(fb, kHudX, kHudY, kHudW, kHudH);
+  for (int line = 0; line < kHudLines; line++) {
+    HudDrawText(fb, kHudX + kHudPad, kHudY + kHudPad + line * kHudLineH,
+                g_hud_text[line]);
+  }
+  g_hud_dirty = false;
+}
+
+// Per-present bookkeeping, shared by both backends.
+//
+// Extracted from PresentSurface when the GL path arrived, because every
+// number this port is steered by comes from here and a backend that did not
+// report them would be unmeasurable -- which is the one thing ADR-0006 does
+// not allow. row_bytes and height are the surface the frame was drawn into;
+// under GL that is the display target rather than a CPU allocation.
+void NotePresent(size_t row_bytes, size_t height) {
+  // A black panel has two very different causes and this separates them: the
+  // engine never producing a frame, or producing frames that are themselves
+  // black. Logging the first present and then every 60th keeps the answer in
+  // the log without the unbuffered writes becoming the frame budget.
+  static unsigned frames = 0;
+  // Every frame for the first 200, then every sixtieth.
+  //
+  // The interval used to be sixty throughout, which was tuned for an app that
+  // paints continuously and is useless for one that does not: the conformance
+  // app repaints once per probe, roughly thirty-five times in its whole life,
+  // so frame sixty never arrived and a run produced exactly one sample -- at
+  // startup, before anything interesting had happened. Painting is the only
+  // clock this log has, so the rate has to match the app being watched, not
+  // the display.
+  if (frames < 200 || frames % 60 == 0) {
+    // Free memory rides along with the frame log, because the alternative is
+    // guessing. The TLS handshake crash leaves a truncated core dump every
+    // time while an ordinary fault in the same binary leaves a complete one,
+    // which reads as the process running out of memory rather than touching a
+    // bad pointer -- and nothing so far has actually measured that.
+    //
+    // size_user is the budget the app allocates from. phycont is separate and
+    // small, and worth watching because the framebuffer lives there.
+    SceKernelFreeMemorySizeInfo mem;
+    mem.size = sizeof(mem);
+    if (sceKernelGetFreeMemorySize(&mem) >= 0) {
+      VLog("flutter-vita: present #%u row_bytes=%u height=%u "
+           "heap=%uM/%uM free user=%dK cdram=%dK phycont=%dK\n",
+           frames, static_cast<unsigned>(row_bytes),
+           static_cast<unsigned>(height), HeapUsedMb(), HeapArenaMb(),
+           mem.size_user / 1024, mem.size_cdram / 1024,
+           mem.size_phycont / 1024);
+    } else {
+      VLog("flutter-vita: present #%u row_bytes=%u height=%u\n", frames,
+           static_cast<unsigned>(row_bytes),
+           static_cast<unsigned>(height));
+    }
+  }
+  frames++;
+
+  {
+    const uint64_t now = sceKernelGetSystemTimeWide();
+    if (g_touch_down_us != 0) {
+      VLog("flutter-vita: LATENCY touch->present %u us\n",
+           static_cast<unsigned>(now - g_touch_down_us));
+      g_touch_down_us = 0;
+    }
+    if (g_last_present_us != 0) {
+      const uint64_t gap = now - g_last_present_us;
+      if (gap > g_win_max_gap_us) g_win_max_gap_us = gap;
+      if (gap > g_hud_max_gap_us) g_hud_max_gap_us = gap;
+      // One line per stutter, with the split that says whose fault it was.
+      //
+      // raster is this thread's own work. wait is how long the raster thread
+      // sat idle before being handed the frame, which under GL is the UI
+      // thread plus scheduling -- so a spike with small raster and large wait
+      // is Dart building a screen, and no renderer change will touch it.
+      if (gap > kJankUs) {
+        VLog("flutter-vita: JANK frame #%u gap %u us "
+             "(raster %u us, wait %u us)\n",
+             static_cast<unsigned>(g_frame_index),
+             static_cast<unsigned>(gap),
+             static_cast<unsigned>(g_last_raster_us),
+             static_cast<unsigned>(g_last_idle_us));
+      }
+      if (gap > kIdleGapUs) {
+        g_win_idle++;
+      } else {
+        g_win_active_us += gap;
+        g_win_active++;
+        g_hud_active_us += gap;
+        g_hud_active++;
+      }
+      g_win_frames++;
+      g_hud_frames++;
+    }
+    if (g_win_first_us == 0) g_win_first_us = now;
+    g_last_present_us = now;
+    g_frame_index++;
+  }
+}
+
+// The 60-frame rolling report, shared by both backends.
+//
+// The columns mean slightly different things per backend, and the difference
+// is worth knowing before reading a number off:
+//
+//   raster  software: the rasterizer's own report, via patch 0008's observer.
+//           GL: make_current to present, so GL command submission -- the GPU
+//           may still be busy when present is entered.
+//   blit    software: the present memcpy. GL: vglSwapBuffers, which is mostly
+//           the wait for vblank and for the GPU to finish.
+//   dmg     software only. The GL path does no partial repaint yet.
+//
+// `active` is the same measurement on both, and is vsync-limited under GL --
+// it saturates at 60 and says nothing beyond "this frame fitted".
+void ReportFrameWindow() {
+if (g_win_frames >= 60) {
+  // Two numbers, because they answer different questions.
+  //
+  // `active` is the rendering rate: mean gap over frames that followed
+  // another frame promptly. That is the figure to optimise and the figure to
+  // quote.
+  //
+  // `blit%` is the share of an active frame spent in the present memcpy, and
+  // it is the whole reason this instrument exists. Phase 0.5 measured that
+  // memcpy at 8.06 ms and ADR-0007 built its case on it. If the share is
+  // small, a GPU backend removes a small thing and the remaining time is
+  // Dart, layout and Skia; if it is large, ADR-0007's damage tracking is the
+  // answer. Guessing between those without this number is how optimisation
+  // budgets get spent on the wrong half.
+  const unsigned active_us =
+      g_win_active != 0 ? static_cast<unsigned>(g_win_active_us / g_win_active)
+                        : 0;
+  const unsigned blit_us =
+      static_cast<unsigned>(g_win_blit_us / g_win_frames);
+  //
+  // `dmg` is the share of the screen the rasterizer said actually changed,
+  // averaged over the window. It is what decides whether partial repaint is
+  // doing anything: at 100% the app repaints everything every frame and the
+  // clip is pure overhead, and any fps that a GPU backend would buy has to
+  // come from somewhere other than painting less.
+  const unsigned dmg_pct = static_cast<unsigned>(
+      g_win_damage_px / g_win_frames * 100 / (kWidth * kHeight));
+  //
+  // `raster` is the third share, and the one that decides the GPU question.
+  // An active frame is raster + blit + everything else, where everything
+  // else is the UI thread and any wait. Reporting all three means the answer
+  // never has to be inferred from the damage rectangle again -- which was
+  // tried, and does not work, because area is not work.
+  const unsigned raster_us =
+      static_cast<unsigned>(g_win_raster_us / g_win_frames);
+  VLog("flutter-vita: FRAMES active %u @ %u us = %u.%02u fps "
+       "(raster %u us = %u%%, blit %u us = %u%%, dmg %u%%, hud %u us) "
+       "| raster max %u us | idle gaps %u | max %u ms | gl wait %u us\n",
+       g_win_active, active_us,
+       active_us != 0 ? 1000000u / active_us : 0,
+       active_us != 0 ? (100000000u / active_us) % 100 : 0, raster_us,
+       active_us != 0 ? raster_us * 100 / active_us : 0, blit_us,
+       active_us != 0 ? blit_us * 100 / active_us : 0, dmg_pct,
+       static_cast<unsigned>(g_win_hud_us / g_win_frames),
+       static_cast<unsigned>(g_win_raster_max_us), g_win_idle,
+       static_cast<unsigned>(g_win_max_gap_us / 1000),
+       static_cast<unsigned>(g_win_gl_idle_us / g_win_frames));
+  g_win_frames = 0;
+  g_win_blit_us = 0;
+  g_win_raster_us = 0;
+  g_win_raster_max_us = 0;
+  g_win_damage_px = 0;
+  g_win_hud_us = 0;
+  g_win_max_gap_us = 0;
+  g_win_gl_idle_us = 0;
+  g_win_active_us = 0;
+  g_win_active = 0;
+  g_win_idle = 0;
+  g_win_first_us = 0;
+}
+}
+
+// |SoftwareSurfacePresentCallback|
+bool PresentSurface(void* /* user_data */,
+                    const void* allocation,
+                    size_t row_bytes,
+                    size_t height) {
+  NotePresent(row_bytes, height);
+
+  if (g_display.base == nullptr) {
+    g_display_stale = true;
+    return false;
+  }
+
+  // Hold the frame while a common dialog is up, and do not copy it.
+  //
+  // This copy covers the whole framebuffer, so a Flutter frame lands straight
+  // on top of the keyboard the shell drew there -- which is why the IME opened
+  // successfully and the panel showed nothing. Compositing after the copy was
+  // the obvious fix and it crashed the GPU driver: PresentSurface runs on the
+  // engine's **raster thread**, sceGxmInitialize ran on the main thread, and
+  // sceCommonDialogUpdate has to be called from the thread that owns the GXM
+  // context.
+  //
+  // So the main loop owns the framebuffer while a dialog is open, compositing
+  // over whatever frame was last copied. The app content freezes underneath,
+  // which is what a modal keyboard means anyway.
+  if (g_ime.open) {
+    // The dialog is drawing into the display buffer, so whatever partial
+    // rectangle this frame changed is about to be painted over. The next frame
+    // that does reach the blit has to copy the whole surface, and can: the
+    // surface is retained and still holds a complete frame.
+    g_display_stale = true;
+    return true;
+  }
+
+  // Single-buffered on purpose, for now. Double buffering is the right answer
+  // and it costs another 2 MiB of CDRAM; that trade belongs with the vsync work
+  // rather than here, because without pacing a second buffer buys nothing but
+  // tearing in a different place.
+  //
+  // Only the damaged rectangle is copied. The display buffer already holds the
+  // previous frame -- that is what makes this legal, and it is the same
+  // property that lets Skia clip its painting to the same rectangle.
+  // Widest row and lowest line either buffer can support, so a mismatch
+  // between the engine's surface and the display truncates rather than runs
+  // off the end.
+  const int max_x = static_cast<int>(
+      (row_bytes < static_cast<size_t>(kPitch * 4) ? row_bytes : kPitch * 4) /
+      4);
+  const int max_y =
+      height < static_cast<size_t>(kHeight) ? static_cast<int>(height) : kHeight;
+
+  const Damage d = g_display_stale ? Damage{} : g_damage;
+  g_display_stale = false;
+
+  const int x0 = d.left;
+  const int x1 = d.right < max_x ? d.right : max_x;
+  const int y0 = d.top;
+  const int y1 = d.bottom < max_y ? d.bottom : max_y;
+  const size_t x_off = static_cast<size_t>(x0) * 4;
+  const size_t copy_bytes =
+      x1 > x0 ? static_cast<size_t>(x1 - x0) * 4 : 0;
+
+  const uint8_t* src = static_cast<const uint8_t*>(allocation);
+  uint8_t* dst = static_cast<uint8_t*>(g_display.base);
+  const uint64_t blit_start = sceKernelGetSystemTimeWide();
+  for (int y = y0; y < y1 && copy_bytes != 0; y++) {
+    std::memcpy(dst + static_cast<size_t>(y) * kPitch * 4 + x_off,
+                src + static_cast<size_t>(y) * row_bytes + x_off, copy_bytes);
+  }
+  const uint64_t blit_elapsed_us = sceKernelGetSystemTimeWide() - blit_start;
+  g_win_blit_us += blit_elapsed_us;
+  g_hud_blit_us += blit_elapsed_us;
+  if (y1 > y0) {
+    const uint64_t damaged =
+        static_cast<uint64_t>(y1 - y0) * static_cast<uint64_t>(copy_bytes / 4);
+    g_win_damage_px += damaged;
+    g_hud_damage_px += damaged;
+  }
+
+  // The HUD, over the top of the frame just copied.
+  //
+  // After the blit rather than before it, because the blit would otherwise
+  // overwrite it wherever damage overlaps the corner -- and it must be redrawn
+  // every present for the same reason. Its cost is timed into its own counter,
+  // never into the blit's, so an instrument can never flatter or slander the
+  // thing it measures.
+  if (x1 > kHudX && x0 < kHudX + kHudW && y1 > kHudY && y0 < kHudY + kHudH) {
+    g_hud_dirty = true;  // the blit just painted app pixels over it
+  }
+  if (flutter_vita_debug_overlay != 0 && g_hud_on) {
+    const uint64_t hud_start = sceKernelGetSystemTimeWide();
+    if (g_hud_frames >= kHudWindow) {
+      HudUpdate();
+    }
+    if (g_hud_dirty) {
+      HudPaint(g_display.base);
+    }
+    g_win_hud_us += sceKernelGetSystemTimeWide() - hud_start;
+  }
+
+  // The next frame is whole until the rasterizer says otherwise. Without this
+  // a frame the observer never reported would silently reuse the last rect.
+  g_damage = Damage{};
+
+  ReportFrameWindow();
+
+  return true;
+}
+
+// ===========================================================================
+// The GL path (ADR-0014)
+// ===========================================================================
+//
+// Everything above this line draws on the CPU and blits with sceDisplay. This
+// section is the alternative: Skia's Ganesh backend on GLES2, through vitaGL.
+//
+// ADR-0014 measured why. localsend's raster pass was 199 ms of a 205 ms frame,
+// and the spike in spikes/g2-ganesh put the same three operations on the GPU:
+//
+//   colour filter      36,628 us -> 1,851 us    19.8x
+//   rotated 512->200  107,519 us -> 1,992 us    54.0x
+//   the composite     172,054 us -> 4,761 us    36.1x
+//
+// and one that went the other way:
+//
+//   saveLayer           2,419 us -> 4,035 us     0.6x
+//
+// The SGX543 is a tile-based deferred renderer, so a render-target switch
+// resolves the tile buffer to memory and reloads it. Offscreens are therefore
+// *more* expensive here than on the CPU, and a Flutter tree is full of them --
+// Opacity, antialiased ClipRRect, ShaderMask, every ColorFiltered. That is why
+// the software path stays and stays selectable, and why the fallback below is
+// a supported configuration rather than an error path.
+
+// A dev switch file under ux0:data/flutter-vita, which is how a decision gets
+// made on a console with no command line.
+//
+// On is a '1' in the first byte, not merely the file existing. Same shape as
+// ime.on, and for a practical reason: the dev server can `put` a file but
+// cannot delete one, so a switch that keys on existence is a switch that
+// cannot be turned back off without walking to the console.
+bool DevSwitchOn(const char* path) {
+  const SceUID fd = sceIoOpen(path, SCE_O_RDONLY, 0777);
+  if (fd < 0) return false;
+  char c = '0';
+  sceIoRead(fd, &c, 1);
+  sceIoClose(fd);
+  return c == '1';
+}
+
+// vitaGL owns GXM and the display once it initialises, which is a different
+// arrangement from the software path: there, this file allocates the CDRAM
+// framebuffer and calls sceDisplaySetFrameBuf itself. Only one of the two may
+// run in a process.
+bool InitGl() {
+  // Point the shader cache somewhere writable before vitaGL starts.
+  //
+  // Without it every Ganesh program pays libshacccg's compile on every launch:
+  // ADR-0014 measured 205 ms for a one-line shader and 405 ms for a short one,
+  // against ~3 ms once cached. Ganesh generates a program per paint
+  // configuration, so uncached is not a slow start, it is a stutter every time
+  // a new widget first paints.
+  //
+  // Two things have to be true for this to work, and both were found the hard
+  // way. The archive must be built with HAVE_SHADER_CACHE=1 -- the VitaSDK
+  // package has it off, and vglSetShaderCachePath there is a two-byte `bx lr`
+  // that silently does nothing. And the directories have to exist, because
+  // vitaGL opens the .gxp for writing and sceIoOpen does not create parents.
+  // The version number in the path is vitaGL's, not ours, so cover the range;
+  // an mkdir of a directory that exists costs nothing.
+  vglSetShaderCachePath(kShaderCachePath);
+  sceIoMkdir("ux0:data", 0777);
+  sceIoMkdir(kShaderCachePath, 0777);
+  for (int v = 0; v < 8; v++) {
+    char p[64];
+    std::snprintf(p, sizeof p, "%s/v%d", kShaderCachePath, v);
+    sceIoMkdir(p, 0777);
+    std::snprintf(p, sizeof p, "%s/v%d/v", kShaderCachePath, v);
+    sceIoMkdir(p, 0777);
+    std::snprintf(p, sizeof p, "%s/v%d/f", kShaderCachePath, v);
+    sceIoMkdir(p, 0777);
+  }
+
+  // The fourth argument is the one that matters and the one that is easy to
+  // get wrong. vitaGL takes the newlib arena for its own RAM pool and leaves
+  // *ram_threshold* behind for malloc -- 16 MB by default, which is not enough
+  // to build a GrDirectContext in, let alone run Dart. templates/vita-app/
+  // heap.c sizes the arena at 160 MB; this hands vitaGL the top of it and
+  // leaves the rest to the engine.
+  const GLboolean up = vglInitExtended(kGlLegacyPoolBytes, kWidth, kHeight,
+                                       kGlRamThresholdBytes,
+                                       SCE_GXM_MULTISAMPLE_NONE);
+
+  // Do not believe that return value. It is GL_FALSE on a context that works
+  // -- three runs of the g1 spike exited on it while the console was showing
+  // vitaGL's splash screen rotating at 60 fps. Probe instead.
+  const char* version = reinterpret_cast<const char*>(glGetString(GL_VERSION));
+  if (version == nullptr) {
+    VLog("flutter-vita: vitaGL has no context (vglInit returned %d)\n",
+         static_cast<int>(up));
+    return false;
+  }
+  VLog("flutter-vita: GL up -- %s / %s (vglInit returned %d)\n", version,
+       reinterpret_cast<const char*>(glGetString(GL_RENDERER)),
+       static_cast<int>(up));
+
+  // End the splash screen. vitaGL draws its logo from a thread of its own and
+  // stops on the first swap; without this it rotates over the first frames the
+  // engine produces.
+  vglSwapBuffers(GL_FALSE);
+  vglSwapBuffers(GL_FALSE);
+  return true;
+}
+
+// --------------------------------------------------------------------------
+// Entry points Skia asks for that vitaGL does not have
+// --------------------------------------------------------------------------
+//
+// GrGLInterface::validate() rejects an interface with any of its 92
+// unconditionally required functions missing, and in a release build reports
+// which of its 55 branches fired to nobody. These six are the difference
+// between the GLES2 vitaGL declares in GLES2/gl2.h and the GLES2 it
+// implements, found by diffing that list against the archive's symbol table.
+//
+// Two of them are not honest implementations and are marked as such.
+
+// Exact. Every pname Skia passes here is scalar, so the vector form is the
+// scalar form with one element.
+void VitaGlTexParameterfv(GLenum target, GLenum pname, const GLfloat* params) {
+  glTexParameterf(target, pname, params[0]);
+}
+
+// NOT exact. vitaGL exposes no constant blend colour, so this drops the value.
+// Correct only for as long as Skia never selects a constant-colour blend
+// coefficient. ADR-0014's criterion 3 rendered five operations bit-exact
+// against the software rasteriser with this in place, which is evidence for
+// those five and not a general result. If a paint ever comes out wrong in a
+// way that looks like a missing blend factor, this is the first suspect.
+void VitaGlBlendColor(GLfloat, GLfloat, GLfloat, GLfloat) {}
+
+// Stub. Skia gates compressed-texture *updates* on caps it queries separately,
+// so the pointer has to be non-null to pass validation while the path behind
+// it stays unreached.
+void VitaGlCompressedTexSubImage2D(GLenum, GLint, GLint, GLint, GLsizei,
+                                   GLsizei, GLenum, GLsizei, const void*) {}
+
+// Stub. Skia calls this to interrogate a renderbuffer it did not create.
+// Ganesh allocates its own render targets, so the query should not be reached.
+void VitaGlGetRenderbufferParameteriv(GLenum, GLenum, GLint* params) {
+  if (params) *params = 0;
+}
+
+// Genuinely correct as a no-op: an event marker is a debug annotation for a
+// GPU profiler with no rendering effect. vitaGL advertises GL_EXT_debug_marker
+// and implements two of the three entry points that extension promises, which
+// is why Skia asked for it at all.
+void VitaGlInsertEventMarker(GLsizei, const GLchar*) {}
+
+// Stub with real values, and the one most likely to be wrong. These are what a
+// driver reports for highp float. The SGX543 supports highp properly in vertex
+// shaders and approximates it in fragment shaders, so claiming it
+// unconditionally may cost accuracy rather than correctness.
+//
+// The int enums are spelled numerically because vitaGL's headers omit
+// GL_LOW_INT, GL_MEDIUM_INT and GL_HIGH_INT -- the same gap as the missing
+// functions, one layer up.
+void VitaGlGetShaderPrecisionFormat(GLenum, GLenum precisiontype, GLint* range,
+                                    GLint* precision) {
+  const bool is_int = precisiontype == 0x8DF3 ||  // GL_LOW_INT
+                      precisiontype == 0x8DF4 ||  // GL_MEDIUM_INT
+                      precisiontype == 0x8DF5;    // GL_HIGH_INT
+  if (range) {
+    range[0] = 127;
+    range[1] = 127;
+  }
+  if (precision) *precision = is_int ? 0 : 23;
+}
+
+// Filtered. Everything else passes through.
+//
+// vitaGL answers 1 for GL_NUM_PROGRAM_BINARY_FORMATS and advertises
+// GL_OES_get_program_binary without providing its entry points, and Skia
+// trusts the count:
+//
+//     GR_GL_GetIntegerv(gli, GR_GL_NUM_PROGRAM_BINARY_FORMATS, &count);
+//     if (count > 0) { ... } else { fProgramBinarySupport = false; }
+//         -- GrGLCaps.cpp:847
+//
+// Reporting zero takes the branch that turns the feature off. Skia's own
+// program cache is redundant here anyway: vitaGL caches the compiled .gxp.
+//
+// The unconditional zeroing of the out-parameter is separate and also load
+// bearing. vitaGL is an incomplete GLES2, and a pname it does not recognise
+// leaves the caller's variable untouched -- which hands Skia whatever was on
+// the stack.
+void VitaGlGetIntegerv(GLenum pname, GLint* params) {
+  if (params) *params = 0;
+  if (pname == 0x87FE) return;  // GL_NUM_PROGRAM_BINARY_FORMATS
+  glGetIntegerv(pname, params);
+}
+
+int g_gl_unresolved = 0;
+
+void* VitaGlProcResolver(void* /* user_data */, const char* name) {
+  struct Shim {
+    const char* name;
+    void* fn;
+  };
+  static const Shim kShims[] = {
+      {"glTexParameterfv", reinterpret_cast<void*>(VitaGlTexParameterfv)},
+      {"glBlendColor", reinterpret_cast<void*>(VitaGlBlendColor)},
+      {"glCompressedTexSubImage2D",
+       reinterpret_cast<void*>(VitaGlCompressedTexSubImage2D)},
+      {"glGetRenderbufferParameteriv",
+       reinterpret_cast<void*>(VitaGlGetRenderbufferParameteriv)},
+      {"glGetIntegerv", reinterpret_cast<void*>(VitaGlGetIntegerv)},
+      {"glGetShaderPrecisionFormat",
+       reinterpret_cast<void*>(VitaGlGetShaderPrecisionFormat)},
+      // Keyed by the name Skia asks for, not the name the spec gives it.
+      {"glInsertEventMarkerEXT",
+       reinterpret_cast<void*>(VitaGlInsertEventMarker)},
+  };
+  for (const Shim& s : kShims) {
+    if (std::strcmp(name, s.name) == 0) return s.fn;
+  }
+
+  if (void* p = vglGetProcAddress(name)) return p;
+
+  // Retry without the vendor suffix.
+  //
+  // Skia's assembler asks for extension entry points by their suffixed names
+  // -- GET_PROC_SUFFIX(PopGroupMarker, EXT) requests "glPopGroupMarkerEXT" --
+  // while vitaGL exports the core spelling and no alias. So a function that is
+  // present fails to resolve purely on its name, which is why an offline
+  // symbol-table diff said the debug-marker block was satisfied and the
+  // console disagreed.
+  static const char* const kSuffixes[] = {"EXT", "OES", "ARB",   "KHR",
+                                          "APPLE", "ANGLE", "NV", "IMG"};
+  const size_t len = std::strlen(name);
+  for (const char* suffix : kSuffixes) {
+    const size_t slen = std::strlen(suffix);
+    if (len <= slen || std::strcmp(name + len - slen, suffix) != 0) continue;
+    char base[128];
+    if (len - slen >= sizeof base) continue;
+    std::memcpy(base, name, len - slen);
+    base[len - slen] = '\0';
+    if (void* p = vglGetProcAddress(base)) return p;
+  }
+
+  // Worth logging rather than swallowing. A driver that advertises an
+  // extension without its entry points defeats Skia's null checks, because
+  // Skia trusts the extension string and calls straight through -- so any name
+  // here is a candidate for a jump to zero later.
+  g_gl_unresolved++;
+  VLog("flutter-vita: GL unresolved %s\n", name);
+  return nullptr;
+}
+
+// --------------------------------------------------------------------------
+// The renderer callbacks
+// --------------------------------------------------------------------------
+//
+// There is one context and it is never unbound, so make_current and
+// clear_current have nothing to do. That is not a shortcut around EGL: vitaGL
+// has no context object to bind, and GXM's context is process-wide. What keeps
+// it correct is that the engine touches GL only from its raster thread.
+
+// When the raster thread started this frame's GL work.
+//
+// The software path gets its raster time from the surface itself, through the
+// observer patch 0008 installs; there is no equivalent hook on the GL surface,
+// so this measures the same window from outside: make_current is the engine
+// saying "I am about to draw", present is it saying "I am done". Command
+// submission only -- the GPU is still working when present is entered, and the
+// swap below is where that gets waited on.
+uint64_t g_gl_frame_start_us = 0;
+
+// How long the raster thread sat between finishing one frame and being handed
+// the next.
+//
+// This exists because the first GL run of localsend cut raster from 156 ms to
+// 5.1 ms -- 30x, exactly what ADR-0014's spike predicted -- and the frame rate
+// did not move: 5.01 fps against 5.94 on the CPU. Something outside the raster
+// window costs ~194 ms per frame, and the two candidates behave completely
+// differently. If the raster thread is *waiting*, the bottleneck moved to the
+// UI thread and the GPU did its job; if it is busy in code this does not time,
+// the measurement is wrong. Guessing between those is how a wrong conclusion
+// gets written down.
+uint64_t g_gl_present_end_us = 0;
+// Set when the process is on its way out, so the raster thread stops being
+// handed frames. See FlutterVitaGpuShutdown.
+std::atomic<bool> g_gl_stopping{false};
+std::atomic<bool> g_gl_in_frame{false};
+
+bool GlMakeCurrent(void* /* user_data */) {
+  // Refusing here makes GPUSurfaceGLSkia::AcquireFrame return null and the
+  // engine drop the frame, which is how the raster thread is brought to a stop
+  // without reaching into it.
+  if (g_gl_stopping.load(std::memory_order_acquire)) return false;
+  g_gl_in_frame.store(true, std::memory_order_release);
+  g_gl_frame_start_us = sceKernelGetSystemTimeWide();
+  if (g_gl_present_end_us != 0) {
+    g_last_idle_us = g_gl_frame_start_us - g_gl_present_end_us;
+    g_win_gl_idle_us += g_last_idle_us;
+  }
+  return true;
+}
+
+bool GlClearCurrent(void* /* user_data */) { return true; }
+
+bool GlPresent(void* /* user_data */) {
+  if (g_gl_frame_start_us != 0) {
+    const uint64_t raster_us =
+        sceKernelGetSystemTimeWide() - g_gl_frame_start_us;
+    g_last_raster_us = raster_us;
+    g_win_raster_us += raster_us;
+    g_hud_raster_us += raster_us;
+    if (raster_us > g_win_raster_max_us) g_win_raster_max_us = raster_us;
+    g_gl_frame_start_us = 0;
+  }
+  NotePresent(static_cast<size_t>(kPitch) * 4, kHeight);
+
+  // Everything after this point is the swap, and the swap is where the frame
+  // rate actually comes from: vitaGL waits for vblank, so `active` reads 60 fps
+  // for any frame that fits inside 16.6 ms and stops discriminating there. The
+  // raster figure above is what to read when it does.
+  const uint64_t swap_start = sceKernelGetSystemTimeWide();
+  vglSwapBuffers(GL_FALSE);
+  g_gl_present_end_us = sceKernelGetSystemTimeWide();
+  g_win_blit_us += g_gl_present_end_us - swap_start;
+  g_gl_in_frame.store(false, std::memory_order_release);
+
+  ReportFrameWindow();
+  return true;
+}
+
+// Zero is the default framebuffer, which under vitaGL is the display target it
+// created in InitGl.
+uint32_t GlFboCallback(void* /* user_data */) { return 0; }
+
+}  // namespace
+
+// Let go of the GPU before this process ends. Called from every exit path.
+//
+// This is the bug that locked the console hard enough to need the power
+// button, twice, on 2026-08-22. The dev server's `handoff` -- and `relaunch`,
+// and `exit`, and bailout.c's crash path -- launch the loader and call
+// sceKernelExitProcess with nothing in between. That was correct for as long
+// as this process never touched the GPU: ADR-0003's software path owns a CDRAM
+// block and a memcpy, and there is nothing to hand back. Under GL there is a
+// live GXM context, a display queue with frames still in flight, and memory
+// blocks those frames name, and tearing the process down underneath them takes
+// the driver with it. The shell composites through the same driver, so the
+// whole console goes -- PS button included.
+//
+// spikes/g2-ganesh hit exactly this and fixed it with the two calls below. It
+// had the easy version: one thread, nothing else running. Here the exit is
+// requested on the dev server's thread while the *raster* thread is inside
+// vitaGL, so calling sceGxmTerminate directly from the caller would be the
+// same use-after-free one level up. The raster thread has to be stopped first,
+// and the only handle this file has on it is make_current -- refuse, and the
+// engine stops handing it frames.
+//
+// The wait is bounded because this runs on the way out. If the raster thread
+// is genuinely wedged, exiting without a clean teardown is no worse than the
+// hang, and hanging here instead would be strictly worse.
+// |fml/thread.cc| on Vita
+//
+// Defined here rather than in fml because fml has no logging destination on
+// this platform: FML_DLOG goes to a stdout the device does not own, which is
+// the same gap that hid every Dart print until 2026-08-24.
+extern "C" void flutter_vita_log_affinity(const char* name,
+                                          int before,
+                                          int after) {
+  VLog("flutter-vita: thread %s affinity 0x%05X -> 0x%05X\n",
+       name != nullptr ? name : "?", static_cast<unsigned>(before),
+       static_cast<unsigned>(after));
+}
+
+extern "C" void flutter_vita_gpu_shutdown(void) {
+  if (!g_gl_enabled) return;
+  VLog("flutter-vita: releasing the GPU before exit\n");
+
+  g_gl_stopping.store(true, std::memory_order_release);
+  for (int i = 0; i < 200 && g_gl_in_frame.load(std::memory_order_acquire);
+       i++) {
+    sceKernelDelayThread(5 * 1000);
+  }
+  if (g_gl_in_frame.load(std::memory_order_acquire)) {
+    VLog("flutter-vita: raster thread still in a frame; tearing down anyway\n");
+  }
+
+  // Drain before terminate. Terminating with flips still queued is a
+  // use-after-free of the buffers they name -- which is the same fault as the
+  // one above, in the driver's own bookkeeping.
+  sceGxmDisplayQueueFinish();
+  sceGxmTerminate();
+  VLog("flutter-vita: GPU released\n");
+}
+
+// The AOT snapshot, linked into eboot.bin rather than loaded. gen_snapshot
+// emits these four symbols into the assembly file that is assembled alongside
+// this translation unit; see ADR-0005 for why the alternative -- an ELF loaded
+// at runtime -- was abandoned.
+extern "C" {
+extern const uint8_t _kDartVmSnapshotData[];
+extern const uint8_t _kDartVmSnapshotInstructions[];
+extern const uint8_t _kDartIsolateSnapshotData[];
+extern const uint8_t _kDartIsolateSnapshotInstructions[];
+}
+
+// m3 shipped without a log channel, which is why the first crash had to be
+// read out of registers. printf on this platform goes to the debug UART, and
+// nothing here has one. Point both streams at a file on ux0: instead, before
+// anything else runs, so `dev.sh get ux0:data/flutter-vita/m3.log` works even
+// after a crash -- the loader is up by then and serves the file.
+//
+// Unbuffered, not line buffered, and that is a deliberate downgrade.
+//
+// The first version asked for _IOLBF with a null buffer and size 0. POSIX
+// leaves that combination implementation-defined, newlib did not give line
+// buffering, and a run that hung produced a log file of zero bytes -- the app
+// had truncated it on open and never flushed a byte. A log that is empty
+// exactly when the program misbehaves is worse than no log, because it looks
+// like evidence.
+//
+// _IONBF sends every write straight through to sceIoWrite. It is slow, and on
+// a memory card it is very slow, but a diagnostic channel that cannot lose its
+// last line is the entire point of having one. Revisit only once the boot is
+// quiet enough that logging volume matters.
+static void OpenLog() {
+  static const char* const kPath = "ux0:data/flutter-vita/m3.log";
+  sceIoMkdir("ux0:data/flutter-vita", 0777);
+
+  // Truncate once, then hold an append handle. Append matters because the
+  // engine's own logging goes through std::cerr, which is a different writer
+  // with a different offset -- two writers each tracking their own position
+  // would overwrite each other rather than interleave.
+  const SceUID truncate =
+      sceIoOpen(kPath, SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
+  if (truncate >= 0) {
+    sceIoClose(truncate);
+  }
+  g_log_fd = sceIoOpen(kPath, SCE_O_WRONLY | SCE_O_APPEND, 0777);
+
+  // FML_LOG writes to std::cerr, and there is no hook to redirect it, so the
+  // engine's diagnostics still have to come through stdio. Append mode and no
+  // buffering, for the same two reasons as above.
+  std::freopen(kPath, "a", stderr);
+  std::setvbuf(stderr, nullptr, _IONBF, 0);
+  std::freopen(kPath, "a", stdout);
+  std::setvbuf(stdout, nullptr, _IONBF, 0);
+}
+
+// The platform task runner, without which no platform channel works at all.
+//
+// This was on the file's own deferred list -- "Custom task runners. The engine
+// will spin up its own threads for now" -- filed as a performance and
+// architecture concern for ADR-0004. It is not. `platform_message_callback`'s
+// contract is that it "will be invoked on the thread on which the
+// `FlutterEngineRun` call is made", and the mechanism for that is the platform
+// task runner: the engine *queues* the dispatch and waits for the embedder to
+// hand it back via FlutterEngineRunTask.
+//
+// With no runner and a main loop that only polls touch, the queue was never
+// drained. Measured before this existed: an `invokeMethod` on
+// `flutter/textinput` timed out after 25 s, and the message callback was never
+// once invoked. Nothing was broken about the channel; the message was simply
+// sitting in a queue nobody serviced.
+//
+// So this is a prerequisite for every channel -- text input, lifecycle,
+// settings, and the `psvita` package in ADR-0010 -- not an optimisation.
+//
+// Deliberately a fixed array rather than a heap queue. This is drained on the
+// main loop sixty times a second and posted to from engine threads; a
+// std::vector here would allocate on a path that runs during frame production.
+// 256 is far more than the observed depth, and overflowing it drops a task,
+// which is why it says so loudly rather than silently wrapping.
+struct PendingTask {
+  FlutterTask task;
+  uint64_t target_time;  // nanos, same clock as FlutterEngineGetCurrentTime
+};
+
+constexpr size_t kMaxPendingTasks = 256;
+PendingTask g_tasks[kMaxPendingTasks];
+size_t g_task_count = 0;
+std::mutex g_task_lock;
+SceUID g_platform_thread = 0;
+
+// May be called from any engine thread.
+void PostPlatformTask(FlutterTask task,
+                      uint64_t target_time,
+                      void* /* user_data */) {
+  std::lock_guard<std::mutex> guard(g_task_lock);
+  if (g_task_count >= kMaxPendingTasks) {
+    VLog("flutter-vita: platform task queue full, DROPPING a task\n");
+    return;
+  }
+  g_tasks[g_task_count].task = task;
+  g_tasks[g_task_count].target_time = target_time;
+  g_task_count++;
+}
+
+bool RunsTasksOnCurrentThread(void* /* user_data */) {
+  return sceKernelGetThreadId() == g_platform_thread;
+}
+
+// Run whatever is due, from the main loop.
+//
+// Tasks are copied out under the lock and run outside it, because a task may
+// post another one -- re-entering the lock from inside it would deadlock on a
+// non-recursive mutex, and the first symptom would be a frozen app with no
+// error anywhere.
+void DrainPlatformTasks(FlutterEngine engine) {
+  const uint64_t now = FlutterEngineGetCurrentTime();
+  FlutterTask due[kMaxPendingTasks];
+  size_t due_count = 0;
+  {
+    std::lock_guard<std::mutex> guard(g_task_lock);
+    size_t kept = 0;
+    for (size_t i = 0; i < g_task_count; i++) {
+      if (g_tasks[i].target_time <= now) {
+        due[due_count++] = g_tasks[i].task;
+      } else {
+        g_tasks[kept++] = g_tasks[i];
+      }
+    }
+    g_task_count = kept;
+  }
+  for (size_t i = 0; i < due_count; i++) {
+    FlutterEngineRunTask(engine, &due[i]);
+  }
+  g_loop_tasks_run += due_count;
+}
+
+// ---------------------------------------------------------------------------
+// Text input: `flutter/textinput` over the system IME dialog.
+//
+// Two facts about the channel make this far smaller than it looks, and both
+// were worth checking before writing any of it:
+//
+//   * It is **JSONMethodCodec**, not the binary standard codec. ADR-0010 calls
+//     hand-encoding StandardMethodCodec in C "the single largest piece of
+//     embedder work outstanding"; text input does not need it. (`flutter/
+//     keyboard` does -- its getKeyboardState arrives as binary framing -- so
+//     that bill is deferred, not cancelled.)
+//   * It is an **OptionalMethodChannel**: unimplemented methods return null
+//     rather than raising. So five inbound methods and two outbound ones are a
+//     working implementation, not a stub. The other twenty-four are scribble,
+//     autofill, floating cursor and selection rects -- iOS and Android
+//     features with no Vita analogue.
+//
+// The dialog is modal, and that is the platform being honest rather than a
+// shortcut: sceIme's inline mode wants a GXM render loop we do not have, and
+// there is no keyboard a Flutter app could draw for itself. So a TextField
+// receives its value when the dialog closes rather than per keystroke, which
+// is how every console does text entry.
+// ---------------------------------------------------------------------------
+
+// Just enough JSON for messages whose shape is fixed and known.
+//
+// Deliberately not a parser. Every message handled here is generated by the
+// framework from a literal, so the questions are only ever "what method is
+// this" and "what is the value of one known key" -- and a real parser would be
+// several hundred lines of attack surface for a channel that never carries
+// anything but framework-authored text.
+const char* JsonFindValue(const char* json, size_t len, const char* key) {
+  char pattern[48];
+  std::snprintf(pattern, sizeof pattern, "\"%s\":", key);
+  const size_t plen = std::strlen(pattern);
+  if (len < plen) return nullptr;
+  for (size_t i = 0; i + plen <= len; i++) {
+    if (std::memcmp(json + i, pattern, plen) == 0) return json + i + plen;
+  }
+  return nullptr;
+}
+
+// Copy a JSON string value, undoing the escapes the framework actually emits.
+size_t JsonUnescape(const char* p, const char* end, char* out, size_t out_max) {
+  if (p >= end || *p != '"') return 0;
+  p++;
+  size_t n = 0;
+  while (p < end && *p != '"' && n + 1 < out_max) {
+    if (*p == '\\' && p + 1 < end) {
+      p++;
+      switch (*p) {
+        case 'n': out[n++] = '\n'; break;
+        case 't': out[n++] = '\t'; break;
+        case 'r': out[n++] = '\r'; break;
+        case 'u': {
+          // \uXXXX. Only the BMP, and only as UTF-8 -- enough for the text the
+          // framework round-trips back to us.
+          if (p + 4 >= end) return n;
+          unsigned cp = 0;
+          for (int k = 1; k <= 4; k++) {
+            const char c = p[k];
+            cp <<= 4;
+            cp |= (c >= '0' && c <= '9')   ? (unsigned)(c - '0')
+                  : (c >= 'a' && c <= 'f') ? (unsigned)(c - 'a' + 10)
+                  : (c >= 'A' && c <= 'F') ? (unsigned)(c - 'A' + 10)
+                                           : 0u;
+          }
+          p += 4;
+          if (cp < 0x80) {
+            out[n++] = (char)cp;
+          } else if (cp < 0x800 && n + 2 < out_max) {
+            out[n++] = (char)(0xC0 | (cp >> 6));
+            out[n++] = (char)(0x80 | (cp & 0x3F));
+          } else if (n + 3 < out_max) {
+            out[n++] = (char)(0xE0 | (cp >> 12));
+            out[n++] = (char)(0x80 | ((cp >> 6) & 0x3F));
+            out[n++] = (char)(0x80 | (cp & 0x3F));
+          }
+          break;
+        }
+        default: out[n++] = *p; break;
+      }
+      p++;
+    } else {
+      out[n++] = *p++;
+    }
+  }
+  out[n] = '\0';
+  return n;
+}
+
+// The framework will reject a malformed reply, and an unescaped quote in user
+// input is the obvious way to produce one -- someone typing `he said "hi"` must
+// not break the channel.
+size_t JsonEscape(const char* in, char* out, size_t out_max) {
+  size_t n = 0;
+  for (const char* p = in; *p != '\0' && n + 7 < out_max; p++) {
+    const unsigned char c = (unsigned char)*p;
+    switch (c) {
+      case '"':  out[n++] = '\\'; out[n++] = '"';  break;
+      case '\\': out[n++] = '\\'; out[n++] = '\\'; break;
+      case '\n': out[n++] = '\\'; out[n++] = 'n';  break;
+      case '\r': out[n++] = '\\'; out[n++] = 'r';  break;
+      case '\t': out[n++] = '\\'; out[n++] = 't';  break;
+      default:
+        if (c < 0x20) {
+          n += (size_t)std::snprintf(out + n, out_max - n, "\\u%04X", c);
+        } else {
+          out[n++] = (char)c;
+        }
+    }
+  }
+  out[n] = '\0';
+  return n;
+}
+
+// The IME speaks UTF-16; the channel speaks UTF-8. BMP only, which is what the
+// dialog can produce anyway.
+void Utf8ToUtf16(const char* in, SceWChar16* out, size_t out_max) {
+  size_t n = 0;
+  const unsigned char* p = (const unsigned char*)in;
+  while (*p != 0 && n + 1 < out_max) {
+    unsigned cp;
+    if (*p < 0x80) {
+      cp = *p++;
+    } else if ((*p & 0xE0) == 0xC0 && p[1]) {
+      cp = ((unsigned)(*p & 0x1F) << 6) | (p[1] & 0x3F);
+      p += 2;
+    } else if ((*p & 0xF0) == 0xE0 && p[1] && p[2]) {
+      cp = ((unsigned)(*p & 0x0F) << 12) | ((unsigned)(p[1] & 0x3F) << 6) |
+           (p[2] & 0x3F);
+      p += 3;
+    } else {
+      p++;  // Outside the BMP, or malformed. Skipped rather than guessed at.
+      continue;
+    }
+    out[n++] = (SceWChar16)cp;
+  }
+  out[n] = 0;
+}
+
+void Utf16ToUtf8(const SceWChar16* in, char* out, size_t out_max) {
+  size_t n = 0;
+  for (size_t i = 0; in[i] != 0 && n + 4 < out_max; i++) {
+    const unsigned cp = in[i];
+    if (cp < 0x80) {
+      out[n++] = (char)cp;
+    } else if (cp < 0x800) {
+      out[n++] = (char)(0xC0 | (cp >> 6));
+      out[n++] = (char)(0x80 | (cp & 0x3F));
+    } else {
+      out[n++] = (char)(0xE0 | (cp >> 12));
+      out[n++] = (char)(0x80 | ((cp >> 6) & 0x3F));
+      out[n++] = (char)(0x80 | (cp & 0x3F));
+    }
+  }
+  out[n] = '\0';
+}
+
+
+// Platform channels arrive here. Phase 8, first step: see them.
+//
+// Nothing was listening before this, so every channel the framework opens --
+// `flutter/textinput`, `flutter/platform`, `flutter/lifecycle`,
+// `flutter/settings` -- was silently dropped by the engine with no record that
+// it had been attempted. The first thing worth knowing is which ones a real app
+// actually uses, and that is a question the log can answer before a single line
+// of IME code exists.
+//
+// **Every message must be answered.** The engine allocates a response handle
+// per message and leaks it otherwise; worse, an `invokeMethod` awaiting a reply
+// never completes, so a missing response is an app that quietly hangs rather
+// than one that visibly fails. A null response of length zero is the encoding
+// for "not implemented", which is exactly true right now and is what
+// `OptionalMethodChannel` -- the one `flutter/textinput` uses -- is built to
+// tolerate.
+//
+// The payload is logged as text and truncated. `flutter/textinput` uses
+// JSONMethodCodec, so its messages are readable ASCII; a channel using the
+// binary standard codec will look like noise here, which is itself the
+// distinction worth seeing.
+FlutterEngine g_engine = nullptr;
+
+// Send a method call up to the framework on `flutter/textinput`.
+void SendTextInputMethod(const char* json) {
+  if (g_engine == nullptr) return;
+  FlutterPlatformMessage out = {};
+  out.struct_size = sizeof(FlutterPlatformMessage);
+  out.channel = "flutter/textinput";
+  out.message = reinterpret_cast<const uint8_t*>(json);
+  out.message_size = std::strlen(json);
+  FlutterEngineSendPlatformMessage(g_engine, &out);
+}
+
+// One-time setup for the IME dialog.
+//
+// Three separate things, each of which fails differently if skipped:
+// SceIme is not resident by default; a common dialog needs the shell's app-util
+// context; and the config param carries the system language and -- the part
+// that is easy to miss -- the **enter button assignment**, which is O in Japan
+// and X everywhere else. Getting that wrong does not fail, it just puts the
+// confirm button under the wrong thumb.
+void InitIme() {
+  const int mod = sceSysmoduleLoadModule(SCE_SYSMODULE_IME);
+  if (mod < 0) {
+    VLog("flutter-vita: SCE_SYSMODULE_IME 0x%08X\n", (unsigned)mod);
+    return;
+  }
+
+  // GXM has to be initialised even though nothing here renders with it.
+  //
+  // Measured, not assumed: with everything else correct, sceImeDialogInit
+  // returns 0x80020436, SCE_COMMON_DIALOG_ERROR_GXM_IS_UNINITIALIZED. A common
+  // dialog is composited by the shell, and the shell will not do that for a
+  // process that has no graphics context -- ADR-0003's software raster is fine
+  // as the *source* of pixels, but the compositor still wants GXM up.
+  //
+  // The parameter buffer is the stock 16 MiB.
+  //
+  // The header says "must be 0x40000 or higher", and the reasoning that this
+  // process submits no draw calls so the minimum must do was wrong: 0x40000
+  // returns 0x805B0017, SCE_GXM_ERROR_DRIVER. The driver has its own opinion
+  // and does not explain it. SCE_GXM_DEFAULT_PARAMETER_BUFFER_SIZE is what
+  // every other application on this console passes, and 16 MiB out of roughly
+  // 87 MiB free is affordable; guessing again would cost another deploy to
+  // learn the same thing.
+  // Under GL, vitaGL has already done all of this and owns it.
+  //
+  // sceGxmInitialize is once per process, and a second call returns
+  // SCE_GXM_ERROR_ALREADY_INITIALIZED -- so the software path's bespoke
+  // "minimal GXM pipeline whose only job is to own the framebuffer" is exactly
+  // what vitaGL is, and better. The note under OpenImeDialog calls that the
+  // real remaining Phase 8 work; the GL path supplies it as a side effect, and
+  // the common-dialog surfaces still need pointing at vitaGL's back buffer
+  // rather than at g_display.base before the IME can actually be turned on.
+  // Left off here rather than half-wired.
+  if (g_gl_enabled) {
+    VLog("flutter-vita: GXM belongs to vitaGL; IME stays off under GL\n");
+  } else {
+    SceGxmInitializeParams gxm = {};
+    gxm.flags = 0;
+    gxm.displayQueueMaxPendingCount = 2;
+    gxm.displayQueueCallback = nullptr;
+    gxm.displayQueueCallbackDataSize = 0;
+    gxm.parameterBufferSize = SCE_GXM_DEFAULT_PARAMETER_BUFFER_SIZE;
+    const int gr = sceGxmInitialize(&gxm);
+    if (gr < 0) {
+      VLog("flutter-vita: sceGxmInitialize 0x%08X\n", (unsigned)gr);
+      return;
+    }
+    if (!InitGxmSurfaces()) {
+      VLog("flutter-vita: GXM surfaces unavailable, IME stays off\n");
+      return;
+    }
+    g_ime.gxm_ready = true;
+  }
+  SceAppUtilInitParam init = {};
+  SceAppUtilBootParam boot = {};
+  sceAppUtilInit(&init, &boot);
+
+  SceCommonDialogConfigParam cfg;
+  sceCommonDialogConfigParamInit(&cfg);
+  int value = 0;
+  if (sceAppUtilSystemParamGetInt(SCE_SYSTEM_PARAM_ID_LANG, &value) >= 0) {
+    cfg.language = static_cast<SceSystemParamLang>(value);
+  }
+  if (sceAppUtilSystemParamGetInt(SCE_SYSTEM_PARAM_ID_ENTER_BUTTON, &value) >=
+      0) {
+    cfg.enterButtonAssign = static_cast<SceSystemParamEnterButtonAssign>(value);
+  }
+  sceCommonDialogSetConfigParam(&cfg);
+  VLog("flutter-vita: IME ready (lang=%d enter=%d)\n", (int)cfg.language,
+       (int)cfg.enterButtonAssign);
+}
+
+// Open the system IME.
+//
+// SCE_IME_DIALOG_MAX_TEXT_LENGTH is 2048 and the buffers are sized for it, so
+// nothing here can overrun regardless of what the framework sends.
+void OpenImeDialog() {
+  if (g_ime.open) return;
+
+  // Off by default, because it takes the whole console down.
+  //
+  // sceImeDialogInit succeeds and then the GPU driver kills the process --
+  // psp2core-*-GPUCRASH.psp2dmp, in which **no thread has a crash stop
+  // reason**, so there is no faulting instruction and nothing to symbolicate.
+  // The driver rejected the work out of band rather than the CPU faulting.
+  //
+  // The cause is that sceGxmInitialize is not the setup a common dialog needs.
+  // Every project that composites one -- SDL's vitagxm backend, vita2d,
+  // vitaGL -- is a full GXM renderer with a context, a colour surface mapped
+  // as GXM memory, a depth surface and a sync object. We hand it a CDRAM block
+  // we memcpy into and a struct with the right fields filled in, and the
+  // fields are not the requirement.
+  //
+  // So text input needs a minimal GXM pipeline whose only job is to own the
+  // framebuffer. That is the real remaining work in Phase 8; everything above
+  // this line -- the channel, the JSON, the five methods, the two replies -- is
+  // measured and works.
+  //
+  // Flip it on for that work with a `1` in the file below; anything else, or
+  // its absence, leaves TextInput.show as a no-op and a TextField simply takes
+  // no input.
+  {
+    const SceUID fd =
+        sceIoOpen("ux0:data/flutter-vita/ime.on", SCE_O_RDONLY, 0777);
+    char c = '0';
+    if (fd >= 0) {
+      sceIoRead(fd, &c, 1);
+      sceIoClose(fd);
+    }
+    if (c != '1') {
+      VLog("flutter-vita: IME disabled (set ux0:data/flutter-vita/ime.on)\n");
+      return;
+    }
+  }
+  if (!g_ime.gxm_ready) {
+    VLog("flutter-vita: IME unavailable, GXM surfaces were not created\n");
+    return;
+  }
+
+  Utf8ToUtf16(g_ime.pending, g_ime.initial, SCE_IME_DIALOG_MAX_TEXT_LENGTH);
+  g_ime.input[0] = 0;
+
+  // The title is **required**. Leaving it null returns 0x80102005,
+  // SCE_IME_DIALOG_ERROR_INVALID_TITLE, which is easy to read as "one of my
+  // parameters is wrong" and hard to guess is the one field that looks
+  // optional. Flutter sends nothing usable for it -- setClient's configuration
+  // carries an inputType and an inputAction, not a label -- so this is a
+  // constant until the `psvita` package gives an app a way to set one.
+  static SceWChar16 title[32];
+  Utf8ToUtf16("Enter text", title, 32);
+  g_ime.title = title;
+
+  SceImeDialogParam param;
+  sceImeDialogParamInit(&param);
+  param.supportedLanguages = 0;   // 0 with languagesForced false: system choice
+  param.languagesForced = SCE_FALSE;
+  param.type = SCE_IME_TYPE_BASIC_LATIN;
+  param.option = g_ime.multiline ? SCE_IME_OPTION_MULTILINE : 0;
+  param.dialogMode = SCE_IME_DIALOG_DIALOG_MODE_DEFAULT;
+  // WITH_CLEAR is not valid on a multiline box -- sceImeDialogInit answers
+  // 0x80102004, SCE_IME_DIALOG_ERROR_INVALID_TEXT_BOX_MODE -- which is
+  // reasonable, since a clear button belongs to a one-line field. Multiline
+  // gets the plain box.
+  param.textBoxMode = g_ime.obscured  ? SCE_IME_DIALOG_TEXTBOX_MODE_PASSWORD
+                      : g_ime.multiline ? SCE_IME_DIALOG_TEXTBOX_MODE_DEFAULT
+                                        : SCE_IME_DIALOG_TEXTBOX_MODE_WITH_CLEAR;
+  param.title = g_ime.title;
+  param.maxTextLength = SCE_IME_DIALOG_MAX_TEXT_LENGTH;
+  param.initialText = g_ime.initial;
+  param.inputTextBuffer = g_ime.input;
+
+  const int r = sceImeDialogInit(&param);
+  if (r < 0) {
+    VLog("flutter-vita: sceImeDialogInit 0x%08X\n", (unsigned)r);
+    return;
+  }
+  g_ime.open = true;
+  VLog("flutter-vita: IME open (client %d)\n", g_ime.client_id);
+}
+
+void CloseImeDialog() {
+  if (!g_ime.open) return;
+  sceImeDialogAbort();
+  sceImeDialogTerm();
+  g_ime.open = false;
+}
+
+// |FlutterProjectArgs::log_message_callback|
+void OnLogMessage(const char* tag, const char* message, void* /* user_data */) {
+  // One write, not two: the log is read by pulling the whole file, and a
+  // torn line from another thread interleaving between tag and message is a
+  // line that cannot be grepped.
+  char line[512];
+  const int n = std::snprintf(line, sizeof line, "[%s] %s\n",
+                              tag != nullptr ? tag : "dart",
+                              message != nullptr ? message : "");
+  if (n > 0) {
+    VLogRaw(line, static_cast<size_t>(n) < sizeof line
+                      ? static_cast<size_t>(n)
+                      : sizeof line - 1);
+  }
+}
+
+void OnPlatformMessage(const FlutterPlatformMessage* message,
+                       void* /* user_data */) {
+  if (message == nullptr) return;
+
+  char preview[161];
+  size_t n = message->message_size;
+  if (n > sizeof preview - 1) n = sizeof preview - 1;
+  for (size_t i = 0; i < n; i++) {
+    const char c = static_cast<const char*>(
+        static_cast<const void*>(message->message))[i];
+    // Control bytes would break the log into unreadable pieces, and the binary
+    // codec is full of them.
+    preview[i] = (c >= 0x20 && c < 0x7F) ? c : '.';
+  }
+  preview[n] = '\0';
+  VLog("flutter-vita: channel %s [%u] %s%s\n",
+       message->channel != nullptr ? message->channel : "(null)",
+       static_cast<unsigned>(message->message_size), preview,
+       message->message_size > n ? "..." : "");
+
+  if (message->channel != nullptr &&
+      std::strcmp(message->channel, "vita/browser") == 0) {
+    // Opening a link means leaving.
+    //
+    // There is no in-app browser to be had: a webview needs a browser engine
+    // rendering into our frame, and this port has neither one nor room for
+    // one. What the console does have is its own browser, and
+    // sceAppUtilLaunchWebBrowser hands it a URL and switches to it -- the app
+    // stays resident and is returned to when the browser closes.
+    //
+    // So a tapped link behaves the way it does on a console rather than the
+    // way it does on a phone, and that is the platform being honest rather
+    // than a shortfall. url_launcher_vita is the Dart half; anything wanting
+    // an *embedded* browser is out of reach and should be told so plainly.
+    const char* body = reinterpret_cast<const char*>(message->message);
+    const size_t len = message->message_size;
+    const char* m = JsonFindValue(body, len, "method");
+    char method[32] = {0};
+    if (m != nullptr) JsonUnescape(m, body + len, method, sizeof method);
+
+    bool ok = false;
+    if (std::strcmp(method, "launch") == 0) {
+      const char* u = JsonFindValue(body, len, "url");
+      char url[1024] = {0};
+      if (u != nullptr) JsonUnescape(u, body + len, url, sizeof url);
+      if (url[0] != '\0') {
+        SceAppUtilWebBrowserParam param;
+        std::memset(&param, 0, sizeof param);
+        param.str = url;
+        param.strlen = static_cast<SceSize>(std::strlen(url));
+        // 0 is "open this URL". The header names no constants for the field,
+        // and the other modes are for local content we have no use for.
+        param.launchMode = 0;
+        const int r = sceAppUtilLaunchWebBrowser(&param);
+        ok = r >= 0;
+        std::printf("flutter-vita: browser launch %s -> 0x%08X\n", url,
+                    static_cast<unsigned>(r));
+      }
+    } else if (std::strcmp(method, "canLaunch") == 0) {
+      // The browser is part of the system software, so it is always there.
+      // Answering honestly here matters: url_launcher's own API asks first and
+      // apps hide UI on a false.
+      ok = true;
+    }
+
+    if (message->response_handle != nullptr && g_engine != nullptr) {
+      // JSONMethodCodec: a success envelope is a one-element list.
+      const char* reply = ok ? "[true]" : "[false]";
+      FlutterEngineSendPlatformMessageResponse(
+          g_engine, message->response_handle,
+          reinterpret_cast<const uint8_t*>(reply), std::strlen(reply));
+    }
+    return;
+  }
+
+  if (message->channel != nullptr &&
+      std::strcmp(message->channel, "flutter/textinput") == 0) {
+    const char* body = reinterpret_cast<const char*>(message->message);
+    const size_t len = message->message_size;
+    const char* m = JsonFindValue(body, len, "method");
+    char method[64] = {0};
+    if (m != nullptr) JsonUnescape(m, body + len, method, sizeof method);
+
+    if (std::strcmp(method, "TextInput.setClient") == 0) {
+      // args is [clientId, configuration]. The id is the first token after the
+      // opening bracket, and the two configuration keys that change the dialog
+      // are the ones read here; everything else in it describes behaviour a
+      // modal system keyboard does not have.
+      const char* a = JsonFindValue(body, len, "args");
+      if (a != nullptr) {
+        while (a < body + len && (*a == '[' || *a == ' ')) a++;
+        g_ime.client_id = std::atoi(a);
+      }
+      const char* name = JsonFindValue(body, len, "name");
+      g_ime.multiline =
+          name != nullptr && std::strncmp(name, "\"TextInputType.multiline\"",
+                                          25) == 0;
+      const char* obsc = JsonFindValue(body, len, "obscureText");
+      g_ime.obscured = obsc != nullptr && std::strncmp(obsc, "true", 4) == 0;
+    } else if (std::strcmp(method, "TextInput.setEditingState") == 0) {
+      const char* t = JsonFindValue(body, len, "text");
+      if (t != nullptr) {
+        JsonUnescape(t, body + len, g_ime.pending, sizeof g_ime.pending);
+      }
+    } else if (std::strcmp(method, "TextInput.show") == 0) {
+      // Only if a person asked for it.
+      //
+      // The IME here is a full-screen modal the shell draws over the app, so
+      // "focus a field" and "cover the entire display" are the same action --
+      // which they are on no other platform. An autofocused field therefore
+      // takes the whole screen before the app has drawn a frame the user could
+      // understand, and there is nothing on that screen explaining why.
+      //
+      // Flutter cannot help us tell the two apart: TextInput.show is identical
+      // whether the focus came from a tap or from autofocus: true. What does
+      // differ is that a tap leaves a fingerprint, so require one within the
+      // last second. Startup autofocus has no touch behind it at all and is
+      // rejected; a button that programmatically focuses a field still works,
+      // because the person did tap something.
+      //
+      // A second is deliberately generous. The path from finger to this line
+      // runs through a hit test, a focus change and a frame, and this port
+      // renders at about twelve of those a second.
+      const uint64_t now = sceKernelGetSystemTimeWide();
+      if (g_last_touch_us != 0 && now - g_last_touch_us < 1000000) {
+        OpenImeDialog();
+      } else {
+        // Not silent: this is the single most confusing thing the rule can do
+        // to someone whose field did not open, and it costs one line.
+        std::printf("flutter-vita: TextInput.show ignored, no recent touch\n");
+      }
+    } else if (std::strcmp(method, "TextInput.hide") == 0 ||
+               std::strcmp(method, "TextInput.clearClient") == 0) {
+      CloseImeDialog();
+      if (std::strcmp(method, "TextInput.clearClient") == 0) {
+        g_ime.client_id = -1;
+      }
+    }
+  }
+
+  if (message->response_handle != nullptr && g_engine != nullptr) {
+    FlutterEngineSendPlatformMessageResponse(g_engine,
+                                             message->response_handle,
+                                             nullptr, 0);
+  }
+}
+
+// Pump the IME, from the main loop.
+//
+// A common dialog is composited by the shell *over the app's own surface*, so
+// every frame it is up has to hand it the framebuffer. That is the one place
+// software rendering (ADR-0003) meets an API written for GXM: the struct wants
+// a colour surface, but its fields are only a pointer, a format and a stride,
+// and the CDRAM block behind sceDisplaySetFrameBuf is exactly describable that
+// way. No GXM rendering happens; the surface is a description of memory we
+// already own.
+void PumpIme(FlutterEngine engine) {
+  if (!g_ime.open) return;
+
+  // Composited here, on the main thread, which is the thread that initialised
+  // GXM. See the note in PresentSurface for what doing this on the raster
+  // thread costs.
+  UpdateCommonDialog();
+
+  if (sceImeDialogGetStatus() != SCE_COMMON_DIALOG_STATUS_FINISHED) return;
+
+  SceImeDialogResult result = {};
+  sceImeDialogGetResult(&result);
+  // What counts as "the user finished" depends on the shape of the field, and
+  // getting this wrong is invisible: the dialog closes and the text silently
+  // does not apply.
+  //
+  // A single-line dialog has two exits -- the enter key confirms, the close
+  // button cancels -- so ENTER is the only confirmation.
+  //
+  // A multiline dialog has one. Its enter key inserts a line break, which is
+  // the whole point of multiline and not something to work around, so **close
+  // is the confirm**. Treating CLOSE as cancel there means there is no way at
+  // all to commit what was typed.
+  //
+  // ABORTED is ours: it is what sceImeDialogAbort produces when the framework
+  // sends TextInput.hide, and it must never apply anything.
+  const bool aborted = result.result == SCE_COMMON_DIALOG_RESULT_ABORTED;
+  const bool confirmed =
+      !aborted && (result.button == SCE_IME_DIALOG_BUTTON_ENTER ||
+                   (g_ime.multiline &&
+                    result.button == SCE_IME_DIALOG_BUTTON_CLOSE));
+
+  char text[1024] = {0};
+  if (confirmed) {
+    Utf16ToUtf8(g_ime.input, text, sizeof text);
+    std::snprintf(g_ime.pending, sizeof g_ime.pending, "%s", text);
+  } else {
+    // Cancelled: report the state unchanged rather than an empty field, or a
+    // cancelled dialog would silently erase what the user already had.
+    std::snprintf(text, sizeof text, "%s", g_ime.pending);
+  }
+
+  sceImeDialogTerm();
+  g_ime.open = false;
+  VLog("flutter-vita: IME %s (button %d result %d), %u chars\n",
+       confirmed ? "confirmed" : "cancelled", (int)result.button,
+       (int)result.result, (unsigned)std::strlen(text));
+
+  if (g_ime.client_id < 0) return;
+
+  char escaped[2048];
+  JsonEscape(text, escaped, sizeof escaped);
+  const int caret = (int)std::strlen(text);
+
+  char json[2600];
+  std::snprintf(json, sizeof json,
+                "{\"method\":\"TextInputClient.updateEditingState\",\"args\":"
+                "[%d,{\"text\":\"%s\",\"selectionBase\":%d,"
+                "\"selectionExtent\":%d,\"selectionAffinity\":"
+                "\"TextAffinity.downstream\",\"selectionIsDirectional\":false,"
+                "\"composingBase\":-1,\"composingExtent\":-1}]}",
+                g_ime.client_id, escaped, caret, caret);
+  SendTextInputMethod(json);
+
+  // `done` for every field, including multiline.
+  //
+  // The tempting alternative is `newline` for a multiline field, mirroring what
+  // its Enter key does on a soft keyboard. It is wrong here: `newline` does not
+  // unfocus, and with a modal editor an unfocused-less field means the next
+  // frame asks for the keyboard again and the dialog reopens the instant it
+  // closes. A dialog that has been dismissed means editing finished, whatever
+  // shape the field is.
+  std::snprintf(json, sizeof json,
+                "{\"method\":\"TextInputClient.performAction\",\"args\":"
+                "[%d,\"TextInputAction.done\"]}",
+                g_ime.client_id);
+  SendTextInputMethod(json);
+  (void)engine;
+}
+
+int main(int argc, char** argv) {
+  OpenLog();
+  VLog("flutter-vita: starting\n");
+
+  // Before the engine, deliberately. If startup hangs or dies, the dev server
+  // is already answering and the log can be pulled without the app exiting.
+  StartDevServer();
+
+  // Clock the console up before anything is measured on it.
+  //
+  // The Vita starts an application at 333 MHz with the bus and GPU well below
+  // their maximums, and nothing in this port ever raised them -- so every
+  // number this project has recorded, back to Phase 0.5, was taken on a
+  // downclocked console. 444 MHz is what essentially every homebrew title
+  // sets, it is the hardware's rated speed rather than an overclock, and the
+  // GPU work in ADR-0014 makes the bus and GXM clocks matter too.
+  //
+  // This is on the critical path for the thing that actually hurts. The GL
+  // measurements on 2026-08-22 put localsend's frame at ~200 ms of which
+  // ~185 ms is the UI thread, and a screen transition at ~400 ms of which
+  // 95% is the UI thread. That is Dart executing on this CPU, so a third more
+  // clock is a third off the part that dominates.
+  //
+  // It costs battery and heat, which is the trade every other Vita
+  // application already makes.
+  scePowerSetArmClockFrequency(444);
+  scePowerSetBusClockFrequency(222);
+  scePowerSetGpuClockFrequency(222);
+  scePowerSetGpuXbarClockFrequency(166);
+  VLog("flutter-vita: clocks arm=%d bus=%d gpu=%d xbar=%d\n",
+       scePowerGetArmClockFrequency(), scePowerGetBusClockFrequency(),
+       scePowerGetGpuClockFrequency(), scePowerGetGpuXbarClockFrequency());
+
+  // Which backend, decided once and here.
+  //
+  // **Software by default, GL on request**, which is the opposite of what
+  // ADR-0014's measurements alone would suggest and is decided by a different
+  // fact: under GL a hard crash takes the whole console down.
+  //
+  // A data abort runs no user code. bailout.c says so in its own first
+  // paragraph -- excpmgr is kernel-only, and a fault is not an exception -- so
+  // nothing releases the GXM context or drains the display queue, and the
+  // driver the shell composites through goes with the process. The PS button
+  // stops responding and the console needs the power button. The software path
+  // has none of this: it owns a CDRAM block and a memcpy, the supervisor
+  // notices the app died, and the loader comes back.
+  //
+  // Verified on 2026-08-22, both directions: `handoff`, `relaunch` and the
+  // abort path all recover cleanly now that they release the GPU first, and a
+  // deliberate `crash` -- a write to address zero -- still wedges the console.
+  //
+  // So GL costs a power cycle per hard crash, on a port that still has them.
+  // That is a bad trade for a default and a fine trade for a deliberate
+  // measurement, so it is opt-in:
+  //
+  //   ux0:data/flutter-vita/gl.on   -- a '1' here selects the GPU path
+  //
+  // Revisit when crashes are rare enough that the cost is theoretical, or if a
+  // way is found to release the GPU from outside the faulting process.
+  // **GPU by default, software on request**, flipped 2026-08-24 from the
+  // opposite default.
+  //
+  //   ux0:data/flutter-vita/software.on   -- a '1' here forces the CPU path
+  //
+  // The benchmark decided it. Worst-frame, software over GL, on the twelve
+  // scenes of ADR-0017 with a warm shader cache: 16.67x on a hero transition,
+  // 15.13x on a backdrop blur, 7.25x on a saveLayer tint, 5.20x on image
+  // scaling. The two scenes GL loses -- transform_scale at 0.86x and
+  // list_churn at 0.90x -- lose by margins that do not pay for making every
+  // other scene slower by default.
+  //
+  // The cache matters, and the first measurement of it was wrong. vitaGL
+  // compiles each shader on first use and keeps it in
+  // ux0:data/shader_cache/<TITLEID>, at 200-400 ms apiece. A cold-cache run
+  // charges that to whichever frame happens to need the shader, which put
+  // blur_backdrop at 0.95x and read as "the GPU cannot help a blur". Warm, it
+  // is 133 ms against software's 2017 ms. Any GL number taken on a fresh
+  // install is a number about compilation, not about rastering.
+  //
+  // What has not changed is why the old default existed: a hard crash under
+  // GL can still wedge the console, because a data abort runs no user code and
+  // nothing releases the GXM context. That risk is now taken deliberately in
+  // exchange for the numbers above, and the escape hatch is one `put` away
+  // rather than a rebuild.
+  //
+  // Two things still want the CPU path and get it. The loader forces it
+  // through the strong symbol below, because the component that recovers from
+  // crashes is the last one permitted to cause an unrecoverable one
+  // (ADR-0016 decision 7). And any app needing text input wants it until the
+  // common dialog can composite over vitaGL, since under GL the IME takes the
+  // screen and never gives it back.
+  const bool force_software =
+      flutter_vita_force_software != 0 ||
+      DevSwitchOn("ux0:data/flutter-vita/software.on");
+  if (force_software) {
+    VLog("flutter-vita: software path (%s)\n",
+         flutter_vita_force_software != 0 ? "built in" : "software.on");
+  } else {
+    g_gl_enabled = InitGl();
+    if (!g_gl_enabled) {
+      VLog("flutter-vita: GL unavailable, falling back to software\n");
+    }
+  }
+
+  if (!g_gl_enabled && !InitDisplay()) {
+    VLog("flutter-vita: display init failed\n");
+    return 1;
+  }
+
+  FlutterRendererConfig config = {};
+  if (g_gl_enabled) {
+    config.type = kOpenGL;
+    config.open_gl.struct_size = sizeof(FlutterOpenGLRendererConfig);
+    config.open_gl.make_current = GlMakeCurrent;
+    config.open_gl.clear_current = GlClearCurrent;
+    config.open_gl.present = GlPresent;
+    config.open_gl.fbo_callback = GlFboCallback;
+    config.open_gl.gl_proc_resolver = VitaGlProcResolver;
+    // The default framebuffer stays bound across a swap under vitaGL, so there
+    // is nothing to restore.
+    config.open_gl.fbo_reset_after_present = false;
+    // make_resource_current is deliberately null. Providing it would tell the
+    // engine it may upload textures from the IO thread on a second context,
+    // and vitaGL has exactly one -- GXM's, process-wide. Leaving it null keeps
+    // every GL call on the raster thread, which is what makes the no-op
+    // make_current above correct.
+    //
+    // populate_existing_damage is also null, so every frame is a full repaint.
+    // ADR-0007's partial repaint is a software-path property today; wiring the
+    // GL equivalent needs damage tracked per back buffer against GXM's
+    // buffering, and that is worth doing only once there is a frame rate to
+    // improve.
+  } else {
+    config.type = kSoftware;
+    config.software.struct_size = sizeof(FlutterSoftwareRendererConfig);
+    config.software.surface_present_callback = PresentSurface;
+  }
+
+  // Partial repaint (ADR-0007). The rasterizer reports what changed; the blit
+  // above copies only that. Installed before FlutterEngineInitialize so no
+  // frame can be presented without it -- a present with no observer would use
+  // the default whole-screen rect, which is correct but measures nothing.
+  if (!g_gl_enabled) {
+    flutter::SetSoftwareFrameDamageObserver(OnFrameDamage);
+    flutter::SetSoftwareRasterTimingObserver(OnRasterTiming);
+  }
+
+  // Captured before FlutterEngineRun, because the engine may post a task
+  // during startup and RunsTasksOnCurrentThread must already be truthful.
+  g_platform_thread = sceKernelGetThreadId();
+
+  FlutterTaskRunnerDescription platform_runner = {};
+  platform_runner.struct_size = sizeof(FlutterTaskRunnerDescription);
+  platform_runner.identifier = 1;
+  platform_runner.runs_task_on_current_thread_callback =
+      RunsTasksOnCurrentThread;
+  platform_runner.post_task_callback = PostPlatformTask;
+
+  FlutterCustomTaskRunners task_runners = {};
+  task_runners.struct_size = sizeof(FlutterCustomTaskRunners);
+  task_runners.platform_task_runner = &platform_runner;
+
+  FlutterProjectArgs args = {};
+  args.struct_size = sizeof(FlutterProjectArgs);
+  args.custom_task_runners = &task_runners;
+  args.platform_message_callback = OnPlatformMessage;
+
+  // Dart's print, and every uncaught Flutter exception, into the same log the
+  // host already pulls with `get`.
+  //
+  // Without this they go to stdout, and on this device stdout goes nowhere at
+  // all. The cost of that is not theoretical: an app in the corpus rendered
+  // its own "Something went wrong" page for two sessions while the engine log
+  // showed a healthy 60 fps and nothing else, because the exception behind it
+  // was written to a file descriptor no one owns. FML_LOG output was already
+  // captured, which made the gap easy to miss -- the log looked like it was
+  // working.
+  //
+  // Called on an engine-managed thread, so it must be cheap and must not
+  // block. VLogRaw is an sceIoWrite on an already-open handle.
+  args.log_message_callback = OnLogMessage;
+  args.log_tag = "dart";
+  // app0: is the read-only mount of the installed .vpk.
+  args.assets_path = "app0:/flutter_assets";
+  args.icu_data_path = "app0:/icudtl.dat";
+  args.vm_snapshot_data = _kDartVmSnapshotData;
+  args.vm_snapshot_instructions = _kDartVmSnapshotInstructions;
+  args.isolate_snapshot_data = _kDartIsolateSnapshotData;
+  args.isolate_snapshot_instructions = _kDartIsolateSnapshotInstructions;
+
+  FlutterEngine engine = nullptr;
+  FlutterEngineResult result =
+      FlutterEngineRun(FLUTTER_ENGINE_VERSION, &config, &args, nullptr, &engine);
+  if (result != kSuccess || engine == nullptr) {
+    VLog("flutter-vita: FlutterEngineRun failed: %d\n", result);
+    return 1;
+  }
+  // The platform message callback needs the engine handle to reply, and it can
+  // fire before FlutterEngineRun returns -- the framework opens channels during
+  // startup. Messages arriving in that window are logged and go unanswered,
+  // which is survivable only because nothing awaits a reply that early.
+  g_engine = engine;
+
+  // Memory, before a single frame exists.
+  //
+  // Until now the first memory reading in a run came from present #0, which is
+  // useless for an app that dies during startup -- and the biggest apps in the
+  // corpus die exactly there. Both numbers matter and neither implies the
+  // other: `heap` is the newlib arena carved by _newlib_heap_size_user, `user`
+  // is what the process budget has left after the ELF, the arena and the
+  // engine's own startup allocations have all been taken out of it. A 20 MB
+  // .text costs the second and not the first.
+  {
+    SceKernelFreeMemorySizeInfo mem;
+    mem.size = sizeof(mem);
+    const int ok = sceKernelGetFreeMemorySize(&mem) >= 0;
+    VLog("flutter-vita: engine running (heap %uM/%uM, free user=%dK "
+         "cdram=%dK phycont=%dK)\n",
+         HeapUsedMb(), HeapArenaMb(), ok ? mem.size_user / 1024 : -1,
+         ok ? mem.size_cdram / 1024 : -1, ok ? mem.size_phycont / 1024 : -1);
+  }
+
+  // Tell the framework a display exists.
+  //
+  // Window metrics below say how big the window is; this says what it is
+  // attached to, and they are separate APIs answering separate questions.
+  // Without this `PlatformDispatcher.instance.displays` is an empty list, and
+  // an app that reads `displays.first` -- to find the refresh rate, or the
+  // physical size, both perfectly ordinary things to want -- gets
+  // `Bad state: No element` out of dart:ui during its first build.
+  //
+  // Found by wonderous, which calls it from the widget that wraps the whole
+  // app: the exception came out of MediaQuery's own callback, so nothing
+  // rendered at all and the log blamed `Iterable.first`.
+  //
+  // refresh_rate is 60 because the panel is 60 Hz. It is a hint the framework
+  // uses for scheduling, and is deliberately the panel's rate rather than the
+  // rate this port currently achieves -- an app asking what the display does
+  // should not be told what the software is managing.
+  FlutterEngineDisplay display = {};
+  display.struct_size = sizeof(FlutterEngineDisplay);
+  display.display_id = 0;
+  display.single_display = true;
+  display.refresh_rate = 60.0;
+  display.width = kWidth;
+  display.height = kHeight;
+  display.device_pixel_ratio = 1.0;
+  const FlutterEngineResult display_result = FlutterEngineNotifyDisplayUpdate(
+      engine, kFlutterEngineDisplaysUpdateTypeStartup, &display, 1);
+  if (display_result != kSuccess) {
+    VLog("flutter-vita: FlutterEngineNotifyDisplayUpdate failed: %d\n",
+         display_result);
+  }
+
+  // Half-resolution rastering, with the layout left alone.
+  //
+  //   ux0:data/flutter-vita/halfres.on   -- a '1' here halves the surface
+  //
+  // An experiment, not a feature, and a narrow one. The GPU run on 2026-08-24
+  // dropped route_push's UI-thread build time from 164 ms to 1.25 ms while its
+  // raster time went from 2500 ms to 7.6 ms. Build time should not depend on
+  // the renderer. Thread
+  // affinity was the first explanation and pinning disproved it, which leaves
+  // memory bandwidth: the software rasteriser writes a 2 MB framebuffer every
+  // frame, and if that starves the bus then Dart slows down beside it without
+  // any two threads ever queueing for a core.
+  //
+  // Halving both dimensions and halving pixel_ratio with them keeps the
+  // logical size at 960x544, so the widget tree, the layout and every line of
+  // Dart are identical -- only the pixel count changes, to a quarter. If build
+  // time moves, the cause is the raster thread's memory traffic and nothing
+  // else. If it does not, bus contention is wrong too.
+  //
+  // The blit needs no changes: it already clamps to the smaller of the surface
+  // and the display, so a quarter-size frame lands in the top-left corner. It
+  // looks wrong on the panel, which is fine -- this measures Dart, it does not
+  // show anything to anyone.
+  const bool half_res = DevSwitchOn("ux0:data/flutter-vita/halfres.on");
+  const double surface_scale = half_res ? 0.5 : 1.0;
+  if (half_res) {
+    VLog("flutter-vita: half-resolution raster (%dx%d, logical %dx%d)\n",
+         static_cast<int>(kWidth * surface_scale),
+         static_cast<int>(kHeight * surface_scale), kWidth, kHeight);
+  }
+
+  FlutterWindowMetricsEvent metrics = {};
+  metrics.struct_size = sizeof(FlutterWindowMetricsEvent);
+  metrics.width = static_cast<size_t>(kWidth * surface_scale);
+  metrics.height = static_cast<size_t>(kHeight * surface_scale);
+  metrics.pixel_ratio = surface_scale;
+  // Same display the notify above described, so the framework can associate the
+  // window with it rather than guessing.
+  metrics.display_id = 0;
+  FlutterEngineSendWindowMetricsEvent(engine, &metrics);
+
+  InitTouch();
+  InitIme();
+
+  // Polled input, no vsync yet. Frames are still presented as the engine
+  // produces them rather than paced against sceDisplayWaitVblankStart, so this
+  // loop's period is an input sampling rate and not a frame budget.
+  for (;;) {
+    // Paced on the panel, not on a timer.
+    //
+    // This used to be sceKernelDelayThread(16 * 1000), which free-runs at
+    // 16.000 ms against a display refreshing every 16.667 ms. The two drift
+    // through each other about forty times a second, and with a single buffer
+    // -- we write into the memory the controller is scanning out of -- that
+    // beat is visible as the IME dialog flickering.
+    //
+    // Waiting for vblank also puts the dialog composite in the right place:
+    // this returns at the *start* of the blanking interval, so the write below
+    // lands before the next scanout begins rather than partway through one.
+    //
+    // It does not make the port double-buffered, which is the real fix for
+    // tearing and is parked with the vsync work in ADR-0006.
+    sceDisplayWaitVblankStart();
+
+    // First after vblank, because it is the one thing here that writes pixels.
+    PumpIme(engine);
+    // A platform message that arrived while we were blocked should be answered
+    // before another frame's worth of input is sampled.
+    //
+    // Once per vblank, which bounds the *latency* of a platform reply at
+    // 16.6 ms however fast the reply itself is. That looked like a candidate
+    // for the ~400 ms screen transitions -- the framework issues
+    // LiveText.isLiveTextInputAvailable, Clipboard.hasStrings and
+    // ProcessText.queryTextActions on navigation, and a chain of replies that
+    // each gate the next would pay a frame apiece.
+    //
+    // Tried, on 2026-08-22: drain fifteen times a frame at 1 ms granularity.
+    // Transitions did not improve and the noisier measurements got worse.
+    // Waking this thread fifteen times a frame and taking the task mutex each
+    // time competes with the UI thread for a core, and the UI thread is what
+    // the transition is waiting on -- so the change spends the thing it was
+    // trying to save. Reverted, and recorded here so it is not retried.
+    const uint64_t task_start = sceKernelGetSystemTimeWide();
+    DrainPlatformTasks(engine);
+    g_loop_task_us += sceKernelGetSystemTimeWide() - task_start;
+    PumpTouch(engine);
+    DrainInjectedTaps(engine);
+
+    // Is the platform thread keeping up with the panel, and is it doing the
+    // engine's work or its own? A loop period well over 16.6 ms means this
+    // thread is the pacer and the sceDisplayWaitVblankStart above is not what
+    // it is waiting on.
+    if (g_loop_first_us == 0) g_loop_first_us = sceKernelGetSystemTimeWide();
+    if (++g_loop_iterations >= 300) {
+      const uint64_t now = sceKernelGetSystemTimeWide();
+      VLog("flutter-vita: LOOP %u iterations @ %u us mean "
+           "| %u tasks (%u us total, %u us mean)\n",
+           static_cast<unsigned>(g_loop_iterations),
+           static_cast<unsigned>((now - g_loop_first_us) / g_loop_iterations),
+           static_cast<unsigned>(g_loop_tasks_run),
+           static_cast<unsigned>(g_loop_task_us),
+           g_loop_tasks_run != 0
+               ? static_cast<unsigned>(g_loop_task_us / g_loop_tasks_run)
+               : 0u);
+      // vitaGL drops a texture upload rather than copying into a failed
+      // allocation, and says so only through this counter -- its own vgl_log
+      // is sceClibPrintf, which needs a kernel plugin this port does not have.
+      // A non-zero count means the GPU pools are exhausted and what is on
+      // screen may be stale, which is the difference between a benchmark
+      // result and a picture of one.
+      if (vgl_oom_count != g_vgl_oom_reported) {
+        VLog("flutter-vita: vitaGL dropped %u texture uploads -- out of GPU "
+             "memory\n",
+             static_cast<unsigned>(vgl_oom_count - g_vgl_oom_reported));
+        g_vgl_oom_reported = vgl_oom_count;
+      }
+
+      g_loop_iterations = 0;
+      g_loop_tasks_run = 0;
+      g_loop_task_us = 0;
+      g_loop_first_us = 0;
+    }
+  }
+
+  return 0;
+}
diff --git a/engine/src/flutter/shell/platform/embedder/vita_link_check.cc b/engine/src/flutter/shell/platform/embedder/vita_link_check.cc
new file mode 100644
index 00000000..1efb39f9
--- /dev/null
+++ b/engine/src/flutter/shell/platform/embedder/vita_link_check.cc
@@ -0,0 +1,49 @@
+// Copyright (c) 2026, the Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The M2 gate: does the Flutter engine link for arm-vita-eabi with no
+// unresolved symbols?
+//
+// This exists because the obvious target cannot answer that question. The
+// engine's own `flutter_engine_library` is a `shared_library`, and on this
+// platform that fails twice over: VitaSDK's crt0.o and crtbegin.o are not PIC
+// (correctly -- homebrew is statically linked), and a shared link *tolerates*
+// undefined symbols by default, so even succeeding would prove nothing.
+//
+// An executable is the honest test. The linker must resolve every symbol
+// reachable from the entry points below, which is what "the engine links"
+// means.
+//
+// It is deliberately not a working embedder. It never runs -- there is no
+// eboot.bin here and nothing calls into it. Its whole job is to name enough of
+// the public API that the object closure gets pulled in and checked. Phase 3's
+// real embedder replaces it.
+
+#include <cstdio>
+
+#include "flutter/shell/platform/embedder/embedder.h"
+
+int main(int argc, char** argv) {
+  // Referencing the struct sizes forces the headers to be consistent with the
+  // objects, and referencing the functions forces the objects to link.
+  FlutterRendererConfig config = {};
+  config.type = kSoftware;
+
+  FlutterProjectArgs args = {};
+  args.struct_size = sizeof(FlutterProjectArgs);
+
+  FlutterEngine engine = nullptr;
+
+  // The four calls a real embedder cannot do without. Between them they reach
+  // the shell, the Dart runtime, dart:io, Skia's software path, txt, and fml.
+  volatile FlutterEngineResult result = kSuccess;
+  result = FlutterEngineRun(FLUTTER_ENGINE_VERSION, &config, &args, nullptr,
+                            &engine);
+  result = FlutterEngineSendWindowMetricsEvent(engine, nullptr);
+  result = FlutterEngineSendPointerEvent(engine, nullptr, 0);
+  result = FlutterEngineShutdown(engine);
+
+  std::printf("link check: %d\n", static_cast<int>(result));
+  return 0;
+}
