diff --git a/engine/src/flutter/shell/platform/embedder/vita_embedder.cc b/engine/src/flutter/shell/platform/embedder/vita_embedder.cc
new file mode 100644
index 00000000..7bad8400
--- /dev/null
+++ b/engine/src/flutter/shell/platform/embedder/vita_embedder.cc
@@ -0,0 +1,716 @@
+// Copyright (c) 2026, the Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The PlayStation Vita embedder — first cut.
+//
+// Replaces vita_link_check.cc, which existed only to make the linker answer the
+// M2 question. This one is meant to run.
+//
+// **It is not complete.** What is here: engine startup against a linked-in AOT
+// snapshot, and a software present callback that copies Skia's output into the
+// display. What is not here yet, in the order it should arrive:
+//
+//   * Input. sceTouchPeek -> FlutterPointerEvent, and
+//     sceCtrlPeekBufferPositive -> a `vita/gamepad` platform channel.
+//   * Vsync. Frames are presented as they arrive rather than paced against
+//     sceDisplayWaitVblankStart, so there is no frame budget being kept.
+//   * Custom task runners. The engine will spin up its own threads for now;
+//     ADR-0004 wants the platform runner pinned to the main Vita thread.
+//
+// Two decisions are already baked in and are worth reading before changing
+// anything here.
+//
+// **The snapshot is linked in, not loaded** (ADR-0005 option A). The four
+// symbols below are emitted by gen_snapshot into an assembly file that becomes
+// part of eboot.bin. The embedder API's other route -- FlutterEngineCreateAOTData
+// with an ELF path -- needs a loader the Vita does not have.
+//
+// **The present path is a memcpy, and that is the measured cost.** Phase 0.5
+// found the blit alone is 8.06 ms at 960x544 and bandwidth-bound at roughly 15%
+// of the memory system, which is why ADR-0006 sets the bar at 30 fps native or
+// 60 at 720x408. If this needs to get faster, the first thing to try is a NEON
+// copy, not a different renderer.
+
+#include <psp2/display.h>
+#include <psp2/io/fcntl.h>
+#include <psp2/io/stat.h>
+#include <psp2/kernel/sysmem.h>
+#include <psp2/kernel/threadmgr.h>
+#include <psp2/touch.h>
+
+#include <unistd.h>
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+
+#include "flutter/shell/platform/embedder/embedder.h"
+
+// M1's on-device dev server, at spikes/m1-vpk/src/devserver.{c,h}, compiled
+// into this binary by the m3 spike's CMakeLists.
+//
+// Declared here rather than included. The header lives in the project repo,
+// outside the engine checkout, and ninja compiles this file with the engine's
+// own include paths -- reaching out of the tree would mean teaching GN about a
+// directory that only exists in one developer layout. One prototype is cheaper
+// and the linker still checks it.
+extern "C" int dev_server_run(void (*log_line)(const char* msg),
+                              const char* log_path,
+                              const char* eboot_path);
+extern "C" void dev_server_set_framebuffer_source(
+    const void* (*read_framebuffer)(unsigned int* size,
+                                    char* describe,
+                                    unsigned int describe_size));
+extern "C" void dev_server_set_tap_handler(void (*tap)(int x, int y));
+
+namespace {
+
+// The Vita's panel. ADR-0006 records that native resolution cannot hold 60 fps
+// and that 720x408 upscaled reaches 68 -- when the reduced-resolution path
+// lands, this is the constant that changes, plus a GXM scale on present.
+constexpr int kWidth = 960;
+constexpr int kHeight = 544;
+
+// sceDisplaySetFrameBuf requires the pitch to be a multiple of 64 pixels; 960
+// already is, but the constant is named rather than assumed because it stops
+// being true the moment the resolution changes.
+constexpr int kPitch = 960;
+
+// SCE_DISPLAY_PIXELFORMAT_A8B8G8R8 is R,G,B,A in memory order on a
+// little-endian target, which is byte-identical to
+// kFlutterSoftwarePixelFormatRGBA8888. VERSIONS.md flagged this as "verify, do
+// not assume" in Phase 0.5; it held, and it is why the present below is a plain
+// copy with no channel swizzle.
+struct VitaDisplay {
+  SceUID memblock = -1;
+  void* base = nullptr;
+};
+
+VitaDisplay g_display;
+
+// The log channel, owning its own file handle and using none of stdio.
+//
+// Three attempts at this failed in three different ways, and the pattern is
+// worth writing down because it will catch the next person.
+//
+//   _IOLBF with a null buffer -- newlib did not give line buffering, so a run
+//   that hung produced a zero-byte file.
+//
+//   freopen on stdout -- newlib here gives each thread its own reentrancy
+//   struct, so it rebinds only the calling thread's FILE. Output from one
+//   thread landed and output from another vanished, which reads like a
+//   buffering bug and is not one.
+//
+//   write(1, ...) -- freopen does not put the reopened stream on fd 1. The
+//   VitaSDK fd table hands out its own slots, so fd 1 is not the log and the
+//   writes went nowhere at all.
+//
+// A diagnostic channel must not have failure modes subtler than the bugs it
+// exists to find. sceIoWrite against a handle this file opened has none of
+// them: no buffering, no per-thread state, no descriptor mapping.
+SceUID g_log_fd = -1;
+
+void VLogRaw(const char* data, size_t len) {
+  if (g_log_fd < 0) {
+    return;
+  }
+  sceIoWrite(g_log_fd, data, len);
+}
+
+void VLog(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+void VLog(const char* fmt, ...) {
+  char buf[512];
+  va_list ap;
+  va_start(ap, fmt);
+  const int n = std::vsnprintf(buf, sizeof buf, fmt, ap);
+  va_end(ap);
+  if (n > 0) {
+    VLogRaw(buf, n < static_cast<int>(sizeof buf) ? n : sizeof buf - 1);
+  }
+}
+
+// Serve the dev protocol on its own thread, because dev_server_run blocks
+// until it is told to exit and the engine needs main() to keep running.
+//
+// Without this m3 answers nothing while it is alive, so a healthy run and a
+// hung one look identical from the host: no port, no log, no way in. Reading
+// the log meant asking someone to close the app and tap the loader, which is
+// exactly the round trip this loop exists to avoid.
+//
+// The server appends its own newline, so this must not add one.
+void DevServerLog(const char* msg) {
+  VLogRaw(msg, std::strlen(msg));
+}
+
+int DevServerThread(SceSize /* args */, void* /* argp */) {
+  dev_server_run(DevServerLog, "ux0:data/flutter-vita/m3.log",
+                 "ux0:app/FVTA00002/eboot.bin");
+  // Asked to exit, or the socket never came up. Either way the engine keeps
+  // going; losing the dev channel is not a reason to take the app down.
+  return sceKernelExitDeleteThread(0);
+}
+
+// Touch, polled from the front panel and translated into pointer events.
+//
+// The front panel reports in its own coordinate space, which is **twice the
+// display resolution** -- 1920x1088 against 960x544. The panel info is queried
+// rather than hard-coded to that factor: the numbers come from the hardware,
+// and a constant here would be an assumption that silently halves or doubles
+// every tap if it were ever wrong.
+//
+// Only the first contact is forwarded. Flutter's pointer protocol handles
+// multitouch by device id, and adding that without a way to test it would be
+// speculative -- a second finger is a change to make when there is something
+// on screen that needs one.
+struct TouchState {
+  bool down = false;
+  double x = 0;
+  double y = 0;
+  int scale_min_x = 0;
+  int scale_min_y = 0;
+  double scale_x = 0.5;  // replaced by panel info at init
+  double scale_y = 0.5;
+};
+
+TouchState g_touch;
+
+void InitTouch() {
+  sceTouchSetSamplingState(SCE_TOUCH_PORT_FRONT,
+                           SCE_TOUCH_SAMPLING_STATE_START);
+
+  SceTouchPanelInfo info = {};
+  if (sceTouchGetPanelInfo(SCE_TOUCH_PORT_FRONT, &info) < 0) {
+    VLog("flutter-vita: sceTouchGetPanelInfo failed, assuming 2x\n");
+    return;
+  }
+
+  const int span_x = info.maxAaX - info.minAaX;
+  const int span_y = info.maxAaY - info.minAaY;
+  if (span_x <= 0 || span_y <= 0) {
+    VLog("flutter-vita: touch panel span %dx%d is unusable, assuming 2x\n",
+         span_x, span_y);
+    return;
+  }
+
+  g_touch.scale_min_x = info.minAaX;
+  g_touch.scale_min_y = info.minAaY;
+  g_touch.scale_x = static_cast<double>(kWidth) / span_x;
+  g_touch.scale_y = static_cast<double>(kHeight) / span_y;
+  VLog("flutter-vita: touch aa=[%d,%d..%d,%d] scale=%.4f,%.4f\n", info.minAaX,
+       info.minAaY, info.maxAaX, info.maxAaY, g_touch.scale_x, g_touch.scale_y);
+}
+
+void SendPointer(FlutterEngine engine,
+                 FlutterPointerPhase phase,
+                 double x,
+                 double y) {
+  FlutterPointerEvent event = {};
+  event.struct_size = sizeof(FlutterPointerEvent);
+  event.phase = phase;
+  // Microseconds since epoch, which is what the engine expects here -- not the
+  // monotonic clock the message loop uses.
+  event.timestamp =
+      static_cast<size_t>(FlutterEngineGetCurrentTime() / 1000);
+  event.x = x;
+  event.y = y;
+  event.device_kind = kFlutterPointerDeviceKindTouch;
+  event.device = 0;
+  // A touch screen has no buttons, and reporting one makes Flutter treat the
+  // gesture as a mouse drag with a held button.
+  event.buttons = 0;
+  FlutterEngineSendPointerEvent(engine, &event, 1);
+}
+
+// Poll once and emit whatever transition happened since the last call.
+//
+// Flutter wants kDown / kMove / kUp, not a level. Sending kDown every frame a
+// finger is present makes every tap look like a fresh gesture and nothing
+// recognises as a press, so the previous state is what this is really about.
+void PumpTouch(FlutterEngine engine) {
+  SceTouchData data = {};
+  if (sceTouchPeek(SCE_TOUCH_PORT_FRONT, &data, 1) < 0) {
+    return;
+  }
+
+  const bool down = data.reportNum > 0;
+  if (down) {
+    const SceTouchReport& report = data.report[0];
+    g_touch.x = (report.x - g_touch.scale_min_x) * g_touch.scale_x;
+    g_touch.y = (report.y - g_touch.scale_min_y) * g_touch.scale_y;
+  }
+
+  if (down && !g_touch.down) {
+    SendPointer(engine, kDown, g_touch.x, g_touch.y);
+    VLog("flutter-vita: touch down %.1f,%.1f\n", g_touch.x, g_touch.y);
+  } else if (down && g_touch.down) {
+    SendPointer(engine, kMove, g_touch.x, g_touch.y);
+  } else if (!down && g_touch.down) {
+    // Released at the last known position: the panel stops reporting
+    // coordinates the moment contact ends, so the alternative is lifting at
+    // 0,0 and cancelling every tap.
+    SendPointer(engine, kUp, g_touch.x, g_touch.y);
+    VLog("flutter-vita: touch up %.1f,%.1f\n", g_touch.x, g_touch.y);
+  }
+  g_touch.down = down;
+}
+
+// Synthetic taps, so input can be verified with nobody holding the console.
+//
+// The dev server calls InjectTap from its own thread, and pointer events must
+// be sent from the thread that owns the engine handle -- so this only records
+// the request, and the main loop turns it into a down/up pair on its next
+// pass. A single int pair guarded by nothing is deliberate: one writer, one
+// reader, and a dropped tap under a race costs a retry rather than corruption.
+//
+// This bypasses sceTouch entirely. It proves the engine's pointer path and
+// says nothing about coordinate scaling or panel sampling, which is why the
+// real thing still has to be tried by hand at least once.
+volatile bool g_injected_tap_pending = false;
+volatile int g_injected_tap_x = 0;
+volatile int g_injected_tap_y = 0;
+
+void InjectTap(int x, int y) {
+  g_injected_tap_x = x;
+  g_injected_tap_y = y;
+  g_injected_tap_pending = true;
+}
+
+void DrainInjectedTaps(FlutterEngine engine) {
+  if (!g_injected_tap_pending) {
+    return;
+  }
+  const double x = g_injected_tap_x;
+  const double y = g_injected_tap_y;
+  g_injected_tap_pending = false;
+
+  // Down and up in one pass. A real tap spans several frames, but Flutter's
+  // gesture recogniser keys on the event sequence rather than the wall-clock
+  // gap between them, so a tap arrives as a tap.
+  SendPointer(engine, kDown, x, y);
+  SendPointer(engine, kUp, x, y);
+  VLog("flutter-vita: injected tap %.0f,%.0f\n", x, y);
+}
+
+// Capture what the display controller is scanning out, not what we drew.
+//
+// The distinction is the whole point. Dumping g_display.base proves only that
+// we wrote pixels into memory we own; if sceDisplaySetFrameBuf never took
+// effect, that dump is a perfect picture of a buffer nobody is reading, over a
+// black panel. sceDisplayGetFrameBuf asks the hardware which buffer it
+// actually holds, and comparing the two answers the real question.
+//
+// The description line carries that comparison plus the vertical retrace
+// count, which separates "configured but parked" from "actively scanning".
+//
+// **Limit, stated so nobody trusts this further than it goes:** this is the
+// app's registered framebuffer, not the composited panel output. System
+// overlays -- notifications, the power dialog, LiveArea -- composite above it
+// and are invisible to a user-mode app. Capturing those needs a kernel plugin.
+const void* ReadFramebuffer(unsigned int* size,
+                            char* describe,
+                            unsigned int describe_size) {
+  SceDisplayFrameBuf fb = {};
+  fb.size = sizeof(fb);
+  const int result = sceDisplayGetFrameBuf(&fb, SCE_DISPLAY_SETBUF_NEXTFRAME);
+
+  const int vcount_before = sceDisplayGetVcount();
+  sceKernelDelayThread(20 * 1000);  // longer than one 60 Hz frame
+  const int vcount_after = sceDisplayGetVcount();
+
+  if (result < 0 || fb.base == nullptr) {
+    std::snprintf(describe, describe_size,
+                  "ERR sceDisplayGetFrameBuf=0x%08X base=%p\n", result,
+                  fb.base);
+    *size = 0;
+    return nullptr;
+  }
+
+  std::snprintf(describe, describe_size,
+                "base=%p ours=%p match=%s %ux%u pitch=%u fmt=0x%08X "
+                "vcount=%d->%d scanning=%s\n",
+                fb.base, g_display.base,
+                fb.base == g_display.base ? "yes" : "NO", fb.width, fb.height,
+                fb.pitch, fb.pixelformat, vcount_before, vcount_after,
+                vcount_after != vcount_before ? "yes" : "NO");
+
+  // Deliberately sized from the descriptor the hardware returned rather than
+  // from our own constants, so a mismatch shows up as a wrong-sized capture
+  // instead of being silently papered over.
+  *size = fb.pitch * fb.height * 4;
+  return fb.base;
+}
+
+void StartDevServer() {
+  dev_server_set_framebuffer_source(ReadFramebuffer);
+  dev_server_set_tap_handler(InjectTap);
+  // 64 KiB of stack because the server's `put` path holds a 32 KiB buffer.
+  const SceUID thread = sceKernelCreateThread(
+      "m3_devserver", DevServerThread, 0x10000100, 64 * 1024, 0, 0, nullptr);
+  if (thread < 0) {
+    VLog("flutter-vita: dev server thread failed: 0x%08X\n", thread);
+    return;
+  }
+  sceKernelStartThread(thread, 0, nullptr);
+}
+
+bool InitDisplay() {
+  // CDRAM is the fast path for the display controller. The framebuffer must be
+  // 256 KiB aligned, which SCE_KERNEL_MEMBLOCK_TYPE_USER_CDRAM_RW gives.
+  const int size = kPitch * kHeight * 4;
+  const int aligned = (size + 0x3FFFF) & ~0x3FFFF;
+
+  g_display.memblock = sceKernelAllocMemBlock(
+      "flutter_fb", SCE_KERNEL_MEMBLOCK_TYPE_USER_CDRAM_RW, aligned, nullptr);
+  if (g_display.memblock < 0) {
+    VLog("sceKernelAllocMemBlock failed: 0x%08X\n", g_display.memblock);
+    return false;
+  }
+  if (sceKernelGetMemBlockBase(g_display.memblock, &g_display.base) < 0) {
+    VLog("sceKernelGetMemBlockBase failed\n");
+    return false;
+  }
+  std::memset(g_display.base, 0, aligned);
+
+  SceDisplayFrameBuf fb = {};
+  fb.size = sizeof(fb);
+  fb.base = g_display.base;
+  fb.pitch = kPitch;
+  fb.pixelformat = SCE_DISPLAY_PIXELFORMAT_A8B8G8R8;
+  fb.width = kWidth;
+  fb.height = kHeight;
+  return sceDisplaySetFrameBuf(&fb, SCE_DISPLAY_SETBUF_NEXTFRAME) >= 0;
+}
+
+// |SoftwareSurfacePresentCallback|
+bool PresentSurface(void* /* user_data */,
+                    const void* allocation,
+                    size_t row_bytes,
+                    size_t height) {
+  // A black panel has two very different causes and this separates them: the
+  // engine never producing a frame, or producing frames that are themselves
+  // black. Logging the first present and then every 60th keeps the answer in
+  // the log without the unbuffered writes becoming the frame budget.
+  static unsigned frames = 0;
+  // Every frame for the first 200, then every sixtieth.
+  //
+  // The interval used to be sixty throughout, which was tuned for an app that
+  // paints continuously and is useless for one that does not: the conformance
+  // app repaints once per probe, roughly thirty-five times in its whole life,
+  // so frame sixty never arrived and a run produced exactly one sample -- at
+  // startup, before anything interesting had happened. Painting is the only
+  // clock this log has, so the rate has to match the app being watched, not
+  // the display.
+  if (frames < 200 || frames % 60 == 0) {
+    // Free memory rides along with the frame log, because the alternative is
+    // guessing. The TLS handshake crash leaves a truncated core dump every
+    // time while an ordinary fault in the same binary leaves a complete one,
+    // which reads as the process running out of memory rather than touching a
+    // bad pointer -- and nothing so far has actually measured that.
+    //
+    // size_user is the budget the app allocates from. phycont is separate and
+    // small, and worth watching because the framebuffer lives there.
+    SceKernelFreeMemorySizeInfo mem;
+    mem.size = sizeof(mem);
+    if (sceKernelGetFreeMemorySize(&mem) >= 0) {
+      VLog("flutter-vita: present #%u row_bytes=%u height=%u "
+           "free user=%dK cdram=%dK phycont=%dK\n",
+           frames, static_cast<unsigned>(row_bytes),
+           static_cast<unsigned>(height), mem.size_user / 1024,
+           mem.size_cdram / 1024, mem.size_phycont / 1024);
+    } else {
+      VLog("flutter-vita: present #%u row_bytes=%u height=%u\n", frames,
+           static_cast<unsigned>(row_bytes),
+           static_cast<unsigned>(height));
+    }
+  }
+  frames++;
+
+  if (g_display.base == nullptr) {
+    return false;
+  }
+
+  // Single-buffered on purpose, for now. Double buffering is the right answer
+  // and it costs another 2 MiB of CDRAM; that trade belongs with the vsync work
+  // rather than here, because without pacing a second buffer buys nothing but
+  // tearing in a different place.
+  const size_t copy_bytes = row_bytes < static_cast<size_t>(kPitch * 4)
+                                ? row_bytes
+                                : static_cast<size_t>(kPitch * 4);
+  const uint8_t* src = static_cast<const uint8_t*>(allocation);
+  uint8_t* dst = static_cast<uint8_t*>(g_display.base);
+  for (size_t y = 0; y < height && y < static_cast<size_t>(kHeight); y++) {
+    std::memcpy(dst + y * kPitch * 4, src + y * row_bytes, copy_bytes);
+  }
+  return true;
+}
+
+}  // namespace
+
+// The AOT snapshot, linked into eboot.bin rather than loaded. gen_snapshot
+// emits these four symbols into the assembly file that is assembled alongside
+// this translation unit; see ADR-0005 for why the alternative -- an ELF loaded
+// at runtime -- was abandoned.
+extern "C" {
+extern const uint8_t _kDartVmSnapshotData[];
+extern const uint8_t _kDartVmSnapshotInstructions[];
+extern const uint8_t _kDartIsolateSnapshotData[];
+extern const uint8_t _kDartIsolateSnapshotInstructions[];
+}
+
+// m3 shipped without a log channel, which is why the first crash had to be
+// read out of registers. printf on this platform goes to the debug UART, and
+// nothing here has one. Point both streams at a file on ux0: instead, before
+// anything else runs, so `dev.sh get ux0:data/flutter-vita/m3.log` works even
+// after a crash -- the loader is up by then and serves the file.
+//
+// Unbuffered, not line buffered, and that is a deliberate downgrade.
+//
+// The first version asked for _IOLBF with a null buffer and size 0. POSIX
+// leaves that combination implementation-defined, newlib did not give line
+// buffering, and a run that hung produced a log file of zero bytes -- the app
+// had truncated it on open and never flushed a byte. A log that is empty
+// exactly when the program misbehaves is worse than no log, because it looks
+// like evidence.
+//
+// _IONBF sends every write straight through to sceIoWrite. It is slow, and on
+// a memory card it is very slow, but a diagnostic channel that cannot lose its
+// last line is the entire point of having one. Revisit only once the boot is
+// quiet enough that logging volume matters.
+static void OpenLog() {
+  static const char* const kPath = "ux0:data/flutter-vita/m3.log";
+  sceIoMkdir("ux0:data/flutter-vita", 0777);
+
+  // Truncate once, then hold an append handle. Append matters because the
+  // engine's own logging goes through std::cerr, which is a different writer
+  // with a different offset -- two writers each tracking their own position
+  // would overwrite each other rather than interleave.
+  const SceUID truncate =
+      sceIoOpen(kPath, SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
+  if (truncate >= 0) {
+    sceIoClose(truncate);
+  }
+  g_log_fd = sceIoOpen(kPath, SCE_O_WRONLY | SCE_O_APPEND, 0777);
+
+  // FML_LOG writes to std::cerr, and there is no hook to redirect it, so the
+  // engine's diagnostics still have to come through stdio. Append mode and no
+  // buffering, for the same two reasons as above.
+  std::freopen(kPath, "a", stderr);
+  std::setvbuf(stderr, nullptr, _IONBF, 0);
+  std::freopen(kPath, "a", stdout);
+  std::setvbuf(stdout, nullptr, _IONBF, 0);
+}
+
+// The platform task runner, without which no platform channel works at all.
+//
+// This was on the file's own deferred list -- "Custom task runners. The engine
+// will spin up its own threads for now" -- filed as a performance and
+// architecture concern for ADR-0004. It is not. `platform_message_callback`'s
+// contract is that it "will be invoked on the thread on which the
+// `FlutterEngineRun` call is made", and the mechanism for that is the platform
+// task runner: the engine *queues* the dispatch and waits for the embedder to
+// hand it back via FlutterEngineRunTask.
+//
+// With no runner and a main loop that only polls touch, the queue was never
+// drained. Measured before this existed: an `invokeMethod` on
+// `flutter/textinput` timed out after 25 s, and the message callback was never
+// once invoked. Nothing was broken about the channel; the message was simply
+// sitting in a queue nobody serviced.
+//
+// So this is a prerequisite for every channel -- text input, lifecycle,
+// settings, and the `psvita` package in ADR-0010 -- not an optimisation.
+//
+// Deliberately a fixed array rather than a heap queue. This is drained on the
+// main loop sixty times a second and posted to from engine threads; a
+// std::vector here would allocate on a path that runs during frame production.
+// 256 is far more than the observed depth, and overflowing it drops a task,
+// which is why it says so loudly rather than silently wrapping.
+struct PendingTask {
+  FlutterTask task;
+  uint64_t target_time;  // nanos, same clock as FlutterEngineGetCurrentTime
+};
+
+constexpr size_t kMaxPendingTasks = 256;
+PendingTask g_tasks[kMaxPendingTasks];
+size_t g_task_count = 0;
+std::mutex g_task_lock;
+SceUID g_platform_thread = 0;
+
+// May be called from any engine thread.
+void PostPlatformTask(FlutterTask task,
+                      uint64_t target_time,
+                      void* /* user_data */) {
+  std::lock_guard<std::mutex> guard(g_task_lock);
+  if (g_task_count >= kMaxPendingTasks) {
+    VLog("flutter-vita: platform task queue full, DROPPING a task\n");
+    return;
+  }
+  g_tasks[g_task_count].task = task;
+  g_tasks[g_task_count].target_time = target_time;
+  g_task_count++;
+}
+
+bool RunsTasksOnCurrentThread(void* /* user_data */) {
+  return sceKernelGetThreadId() == g_platform_thread;
+}
+
+// Run whatever is due, from the main loop.
+//
+// Tasks are copied out under the lock and run outside it, because a task may
+// post another one -- re-entering the lock from inside it would deadlock on a
+// non-recursive mutex, and the first symptom would be a frozen app with no
+// error anywhere.
+void DrainPlatformTasks(FlutterEngine engine) {
+  const uint64_t now = FlutterEngineGetCurrentTime();
+  FlutterTask due[kMaxPendingTasks];
+  size_t due_count = 0;
+  {
+    std::lock_guard<std::mutex> guard(g_task_lock);
+    size_t kept = 0;
+    for (size_t i = 0; i < g_task_count; i++) {
+      if (g_tasks[i].target_time <= now) {
+        due[due_count++] = g_tasks[i].task;
+      } else {
+        g_tasks[kept++] = g_tasks[i];
+      }
+    }
+    g_task_count = kept;
+  }
+  for (size_t i = 0; i < due_count; i++) {
+    FlutterEngineRunTask(engine, &due[i]);
+  }
+}
+
+// Platform channels arrive here. Phase 8, first step: see them.
+//
+// Nothing was listening before this, so every channel the framework opens --
+// `flutter/textinput`, `flutter/platform`, `flutter/lifecycle`,
+// `flutter/settings` -- was silently dropped by the engine with no record that
+// it had been attempted. The first thing worth knowing is which ones a real app
+// actually uses, and that is a question the log can answer before a single line
+// of IME code exists.
+//
+// **Every message must be answered.** The engine allocates a response handle
+// per message and leaks it otherwise; worse, an `invokeMethod` awaiting a reply
+// never completes, so a missing response is an app that quietly hangs rather
+// than one that visibly fails. A null response of length zero is the encoding
+// for "not implemented", which is exactly true right now and is what
+// `OptionalMethodChannel` -- the one `flutter/textinput` uses -- is built to
+// tolerate.
+//
+// The payload is logged as text and truncated. `flutter/textinput` uses
+// JSONMethodCodec, so its messages are readable ASCII; a channel using the
+// binary standard codec will look like noise here, which is itself the
+// distinction worth seeing.
+FlutterEngine g_engine = nullptr;
+
+void OnPlatformMessage(const FlutterPlatformMessage* message,
+                       void* /* user_data */) {
+  if (message == nullptr) return;
+
+  char preview[161];
+  size_t n = message->message_size;
+  if (n > sizeof preview - 1) n = sizeof preview - 1;
+  for (size_t i = 0; i < n; i++) {
+    const char c = static_cast<const char*>(
+        static_cast<const void*>(message->message))[i];
+    // Control bytes would break the log into unreadable pieces, and the binary
+    // codec is full of them.
+    preview[i] = (c >= 0x20 && c < 0x7F) ? c : '.';
+  }
+  preview[n] = '\0';
+  VLog("flutter-vita: channel %s [%u] %s%s\n",
+       message->channel != nullptr ? message->channel : "(null)",
+       static_cast<unsigned>(message->message_size), preview,
+       message->message_size > n ? "..." : "");
+
+  if (message->response_handle != nullptr && g_engine != nullptr) {
+    FlutterEngineSendPlatformMessageResponse(g_engine,
+                                             message->response_handle,
+                                             nullptr, 0);
+  }
+}
+
+int main(int argc, char** argv) {
+  OpenLog();
+  VLog("flutter-vita: starting\n");
+
+  // Before the engine, deliberately. If startup hangs or dies, the dev server
+  // is already answering and the log can be pulled without the app exiting.
+  StartDevServer();
+
+  if (!InitDisplay()) {
+    VLog("flutter-vita: display init failed\n");
+    return 1;
+  }
+
+  FlutterRendererConfig config = {};
+  config.type = kSoftware;
+  config.software.struct_size = sizeof(FlutterSoftwareRendererConfig);
+  config.software.surface_present_callback = PresentSurface;
+
+  // Captured before FlutterEngineRun, because the engine may post a task
+  // during startup and RunsTasksOnCurrentThread must already be truthful.
+  g_platform_thread = sceKernelGetThreadId();
+
+  FlutterTaskRunnerDescription platform_runner = {};
+  platform_runner.struct_size = sizeof(FlutterTaskRunnerDescription);
+  platform_runner.identifier = 1;
+  platform_runner.runs_task_on_current_thread_callback =
+      RunsTasksOnCurrentThread;
+  platform_runner.post_task_callback = PostPlatformTask;
+
+  FlutterCustomTaskRunners task_runners = {};
+  task_runners.struct_size = sizeof(FlutterCustomTaskRunners);
+  task_runners.platform_task_runner = &platform_runner;
+
+  FlutterProjectArgs args = {};
+  args.struct_size = sizeof(FlutterProjectArgs);
+  args.custom_task_runners = &task_runners;
+  args.platform_message_callback = OnPlatformMessage;
+  // app0: is the read-only mount of the installed .vpk.
+  args.assets_path = "app0:/flutter_assets";
+  args.icu_data_path = "app0:/icudtl.dat";
+  args.vm_snapshot_data = _kDartVmSnapshotData;
+  args.vm_snapshot_instructions = _kDartVmSnapshotInstructions;
+  args.isolate_snapshot_data = _kDartIsolateSnapshotData;
+  args.isolate_snapshot_instructions = _kDartIsolateSnapshotInstructions;
+
+  FlutterEngine engine = nullptr;
+  FlutterEngineResult result =
+      FlutterEngineRun(FLUTTER_ENGINE_VERSION, &config, &args, nullptr, &engine);
+  if (result != kSuccess || engine == nullptr) {
+    VLog("flutter-vita: FlutterEngineRun failed: %d\n", result);
+    return 1;
+  }
+  // The platform message callback needs the engine handle to reply, and it can
+  // fire before FlutterEngineRun returns -- the framework opens channels during
+  // startup. Messages arriving in that window are logged and go unanswered,
+  // which is survivable only because nothing awaits a reply that early.
+  g_engine = engine;
+  VLog("flutter-vita: engine running\n");
+
+  FlutterWindowMetricsEvent metrics = {};
+  metrics.struct_size = sizeof(FlutterWindowMetricsEvent);
+  metrics.width = kWidth;
+  metrics.height = kHeight;
+  metrics.pixel_ratio = 1.0;
+  FlutterEngineSendWindowMetricsEvent(engine, &metrics);
+
+  InitTouch();
+
+  // Polled input, no vsync yet. Frames are still presented as the engine
+  // produces them rather than paced against sceDisplayWaitVblankStart, so this
+  // loop's period is an input sampling rate and not a frame budget.
+  for (;;) {
+    // First, because a platform message that arrived while we were asleep
+    // should be answered before another frame's worth of input is sampled.
+    DrainPlatformTasks(engine);
+    PumpTouch(engine);
+    DrainInjectedTaps(engine);
+    sceKernelDelayThread(16 * 1000);
+  }
+
+  return 0;
+}
