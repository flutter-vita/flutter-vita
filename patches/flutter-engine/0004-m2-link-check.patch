+// ---------------------------------------------------------------------------
+// The debug strip.
+//
+// Every number this port has been tuned by so far -- frame rate, raster and
+// swap time, GPU load, free memory -- has been read out of a log file pulled
+// over the network after the fact. That is fine for a measurement and useless
+// while somebody is holding the console: the moment you want to know *which*
+// screen is slow, or whether a scroll is the expensive thing, the answer has
+// to be on the panel next to the thing you are touching.
+//
+// So this draws the same window the FRAMES line reports as a strip along the
+// top edge of the frame: a row of labels and a row of values, the layout of
+// the gallery's vita_debug_strip, which is the look that read well. Flutter
+// knows nothing about it, which is deliberate: it costs the app nothing, needs
+// no widget, and works identically in every app without a line of Dart. On
+// the software path it goes over the display buffer after the blit; under GL
+// it goes onto each finished frame from the layer's display thread
+// (HudFrameHook), after the GPU and outside the GL context.
+//
+// The text is composed in ordinary memory when it changes, every twenty
+// frames, and copied to the display a row at a time: the display buffer is
+// in CDRAM, where a read costs many times a write, and the display thread's
+// time delays the flip. Its own cost is timed into g_win_hud_us, never into
+// the raster's or the blit's, so an instrument cannot flatter or slander the
+// thing it measures.
+
+constexpr int kHudH = 34;
+constexpr int kHudW = kWidth;
+constexpr int kHudX = 0;
+constexpr int kHudY = 0;
+constexpr int kHudLabelY = 3;   // the label row's cell top; caps start a row in
+constexpr int kHudValueY = 17;  // the value row's
+constexpr int kHudPad = 8;      // the strip's side margins
+constexpr int kHudGap = 20;     // between columns
+constexpr int kHudLabelAdvance = kHudLabelFontW + 1;  // labels are letter-spaced
+constexpr int kHudValueAdvance = kHudValueFontW;
+constexpr uint32_t kHudBack = 0xFF1B120Eu;   // A8B8G8R8: #0E121B, the receiver's panel
+constexpr uint32_t kHudLabel = 0xFFA5938Bu;  // #8B93A5
+constexpr uint32_t kHudValue = 0xFFEFE9E6u;  // #E6E9EF
+constexpr uint32_t kHudDim = 0xFF78645Cu;    // #5C6478, the second line at the left
+
+// The columns. A label and a value each; the value is what HudUpdate
+// rewrites. Right-aligned under each other, the block right-aligned in the
+// strip, as the Dart strip lays them out.
+constexpr int kHudColumns = 9;
+struct HudColumn {
+  const char* label;
+  char value[24];
+};
+HudColumn g_hud_columns[kHudColumns] = {
+    {"fps", "--"},         {"raster ms", "--"}, {"swap ms", "--"},
+    {"gpu busy", "--"},    {"cpu cores %", "--"}, {"ram MB", "--"},
+    {"cdram MB", "--"},    {"heap MB", "--"},   {"battery", "--"},
+};
+// The left of the strip: which app this is, and the backend and engine
+// under it. Filled once, at startup.
+char g_hud_title[32] = "";
+char g_hud_subtitle[48] = "";
+
+// The strip as pixels, composed in ordinary memory when the text changes and
+// copied to the display a row at a time. Two of them: the raster thread
+// composes into the one the display is not reading.
+uint32_t g_hud_box[2][kHudH][kHudW];
+std::atomic<int> g_hud_box_shown{-1};  // index into g_hud_box, -1 before the first compose
+
+// The glyph for the next character of a UTF-8 string, -1 for one the font
+// does not have, -2 at the end; advances the pointer. The degree sign is the
+// one two-byte character the strip prints.
+int HudGlyph(const char** p) {
+  const unsigned char c = static_cast<unsigned char>(**p);
+  if (c == 0) return -2;  // the end
+  (*p)++;
+  if (c >= 0x20 && c < 0x7F) return c - 0x20;
+  if (c == 0xC2 && static_cast<unsigned char>(**p) == 0xB0) {
+    (*p)++;
+    return kHudFontDegree;
+  }
+  while ((static_cast<unsigned char>(**p) & 0xC0) == 0x80) (*p)++;  // the rest of an unknown sequence
+  return -1;
+}
+
+int HudTextWidth(const char* text, int advance) {
+  int n = 0;
+  while (HudGlyph(&text) != -2) n++;
+  return n * advance;
+}
+
+// One alpha-blended pixel of the box.
+inline void HudBlend(uint32_t* px, uint32_t ink, unsigned a) {
+  if (a == 0) return;
+  if (a == 255) {
+    *px = ink;
+    return;
+  }
+  const uint32_t bg = *px;
+  uint32_t out = 0xFF000000u;
+  for (int shift = 0; shift < 24; shift += 8) {
+    const unsigned b = (bg >> shift) & 0xFF, i = (ink >> shift) & 0xFF;
+    out |= ((i * a + b * (255 - a)) / 255) << shift;
+  }
+  *px = out;
+}
+
+// Text into the box at (x, y), in one of the two fonts; returns the x after
+// it. Clipped to the box.
+template <int W, int H>
+int HudDrawText(uint32_t (*box)[kHudW], int x, int y, const char* text,
+                const uint8_t (*font)[H][W], int advance, uint32_t ink) {
+  for (;;) {
+    const int glyph = HudGlyph(&text);
+    if (glyph == -2) break;
+    if (glyph >= 0) {
+      for (int gy = 0; gy < H; gy++) {
+        const int py = y + gy;
+        if (py < 0 || py >= kHudH) continue;
+        for (int gx = 0; gx < W; gx++) {
+          const int px = x + gx;
+          if (px < 0 || px >= kHudW) continue;
+          HudBlend(&box[py][px], ink, font[glyph][gy][gx]);
+        }
+      }
+    }
+    x += advance;
+  }
+  return x;
+}
+
+// The text as pixels, into the box the display is not showing, then shown.
+void HudCompose() {
+  const int shown = g_hud_box_shown.load(std::memory_order_acquire);
+  const int next = shown == 0 ? 1 : 0;
+  uint32_t (*box)[kHudW] = g_hud_box[next];
+  for (int row = 0; row < kHudH; row++) {
+    for (int col = 0; col < kHudW; col++) box[row][col] = kHudBack;
+  }
+  HudDrawText<kHudLabelFontW, kHudLabelFontH>(box, kHudPad, kHudLabelY, g_hud_title, kHudLabelFont,
+                                              kHudLabelAdvance, kHudLabel);
+  HudDrawText<kHudLabelFontW, kHudLabelFontH>(box, kHudPad, kHudValueY, g_hud_subtitle, kHudLabelFont,
+                                              kHudLabelAdvance, kHudDim);
+  int widths[kHudColumns];
+  int total = kHudGap * (kHudColumns - 1);
+  for (int c = 0; c < kHudColumns; c++) {
+    const int lw = HudTextWidth(g_hud_columns[c].label, kHudLabelAdvance);
+    const int vw = HudTextWidth(g_hud_columns[c].value, kHudValueAdvance);
+    widths[c] = lw > vw ? lw : vw;
+    total += widths[c];
+  }
+  int x = kHudW - kHudPad - total;
+  for (int c = 0; c < kHudColumns; c++) {
+    const HudColumn& col = g_hud_columns[c];
+    const int lw = HudTextWidth(col.label, kHudLabelAdvance);
+    const int vw = HudTextWidth(col.value, kHudValueAdvance);
+    HudDrawText<kHudLabelFontW, kHudLabelFontH>(box, x + widths[c] - lw, kHudLabelY, col.label,
+                                                kHudLabelFont, kHudLabelAdvance, kHudLabel);
+    HudDrawText<kHudValueFontW, kHudValueFontH>(box, x + widths[c] - vw, kHudValueY, col.value,
+                                                kHudValueFont, kHudValueAdvance, kHudValue);
+    x += widths[c] + kHudGap;
+  }
+  g_hud_box_shown.store(next, std::memory_order_release);
+}
+
+// The composed strip onto a frame, `stride` pixels per row. Nothing is read
+// back from the frame.
+void HudBlit(void* base, int stride, int width, int height) {
+  const int shown = g_hud_box_shown.load(std::memory_order_acquire);
+  if (shown < 0) return;
+  if (kHudX + kHudW > width || kHudY + kHudH > height) return;
+  uint32_t* fb = static_cast<uint32_t*>(base);
+  for (int row = 0; row < kHudH; row++) {
+    std::memcpy(fb + static_cast<size_t>(kHudY + row) * stride + kHudX,
+                g_hud_box[shown][row], sizeof g_hud_box[shown][row]);
+  }
+}
+
+// A second, shorter accumulation window, for the HUD only.
+//
+// Deliberately not the same window as the FRAMES line. Sixty frames is the
+// right size for a number somebody is going to quote in a commit message and
+// far too slow for one somebody is watching while they scroll -- at 13 fps it
+// updates once every four and a half seconds. Twenty frames updates three times
+// a second at 60 fps and still often enough to follow at 13. The log stays
+// authoritative; the HUD is for steering.
+constexpr unsigned kHudWindow = 20;
+unsigned g_hud_frames = 0;
+unsigned g_hud_active = 0;
+uint64_t g_hud_active_us = 0;
+uint64_t g_hud_blit_us = 0;
+uint64_t g_hud_damage_px = 0;
+uint64_t g_hud_max_gap_us = 0;
+
+// How much of the C heap is in use, in MiB.
+//
+// This is the number the free-memory line above cannot see and the one that has
+// actually been killing long runs. `_newlib_heap_size_user` carves a fixed
+// arena out of the process budget at startup, so `sceKernelGetFreeMemorySize`
+// can report tens of megabytes free while the arena is completely full -- which
+// is exactly what happened before the arena was raised to 160 MB, and is the
+// first thing to check when a run dies with the budget looking healthy.
+//
+// mallinfo walks every free chunk of the arena with the malloc lock held, and
+// every thread that allocates meanwhile waits for it: the UI thread building
+// a frame, the raster thread recording one. So it is sampled, at most once
+// every five seconds whoever asks, and its cost is kept next to the sample
+// so a run can say what it paid. Until 2026-09-14 it ran once a second from
+// the present line and, with the gallery's stats channel, once more from the
+// main thread; the gallery's run 34 had a 83..133 ms frame in nearly every
+// scene, on the second.
+struct HeapSample {
+  unsigned used_mb, arena_mb, cost_us;
+};
+
+HeapSample HeapNow() {
+  static std::mutex mutex;
+  static HeapSample sample;
+  static uint64_t taken_us = 0;
+  std::lock_guard<std::mutex> lock(mutex);
+  const uint64_t now = sceKernelGetSystemTimeWide();
+  if (taken_us == 0 || now - taken_us > 5 * 1000 * 1000) {
+    const struct mallinfo mi = mallinfo();
+    sample.cost_us = static_cast<unsigned>(sceKernelGetSystemTimeWide() - now);
+    sample.used_mb = static_cast<unsigned>(mi.uordblks / (1024 * 1024));
+    sample.arena_mb = static_cast<unsigned>(mi.arena / (1024 * 1024));
+    taken_us = now;
+  }
+  return sample;
+}
+
+unsigned HeapUsedMb() { return HeapNow().used_mb; }
+unsigned HeapArenaMb() { return HeapNow().arena_mb; }
+
+// Each core's load over the window, 0..100, from the kernel's idle clocks.
+void HudCpuLoad(unsigned load[4]) {
+  static uint64_t last_us = 0;
+  static uint64_t last_idle[4] = {0, 0, 0, 0};
+  for (int c = 0; c < 4; c++) load[c] = 0;
+  const uint64_t now = sceKernelGetSystemTimeWide();
+  const uint64_t window = last_us != 0 ? now - last_us : 0;
+  SceKernelSystemInfo sys;
+  std::memset(&sys, 0, sizeof sys);
+  sys.size = sizeof sys;
+  if (sceKernelGetSystemInfo(&sys) < 0) return;
+  for (int c = 0; c < 4; c++) {
+    const uint64_t idle = sys.cpuInfo[c].idleClock;
+    if (window != 0 && idle >= last_idle[c]) {
+      const uint64_t idle_pct = (idle - last_idle[c]) * 100 / window;
+      load[c] = idle_pct > 100 ? 0 : 100 - static_cast<unsigned>(idle_pct);
+    }
+    last_idle[c] = idle;
+  }
+  last_us = now;
+}
+
+// The process's budgets, in MiB, read once: sceAppMgrGetBudgetInfo, its
+// syscall, or the standard budget when both refuse (they do on 3.73; the
+// vita/stats handler has the numbers).
+void HudBudget(unsigned* user_mb, unsigned* cdram_mb) {
+  static unsigned user = 0, cdram = 0;
+  if (user == 0) {
+    SceAppMgrBudgetInfo budget;
+    std::memset(&budget, 0, sizeof budget);
+    budget.size = sizeof budget;
+    int brc = sceAppMgrGetBudgetInfo(&budget);
+    if (brc < 0) {
+      std::memset(&budget, 0, sizeof budget);
+      budget.size = sizeof budget;
+      brc = _sceAppMgrGetBudgetInfo(&budget);
+    }
+    if (brc >= 0) {
+      user = budget.total_user_rw_mem / (1024 * 1024);
+      cdram = budget.total_cdram_mem / (1024 * 1024);
+    } else {
+      user = 256;
+      cdram = 112;
+    }
+  }
+  *user_mb = user;
+  *cdram_mb = cdram;
+}
+
+// When the strip was last composed, and a flag so the raster thread and the
+// main loop never compose at the same time (HudTryUpdate).
+uint64_t g_hud_composed_us = 0;
+std::atomic<bool> g_hud_composing{false};
+
+void HudUpdate() {
+  const unsigned active_us =
+      g_hud_active != 0 ? static_cast<unsigned>(g_hud_active_us / g_hud_active)
+                        : 0;
+  const unsigned fps = active_us != 0 ? 1000000u / active_us : 0;
+  const unsigned fps_frac = active_us != 0 ? (10000000u / active_us) % 10 : 0;
+  // No frames in the window (an idle screen, composed on the timer): every
+  // per-frame figure is a zero, which is the truth of an idle screen.
+  const unsigned frames = g_hud_frames != 0 ? g_hud_frames : 1;
+  const unsigned blit_us = static_cast<unsigned>(g_hud_blit_us / frames);
+  const unsigned raster_us = static_cast<unsigned>(g_hud_raster_us / frames);
+  const unsigned dmg_pct =
+      static_cast<unsigned>(g_hud_damage_px / frames * 100 / (kWidth * kHeight));
+
+  SceKernelFreeMemorySizeInfo mem;
+  mem.size = sizeof(mem);
+  unsigned free_mb = 0, cdram_free_mb = 0;
+  if (sceKernelGetFreeMemorySize(&mem) >= 0) {
+    free_mb = static_cast<unsigned>(mem.size_user / (1024 * 1024));
+    cdram_free_mb = static_cast<unsigned>(mem.size_cdram / (1024 * 1024));
+  }
+  unsigned user_mb, cdram_mb;
+  HudBudget(&user_mb, &cdram_mb);
+  unsigned cpu[4];
+  HudCpuLoad(cpu);
+
+  HudColumn* col = g_hud_columns;
+  std::snprintf(col[0].value, sizeof col[0].value, "%u.%u", fps, fps_frac);
+  std::snprintf(col[1].value, sizeof col[1].value, "%u.%u", raster_us / 1000,
+                (raster_us / 100) % 10);
+  if (g_gl_enabled) {
+    // Raster is Skia's time on the raster thread, swap the wait to queue the
+    // frame: a swap that grows is the GPU falling behind, a raster that grows
+    // is Skia, and what is left of the frame after both is the UI thread.
+    col[2].label = "swap ms";
+    std::snprintf(col[2].value, sizeof col[2].value, "%u.%u", blit_us / 1000,
+                  (blit_us / 100) % 10);
+    // GPU busy over the window from the layer's completion notifications,
+    // the same reading vita/stats gives the Dart strip, and the GPU's time
+    // per frame beside it; past 100 when frames queue behind each other.
+    static unsigned last_gpu_us = 0, last_gpu_frames = 0;
+    static uint64_t last_window_end_us = 0;
+    unsigned gpu_frames = 0;
+    const unsigned gpu_us = flutter_vita_gl_gpu_us(&gpu_frames);
+    const uint64_t now = sceKernelGetSystemTimeWide();
+    unsigned gpu_pct = 0, gpu_frame_us = 0;
+    if (last_window_end_us != 0 && gpu_us >= last_gpu_us &&
+        now > last_window_end_us) {
+      const unsigned d = gpu_us - last_gpu_us;
+      gpu_pct = static_cast<unsigned>(static_cast<uint64_t>(d) * 100 /
+                                      (now - last_window_end_us));
+      if (gpu_frames > last_gpu_frames) gpu_frame_us = d / (gpu_frames - last_gpu_frames);
+    }
+    last_gpu_us = gpu_us;
+    last_gpu_frames = gpu_frames;
+    last_window_end_us = now;
+    col[3].label = "gpu busy";
+    std::snprintf(col[3].value, sizeof col[3].value, "%u%% %u.%ums", gpu_pct,
+                  gpu_frame_us / 1000, (gpu_frame_us / 100) % 10);
+  } else {
+    // Raster and blit and the damaged share of the screen, because the
+    // useful reading is what is left over: frame time minus these is the UI
+    // thread.
+    col[2].label = "blit ms";
+    std::snprintf(col[2].value, sizeof col[2].value, "%u.%u", blit_us / 1000,
+                  (blit_us / 100) % 10);
+    col[3].label = "damage";
+    std::snprintf(col[3].value, sizeof col[3].value, "%u%%", dmg_pct);
+  }
+  std::snprintf(col[4].value, sizeof col[4].value, "%u %u %u %u", cpu[0], cpu[1],
+                cpu[2], cpu[3]);
+  std::snprintf(col[5].value, sizeof col[5].value, "%u / %u",
+                user_mb > free_mb ? user_mb - free_mb : 0, user_mb);
+  // CDRAM is the number the GL path runs out of first: the gallery's first
+  // bench on fvita_gles2 ran it to nothing while every other figure looked
+  // fine.
+  std::snprintf(col[6].value, sizeof col[6].value, "%u / %u",
+                cdram_mb > cdram_free_mb ? cdram_mb - cdram_free_mb : 0, cdram_mb);
+  // The heap before the budget, because the budget has never yet been the
+  // thing that ran out and the heap has. Used over the cap the app set
+  // before main.
+  const HeapSample heap = HeapNow();
+  const unsigned heap_cap_mb = &_newlib_heap_size_user != nullptr
+                                   ? _newlib_heap_size_user / (1024 * 1024)
+                                   : heap.arena_mb;
+  std::snprintf(col[7].value, sizeof col[7].value, "%u / %u", heap.used_mb, heap_cap_mb);
+  // The battery's temperature is the only one user mode can read on this
+  // console; its charge says how long a bench has.
+  const int batt_c100 = scePowerGetBatteryTemp();
+  std::snprintf(col[8].value, sizeof col[8].value, "%d%% %d.%d\xC2\xB0" "C",
+                scePowerGetBatteryLifePercent(), batt_c100 / 100,
+                std::abs(batt_c100 % 100) / 10);
+
+  HudCompose();
+  g_hud_dirty = true;
+  g_hud_composed_us = sceKernelGetSystemTimeWide();
+
+  g_hud_frames = 0;
+  g_hud_active = 0;
+  g_hud_active_us = 0;
+  g_hud_blit_us = 0;
+  g_hud_raster_us = 0;
+  g_hud_damage_px = 0;
+  g_hud_max_gap_us = 0;
+}
+
+// HudUpdate unless another thread is inside it. The raster thread composes
+// every twenty frames; the main loop composes once a second when frames
+// are not coming (an idle screen), so the memory and the battery stay
+// current and the toggle shows numbers rather than dashes. A lost race
+// costs one composition, never a torn one.
+void HudTryUpdate() {
+  if (g_hud_composing.exchange(true, std::memory_order_acquire)) return;
+  HudUpdate();
+  g_hud_composing.store(false, std::memory_order_release);
+}
+
+// The strip's left: the title id, then the backend and the engine's commit.
+void HudTitle(const char* backend) {
+  char self[16] = "";
+  sceAppMgrAppParamGetString(0, 12, self, sizeof self);
+  std::snprintf(g_hud_title, sizeof g_hud_title, "%s", self[0] != '\0' ? self : "flutter-vita");
+  std::snprintf(g_hud_subtitle, sizeof g_hud_subtitle, "%s  %.8s", backend,
+                flutter::GetFlutterEngineVersion());
+}
+
+// The software path: onto the display buffer, after the blit.
+void HudPaint(void* base) {
+  if (g_hud_box_shown.load(std::memory_order_acquire) < 0) HudCompose();
+  HudBlit(base, kPitch, kWidth, kHeight);
+  g_hud_dirty = false;
+}
+
+// The GL path: onto each finished frame, on the layer's display thread (see
+// flutter_vita_gl_set_frame_hook). The text is composed on the raster thread
+// by HudUpdate; this copies the box it published last.
+void HudFrameHook(void* /* ctx */, void* pixels, int width, int height, int stride) {
+  if (flutter_vita_debug_overlay == 0 || !g_hud_on) return;
+  HudBlit(pixels, stride, width, height);
+}
+
+// Per-present bookkeeping, shared by both backends.
+//
+// Extracted from PresentSurface when the GL path arrived, because every
+// number this port is steered by comes from here and a backend that did not
+// report them would be unmeasurable -- which is the one thing ADR-0006 does
+// not allow. row_bytes and height are the surface the frame was drawn into;
+// under GL that is the display target rather than a CPU allocation.
+// Compile a shader pair on demand, from the raster thread, and say what
+// happened.
+//
+// libshacccg refuses one of the programs Skia generates for an image draw and
+// gives no reason: "link failed but did not provide an info log". Finding which
+// construct it objects to means compiling variants, and libshacccg is a Vita
+// module -- there is no host copy to bisect against. So the bisection happens
+// here.
+//
+// Put a vertex and fragment shader beside a `go` marker and this compiles them
+// on the next present and writes the answer back. One rebuild, then the loop is
+// two file transfers:
+//
+//   put ux0:data/flutter-vita/shadertest/v.glsl
+//   put ux0:data/flutter-vita/shadertest/f.glsl
+//   put ux0:data/flutter-vita/shadertest/go
+//   get ux0:data/flutter-vita/shadertest/result.txt
+//
+// It has to run on this thread: the GL is driven from the raster thread and
+// nothing else in the process may touch it.
+constexpr const char* kProbeDir = "ux0:data/flutter-vita/shadertest";
+
+char* ReadWholeFile(const char* path, int* out_len) {
+  const SceUID fd = sceIoOpen(path, SCE_O_RDONLY, 0777);
+  if (fd < 0) return nullptr;
+  const int len = static_cast<int>(sceIoLseek(fd, 0, SCE_SEEK_END));
+  sceIoLseek(fd, 0, SCE_SEEK_SET);
+  if (len <= 0 || len > 256 * 1024) {
+    sceIoClose(fd);
+    return nullptr;
+  }
+  char* buf = static_cast<char*>(std::malloc(len + 1));
+  if (buf == nullptr) {
+    sceIoClose(fd);
+    return nullptr;
+  }
+  const int got = sceIoRead(fd, buf, len);
+  sceIoClose(fd);
+  if (got != len) {
+    std::free(buf);
+    return nullptr;
+  }
+  buf[len] = '\0';
+  if (out_len != nullptr) *out_len = len;
+  return buf;
+}
+
+void ProbeAppend(char* out, int cap, int* n, const char* fmt, ...) {
+  if (*n >= cap - 1) return;
+  va_list ap;
+  va_start(ap, fmt);
+  const int wrote = std::vsnprintf(out + *n, cap - *n, fmt, ap);
+  va_end(ap);
+  if (wrote > 0) *n += wrote < cap - *n ? wrote : cap - *n - 1;
+}
+
+void ProbeShaderLog(GLuint obj, bool program, char* out, int cap, int* n,
+                    const char* label) {
+  GLint len = 0;
+  if (program) {
+    glGetProgramiv(obj, GL_INFO_LOG_LENGTH, &len);
+  } else {
+    glGetShaderiv(obj, GL_INFO_LOG_LENGTH, &len);
+  }
+  if (len <= 1) {
+    ProbeAppend(out, cap, n, "%s log: (empty)\n", label);
+    return;
+  }
+  if (len > 4096) len = 4096;
+  char* log = static_cast<char*>(std::malloc(len + 1));
+  if (log == nullptr) return;
+  log[0] = '\0';
+  if (program) {
+    glGetProgramInfoLog(obj, len, nullptr, log);
+  } else {
+    glGetShaderInfoLog(obj, len, nullptr, log);
+  }
+  log[len] = '\0';
+  ProbeAppend(out, cap, n, "%s log: %s\n", label, log);
+  std::free(log);
+}
+
+void RunShaderProbe() {
+  char path[256];
+  std::snprintf(path, sizeof path, "%s/go", kProbeDir);
+  SceIoStat st;
+  if (sceIoGetstat(path, &st) < 0) return;
+  sceIoRemove(path);
+
+  static char out[8192];
+  int n = 0;
+  out[0] = '\0';
+
+  char vpath[256], fpath[256];
+  std::snprintf(vpath, sizeof vpath, "%s/v.glsl", kProbeDir);
+  std::snprintf(fpath, sizeof fpath, "%s/f.glsl", kProbeDir);
+  char* vsrc = ReadWholeFile(vpath, nullptr);
+  char* fsrc = ReadWholeFile(fpath, nullptr);
+  if (vsrc == nullptr || fsrc == nullptr) {
+    ProbeAppend(out, sizeof out, &n, "MISSING %s\n",
+                vsrc == nullptr ? "v.glsl" : "f.glsl");
+  } else {
+    // The compiler's optimisation level was a knob here while vitaGL was the
+    // GL; fvita_gles2 compiles at one level and keeps its translated Cg in
+    // its own cache directory, so the probe is the compile and its log.
+    const uint64_t t0 = sceKernelGetSystemTimeWide();
+    const GLuint vs = glCreateShader(GL_VERTEX_SHADER);
+    const GLuint fs = glCreateShader(GL_FRAGMENT_SHADER);
+    const char* vp = vsrc;
+    const char* fp = fsrc;
+    glShaderSource(vs, 1, &vp, nullptr);
+    glShaderSource(fs, 1, &fp, nullptr);
+    glCompileShader(vs);
+    glCompileShader(fs);
+    const GLuint prog = glCreateProgram();
+    glAttachShader(prog, vs);
+    glAttachShader(prog, fs);
+    glLinkProgram(prog);
+    const uint64_t took = sceKernelGetSystemTimeWide() - t0;
+
+    GLint linked = 0;
+    glGetProgramiv(prog, GL_LINK_STATUS, &linked);
+    ProbeAppend(out, sizeof out, &n, "LINK %s in %u us\n",
+                linked ? "OK" : "FAILED", static_cast<unsigned>(took));
+    ProbeShaderLog(vs, false, out, sizeof out, &n, "vertex");
+    ProbeShaderLog(fs, false, out, sizeof out, &n, "fragment");
+    ProbeShaderLog(prog, true, out, sizeof out, &n, "program");
+
+    glDeleteProgram(prog);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+  }
+  std::free(vsrc);
+  std::free(fsrc);
+
+  std::snprintf(path, sizeof path, "%s/result.txt", kProbeDir);
+  const SceUID fd =
+      sceIoOpen(path, SCE_O_CREAT | SCE_O_WRONLY | SCE_O_TRUNC, 0777);
+  if (fd >= 0) {
+    sceIoWrite(fd, out, std::strlen(out));
+    sceIoClose(fd);
+  }
+  VLogRaw(out, std::strlen(out));
+}
+
+void NotePresent(size_t row_bytes, size_t height) {
+  // A black panel has two very different causes and this separates them: the
+  // engine never producing a frame, or producing frames that are themselves
+  // black. Logging the first present and then every 60th keeps the answer in
+  // the log without the unbuffered writes becoming the frame budget.
+  static unsigned frames = 0;
+  // Every frame for the first 200, then every sixtieth.
+  //
+  // The interval used to be sixty throughout, which was tuned for an app that
+  // paints continuously and is useless for one that does not: the conformance
+  // app repaints once per probe, roughly thirty-five times in its whole life,
+  // so frame sixty never arrived and a run produced exactly one sample -- at
+  // startup, before anything interesting had happened. Painting is the only
+  // clock this log has, so the rate has to match the app being watched, not
+  // the display.
+  if (frames < 200 || frames % 60 == 0) {
+    // Free memory rides along with the frame log, because the alternative is
+    // guessing. The TLS handshake crash leaves a truncated core dump every
+    // time while an ordinary fault in the same binary leaves a complete one,
+    // which reads as the process running out of memory rather than touching a
+    // bad pointer -- and nothing so far has actually measured that.
+    //
+    // size_user is the budget the app allocates from. phycont is separate and
+    // small, and worth watching because the framebuffer lives there.
+    SceKernelFreeMemorySizeInfo mem;
+    mem.size = sizeof(mem);
+    if (sceKernelGetFreeMemorySize(&mem) >= 0) {
+      const HeapSample heap = HeapNow();
+      VLog("flutter-vita: present #%u row_bytes=%u height=%u "
+           "heap=%uM/%uM (mallinfo %u us) free user=%dK cdram=%dK "
+           "phycont=%dK\n",
+           frames, static_cast<unsigned>(row_bytes),
+           static_cast<unsigned>(height), heap.used_mb, heap.arena_mb,
+           heap.cost_us, mem.size_user / 1024, mem.size_cdram / 1024,
+           mem.size_phycont / 1024);
+    } else {
+      VLog("flutter-vita: present #%u row_bytes=%u height=%u\n", frames,
+           static_cast<unsigned>(row_bytes),
+           static_cast<unsigned>(height));
+    }
+  }
+  frames++;
+
+  {
+    const uint64_t now = sceKernelGetSystemTimeWide();
+    if (g_touch_down_us != 0) {
+      VLog("flutter-vita: LATENCY touch->present %u us\n",
+           static_cast<unsigned>(now - g_touch_down_us));
+      g_touch_down_us = 0;
+    }
+    if (g_last_present_us != 0) {
+      const uint64_t gap = now - g_last_present_us;
+      if (gap > g_win_max_gap_us) g_win_max_gap_us = gap;
+      if (gap > g_hud_max_gap_us) g_hud_max_gap_us = gap;
+      // One line per stutter, with the split that says whose fault it was.
+      //
+      // raster is this thread's own work. wait is how long the raster thread
+      // sat idle before being handed the frame, which under GL is the UI
+      // thread plus scheduling -- so a spike with small raster and large wait
+      // is Dart building a screen, and no renderer change will touch it.
+      if (gap > kJankUs) {
+        VLog("flutter-vita: JANK frame #%u gap %u us "
+             "(raster %u us, wait %u us)\n",
+             static_cast<unsigned>(g_frame_index),
+             static_cast<unsigned>(gap),
+             static_cast<unsigned>(g_last_raster_us),
+             static_cast<unsigned>(g_last_idle_us));
+      }
+      if (gap > kIdleGapUs) {
+        g_win_idle++;
+      } else {
+        g_win_active_us += gap;
+        g_win_active++;
+        g_hud_active_us += gap;
+        g_hud_active++;
+      }
+      g_win_frames++;
+      g_hud_frames++;
+    }
+    if (g_win_first_us == 0) g_win_first_us = now;
+    g_last_present_us = now;
+    g_frame_index++;
+  }
+}
+
+// The 60-frame rolling report, shared by both backends.
+//
+// The columns mean slightly different things per backend, and the difference
+// is worth knowing before reading a number off:
+//
+//   raster  software: the rasterizer's own report, via patch 0008's observer.
+//           GL: make_current to present, so GL command submission -- the GPU
+//           may still be busy when present is entered.
+//   blit    software: the present memcpy. GL: the layer's swap, which is
+//           mostly the wait for vblank and for the GPU to finish.
+//   dmg     software only. The GL path does no partial repaint yet.
+//
+// `active` is the same measurement on both, and is vsync-limited under GL --
+// it saturates at 60 and says nothing beyond "this frame fitted".
+void ReportFrameWindow() {
+if (g_win_frames >= 60) {
+  // Two numbers, because they answer different questions.
+  //
+  // `active` is the rendering rate: mean gap over frames that followed
+  // another frame promptly. That is the figure to optimise and the figure to
+  // quote.
+  //
+  // `blit%` is the share of an active frame spent in the present memcpy, and
+  // it is the whole reason this instrument exists. Phase 0.5 measured that
+  // memcpy at 8.06 ms and ADR-0007 built its case on it. If the share is
+  // small, a GPU backend removes a small thing and the remaining time is
+  // Dart, layout and Skia; if it is large, ADR-0007's damage tracking is the
+  // answer. Guessing between those without this number is how optimisation
+  // budgets get spent on the wrong half.
+  const unsigned active_us =
+      g_win_active != 0 ? static_cast<unsigned>(g_win_active_us / g_win_active)
+                        : 0;
+  const unsigned blit_us =
+      static_cast<unsigned>(g_win_blit_us / g_win_frames);
+  //
+  // `dmg` is the share of the screen the rasterizer said actually changed,
+  // averaged over the window. It is what decides whether partial repaint is
+  // doing anything: at 100% the app repaints everything every frame and the
+  // clip is pure overhead, and any fps that a GPU backend would buy has to
+  // come from somewhere other than painting less.
+  const unsigned dmg_pct = static_cast<unsigned>(
+      g_win_damage_px / g_win_frames * 100 / (kWidth * kHeight));
+  //
+  // `raster` is the third share, and the one that decides the GPU question.
+  // An active frame is raster + blit + everything else, where everything
+  // else is the UI thread and any wait. Reporting all three means the answer
+  // never has to be inferred from the damage rectangle again -- which was
+  // tried, and does not work, because area is not work.
+  const unsigned raster_us =
+      static_cast<unsigned>(g_win_raster_us / g_win_frames);
+  // The GL backend's own counters, when it has any (flutter_vita_gl.h).
+  char gl_stats[256] = "";
+  if (g_gl_enabled) flutter_vita_gl_stats(gl_stats, sizeof gl_stats);
+  const unsigned log_us = static_cast<unsigned>(g_win_log_us);
+  const unsigned log_max_us = static_cast<unsigned>(g_win_log_max_us);
+  g_win_log_us = 0;
+  g_win_log_max_us = 0;
+  VLog("flutter-vita: FRAMES active %u @ %u us = %u.%02u fps "
+       "(raster %u us = %u%%, blit %u us = %u%%, dmg %u%%, hud %u us) "
+       "| raster max %u us | idle gaps %u | max %u ms | gl wait %u us "
+       "| log %u us max %u dropped %u%s%s\n",
+       g_win_active, active_us,
+       active_us != 0 ? 1000000u / active_us : 0,
+       active_us != 0 ? (100000000u / active_us) % 100 : 0, raster_us,
+       active_us != 0 ? raster_us * 100 / active_us : 0, blit_us,
+       active_us != 0 ? blit_us * 100 / active_us : 0, dmg_pct,
+       static_cast<unsigned>(g_win_hud_us / g_win_frames),
+       static_cast<unsigned>(g_win_raster_max_us), g_win_idle,
+       static_cast<unsigned>(g_win_max_gap_us / 1000),
+       static_cast<unsigned>(g_win_gl_idle_us / g_win_frames), log_us,
+       log_max_us, g_log_dropped, gl_stats[0] ? " | " : "", gl_stats);
+  g_win_frames = 0;
+  g_win_blit_us = 0;
+  g_win_raster_us = 0;
+  g_win_raster_max_us = 0;
+  g_win_damage_px = 0;
+  g_win_hud_us = 0;
+  g_win_max_gap_us = 0;
+  g_win_gl_idle_us = 0;
+  g_win_active_us = 0;
+  g_win_active = 0;
+  g_win_idle = 0;
+  g_win_first_us = 0;
+}
+}
+// --------------------------------------------------------------------------
+// The stall watchdog
+// --------------------------------------------------------------------------
+//
+// Every other instrument in this file reports from the present path, which is
+// fine right up until the thing that goes wrong is that presents stop. Then
+// the instrument and the fault share a thread, the log ends mid-sentence, and
+// what is left behind is a frame rate that trails off to nothing and no reason
+// -- which is the 08-31 localsend stall, still open, and by the user's account
+// the ordinary way a GPU app dies here rather than a localsend peculiarity.
+//
+// This reports from the platform loop instead. That thread waits on vblank,
+// drains platform tasks, touches no GL, and held perfect 16.6 ms cadence right
+// through the stall, so it is the one place in the process that is still
+// running when the screen freezes.
+//
+// What it prints is picked to separate the three explanations a frozen screen
+// cannot be told apart from outside:
+//
+//   * the UI thread has stopped producing layer trees -- parked in a wait,
+//     runClocks flat, raster idle behind it;
+//   * the UI thread is busy -- runClocks climbing with nothing on screen;
+//   * the raster thread is stuck below Skia -- `phase` says which call it went
+//     into, and runClocks says whether it is spinning or blocked.
+//
+// sceKernelGetThreadInfo answers all three for any thread in the process:
+// status, what it is waiting on, and how many cycles it has burned. No
+// debugger, no kernel plugin, and nothing that has to be running beforehand.
+
+// Where the raster thread is in a frame. Read during a stall, when the thread
+// that sets it is by definition not the thread reading it.
+enum RasterPhase : uint32_t {
+  kPhaseIdle = 0,     // between frames, waiting to be handed one
+  kPhaseDraw,         // make_current returned; Skia is submitting
+  kPhasePresent,      // present entered; command submission done
+  kPhaseSwap,         // inside the layer's swap -- vblank and the GPU
+  kPhaseCopy,         // software path: the framebuffer memcpy
+};
+const char* kPhaseNames[] = {"idle", "draw", "present", "swap", "copy"};
+std::atomic<uint32_t> g_raster_phase{kPhaseIdle};
+std::atomic<uint64_t> g_raster_phase_us{0};
+
+void EnterPhase(RasterPhase phase) {
+  g_raster_phase_us.store(sceKernelGetSystemTimeWide(),
+                          std::memory_order_relaxed);
+  g_raster_phase.store(phase, std::memory_order_release);
+}
+
+// The threads to ask about.
+//
+// The kernel names every pthread "pthread", which is why a crash dump lists
+// six of them and says nothing about which is the UI thread. fml announces its
+// own through flutter_vita_log_affinity, so that name is kept here alongside
+// the uid; everything else -- the display queue, SceNet's workers -- arrives
+// through the process-wide thread event handler with
+// whatever the kernel calls it.
+constexpr int kMaxWatched = 48;
+
+struct WatchedThread {
+  std::atomic<SceUID> uid;   // 0 means the slot is free
+  char label[24];            // fml's name, when there is one
+  uint64_t run_clocks;       // at the previous sample
+  uint32_t preempts;         // ditto
+};
+WatchedThread g_watched[kMaxWatched];
+std::atomic<int> g_watched_used{0};
+
+// Called from a thread event handler, so: atomics only, no allocation, no
+// logging, and nothing that can block.
+void NoteThread(SceUID uid, const char* label) {
+  if (uid <= 0) return;
+  const int used = g_watched_used.load(std::memory_order_acquire);
+  for (int i = 0; i < used; i++) {
+    if (g_watched[i].uid.load(std::memory_order_acquire) != uid) continue;
+    if (label != nullptr) {
+      std::snprintf(g_watched[i].label, sizeof g_watched[i].label, "%s", label);
+    }
+    return;
+  }
+  // A free slot from an exited thread first, then the end of the array.
+  for (int i = 0; i < used; i++) {
+    SceUID empty = 0;
+    if (!g_watched[i].uid.compare_exchange_strong(empty, uid,
+                                                  std::memory_order_acq_rel)) {
+      continue;
+    }
+    g_watched[i].label[0] = '\0';
+    if (label != nullptr) {
+      std::snprintf(g_watched[i].label, sizeof g_watched[i].label, "%s", label);
+    }
+    g_watched[i].run_clocks = 0;
+    g_watched[i].preempts = 0;
+    return;
+  }
+  const int slot = g_watched_used.fetch_add(1, std::memory_order_acq_rel);
+  if (slot >= kMaxWatched) {
+    g_watched_used.store(kMaxWatched, std::memory_order_release);
+    return;
+  }
+  g_watched[slot].label[0] = '\0';
+  if (label != nullptr) {
+    std::snprintf(g_watched[slot].label, sizeof g_watched[slot].label, "%s",
+                  label);
+  }
+  g_watched[slot].run_clocks = 0;
+  g_watched[slot].preempts = 0;
+  g_watched[slot].uid.store(uid, std::memory_order_release);
+}
+
+void ForgetThread(SceUID uid) {
+  const int used = g_watched_used.load(std::memory_order_acquire);
+  for (int i = 0; i < used; i++) {
+    SceUID held = uid;
+    if (g_watched[i].uid.compare_exchange_strong(held, 0,
+                                                 std::memory_order_acq_rel)) {
+      return;
+    }
+  }
+}
+
+int ThreadEvent(SceInt32 type, SceUID thid, SceInt32 /* arg */,
+                void* /* common */) {
+  if (type == SCE_KERNEL_THREAD_EVENT_TYPE_START) {
+    NoteThread(thid, nullptr);
+  } else if (type == SCE_KERNEL_THREAD_EVENT_TYPE_EXIT) {
+    ForgetThread(thid);
+  }
+  return 0;
+}
+
+const char* StatusName(SceUInt32 status) {
+  if (status & SCE_THREAD_RUNNING) return "run";
+  if (status & SCE_THREAD_READY) return "ready";
+  if (status & SCE_THREAD_STANDBY) return "standby";
+  if (status & SCE_THREAD_WAITING) return "wait";
+  if (status & SCE_THREAD_DORMANT) return "dormant";
+  if (status & SCE_THREAD_DELETED) return "killed";
+  if (status & SCE_THREAD_DEAD) return "dead";
+  if (status & 256) return "susp";
+  return "?";
+}
+
+// waitType is a threadmgr UID class: the kind of object the thread is parked
+// on. Naming it is the difference between "blocked" and "blocked on a
+// semaphore somebody else holds".
+const char* WaitName(SceUInt32 type) {
+  switch (type) {
+    case SCE_KERNEL_TMID_Semaphore: return "sema";
+    case SCE_KERNEL_TMID_EventFlag: return "evf";
+    case SCE_KERNEL_TMID_Mbox: return "mbox";
+    case SCE_KERNEL_TMID_Vpl: return "vpl";
+    case SCE_KERNEL_TMID_Fpl: return "fpl";
+    case SCE_KERNEL_TMID_Mpipe: return "mpipe";
+    case SCE_KERNEL_TMID_Callback: return "cb";
+    case SCE_KERNEL_TMID_SleepThread: return "sleep";
+    case SCE_KERNEL_TMID_DelayThread: return "delay";
+    case SCE_KERNEL_TMID_SuspendThread: return "suspend";
+    case SCE_KERNEL_TMID_DormantThread: return "dormant";
+    case 0: return "-";
+    default: return "obj";
+  }
+}
+
+// A backtrace for a thread that is not this one.
+//
+// Nothing on this console can ask another thread where it is. There is no
+// ptrace, no kernel plugin (and there will not be one), and the crash dump --
+// the only thing that has ever produced a thread list here -- needs the
+// process to be dying first. A stall is the case where it is not.
+//
+// So: read the thread's stack out of our own address space, which is the same
+// address space, and pick out the values that look like return addresses.
+// sceKernelGetThreadStackFreeSize gives the live portion, so this scans the
+// frames that are actually there rather than the whole megabyte of history
+// underneath them.
+//
+// "Looks like a return address" is: odd, because every function in this build
+// is Thumb and bit 0 is the interworking bit, and inside the range user
+// modules load into. System modules live up at 0xE0000000 and are excluded --
+// they would be the more interesting half if they could be symbolicated, and
+// they cannot.
+//
+// It is a heuristic and it prints stale frames alongside live ones. It is also
+// the difference between "io.flutter.ui is waiting on something" and knowing
+// what it called to get there.
+constexpr uintptr_t kUserTextLo = 0x81000000u;
+constexpr uintptr_t kUserTextHi = 0x88000000u;
+constexpr int kMaxFrames = 14;
+
+// The registers of a thread that is not this one, or false.
+//
+// Tried live first. If the kernel wants the thread parked for it, park it
+// for the read and let it go: a thread that is waiting does not notice, and a
+// thread that is spinning loses a few microseconds. `err` keeps the last
+// refusal so the report can say why a thread has no pc.
+bool ReadThreadRegisters(SceUID uid, VitaCpuRegisters* cpu, int* err) {
+  std::memset(cpu, 0, sizeof *cpu);
+  cpu->size = sizeof *cpu;
+  VitaVfpRegisters vfp;
+  std::memset(&vfp, 0, sizeof vfp);
+  vfp.size = sizeof vfp;
+  int r = sceKernelGetThreadContextForVM(uid, cpu, &vfp);
+  if (r < 0) {
+    // The user-side wrapper refused (0x8002710B, NO_MEMORY, on 2026-09-13,
+    // for every thread). The syscall behind it, and once more with the
+    // thread parked, before giving up.
+    cpu->size = sizeof *cpu;
+    r = _sceKernelGetThreadContextForVM(uid, cpu, &vfp);
+  }
+  if (r < 0) {
+    const int s = sceKernelSuspendThreadForVM(uid);
+    if (s >= 0) {
+      cpu->size = sizeof *cpu;
+      vfp.size = sizeof vfp;
+      r = sceKernelGetThreadContextForVM(uid, cpu, &vfp);
+      if (r < 0) r = _sceKernelGetThreadContextForVM(uid, cpu, &vfp);
+      sceKernelResumeThreadForVM(uid);
+    } else if (err != nullptr) {
+      *err = s;
+      return false;
+    }
+  }
+  if (err != nullptr) *err = r;
+  return r >= 0;
+}
+
+int ScanStack(const SceKernelThreadInfo& info, SceUID uid, uintptr_t* out,
+              int* reported_free, uintptr_t sp_hint) {
+  const uintptr_t base = reinterpret_cast<uintptr_t>(info.stack);
+  const uintptr_t top = base + static_cast<uintptr_t>(info.stackSize);
+  if (reported_free != nullptr) *reported_free = 0;
+  if (base == 0 || info.stackSize <= 0) return 0;
+
+  // Free space is measured from the base, and the stack grows down towards it,
+  // so base + free is where this thread's live frames start.
+  const int free_bytes = sceKernelGetThreadStackFreeSize(uid);
+  if (reported_free != nullptr) *reported_free = free_bytes;
+  uintptr_t sp;
+  if (sp_hint >= base && sp_hint < top) {
+    // The real one, from the thread's registers. Everything above it is live.
+    sp = sp_hint;
+  } else if (free_bytes > 0 &&
+             static_cast<uintptr_t>(free_bytes) < info.stackSize) {
+    sp = base + static_cast<uintptr_t>(free_bytes);
+  } else {
+    // The call is documented but not promised for a thread that is not this
+    // one. Without it the live region is unknown, so take the top 32 KB: deep
+    // enough for any frame stack this port produces, shallow enough that the
+    // scan is mostly live rather than mostly history.
+    const uintptr_t window = 32u * 1024u;
+    sp = info.stackSize > static_cast<SceInt32>(window) ? top - window : base;
+  }
+  sp &= ~static_cast<uintptr_t>(3);
+  if (sp < base || sp >= top) return 0;
+
+  int n = 0;
+  uintptr_t last = 0;
+  for (uintptr_t a = sp; a < top && n < kMaxFrames; a += 4) {
+    const uintptr_t v = *reinterpret_cast<const uintptr_t*>(a);
+    if ((v & 1) == 0) continue;
+    if (v < kUserTextLo || v >= kUserTextHi) continue;
+    // Consecutive duplicates are one frame's address spilled twice, not two
+    // frames.
+    if (v == last) continue;
+    last = v;
+    out[n++] = v;
+  }
+  return n;
+}
+
+// Is the UI thread taking work? A platform message is a task on the UI
+// thread and its reply is a task back on this one, and neither depends on a
+// frame being scheduled or on a dart:io timer firing -- so a reply says the
+// UI thread runs, and no reply for seconds says it is wedged, whatever the
+// screen shows. One is sent a second, once a frame has ever been presented.
+// The reply comes from the framework's `flutter/navigation` handler, which
+// answers an unknown method with null; no app code is involved.
+uint64_t g_hb_sent_us = 0;     // the outstanding heartbeat, 0 if none
+uint64_t g_hb_reply_us = 0;    // when the last reply landed
+uint64_t g_hb_rtt_us = 0;      // its round trip
+uint64_t g_hb_rtt_max_us = 0;  // the slowest round trip so far
+uint32_t g_hb_replies = 0;
+
+// Where each thread last went to sleep.
+//
+// The kernel will not say where another thread is (see ScanStack), so the
+// threads say it themselves: a dev build wraps the blocking kernel calls at
+// link time (templates/vita-app/waits.c, `-Wl,--wrap=sceKernelWaitSema` and
+// friends) and every wait records its caller, the object, and -- the part
+// that makes the stack scan exact -- the stack pointer at the moment of the
+// wait. Frames above that pointer are live by construction. A release build
+// links no wrappers and this table stays empty.
+// Waits nest: a Dart monitor wait is a pthread condvar wait is a pte
+// semaphore wait is sceKernelWaitSema, and each wrapped level records
+// itself. The outermost level names the reason, the innermost the stack
+// pointer to scan from, so a thread keeps a short stack of them.
+constexpr int kWaitDepth = 4;
+struct WaitLevel {
+  uint8_t kind = 0;
+  uint32_t object = 0;
+  uintptr_t caller = 0;
+  uintptr_t sp = 0;
+  uint64_t since_us = 0;
+};
+struct WaitNote {
+  std::atomic<SceUID> uid{0};
+  std::atomic<int> depth{0};
+  // The thread's stack, so a wait can find its own note from its stack
+  // pointer without asking the kernel who it is. pthreads-embedded polls a
+  // blocked semaphore every 500 us (pte_osSemaphoreCancellablePend, seen in
+  // the disassembly on 2026-09-13), so every parked pthread passes through
+  // here two thousand times a second, and a syscall per pass was a
+  // measurable share of a frame.
+  uintptr_t stack_lo = 0;
+  uintptr_t stack_hi = 0;
+  WaitLevel level[kWaitDepth];
+  WaitLevel last;  // the outermost level of the previous wait
+  uint32_t count = 0;
+};
+constexpr int kMaxWaitNotes = 40;
+WaitNote g_waits[kMaxWaitNotes];
+
+const char* WaitKindName(int kind) {
+  switch (kind) {
+    case 1: return "sema";
+    case 2: return "evf";
+    case 3: return "mutex";
+    case 4: return "lwmutex";
+    case 5: return "cond";
+    case 6: return "lwcond";
+    case 7: return "signal";
+    case 8: return "delay";
+    case 9: return "dart-monitor";
+    case 10: return "std-condvar";
+    default: return "?";
+  }
+}
+
+WaitNote* WaitNoteByUid(SceUID uid) {
+  for (int i = 0; i < kMaxWaitNotes; i++) {
+    if (g_waits[i].uid.load(std::memory_order_acquire) == uid) return &g_waits[i];
+  }
+  // First wait on this thread: claim an empty slot, or one whose thread is
+  // gone. Dart's pool workers come and go, and forty slots would otherwise
+  // fill over a long run.
+  for (int pass = 0; pass < 2; pass++) {
+    for (int i = 0; i < kMaxWaitNotes; i++) {
+      SceUID have = g_waits[i].uid.load(std::memory_order_acquire);
+      if (pass == 1 && have != 0) {
+        SceKernelThreadInfo info;
+        std::memset(&info, 0, sizeof info);
+        info.size = sizeof info;
+        if (sceKernelGetThreadInfo(have, &info) >= 0) continue;
+        if (!g_waits[i].uid.compare_exchange_strong(have, uid)) continue;
+        return &g_waits[i];
+      }
+      if (have == 0 && g_waits[i].uid.compare_exchange_strong(have, uid)) {
+        return &g_waits[i];
+      }
+    }
+  }
+  return nullptr;
+}
+
+// The calling thread's note, found by its stack pointer. The kernel is asked
+// only for a thread this table has not seen, and once in a while after
+// that, in case a thread ended and another one inherited its stack.
+WaitNote* WaitNoteFor(uintptr_t sp) {
+  for (int i = 0; i < kMaxWaitNotes; i++) {
+    WaitNote& w = g_waits[i];
+    if (sp >= w.stack_lo && sp < w.stack_hi &&
+        w.uid.load(std::memory_order_acquire) != 0) {
+      if ((w.count & 1023u) != 0) return &w;
+      // Revalidate: same thread still?
+      if (w.uid.load(std::memory_order_relaxed) == sceKernelGetThreadId()) {
+        return &w;
+      }
+      w.stack_lo = w.stack_hi = 0;
+      break;
+    }
+  }
+  const SceUID uid = sceKernelGetThreadId();
+  WaitNote* w = WaitNoteByUid(uid);
+  if (w == nullptr) return nullptr;
+  if (w->stack_lo == 0) {
+    SceKernelThreadInfo info;
+    std::memset(&info, 0, sizeof info);
+    info.size = sizeof info;
+    if (sceKernelGetThreadInfo(uid, &info) >= 0 && info.stack != nullptr) {
+      w->stack_lo = reinterpret_cast<uintptr_t>(info.stack);
+      w->stack_hi = w->stack_lo + static_cast<uintptr_t>(info.stackSize);
+    }
+  }
+  return w;
+}
+
+const WaitNote* WaitNoteOf(SceUID uid) {
+  for (int i = 0; i < kMaxWaitNotes; i++) {
+    if (g_waits[i].uid.load(std::memory_order_acquire) == uid) return &g_waits[i];
+  }
+  return nullptr;
+}
+
+// One buffer, because both callers want the same text and neither wants to own
+// it: the platform loop prints it, and the dev server's `diag` returns it.
+std::mutex g_diag_mutex;
+char g_diag_text[16384];
+uint64_t g_diag_last_us = 0;      // when the last sample was taken
+uint64_t g_sys_idle_us[4] = {0};  // per-CPU idle clocks at that sample
+uint32_t g_sys_switches = 0;
+
+// Fill g_diag_text with everything known about why nothing is moving.
+//
+// Deltas are against the previous call, so two calls a few seconds apart are
+// worth far more than one: a thread that is merely parked and a thread that is
+// spinning look identical in a single sample and completely different across
+// two.
+void BuildDiag(const char* why, uint64_t since_present_us) {
+  const uint64_t now = sceKernelGetSystemTimeWide();
+  const uint64_t window_us = g_diag_last_us != 0 ? now - g_diag_last_us : 0;
+  int n = 0;
+  const int cap = static_cast<int>(sizeof g_diag_text);
+
+  // Every runtime address below is relative to wherever the kernel loaded this
+  // module, which is not the ELF's vaddr -- 0x8104b000 against 0x81000000 on
+  // 2026-08-31. Printing the runtime address of one known symbol lets the host
+  // subtract: elf = runtime - anchor + nm(BuildDiag). Cheaper than asking the
+  // kernel for a module list, and it cannot go stale.
+  n += std::snprintf(g_diag_text + n, cap - n,
+                     "flutter-vita:   anchor BuildDiag=0x%08X%s\n",
+                     static_cast<unsigned>(
+                         reinterpret_cast<uintptr_t>(&BuildDiag)),
+                     g_diag_last_us == 0 ? "  (first sample: deltas below are"
+                                           " since launch, not a window)"
+                                         : "");
+  n += std::snprintf(g_diag_text + n, cap - n,
+                     "flutter-vita: %s %u ms since present #%u"
+                     " -- raster phase %s for %u ms, loop iter %u\n",
+                     why, static_cast<unsigned>(since_present_us / 1000),
+                     static_cast<unsigned>(g_frame_index),
+                     kPhaseNames[g_raster_phase.load(std::memory_order_acquire)
+                                 % 5],
+                     static_cast<unsigned>(
+                         (now - g_raster_phase_us.load(
+                                    std::memory_order_acquire)) / 1000),
+                     static_cast<unsigned>(g_loop_iterations));
+
+  SceKernelFreeMemorySizeInfo mem;
+  mem.size = sizeof(mem);
+  if (sceKernelGetFreeMemorySize(&mem) >= 0) {
+    n += std::snprintf(g_diag_text + n, cap - n,
+                       "flutter-vita:   mem user=%dK cdram=%dK phycont=%dK"
+                       " heap=%uM/%uM\n",
+                       mem.size_user / 1024, mem.size_cdram / 1024,
+                       mem.size_phycont / 1024, HeapUsedMb(), HeapArenaMb());
+  }
+
+  if (g_hb_reply_us != 0 || g_hb_sent_us != 0) {
+    n += std::snprintf(g_diag_text + n, cap - n,
+                       "flutter-vita:   ui thread: heartbeat replies %u,"
+                       " last %u ms ago, rtt %u us, max %u us",
+                       static_cast<unsigned>(g_hb_replies),
+                       static_cast<unsigned>(
+                           g_hb_reply_us != 0 ? (now - g_hb_reply_us) / 1000
+                                              : 0),
+                       static_cast<unsigned>(g_hb_rtt_us),
+                       static_cast<unsigned>(g_hb_rtt_max_us));
+    if (g_hb_sent_us != 0) {
+      n += std::snprintf(g_diag_text + n, cap - n,
+                         " -- NO REPLY for %u ms",
+                         static_cast<unsigned>((now - g_hb_sent_us) / 1000));
+    }
+    n += std::snprintf(g_diag_text + n, cap - n, "\n");
+  }
+
+  // Whether the console is idle or busy, independent of this process. A stall
+  // with all four cores idle is a wait; one with a core pinned is a spin, and
+  // the thread table below says whose.
+  SceKernelSystemInfo sys;
+  std::memset(&sys, 0, sizeof sys);
+  sys.size = sizeof(sys);
+  if (sceKernelGetSystemInfo(&sys) >= 0) {
+    n += std::snprintf(g_diag_text + n, cap - n, "flutter-vita:   cpu idle");
+    for (int c = 0; c < 4; c++) {
+      const uint64_t idle = sys.cpuInfo[c].idleClock;
+      const uint64_t d = idle - g_sys_idle_us[c];
+      n += std::snprintf(g_diag_text + n, cap - n, " %u%%",
+                         window_us != 0
+                             ? static_cast<unsigned>(d * 100 / window_us)
+                             : 0u);
+      g_sys_idle_us[c] = idle;
+    }
+    const uint32_t sw = sys.cpuInfo[0].threadSwitchCount +
+                        sys.cpuInfo[1].threadSwitchCount +
+                        sys.cpuInfo[2].threadSwitchCount +
+                        sys.cpuInfo[3].threadSwitchCount;
+    n += std::snprintf(g_diag_text + n, cap - n, " switches +%u over %u ms\n",
+                       static_cast<unsigned>(sw - g_sys_switches),
+                       static_cast<unsigned>(window_us / 1000));
+    g_sys_switches = sw;
+  }
+
+  const int used = g_watched_used.load(std::memory_order_acquire);
+  for (int i = 0; i < used && n < cap - 128; i++) {
+    const SceUID uid = g_watched[i].uid.load(std::memory_order_acquire);
+    if (uid == 0) continue;
+    SceKernelThreadInfo info;
+    std::memset(&info, 0, sizeof info);
+    info.size = sizeof(info);
+    if (sceKernelGetThreadInfo(uid, &info) < 0) continue;
+
+    // The delta over the window is the whole point: zero means parked, and a
+    // figure near the window length means one thread is eating a core with
+    // nothing to show for it.
+    //
+    // The unit is printed without one. SceKernelSysClock is microseconds
+    // everywhere else in this SDK, and if runClocks follows that then the
+    // percentage beside it is a CPU share; if it is really cycles at 444 MHz
+    // the percentage will read in the tens of thousands and say so plainly.
+    // The first report off the console settles it, and a wrong unit in a log
+    // is worse than no unit.
+    const uint64_t clocks = static_cast<uint64_t>(info.runClocks);
+    const uint64_t ran = clocks - g_watched[i].run_clocks;
+    g_watched[i].run_clocks = clocks;
+    const uint32_t preempts = info.threadPreemptCount - g_watched[i].preempts;
+    g_watched[i].preempts = info.threadPreemptCount;
+
+    n += std::snprintf(
+        g_diag_text + n, cap - n,
+        "flutter-vita:   thr %-18s 0x%08X %-7s %s(%u):0x%08X ran +%u us"
+        " (%u%%) pre +%u cpu %d entry 0x%08X\n",
+        g_watched[i].label[0] != '\0' ? g_watched[i].label : info.name,
+        static_cast<unsigned>(uid), StatusName(info.status),
+        WaitName(info.waitType), static_cast<unsigned>(info.waitType),
+        static_cast<unsigned>(info.waitId),
+        static_cast<unsigned>(ran),
+        window_us != 0 ? static_cast<unsigned>(ran * 100 / window_us) : 0u,
+        static_cast<unsigned>(preempts),
+        static_cast<int>(info.lastExecutedCpuId),
+        static_cast<unsigned>(reinterpret_cast<uintptr_t>(info.entry)));
+
+    // Its registers, unless it is this thread: our own pc would be here.
+    VitaCpuRegisters regs;
+    int regs_err = 0;
+    const bool have_regs =
+        uid != sceKernelGetThreadId() && ReadThreadRegisters(uid, &regs, &regs_err);
+
+    // Where it said it went to sleep, if the build's wrappers told us:
+    // every level, outermost first, so the line reads as the reason and
+    // then the mechanism. The age is clamped: pte polls its semaphores
+    // about every half millisecond, so the innermost level's since_us can
+    // be newer than `now` above; the outermost level's is the real one.
+    const WaitNote* note = WaitNoteOf(uid);
+    uintptr_t sp_hint = have_regs ? regs.reg[13] : 0;
+    const int depth =
+        note != nullptr ? note->depth.load(std::memory_order_acquire) : 0;
+    if (depth > 0 && n < cap - 256) {
+      const int levels = depth < kWaitDepth ? depth : kWaitDepth;
+      sp_hint = note->level[levels - 1].sp;
+      const uint64_t since = note->level[0].since_us;
+      n += std::snprintf(g_diag_text + n, cap - n,
+                         "flutter-vita:     in (%u ms, wait #%u)",
+                         static_cast<unsigned>(
+                             now > since ? (now - since) / 1000 : 0),
+                         note->count);
+      for (int l = 0; l < levels && n < cap - 48; l++) {
+        n += std::snprintf(g_diag_text + n, cap - n, "%s %s 0x%08X from %08X",
+                           l == 0 ? "" : " >", WaitKindName(note->level[l].kind),
+                           note->level[l].object,
+                           static_cast<unsigned>(note->level[l].caller));
+      }
+      n += std::snprintf(g_diag_text + n, cap - n, "\n");
+    } else if (note != nullptr && note->count != 0 && n < cap - 128) {
+      n += std::snprintf(g_diag_text + n, cap - n,
+                         "flutter-vita:     last %s 0x%08X %u ms ago from %08X"
+                         " (wait #%u)\n",
+                         WaitKindName(note->last.kind), note->last.object,
+                         static_cast<unsigned>(
+                             now > note->last.since_us
+                                 ? (now - note->last.since_us) / 1000
+                                 : 0),
+                         static_cast<unsigned>(note->last.caller), note->count);
+    }
+
+    uintptr_t frames[kMaxFrames];
+    int reported_free = 0;
+    const int frame_count =
+        ScanStack(info, uid, frames, &reported_free, sp_hint);
+    if (n < cap - 96) {
+      n += std::snprintf(g_diag_text + n, cap - n,
+                         "flutter-vita:     stk 0x%08X+%u free %d frames %d\n",
+                         static_cast<unsigned>(
+                             reinterpret_cast<uintptr_t>(info.stack)),
+                         static_cast<unsigned>(info.stackSize), reported_free,
+                         frame_count);
+    }
+    if (n < cap - 96) {
+      if (have_regs) {
+        n += std::snprintf(g_diag_text + n, cap - n,
+                           "flutter-vita:     pc %08X lr %08X sp %08X\n",
+                           static_cast<unsigned>(regs.reg[15]),
+                           static_cast<unsigned>(regs.reg[14]),
+                           static_cast<unsigned>(regs.reg[13]));
+      } else if (uid != sceKernelGetThreadId()) {
+        n += std::snprintf(g_diag_text + n, cap - n,
+                           "flutter-vita:     regs refused 0x%08X\n",
+                           static_cast<unsigned>(regs_err));
+      }
+    }
+    if (frame_count > 0 && n < cap - 128) {
+      n += std::snprintf(g_diag_text + n, cap - n, "flutter-vita:     at");
+      for (int f = 0; f < frame_count && n < cap - 16; f++) {
+        n += std::snprintf(g_diag_text + n, cap - n, " %08X",
+                           static_cast<unsigned>(frames[f]));
+      }
+      n += std::snprintf(g_diag_text + n, cap - n, "\n");
+    }
+  }
+  g_diag_last_us = now;
+}
+
+// Called once per platform-loop iteration, which is once per vblank.
+//
+// Cheap in the common case: one comparison against a timestamp the present
+// path already maintains. The expensive part -- forty-odd sceKernelGetThreadInfo
+// calls -- only runs when the screen has already been frozen for two seconds,
+// at which point nothing else is competing for the CPU anyway.
+constexpr uint64_t kStallUs = 2 * 1000 * 1000;
+constexpr uint64_t kStallRepeatUs = 5 * 1000 * 1000;
+
+uint64_t g_stall_reported_us = 0;
+unsigned g_stall_reports = 0;
+
+void CheckForStall() {
+  if (g_last_present_us == 0) return;  // nothing has ever been presented
+  const uint64_t now = sceKernelGetSystemTimeWide();
+  const uint64_t since = now - g_last_present_us;
+
+  // A screen with nothing to draw is not a stall. The gallery never sits
+  // still, so this test was enough for it; wonderous parks on a static
+  // wonder for as long as nobody touches it, and the first run on
+  // fvita_gles2 filled its log with ten reports of a raster thread that was
+  // idle because it had been given nothing. With the raster idle and the UI
+  // thread answering its heartbeat, the app is waiting for input, and
+  // CheckUiThread below owns the other case.
+  const bool nothing_to_draw =
+      g_raster_phase.load(std::memory_order_acquire) == kPhaseIdle &&
+      g_hb_reply_us != 0 && now - g_hb_reply_us < kStallUs;
+  if (since < kStallUs || nothing_to_draw) {
+    if (g_stall_reports != 0) {
+      VLog("flutter-vita: UNSTALLED after %u ms and %u reports\n",
+           static_cast<unsigned>(g_stall_reported_us != 0
+                                     ? (now - g_stall_reported_us) / 1000
+                                     : 0),
+           g_stall_reports);
+      g_stall_reports = 0;
+      g_stall_reported_us = 0;
+    }
+    return;
+  }
+
+  if (g_stall_reported_us != 0 && now - g_stall_reported_us < kStallRepeatUs) {
+    return;
+  }
+  // Ten reports is fifty seconds of evidence. Past that the app is not coming
+  // back and the log is just growing, and an unbuffered write per line on a
+  // memory card is not free.
+  if (g_stall_reports >= 10) return;
+
+  std::lock_guard<std::mutex> lock(g_diag_mutex);
+  BuildDiag("STALL", since);
+  // Not VLog: its buffer is 512 bytes and a report is thousands, which cut
+  // every line after the third one straight through the middle.
+  VLogRaw(g_diag_text, std::strlen(g_diag_text));
+  g_stall_reported_us = now;
+  g_stall_reports++;
+}
+
+// |SoftwareSurfacePresentCallback|
+bool PresentSurface(void* /* user_data */,
+                    const void* allocation,
+                    size_t row_bytes,
+                    size_t height) {
+  EnterPhase(kPhaseCopy);
+  NotePresent(row_bytes, height);
+
+  if (g_display.base == nullptr) {
+    g_display_stale = true;
+    return false;
+  }
+
+  // Hold the frame while a common dialog is up, and do not copy it.
+  //
+  // This copy covers the whole framebuffer, so a Flutter frame lands straight
+  // on top of the keyboard the shell drew there -- which is why the IME opened
+  // successfully and the panel showed nothing. Compositing after the copy was
+  // the obvious fix and it crashed the GPU driver: PresentSurface runs on the
+  // engine's **raster thread**, sceGxmInitialize ran on the main thread, and
+  // sceCommonDialogUpdate has to be called from the thread that owns the GXM
+  // context.
+  //
+  // So the main loop owns the framebuffer while the keyboard is open,
+  // compositing over whatever frame was last copied. The app content freezes
+  // underneath.
+  //
+  // That was the right trade for a modal dialog and is the wrong one for an
+  // inline keyboard: libime covers the bottom third and the app above it
+  // should keep animating, as it does under GL. Fixing it is not a one-liner
+  // -- the thread that owns the GXM context is the main loop, not the raster
+  // thread that runs this copy -- so the software path keeps the freeze and
+  // the GL path does not.
+  if (g_ime.open && !g_gl_enabled) {
+    // The overlay draws into the display buffer on this path, so whatever
+    // partial rectangle this frame changed is about to be painted over. The
+    // next frame that does reach the blit has to copy the whole surface, and
+    // can: the surface is retained and still holds a complete frame.
+    //
+    // Under GL this does not apply and the app keeps presenting normally --
+    // the layer composites the keyboard into its back buffer at swap time,
+    // which is the whole reason an overlay keyboard is worth having. Freezing
+    // there would give back exactly what libime was chosen for.
+    g_display_stale = true;
+    return true;
+  }
+
+  // Single-buffered on purpose, for now. Double buffering is the right answer
+  // and it costs another 2 MiB of CDRAM; that trade belongs with the vsync work
+  // rather than here, because without pacing a second buffer buys nothing but
+  // tearing in a different place.
+  //
+  // Only the damaged rectangle is copied. The display buffer already holds the
+  // previous frame -- that is what makes this legal, and it is the same
+  // property that lets Skia clip its painting to the same rectangle.
+  // Widest row and lowest line either buffer can support, so a mismatch
+  // between the engine's surface and the display truncates rather than runs
+  // off the end.
+  const int max_x = static_cast<int>(
+      (row_bytes < static_cast<size_t>(kPitch * 4) ? row_bytes : kPitch * 4) /
+      4);
+  const int max_y =
+      height < static_cast<size_t>(kHeight) ? static_cast<int>(height) : kHeight;
+
+  const Damage d = g_display_stale ? Damage{} : g_damage;
+  g_display_stale = false;
+
+  const int x0 = d.left;
+  const int x1 = d.right < max_x ? d.right : max_x;
+  const int y0 = d.top;
+  const int y1 = d.bottom < max_y ? d.bottom : max_y;
+  const size_t x_off = static_cast<size_t>(x0) * 4;
+  const size_t copy_bytes =
+      x1 > x0 ? static_cast<size_t>(x1 - x0) * 4 : 0;
+
+  const uint8_t* src = static_cast<const uint8_t*>(allocation);
+  uint8_t* dst = static_cast<uint8_t*>(g_display.base);
+  const uint64_t blit_start = sceKernelGetSystemTimeWide();
+  for (int y = y0; y < y1 && copy_bytes != 0; y++) {
+    std::memcpy(dst + static_cast<size_t>(y) * kPitch * 4 + x_off,
+                src + static_cast<size_t>(y) * row_bytes + x_off, copy_bytes);
+  }
+  const uint64_t blit_elapsed_us = sceKernelGetSystemTimeWide() - blit_start;
+  g_win_blit_us += blit_elapsed_us;
+  g_hud_blit_us += blit_elapsed_us;
+  if (y1 > y0) {
+    const uint64_t damaged =
+        static_cast<uint64_t>(y1 - y0) * static_cast<uint64_t>(copy_bytes / 4);
+    g_win_damage_px += damaged;
+    g_hud_damage_px += damaged;
+  }
+
+  // The HUD, over the top of the frame just copied.
+  //
+  // After the blit rather than before it, because the blit would otherwise
+  // overwrite it wherever damage overlaps the corner -- and it must be redrawn
+  // every present for the same reason. Its cost is timed into its own counter,
+  // never into the blit's, so an instrument can never flatter or slander the
+  // thing it measures.
+  if (x1 > kHudX && x0 < kHudX + kHudW && y1 > kHudY && y0 < kHudY + kHudH) {
+    g_hud_dirty = true;  // the blit just painted app pixels over it
+  }
+  if (flutter_vita_debug_overlay != 0 && g_hud_on) {
+    const uint64_t hud_start = sceKernelGetSystemTimeWide();
+    if (g_hud_frames >= kHudWindow) {
+      HudTryUpdate();
+    }
+    if (g_hud_dirty) {
+      HudPaint(g_display.base);
+    }
+    g_win_hud_us += sceKernelGetSystemTimeWide() - hud_start;
+  }
+
+  // The next frame is whole until the rasterizer says otherwise. Without this
+  // a frame the observer never reported would silently reuse the last rect.
+  g_damage = Damage{};
+
+  EnterPhase(kPhaseIdle);
+  ReportFrameWindow();
+
+  return true;
+}
+
+// ===========================================================================
+// The GL path (ADR-0014)
+// ===========================================================================
+//
+// Everything above this line draws on the CPU and blits with sceDisplay. This
+// section is the alternative: Skia's Ganesh backend on GLES2, through
+// fvita_gles2 (through vitaGL until 2026-09-14).
+//
+// ADR-0014 measured why. localsend's raster pass was 199 ms of a 205 ms frame,
+// and the spike in spikes/g2-ganesh put the same three operations on the GPU:
+//
+//   colour filter      36,628 us -> 1,851 us    19.8x
+//   rotated 512->200  107,519 us -> 1,992 us    54.0x
+//   the composite     172,054 us -> 4,761 us    36.1x
+//
+// and one that went the other way:
+//
+//   saveLayer           2,419 us -> 4,035 us     0.6x
+//
+// The SGX543 is a tile-based deferred renderer, so a render-target switch
+// resolves the tile buffer to memory and reloads it. Offscreens are therefore
+// *more* expensive here than on the CPU, and a Flutter tree is full of them --
+// Opacity, antialiased ClipRRect, ShaderMask, every ColorFiltered. That is why
+// the software path stays and stays selectable, and why the fallback below is
+// a supported configuration rather than an error path.
+
+// A dev switch file under ux0:data/flutter-vita, which is how a decision gets
+// made on a console with no command line.
+//
+// On is a '1' in the first byte, not merely the file existing. Same shape as
+// ime.on, and for a practical reason: the dev server can `put` a file but
+// cannot delete one, so a switch that keys on existence is a switch that
+// cannot be turned back off without walking to the console.
+bool DevSwitchOn(const char* path) {
+  const SceUID fd = sceIoOpen(path, SCE_O_RDONLY, 0777);
+  if (fd < 0) return false;
+  char c = '0';
+  sceIoRead(fd, &c, 1);
+  sceIoClose(fd);
+  return c == '1';
+}
+
+// The GL backend owns GXM and the display once it initialises, which is a
+// different arrangement from the software path: there, this file allocates
+// the CDRAM framebuffer and calls sceDisplaySetFrameBuf itself. Only one of
+// the two may run in a process.
+//
+// The backend answers flutter_vita_gl.h; gl_gles2.c in the app template sizes
+// the display chain and points the shader cache somewhere writable before the
+// layer starts, and the reasons are with the code that does it.
+bool InitGl() {
+  sceIoMkdir("ux0:data", 0777);
+  sceIoMkdir("ux0:data/flutter-vita", 0777);
+  sceIoMkdir(kProbeDir, 0777);
+
+  const int r = flutter_vita_gl_init(kWidth, kHeight, DevServerLog);
+
+  // Probe rather than believe the return value: vitaGL's was GL_FALSE on a
+  // context that worked, three runs out of three in the g1 spike, and the
+  // habit is worth keeping.
+  const char* version = reinterpret_cast<const char*>(glGetString(GL_VERSION));
+  if (version == nullptr) {
+    VLog("flutter-vita: %s has no context (init returned %d)\n",
+         flutter_vita_gl_backend(), r);
+    return false;
+  }
+  VLog("flutter-vita: GL up -- %s / %s (init returned %d)\n", version,
+       reinterpret_cast<const char*>(glGetString(GL_RENDERER)), r);
+  if (flutter_vita_debug_overlay != 0) {
+    HudTitle(flutter_vita_gl_backend());
+    HudCompose();  // the pre-filled text, so the first frames carry the strip
+    flutter_vita_gl_set_frame_hook(HudFrameHook, nullptr);
+  }
+  return true;
+}
+
+// --------------------------------------------------------------------------
+// The proc resolver
+// --------------------------------------------------------------------------
+//
+// Every name Skia asks for goes to the layer. Seven of them used to be
+// answered here instead, with shims for entry points vitaGL lacked
+// (glBlendColor dropped its value, glGetShaderPrecisionFormat made numbers
+// up, glGetIntegerv hid GL_NUM_PROGRAM_BINARY_FORMATS); fvita_gles2 answers
+// all of them, as a real function or as a recording stub that puts the name
+// in ux0:data/flutter-vita/gles2-unimplemented.txt, which is where a gap
+// belongs.
+
+int g_gl_unresolved = 0;
+
+void* VitaGlProcResolver(void* /* user_data */, const char* name) {
+  if (void* p = flutter_vita_gl_proc_address(name)) return p;
+
+  // Retry without the vendor suffix.
+  //
+  // Skia's assembler asks for extension entry points by their suffixed names
+  // -- GET_PROC_SUFFIX(PopGroupMarker, EXT) requests "glPopGroupMarkerEXT".
+  // The layer registers the names Skia asks for, suffix included, so this is
+  // a safety net for a name the ledger has under its core spelling.
+  static const char* const kSuffixes[] = {"EXT", "OES", "ARB",   "KHR",
+                                          "APPLE", "ANGLE", "NV", "IMG"};
+  const size_t len = std::strlen(name);
+  for (const char* suffix : kSuffixes) {
+    const size_t slen = std::strlen(suffix);
+    if (len <= slen || std::strcmp(name + len - slen, suffix) != 0) continue;
+    char base[128];
+    if (len - slen >= sizeof base) continue;
+    std::memcpy(base, name, len - slen);
+    base[len - slen] = '\0';
+    if (void* p = flutter_vita_gl_proc_address(base)) return p;
+  }
+
+  // Worth logging rather than swallowing. A driver that advertises an
+  // extension without its entry points defeats Skia's null checks, because
+  // Skia trusts the extension string and calls straight through -- so any name
+  // here is a candidate for a jump to zero later.
+  g_gl_unresolved++;
+  VLog("flutter-vita: GL unresolved %s\n", name);
+  return nullptr;
+}
+
+// --------------------------------------------------------------------------
+// The renderer callbacks
+// --------------------------------------------------------------------------
+//
+// There is one context and it is never unbound, so make_current and
+// clear_current have nothing to do. That is not a shortcut around EGL: the
+// layer has no context object to bind, and GXM's context is process-wide. What keeps
+// it correct is that the engine touches GL only from its raster thread.
+
+// When the raster thread started this frame's GL work.
+//
+// The software path gets its raster time from the surface itself, through the
+// observer patch 0008 installs; there is no equivalent hook on the GL surface,
+// so this measures the same window from outside: make_current is the engine
+// saying "I am about to draw", present is it saying "I am done". Command
+// submission only -- the GPU is still working when present is entered, and the
+// swap below is where that gets waited on.
+uint64_t g_gl_frame_start_us = 0;
+
+// How long the raster thread sat between finishing one frame and being handed
+// the next.
+//
+// This exists because the first GL run of localsend cut raster from 156 ms to
+// 5.1 ms -- 30x, exactly what ADR-0014's spike predicted -- and the frame rate
+// did not move: 5.01 fps against 5.94 on the CPU. Something outside the raster
+// window costs ~194 ms per frame, and the two candidates behave completely
+// differently. If the raster thread is *waiting*, the bottleneck moved to the
+// UI thread and the GPU did its job; if it is busy in code this does not time,
+// the measurement is wrong. Guessing between those is how a wrong conclusion
+// gets written down.
+uint64_t g_gl_present_end_us = 0;
+// Set when the process is on its way out, so the raster thread stops being
+// handed frames. See FlutterVitaGpuShutdown.
+std::atomic<bool> g_gl_stopping{false};
+std::atomic<bool> g_gl_in_frame{false};
+
+bool GlMakeCurrent(void* /* user_data */) {
+  // Refusing here makes GPUSurfaceGLSkia::AcquireFrame return null and the
+  // engine drop the frame, which is how the raster thread is brought to a stop
+  // without reaching into it.
+  if (g_gl_stopping.load(std::memory_order_acquire)) return false;
+  g_gl_in_frame.store(true, std::memory_order_release);
+  EnterPhase(kPhaseDraw);
+  g_gl_frame_start_us = sceKernelGetSystemTimeWide();
+  if (g_gl_present_end_us != 0) {
+    g_last_idle_us = g_gl_frame_start_us - g_gl_present_end_us;
+    g_win_gl_idle_us += g_last_idle_us;
+  }
+  return true;
+}
+
+bool GlClearCurrent(void* /* user_data */) { return true; }
+
+bool GlPresent(void* /* user_data */) {
+  EnterPhase(kPhasePresent);
+  if (g_gl_frame_start_us != 0) {
+    const uint64_t raster_us =
+        sceKernelGetSystemTimeWide() - g_gl_frame_start_us;
+    g_last_raster_us = raster_us;
+    g_win_raster_us += raster_us;
+    g_hud_raster_us += raster_us;
+    if (raster_us > g_win_raster_max_us) g_win_raster_max_us = raster_us;
+    g_gl_frame_start_us = 0;
+  }
+  NotePresent(static_cast<size_t>(kPitch) * 4, kHeight);
+  // One stat every sixty frames, which is nothing next to a frame.
+  static unsigned probe_tick = 0;
+  if (++probe_tick % 60 == 0) RunShaderProbe();
+
+  // Everything after this point is the swap, and the swap is where the frame
+  // rate actually comes from: the swap waits for vblank, so `active` reads 60 fps
+  // for any frame that fits inside 16.6 ms and stops discriminating there. The
+  // raster figure above is what to read when it does.
+  const uint64_t swap_start = sceKernelGetSystemTimeWide();
+  EnterPhase(kPhaseSwap);
+  // The flag makes the layer run sceCommonDialogUpdate against its own back
+  // buffer, which is how the libime keyboard reaches the screen over GL
+  // content. Only while one is open -- it is a per-frame cost with nothing to
+  // show for it otherwise.
+  flutter_vita_gl_swap(g_ime.open ? 1 : 0);
+  g_gl_present_end_us = sceKernelGetSystemTimeWide();
+  g_win_blit_us += g_gl_present_end_us - swap_start;
+  g_hud_blit_us += g_gl_present_end_us - swap_start;
+  g_gl_in_frame.store(false, std::memory_order_release);
+  EnterPhase(kPhaseIdle);
+
+  // The HUD's text, every twenty frames; its pixels go onto each frame from
+  // the layer's display thread (HudFrameHook), which is why nothing here
+  // draws.
+  if (flutter_vita_debug_overlay != 0 && g_hud_on && g_hud_frames >= kHudWindow) {
+    const uint64_t hud_start = sceKernelGetSystemTimeWide();
+    HudTryUpdate();
+    g_win_hud_us += sceKernelGetSystemTimeWide() - hud_start;
+  }
+
+  ReportFrameWindow();
+  return true;
+}
+
+// Zero is the default framebuffer, which is the display target the layer
+// created in InitGl.
+uint32_t GlFboCallback(void* /* user_data */) { return 0; }
+
+}  // namespace
+
+// Let go of the GPU before this process ends. Called from every exit path.
+//
+// This is the bug that locked the console hard enough to need the power
+// button, twice, on 2026-08-22. The dev server's `handoff` -- and `relaunch`,
+// and `exit`, and bailout.c's crash path -- launch the loader and call
+// sceKernelExitProcess with nothing in between. That was correct for as long
+// as this process never touched the GPU: ADR-0003's software path owns a CDRAM
+// block and a memcpy, and there is nothing to hand back. Under GL there is a
+// live GXM context, a display queue with frames still in flight, and memory
+// blocks those frames name, and tearing the process down underneath them takes
+// the driver with it. The shell composites through the same driver, so the
+// whole console goes -- PS button included.
+//
+// spikes/g2-ganesh hit exactly this and fixed it with the two calls below. It
+// had the easy version: one thread, nothing else running. Here the exit is
+// requested on the dev server's thread while the *raster* thread is inside
+// the layer, so calling sceGxmTerminate directly from the caller would be the
+// same use-after-free one level up. The raster thread has to be stopped first,
+// and the only handle this file has on it is make_current -- refuse, and the
+// engine stops handing it frames.
+//
+// The wait is bounded because this runs on the way out. If the raster thread
+// is genuinely wedged, exiting without a clean teardown is no worse than the
+// hang, and hanging here instead would be strictly worse.
+// |fml/thread.cc| on Vita
+//
+// Defined here rather than in fml because fml has no logging destination on
+// this platform: FML_DLOG goes to a stdout the device does not own, which is
+// the same gap that hid every Dart print until 2026-08-24.
+extern "C" void flutter_vita_log_affinity(const char* name,
+                                          int before,
+                                          int after) {
+  VLog("flutter-vita: thread %s affinity 0x%05X -> 0x%05X\n",
+       name != nullptr ? name : "?", static_cast<unsigned>(before),
+       static_cast<unsigned>(after));
+  // The kernel calls all of these "pthread". This is the only place the port
+  // learns which one is the UI thread and which is the raster thread, and the
+  // stall report is unreadable without that.
+  NoteThread(sceKernelGetThreadId(), name);
+}
+
+// The wrappers' two calls. See WaitNote.
+//
+// Kept to a thread-id syscall, a scan of forty slots and a few stores: the
+// message loops go through here once per idle, Dart's monitors once per
+// message, and neither should notice.
+extern "C" void flutter_vita_wait_begin(int kind, unsigned object,
+                                        uintptr_t sp, uintptr_t caller) {
+  WaitNote* note = WaitNoteFor(sp);
+  if (note == nullptr) return;
+  const int d = note->depth.load(std::memory_order_relaxed);
+  if (d < kWaitDepth) {
+    WaitLevel& l = note->level[d];
+    l.kind = static_cast<uint8_t>(kind);
+    l.object = object;
+    l.caller = caller;
+    l.sp = sp;
+    l.since_us = sceKernelGetSystemTimeWide();
+  }
+  if (d == 0) note->count++;
+  note->depth.store(d + 1, std::memory_order_release);
+}
+
+extern "C" void flutter_vita_wait_end(void) {
+  uintptr_t sp;
+  __asm__ volatile("mov %0, sp" : "=r"(sp));
+  WaitNote* note = WaitNoteFor(sp);
+  if (note == nullptr) return;
+  const int d = note->depth.load(std::memory_order_relaxed);
+  if (d <= 0) return;
+  if (d == 1) note->last = note->level[0];
+  note->depth.store(d - 1, std::memory_order_release);
+}
+
+// What the stall watchdog would print, on demand, over the dev server.
+//
+// The watchdog only speaks when presents have stopped, and half of what a
+// frozen app needs is the reading from *before* it froze -- or from an app
+// that is merely slow rather than stopped, which is the more common complaint.
+// This is the same sample, taken because someone asked.
+//
+// Two calls are worth four times one: every runClocks figure is a delta
+// against the previous sample, so a single call reports a window of unknown
+// length and a pair reports the seconds between them.
+extern "C" int flutter_vita_diag(char* out, int cap) {
+  if (out == nullptr || cap <= 0) return 0;
+  std::lock_guard<std::mutex> lock(g_diag_mutex);
+  const uint64_t since = g_last_present_us != 0
+                             ? sceKernelGetSystemTimeWide() - g_last_present_us
+                             : 0;
+  BuildDiag("DIAG", since);
+  const int n = std::snprintf(out, cap, "%s", g_diag_text);
+  return n < cap ? n : cap - 1;
+}
+
+extern FlutterEngine g_engine;  // defined with the platform messages, below
+
+namespace {
+std::atomic<int> g_gl_teardown_done{0};
+void TeardownOnRasterThread(void*) {
+  flutter_vita_gl_shutdown();
+  g_gl_teardown_done.store(1, std::memory_order_release);
+}
+}  // namespace
+
+extern "C" void flutter_vita_gpu_shutdown(void) {
+  if (!g_gl_enabled) return;
+  VLog("flutter-vita: releasing the GPU before exit\n");
+
+  g_gl_stopping.store(true, std::memory_order_release);
+  for (int i = 0; i < 200 && g_gl_in_frame.load(std::memory_order_acquire);
+       i++) {
+    sceKernelDelayThread(5 * 1000);
+  }
+  if (g_gl_in_frame.load(std::memory_order_acquire)) {
+    VLog("flutter-vita: raster thread still in a frame; tearing down anyway\n");
+  }
+
+  // Drain before terminate. Terminating with flips still queued is a
+  // use-after-free of the buffers they name -- which is the same fault as the
+  // one above, in the driver's own bookkeeping. The backend does both.
+  //
+  // On the raster thread when it will take the task: that is the one thread
+  // that calls GL, and between frames it still does -- Skia frees what it
+  // has not used for a while -- so a teardown from any other thread races
+  // it. The gallery's build 29 (2026-09-14, 26 minutes in) died that way, a
+  // glDeleteTextures inside the layer's texture loop, a double free. A
+  // raster thread that does not get to the task in two seconds is stuck,
+  // and a stuck thread is not calling GL either: tear down from here then.
+  bool posted = false;
+  if (g_engine != nullptr) {
+    posted = FlutterEnginePostRenderThreadTask(g_engine, TeardownOnRasterThread,
+                                               nullptr) == kSuccess;
+  }
+  for (int i = 0; posted && i < 400 &&
+                  !g_gl_teardown_done.load(std::memory_order_acquire);
+       i++) {
+    sceKernelDelayThread(5 * 1000);
+  }
+  if (!g_gl_teardown_done.load(std::memory_order_acquire)) {
+    VLog("flutter-vita: raster thread did not take the teardown; from this thread\n");
+    flutter_vita_gl_shutdown();
+  }
+  VLog("flutter-vita: GPU released\n");
+}
+
+// The AOT snapshot, linked into eboot.bin rather than loaded. gen_snapshot
+// emits these four symbols into the assembly file that is assembled alongside
+// this translation unit; see ADR-0005 for why the alternative -- an ELF loaded
+// at runtime -- was abandoned.
+extern "C" {
+extern const uint8_t _kDartVmSnapshotData[];
+extern const uint8_t _kDartVmSnapshotInstructions[];
+extern const uint8_t _kDartIsolateSnapshotData[];
+extern const uint8_t _kDartIsolateSnapshotInstructions[];
+}
+
+// m3 shipped without a log channel, which is why the first crash had to be
+// read out of registers. printf on this platform goes to the debug UART, and
+// nothing here has one. Point both streams at a file on ux0: instead, before
+// anything else runs, so `dev.sh get ux0:data/flutter-vita/app.log` works even
+// after a crash -- the loader is up by then and serves the file, and since
+// 2026-08-28 it no longer truncates that path on the way in (see LogPath).
+//
+// No stdio buffering, and that is a deliberate downgrade.
+//
+// The first version asked for _IOLBF with a null buffer and size 0. POSIX
+// leaves that combination implementation-defined, newlib did not give line
+// buffering, and a run that hung produced a log file of zero bytes -- the app
+// had truncated it on open and never flushed a byte. A log that is empty
+// exactly when the program misbehaves is worse than no log, because it looks
+// like evidence.
+//
+// _IONBF sends every stdio write straight through to sceIoWrite; that is the
+// engine's own FML_LOG lines, a handful per run. Everything of ours goes
+// through VLog, which queues for the writer thread above: logging volume
+// came to matter on 2026-09-14, at 33 ms of card time per second.
+static void OpenLog() {
+  const char* const kPath = LogPath();
+  sceIoMkdir("ux0:data/flutter-vita", 0777);
+
+  // Truncate once, then hold an append handle. Append matters because the
+  // engine's own logging goes through std::cerr, which is a different writer
+  // with a different offset -- two writers each tracking their own position
+  // would overwrite each other rather than interleave.
+  const SceUID truncate =
+      sceIoOpen(kPath, SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
+  if (truncate >= 0) {
+    sceIoClose(truncate);
+  }
+  g_log_fd = sceIoOpen(kPath, SCE_O_WRONLY | SCE_O_APPEND, 0777);
+  StartLogThread();
+
+  // FML_LOG writes to std::cerr, and there is no hook to redirect it, so the
+  // engine's diagnostics still have to come through stdio. Append mode and no
+  // buffering, for the same two reasons as above.
+  std::freopen(kPath, "a", stderr);
+  std::setvbuf(stderr, nullptr, _IONBF, 0);
+  std::freopen(kPath, "a", stdout);
+  std::setvbuf(stdout, nullptr, _IONBF, 0);
+}
+
+// The platform task runner, without which no platform channel works at all.
+//
+// This was on the file's own deferred list -- "Custom task runners. The engine
+// will spin up its own threads for now" -- filed as a performance and
+// architecture concern for ADR-0004. It is not. `platform_message_callback`'s
+// contract is that it "will be invoked on the thread on which the
+// `FlutterEngineRun` call is made", and the mechanism for that is the platform
+// task runner: the engine *queues* the dispatch and waits for the embedder to
+// hand it back via FlutterEngineRunTask.
+//
+// With no runner and a main loop that only polls touch, the queue was never
+// drained. Measured before this existed: an `invokeMethod` on
+// `flutter/textinput` timed out after 25 s, and the message callback was never
+// once invoked. Nothing was broken about the channel; the message was simply
+// sitting in a queue nobody serviced.
+//
+// So this is a prerequisite for every channel -- text input, lifecycle,
+// settings, and the `psvita` package in ADR-0010 -- not an optimisation.
+//
+// Deliberately a fixed array rather than a heap queue. This is drained on the
+// main loop sixty times a second and posted to from engine threads; a
+// std::vector here would allocate on a path that runs during frame production.
+// 256 is far more than the observed depth, and overflowing it drops a task,
+// which is why it says so loudly rather than silently wrapping.
+struct PendingTask {
+  FlutterTask task;
+  uint64_t target_time;  // nanos, same clock as FlutterEngineGetCurrentTime
+};
+
+constexpr size_t kMaxPendingTasks = 256;
+PendingTask g_tasks[kMaxPendingTasks];
+size_t g_task_count = 0;
+std::mutex g_task_lock;
+SceUID g_platform_thread = 0;
+
+// May be called from any engine thread.
+void PostPlatformTask(FlutterTask task,
+                      uint64_t target_time,
+                      void* /* user_data */) {
+  std::lock_guard<std::mutex> guard(g_task_lock);
+  if (g_task_count >= kMaxPendingTasks) {
+    VLog("flutter-vita: platform task queue full, DROPPING a task\n");
+    return;
+  }
+  g_tasks[g_task_count].task = task;
+  g_tasks[g_task_count].target_time = target_time;
+  g_task_count++;
+}
+
+bool RunsTasksOnCurrentThread(void* /* user_data */) {
+  return sceKernelGetThreadId() == g_platform_thread;
+}
+
+// Run whatever is due, from the main loop.
+//
+// Tasks are copied out under the lock and run outside it, because a task may
+// post another one -- re-entering the lock from inside it would deadlock on a
+// non-recursive mutex, and the first symptom would be a frozen app with no
+// error anywhere.
+void DrainPlatformTasks(FlutterEngine engine) {
+  const uint64_t now = FlutterEngineGetCurrentTime();
+  FlutterTask due[kMaxPendingTasks];
+  size_t due_count = 0;
+  {
+    std::lock_guard<std::mutex> guard(g_task_lock);
+    size_t kept = 0;
+    for (size_t i = 0; i < g_task_count; i++) {
+      if (g_tasks[i].target_time <= now) {
+        due[due_count++] = g_tasks[i].task;
+      } else {
+        g_tasks[kept++] = g_tasks[i];
+      }
+    }
+    g_task_count = kept;
+  }
+  for (size_t i = 0; i < due_count; i++) {
+    FlutterEngineRunTask(engine, &due[i]);
+  }
+  g_loop_tasks_run += due_count;
+}
+
+// ---------------------------------------------------------------------------
+// Text input: `flutter/textinput` over the system IME dialog.
+//
+// Two facts about the channel make this far smaller than it looks, and both
+// were worth checking before writing any of it:
+//
+//   * It is **JSONMethodCodec**, not the binary standard codec. ADR-0010 calls
+//     hand-encoding StandardMethodCodec in C "the single largest piece of
+//     embedder work outstanding"; text input does not need it. (`flutter/
+//     keyboard` does -- its getKeyboardState arrives as binary framing -- so
+//     that bill is deferred, not cancelled.)
+//   * It is an **OptionalMethodChannel**: unimplemented methods return null
+//     rather than raising. So five inbound methods and two outbound ones are a
+//     working implementation, not a stub. The other twenty-four are scribble,
+//     autofill, floating cursor and selection rects -- iOS and Android
+//     features with no Vita analogue.
+//
+// The dialog is modal, and that is the platform being honest rather than a
+// shortcut: sceIme's inline mode wants a GXM render loop we do not have, and
+// there is no keyboard a Flutter app could draw for itself. So a TextField
+// receives its value when the dialog closes rather than per keystroke, which
+// is how every console does text entry.
+// ---------------------------------------------------------------------------
+
+// Just enough JSON for messages whose shape is fixed and known.
+//
+// Deliberately not a parser. Every message handled here is generated by the
+// framework from a literal, so the questions are only ever "what method is
+// this" and "what is the value of one known key" -- and a real parser would be
+// several hundred lines of attack surface for a channel that never carries
+// anything but framework-authored text.
+const char* JsonFindValue(const char* json, size_t len, const char* key) {
+  char pattern[48];
+  std::snprintf(pattern, sizeof pattern, "\"%s\":", key);
+  const size_t plen = std::strlen(pattern);
+  if (len < plen) return nullptr;
+  for (size_t i = 0; i + plen <= len; i++) {
+    if (std::memcmp(json + i, pattern, plen) == 0) return json + i + plen;
+  }
+  return nullptr;
+}
+
+// Copy a JSON string value, undoing the escapes the framework actually emits.
+size_t JsonUnescape(const char* p, const char* end, char* out, size_t out_max) {
+  if (p >= end || *p != '"') return 0;
+  p++;
+  size_t n = 0;
+  while (p < end && *p != '"' && n + 1 < out_max) {
+    if (*p == '\\' && p + 1 < end) {
+      p++;
+      switch (*p) {
+        case 'n': out[n++] = '\n'; break;
+        case 't': out[n++] = '\t'; break;
+        case 'r': out[n++] = '\r'; break;
+        case 'u': {
+          // \uXXXX. Only the BMP, and only as UTF-8 -- enough for the text the
+          // framework round-trips back to us.
+          if (p + 4 >= end) return n;
+          unsigned cp = 0;
+          for (int k = 1; k <= 4; k++) {
+            const char c = p[k];
+            cp <<= 4;
+            cp |= (c >= '0' && c <= '9')   ? (unsigned)(c - '0')
+                  : (c >= 'a' && c <= 'f') ? (unsigned)(c - 'a' + 10)
+                  : (c >= 'A' && c <= 'F') ? (unsigned)(c - 'A' + 10)
+                                           : 0u;
+          }
+          p += 4;
+          if (cp < 0x80) {
+            out[n++] = (char)cp;
+          } else if (cp < 0x800 && n + 2 < out_max) {
+            out[n++] = (char)(0xC0 | (cp >> 6));
+            out[n++] = (char)(0x80 | (cp & 0x3F));
+          } else if (n + 3 < out_max) {
+            out[n++] = (char)(0xE0 | (cp >> 12));
+            out[n++] = (char)(0x80 | ((cp >> 6) & 0x3F));
+            out[n++] = (char)(0x80 | (cp & 0x3F));
+          }
+          break;
+        }
+        default: out[n++] = *p; break;
+      }
+      p++;
+    } else {
+      out[n++] = *p++;
+    }
+  }
+  out[n] = '\0';
+  return n;
+}
+
+// The framework will reject a malformed reply, and an unescaped quote in user
+// input is the obvious way to produce one -- someone typing `he said "hi"` must
+// not break the channel.
+size_t JsonEscape(const char* in, char* out, size_t out_max) {
+  size_t n = 0;
+  for (const char* p = in; *p != '\0' && n + 7 < out_max; p++) {
+    const unsigned char c = (unsigned char)*p;
+    switch (c) {
+      case '"':  out[n++] = '\\'; out[n++] = '"';  break;
+      case '\\': out[n++] = '\\'; out[n++] = '\\'; break;
+      case '\n': out[n++] = '\\'; out[n++] = 'n';  break;
+      case '\r': out[n++] = '\\'; out[n++] = 'r';  break;
+      case '\t': out[n++] = '\\'; out[n++] = 't';  break;
+      default:
+        if (c < 0x20) {
+          n += (size_t)std::snprintf(out + n, out_max - n, "\\u%04X", c);
+        } else {
+          out[n++] = (char)c;
+        }
+    }
+  }
+  out[n] = '\0';
+  return n;
+}
+
+// The IME speaks UTF-16; the channel speaks UTF-8. BMP only, which is what the
+// dialog can produce anyway.
+void Utf8ToUtf16(const char* in, SceWChar16* out, size_t out_max) {
+  size_t n = 0;
+  const unsigned char* p = (const unsigned char*)in;
+  while (*p != 0 && n + 1 < out_max) {
+    unsigned cp;
+    if (*p < 0x80) {
+      cp = *p++;
+    } else if ((*p & 0xE0) == 0xC0 && p[1]) {
+      cp = ((unsigned)(*p & 0x1F) << 6) | (p[1] & 0x3F);
+      p += 2;
+    } else if ((*p & 0xF0) == 0xE0 && p[1] && p[2]) {
+      cp = ((unsigned)(*p & 0x0F) << 12) | ((unsigned)(p[1] & 0x3F) << 6) |
+           (p[2] & 0x3F);
+      p += 3;
+    } else {
+      p++;  // Outside the BMP, or malformed. Skipped rather than guessed at.
+      continue;
+    }
+    out[n++] = (SceWChar16)cp;
+  }
+  out[n] = 0;
+}
+
+void Utf16ToUtf8(const SceWChar16* in, char* out, size_t out_max) {
+  size_t n = 0;
+  for (size_t i = 0; in[i] != 0 && n + 4 < out_max; i++) {
+    const unsigned cp = in[i];
+    if (cp < 0x80) {
+      out[n++] = (char)cp;
+    } else if (cp < 0x800) {
+      out[n++] = (char)(0xC0 | (cp >> 6));
+      out[n++] = (char)(0x80 | (cp & 0x3F));
+    } else {
+      out[n++] = (char)(0xE0 | (cp >> 12));
+      out[n++] = (char)(0x80 | ((cp >> 6) & 0x3F));
+      out[n++] = (char)(0x80 | (cp & 0x3F));
+    }
+  }
+  out[n] = '\0';
+}
+
+
+// Platform channels arrive here. Phase 8, first step: see them.
+//
+// Nothing was listening before this, so every channel the framework opens --
+// `flutter/textinput`, `flutter/platform`, `flutter/lifecycle`,
+// `flutter/settings` -- was silently dropped by the engine with no record that
+// it had been attempted. The first thing worth knowing is which ones a real app
+// actually uses, and that is a question the log can answer before a single line
+// of IME code exists.
+//
+// **Every message must be answered.** The engine allocates a response handle
+// per message and leaks it otherwise; worse, an `invokeMethod` awaiting a reply
+// never completes, so a missing response is an app that quietly hangs rather
+// than one that visibly fails. A null response of length zero is the encoding
+// for "not implemented", which is exactly true right now and is what
+// `OptionalMethodChannel` -- the one `flutter/textinput` uses -- is built to
+// tolerate.
+//
+// The payload is logged as text and truncated. `flutter/textinput` uses
+// JSONMethodCodec, so its messages are readable ASCII; a channel using the
+// binary standard codec will look like noise here, which is itself the
+// distinction worth seeing.
+FlutterEngine g_engine = nullptr;
+
+// Send a method call up to the framework on `flutter/textinput`.
+void SendTextInputMethod(const char* json) {
+  if (g_engine == nullptr) return;
+  FlutterPlatformMessage out = {};
+  out.struct_size = sizeof(FlutterPlatformMessage);
+  out.channel = "flutter/textinput";
+  out.message = reinterpret_cast<const uint8_t*>(json);
+  out.message_size = std::strlen(json);
+  FlutterEngineSendPlatformMessage(g_engine, &out);
+}
+
+// The UI-thread heartbeat, and the watchdog behind it.
+//
+// A frozen screen has two different causes that look the same from outside:
+// nothing scheduled a frame, or the UI thread cannot take a task. The stall
+// report reads threads from the outside and cannot always tell them apart.
+// A platform message can: it is a task on the UI thread and its reply is a
+// task back here, independent of frames and of dart:io timers. One goes up
+// every second once anything has been presented, and the round trip lands
+// in the stall report.
+//
+// When there has been no reply for kUiDeadUs, the report is taken twice,
+// five seconds apart, into ux0:data/flutter-vita/stall.txt; at kUiRelaunchUs
+// the log is copied to stall.log next to it and the app relaunches itself,
+// the same way the dev server's `relaunch` does. The host reads both files
+// after the fact, and a bench that hit this carries on with the next scene
+// instead of sitting on a frozen console until someone notices. Dev builds
+// only, see flutter_vita_watchdog.
+constexpr uint64_t kHeartbeatUs = 1000 * 1000;
+// A reply this late is a frame's worth of UI thread gone, and the same
+// report that describes a freeze describes it, taken while it is happening:
+// the wait-site table says what the UI thread is inside right now. Once per
+// ten seconds at most, so a slow scene does not fill the log with them.
+constexpr uint64_t kUiSlowUs = 300 * 1000;
+constexpr uint64_t kUiSlowRepeatUs = 10 * 1000 * 1000;
+uint64_t g_ui_slow_reported_us = 0;
+constexpr uint64_t kUiDeadUs = 20 * 1000 * 1000;
+constexpr uint64_t kUiSecondDumpUs = 25 * 1000 * 1000;
+constexpr uint64_t kUiRelaunchUs = 30 * 1000 * 1000;
+constexpr const char* kStallReportPath = "ux0:data/flutter-vita/stall.txt";
+constexpr const char* kStallLogPath = "ux0:data/flutter-vita/stall.log";
+int g_watchdog_dumps = 0;  // 0 none, 1 first, 2 second, 3 relaunching
+
+// On the platform thread, from DrainPlatformTasks.
+void HeartbeatReply(const uint8_t* /* data */, size_t /* size */,
+                    void* /* user_data */) {
+  const uint64_t now = sceKernelGetSystemTimeWide();
+  if (g_hb_sent_us != 0) {
+    g_hb_rtt_us = now - g_hb_sent_us;
+    if (g_hb_rtt_us > g_hb_rtt_max_us) g_hb_rtt_max_us = g_hb_rtt_us;
+    if (g_watchdog_dumps != 0) {
+      VLog("flutter-vita: WATCHDOG ui thread back after %u ms\n",
+           static_cast<unsigned>(g_hb_rtt_us / 1000));
+      g_watchdog_dumps = 0;
+    }
+  }
+  g_hb_reply_us = now;
+  g_hb_sent_us = 0;
+  g_hb_replies++;
+}
+
+void SendHeartbeat(uint64_t now) {
+  if (g_engine == nullptr) return;
+  FlutterPlatformMessageResponseHandle* handle = nullptr;
+  if (FlutterPlatformMessageCreateResponseHandle(g_engine, HeartbeatReply,
+                                                 nullptr, &handle) != kSuccess) {
+    return;
+  }
+  // JSONMethodCodec, which is what flutter/navigation speaks. The framework
+  // answers a method it does not know with null, which is all this needs.
+  static const char kCall[] =
+      "{\"method\":\"flutter-vita/heartbeat\",\"args\":null}";
+  FlutterPlatformMessage out = {};
+  out.struct_size = sizeof(FlutterPlatformMessage);
+  out.channel = "flutter/navigation";
+  out.message = reinterpret_cast<const uint8_t*>(kCall);
+  out.message_size = sizeof kCall - 1;
+  out.response_handle = handle;
+  g_hb_sent_us = now;
+  const FlutterEngineResult r = FlutterEngineSendPlatformMessage(g_engine, &out);
+  FlutterPlatformMessageReleaseResponseHandle(g_engine, handle);
+  if (r != kSuccess) g_hb_sent_us = 0;
+}
+
+// The build's switch, then the card's. Read once, logged once.
+bool WatchdogArmed() {
+  static int armed = -1;
+  if (armed >= 0) return armed == 1;
+  armed = flutter_vita_watchdog != 0 ? 1 : 0;
+  if (armed == 1) {
+    const SceUID fd =
+        sceIoOpen("ux0:data/flutter-vita/watchdog.off", SCE_O_RDONLY, 0);
+    if (fd >= 0) {
+      char c = 0;
+      if (sceIoRead(fd, &c, 1) == 1 && c == '1') armed = 0;
+      sceIoClose(fd);
+    }
+  }
+  VLog("flutter-vita: WATCHDOG %s\n",
+       armed == 1 ? "armed: a UI thread silent for 30 s relaunches the app"
+                  : "off");
+  return armed == 1;
+}
+
+void WriteStallReport(const char* which, uint64_t silent_us, bool append) {
+  std::lock_guard<std::mutex> lock(g_diag_mutex);
+  BuildDiag("WATCHDOG", sceKernelGetSystemTimeWide() - g_last_present_us);
+  const size_t len = std::strlen(g_diag_text);
+  // Into the log as well, so the two are side by side with the frames.
+  VLog("flutter-vita: WATCHDOG %s sample, ui thread silent %u ms\n", which,
+       static_cast<unsigned>(silent_us / 1000));
+  VLogRaw(g_diag_text, len);
+  const SceUID fd = sceIoOpen(
+      kStallReportPath,
+      SCE_O_WRONLY | SCE_O_CREAT | (append ? SCE_O_APPEND : SCE_O_TRUNC),
+      0777);
+  if (fd < 0) return;
+  char head[128];
+  const int hn = std::snprintf(head, sizeof head,
+                               "== %s sample, ui thread silent %u ms, "
+                               "present #%u\n",
+                               which, static_cast<unsigned>(silent_us / 1000),
+                               static_cast<unsigned>(g_frame_index));
+  sceIoWrite(fd, head, hn);
+  sceIoWrite(fd, g_diag_text, len);
+  sceIoClose(fd);
+}
+
+// app.log as it stands, copied whole: the relaunch truncates it.
+void CopyLogForStall() {
+  flutter_vita_log_flush();
+  const SceUID in = sceIoOpen(LogPath(), SCE_O_RDONLY, 0);
+  if (in < 0) return;
+  const SceUID out =
+      sceIoOpen(kStallLogPath, SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
+  if (out < 0) {
+    sceIoClose(in);
+    return;
+  }
+  const int kChunk = 64 * 1024;
+  char* buf = static_cast<char*>(std::malloc(kChunk));
+  if (buf != nullptr) {
+    for (;;) {
+      const int got = sceIoRead(in, buf, kChunk);
+      if (got <= 0) break;
+      sceIoWrite(out, buf, got);
+    }
+    std::free(buf);
+  }
+  sceIoClose(out);
+  sceIoClose(in);
+}
+
+// Once per platform-loop iteration, after the tasks have been drained.
+void CheckUiThread() {
+  if (g_last_present_us == 0) return;  // the framework is not up yet
+  const uint64_t now = sceKernelGetSystemTimeWide();
+  if (g_hb_sent_us == 0) {
+    if (now - g_hb_reply_us >= kHeartbeatUs) SendHeartbeat(now);
+    return;
+  }
+  const uint64_t silent = now - g_hb_sent_us;
+  // Not during the first frames: the first build of an app is a second of
+  // UI thread by design, and a report of it says nothing new.
+  if (silent >= kUiSlowUs && silent < kUiDeadUs && g_frame_index > 60 &&
+      now - g_ui_slow_reported_us >= kUiSlowRepeatUs) {
+    g_ui_slow_reported_us = now;
+    std::lock_guard<std::mutex> lock(g_diag_mutex);
+    BuildDiag("SLOW", now - g_last_present_us);
+    VLog("flutter-vita: SLOW ui thread, no heartbeat reply for %u ms\n",
+         static_cast<unsigned>(silent / 1000));
+    VLogRaw(g_diag_text, std::strlen(g_diag_text));
+    return;
+  }
+  if (silent < kUiDeadUs) return;
+  if (!WatchdogArmed()) return;
+  if (g_watchdog_dumps == 0) {
+    g_watchdog_dumps = 1;
+    WriteStallReport("first", silent, /*append=*/false);
+  } else if (g_watchdog_dumps == 1 && silent >= kUiSecondDumpUs) {
+    g_watchdog_dumps = 2;
+    WriteStallReport("second", silent, /*append=*/true);
+  } else if (g_watchdog_dumps == 2 && silent >= kUiRelaunchUs) {
+    g_watchdog_dumps = 3;
+    VLog("flutter-vita: WATCHDOG relaunching: ui thread silent %u ms,"
+         " report in %s, log copy in %s\n",
+         static_cast<unsigned>(silent / 1000), kStallReportPath,
+         kStallLogPath);
+    CopyLogForStall();
+    flutter_vita_gpu_shutdown();
+    flutter_vita_log_flush();
+    sceKernelDelayThread(200 * 1000);
+    sceAppMgrLoadExec("app0:eboot.bin", nullptr, nullptr);
+    // Only reached if LoadExec refused.
+    VLog("flutter-vita: WATCHDOG sceAppMgrLoadExec returned\n");
+  }
+}
+
+// One-time setup for the IME dialog.
+//
+// Three separate things, each of which fails differently if skipped:
+// SceIme is not resident by default; a common dialog needs the shell's app-util
+// context; and the config param carries the system language and -- the part
+// that is easy to miss -- the **enter button assignment**, which is O in Japan
+// and X everywhere else. Getting that wrong does not fail, it just puts the
+// confirm button under the wrong thumb.
+void InitIme() {
+  const int mod = sceSysmoduleLoadModule(SCE_SYSMODULE_IME);
+  if (mod < 0) {
+    VLog("flutter-vita: SCE_SYSMODULE_IME 0x%08X\n", (unsigned)mod);
+    return;
+  }
+
+  // GXM has to be initialised even though nothing here renders with it.
+  //
+  // Measured, not assumed: with everything else correct, the common dialog
+  // returns 0x80020436, SCE_COMMON_DIALOG_ERROR_GXM_IS_UNINITIALIZED. A common
+  // dialog is composited by the shell, and the shell will not do that for a
+  // process that has no graphics context -- ADR-0003's software raster is fine
+  // as the *source* of pixels, but the compositor still wants GXM up.
+  //
+  // The parameter buffer is the stock 16 MiB.
+  //
+  // The header says "must be 0x40000 or higher", and the reasoning that this
+  // process submits no draw calls so the minimum must do was wrong: 0x40000
+  // returns 0x805B0017, SCE_GXM_ERROR_DRIVER. The driver has its own opinion
+  // and does not explain it. SCE_GXM_DEFAULT_PARAMETER_BUFFER_SIZE is what
+  // every other application on this console passes, and 16 MiB out of roughly
+  // 87 MiB free is affordable; guessing again would cost another deploy to
+  // learn the same thing.
+  // Under GL, the layer has already done all of this and owns it -- both the
+  // GXM init and the compositing, which it does inside its swap. So the
+  // GL path skips the whole block and still gets a keyboard; it is the
+  // software path that has to build the surfaces itself.
+  //
+  // sceGxmInitialize is once per process, and a second call returns
+  // SCE_GXM_ERROR_ALREADY_INITIALIZED.
+  if (g_gl_enabled) {
+    VLog("flutter-vita: GXM belongs to %s; it composites the IME\n",
+         flutter_vita_gl_backend());
+  } else {
+    SceGxmInitializeParams gxm = {};
+    gxm.flags = 0;
+    gxm.displayQueueMaxPendingCount = 2;
+    gxm.displayQueueCallback = nullptr;
+    gxm.displayQueueCallbackDataSize = 0;
+    gxm.parameterBufferSize = SCE_GXM_DEFAULT_PARAMETER_BUFFER_SIZE;
+    const int gr = sceGxmInitialize(&gxm);
+    if (gr < 0) {
+      VLog("flutter-vita: sceGxmInitialize 0x%08X\n", (unsigned)gr);
+      return;
+    }
+    if (!InitGxmSurfaces()) {
+      VLog("flutter-vita: GXM surfaces unavailable, IME stays off\n");
+      return;
+    }
+    g_ime.gxm_ready = true;
+  }
+  SceAppUtilInitParam init = {};
+  SceAppUtilBootParam boot = {};
+  sceAppUtilInit(&init, &boot);
+
+  SceCommonDialogConfigParam cfg;
+  sceCommonDialogConfigParamInit(&cfg);
+  int value = 0;
+  if (sceAppUtilSystemParamGetInt(SCE_SYSTEM_PARAM_ID_LANG, &value) >= 0) {
+    cfg.language = static_cast<SceSystemParamLang>(value);
+  }
+  if (sceAppUtilSystemParamGetInt(SCE_SYSTEM_PARAM_ID_ENTER_BUTTON, &value) >=
+      0) {
+    cfg.enterButtonAssign = static_cast<SceSystemParamEnterButtonAssign>(value);
+  }
+  sceCommonDialogSetConfigParam(&cfg);
+  VLog("flutter-vita: IME ready (lang=%d enter=%d)\n", (int)cfg.language,
+       (int)cfg.enterButtonAssign);
+}
+
+// SCE_IME_MAX_TEXT_LENGTH is 2048 and ImeState's buffers are sized for it plus
+// the preedit, so nothing here can overrun regardless of what the framework
+// sends.
+void CloseIme(bool user_dismissed = false);
+
+// Everything libime tells us, translated into the two messages the framework
+// understands.
+//
+// Called from inside sceImeUpdate, on the main loop's thread, so nothing here
+// crosses threads -- and for the same reason it must stay cheap.
+void ImeEventHandler(void* arg, const SceImeEventData* e) {
+  (void)arg;
+  switch (e->id) {
+    case SCE_IME_EVENT_OPEN:
+    case SCE_IME_EVENT_CHANGE_SIZE:
+      // Believe the keyboard about its own size rather than hardcoding one: it
+      // differs by language and by whether the assistance bar is up, and it
+      // changes while open.
+      g_ime.inset_bottom = static_cast<double>(e->param.rect.height);
+      g_ime.metrics_dirty = true;
+      VLog("flutter-vita: IME %s rect %ux%u at %u,%u\n",
+           e->id == SCE_IME_EVENT_OPEN ? "open" : "resized",
+           (unsigned)e->param.rect.width, (unsigned)e->param.rect.height,
+           (unsigned)e->param.rect.x, (unsigned)e->param.rect.y);
+      break;
+
+    case SCE_IME_EVENT_UPDATE_TEXT: {
+      if (g_ime.client_id < 0) break;
+      char text[1024] = {0};
+      Utf16ToUtf8(g_ime.text, text, sizeof text);
+      std::snprintf(g_ime.pending, sizeof g_ime.pending, "%s", text);
+
+      char escaped[2048];
+      JsonEscape(text, escaped, sizeof escaped);
+
+      // The indices arrive in UTF-16 code units and Dart strings are UTF-16,
+      // so they pass through unchanged. Recomputing them against the UTF-8 we
+      // just built would be wrong for anything outside ASCII.
+      const int caret = static_cast<int>(e->param.text.caretIndex);
+      const int preedit_len = static_cast<int>(e->param.text.preeditLength);
+      const int composing_base =
+          preedit_len > 0 ? static_cast<int>(e->param.text.preeditIndex) : -1;
+      const int composing_extent =
+          preedit_len > 0 ? composing_base + preedit_len : -1;
+
+      char json[2600];
+      std::snprintf(json, sizeof json,
+                    "{\"method\":\"TextInputClient.updateEditingState\","
+                    "\"args\":[%d,{\"text\":\"%s\",\"selectionBase\":%d,"
+                    "\"selectionExtent\":%d,\"selectionAffinity\":"
+                    "\"TextAffinity.downstream\",\"selectionIsDirectional\":"
+                    "false,\"composingBase\":%d,\"composingExtent\":%d}]}",
+                    g_ime.client_id, escaped, caret, caret, composing_base,
+                    composing_extent);
+      SendTextInputMethod(json);
+      break;
+    }
+
+    case SCE_IME_EVENT_PRESS_ENTER: {
+      if (g_ime.client_id < 0) break;
+      // In a real multiline session Enter inserts a line break, which libime
+      // has already done and reported through UPDATE_TEXT; sending `done` as
+      // well would unfocus the field mid-paragraph. Otherwise Enter means
+      // finished.
+      //
+      // multiline_active, not multiline: this console's libime refuses
+      // MULTILINE outright, so a multiline field opens a single-line keyboard
+      // and its Enter is the only way the user can commit. Testing what was
+      // *asked for* here would swallow that and leave no way out of the field
+      // but the close button.
+      if (g_ime.multiline_active) break;
+      char json[256];
+      std::snprintf(json, sizeof json,
+                    "{\"method\":\"TextInputClient.performAction\","
+                    "\"args\":[%d,\"TextInputAction.done\"]}",
+                    g_ime.client_id);
+      SendTextInputMethod(json);
+      break;
+    }
+
+    case SCE_IME_EVENT_PRESS_CLOSE:
+      // The user hit the keyboard's own close button. The framework has no way
+      // to know that, and without being told it keeps the field focused with
+      // no keyboard under it -- and then never asks for one again, because as
+      // far as it is concerned the connection is still open.
+      CloseIme(/*user_dismissed=*/true);
+      break;
+
+    default:
+      break;
+  }
+}
+
+// Flutter's keyboard type, in the four shapes this console has for it.
+//
+// The names are the framework's own, straight out of setClient. Anything not
+// listed gets the default keyboard, which is the right answer for
+// TextInputType.text, .name, .streetAddress and anything added later.
+SceUInt32 ImeTypeFor(const char* name, bool obscured) {
+  // A password field first, whatever it claims to be: prediction over a
+  // password is a bad idea, and BASIC_LATIN is the keyboard without it.
+  if (obscured) return SCE_IME_TYPE_BASIC_LATIN;
+  if (name == nullptr) return SCE_IME_TYPE_DEFAULT;
+  if (std::strcmp(name, "TextInputType.emailAddress") == 0)
+    return SCE_IME_TYPE_MAIL;
+  if (std::strcmp(name, "TextInputType.url") == 0) return SCE_IME_TYPE_URL;
+  if (std::strcmp(name, "TextInputType.number") == 0)
+    return SCE_IME_TYPE_NUMBER;
+  // Phone and datetime need the punctuation a bare number pad does not have --
+  // +, *, # and separators -- which is what EXTENDED_NUMBER is for.
+  if (std::strcmp(name, "TextInputType.phone") == 0 ||
+      std::strcmp(name, "TextInputType.datetime") == 0)
+    return SCE_IME_TYPE_EXTENDED_NUMBER;
+  if (std::strcmp(name, "TextInputType.visiblePassword") == 0)
+    return SCE_IME_TYPE_BASIC_LATIN;
+  return SCE_IME_TYPE_DEFAULT;
+}
+
+// What the Enter key should say. The console offers three labels and a
+// default; Flutter has a dozen actions, so the ones without a match keep the
+// plain key rather than being forced into an approximation.
+SceUChar8 ImeEnterLabelFor(const char* action) {
+  if (action == nullptr) return SCE_IME_ENTER_LABEL_DEFAULT;
+  if (std::strcmp(action, "TextInputAction.search") == 0)
+    return SCE_IME_ENTER_LABEL_SEARCH;
+  if (std::strcmp(action, "TextInputAction.send") == 0)
+    return SCE_IME_ENTER_LABEL_SEND;
+  if (std::strcmp(action, "TextInputAction.go") == 0)
+    return SCE_IME_ENTER_LABEL_GO;
+  return SCE_IME_ENTER_LABEL_DEFAULT;
+}
+
+void OpenIme() {
+  if (g_ime.open) return;
+
+  // Seed it with what the field already holds, so editing an existing value
+  // does not start from empty.
+  Utf8ToUtf16(g_ime.pending, g_ime.initial, SCE_IME_MAX_TEXT_LENGTH);
+  std::memcpy(g_ime.text, g_ime.initial, sizeof g_ime.initial);
+
+  SceImeParam param;
+  sceImeParamInit(&param);
+  // Zero means "whatever the console is set to", which is the right default:
+  // this port has no business overriding the language its owner picked. If the
+  // firmware rejects it the retry below falls back to English.
+  param.supportedLanguages = 0;
+  param.languagesForced = SCE_FALSE;
+  param.type = ImeTypeFor(g_ime.type_name, g_ime.obscured);
+  param.enterLabel = ImeEnterLabelFor(g_ime.action_name);
+  param.inputTextBuffer = g_ime.text;
+  param.maxTextLength = SCE_IME_MAX_TEXT_LENGTH;
+  param.handler = ImeEventHandler;
+  param.filter = nullptr;
+  param.initialText = g_ime.initial;
+  param.arg = nullptr;
+  param.work = g_ime.work;
+
+  // libime validates each field separately, and on rejection it names the
+  // *kind* of field it disliked rather than just failing. That makes a
+  // rejection actionable: drop the refinement it objected to and ask again,
+  // rather than giving up and leaving the person with no keyboard.
+  //
+  // Measured on a PCH-2000, 2026-08-28: **this console's libime rejects
+  // MULTILINE outright.** Both MULTILINE|NO_ASSISTANCE and MULTILINE alone
+  // came back SCE_IME_ERROR_INVALID_OPTION and only 0 opened. So a multiline
+  // field gets a single-line keyboard, and whether that happened is recorded
+  // in multiline_active -- the field being multiline and the keyboard being
+  // multiline are different facts, and the Enter handling reads the second.
+  //
+  // NO_ASSISTANCE goes before MULTILINE because it is the more expendable of
+  // the two: it only suppresses the prediction bar.
+  param.option = (g_ime.multiline ? SCE_IME_OPTION_MULTILINE : 0) |
+                 SCE_IME_OPTION_NO_ASSISTANCE;
+
+  SceInt32 r = -1;
+  for (int attempt = 0; attempt < 6; attempt++) {
+    r = sceImeOpen(&param);
+    if (r >= 0) break;
+    const unsigned err = static_cast<unsigned>(r);
+    VLog("flutter-vita: sceImeOpen 0x%08X (type %u option 0x%X enter %u)\n",
+         err, (unsigned)param.type, (unsigned)param.option,
+         (unsigned)param.enterLabel);
+    if (err == SCE_IME_ERROR_INVALID_OPTION && param.option != 0) {
+      if ((param.option & SCE_IME_OPTION_NO_ASSISTANCE) != 0) {
+        param.option &= ~static_cast<SceUInt32>(SCE_IME_OPTION_NO_ASSISTANCE);
+      } else {
+        param.option = 0;
+      }
+    } else if (err == SCE_IME_ERROR_INVALID_ENTER_LABEL &&
+               param.enterLabel != SCE_IME_ENTER_LABEL_DEFAULT) {
+      param.enterLabel = SCE_IME_ENTER_LABEL_DEFAULT;
+    } else if (err == SCE_IME_ERROR_INVALID_TYPE &&
+               param.type != SCE_IME_TYPE_DEFAULT) {
+      param.type = SCE_IME_TYPE_DEFAULT;
+    } else if (err == SCE_IME_ERROR_INVALID_SUPPORTED_LANGUAGES &&
+               param.supportedLanguages != SCE_IME_LANGUAGE_ENGLISH) {
+      param.supportedLanguages = SCE_IME_LANGUAGE_ENGLISH;
+    } else {
+      // Nothing left to give up, or a failure that degrading cannot fix.
+      break;
+    }
+  }
+  if (r < 0) {
+    return;
+  }
+  g_ime.multiline_active = (param.option & SCE_IME_OPTION_MULTILINE) != 0;
+  g_ime.open = true;
+  VLog("flutter-vita: IME open (client %d, %s, type %u option 0x%X enter %u%s)\n",
+       g_ime.client_id, g_ime.type_name[0] != '\0' ? g_ime.type_name : "?",
+       (unsigned)param.type, (unsigned)param.option, (unsigned)param.enterLabel,
+       (g_ime.multiline && !g_ime.multiline_active) ? ", multiline refused"
+                                                    : "");
+}
+
+void CloseIme(bool user_dismissed) {
+  if (!g_ime.open) return;
+  sceImeClose();
+  g_ime.open = false;
+  // Give the screen back, or the framework keeps laying out around a keyboard
+  // that is no longer there.
+  g_ime.inset_bottom = 0.0;
+  g_ime.metrics_dirty = true;
+  VLog("flutter-vita: IME closed%s\n", user_dismissed ? " by the user" : "");
+
+  // Only when the user closed it. If the framework asked us to hide, echoing a
+  // close back at it would be reporting its own request as news.
+  if (user_dismissed && g_ime.client_id >= 0) {
+    char json[192];
+    std::snprintf(json, sizeof json,
+                  "{\"method\":\"TextInputClient.onConnectionClosed\","
+                  "\"args\":[%d]}",
+                  g_ime.client_id);
+    SendTextInputMethod(json);
+  }
+}
+
+// |FlutterProjectArgs::log_message_callback|
+void OnLogMessage(const char* tag, const char* message, void* /* user_data */) {
+  // One write, not two: the log is read by pulling the whole file, and a
+  // torn line from another thread interleaving between tag and message is a
+  // line that cannot be grepped.
+  char line[512];
+  const int n = std::snprintf(line, sizeof line, "[%s] %s\n",
+                              tag != nullptr ? tag : "dart",
+                              message != nullptr ? message : "");
+  if (n > 0) {
+    VLogRaw(line, static_cast<size_t>(n) < sizeof line
+                      ? static_cast<size_t>(n)
+                      : sizeof line - 1);
+  }
+}
+
+void OnPlatformMessage(const FlutterPlatformMessage* message,
+                       void* /* user_data */) {
+  if (message == nullptr) return;
+
+  char preview[161];
+  size_t n = message->message_size;
+  if (n > sizeof preview - 1) n = sizeof preview - 1;
+  for (size_t i = 0; i < n; i++) {
+    const char c = static_cast<const char*>(
+        static_cast<const void*>(message->message))[i];
+    // Control bytes would break the log into unreadable pieces, and the binary
+    // codec is full of them.
+    preview[i] = (c >= 0x20 && c < 0x7F) ? c : '.';
+  }
+  preview[n] = '\0';
+  // The stats channel is polled once a second by any app with the HUD strip;
+  // a log line per poll would be most of the log. The plugins' channels
+  // (vita/sensors, vita/camera) poll faster still: their first ten
+  // messages are logged, then one in a hundred.
+  const bool is_stats = message->channel != nullptr &&
+                        std::strcmp(message->channel, "vita/stats") == 0;
+  bool quiet = is_stats;
+  if (!quiet && message->channel != nullptr &&
+      std::strncmp(message->channel, "vita/", 5) == 0 &&
+      std::strcmp(message->channel, "vita/hardware") != 0) {
+    static struct {
+      char name[32];
+      unsigned count;
+    } seen[16];
+    for (auto& e : seen) {
+      if (e.name[0] == '\0') {
+        std::snprintf(e.name, sizeof e.name, "%s", message->channel);
+      }
+      if (std::strcmp(e.name, message->channel) == 0) {
+        e.count++;
+        quiet = e.count > 10 && e.count % 100 != 0;
+        break;
+      }
+    }
+  }
+  if (!quiet) {
+    VLog("flutter-vita: channel %s [%u] %s%s\n",
+         message->channel != nullptr ? message->channel : "(null)",
+         static_cast<unsigned>(message->message_size), preview,
+         message->message_size > n ? "..." : "");
+  }
+
+  if (is_stats) {
+    // What the console is doing this second, for a HUD. JSONMethodCodec,
+    // method `read`, one object back. Frame times are not here: Dart has them
+    // from FrameTiming with less plumbing and the same clock. What only this
+    // side can see is the cores, the GPU, the battery and the memory.
+    //
+    // Each rate is over the interval since the previous read, so the first
+    // read after launch reports zeros for them.
+    static uint64_t last_us = 0;
+    static uint64_t last_idle[4] = {0, 0, 0, 0};
+    static unsigned last_gpu_us = 0, last_gpu_frames = 0;
+    const uint64_t now = sceKernelGetSystemTimeWide();
+    const uint64_t window = last_us != 0 ? now - last_us : 0;
+    unsigned idle_pct[4] = {0, 0, 0, 0};
+    SceKernelSystemInfo sys;
+    std::memset(&sys, 0, sizeof sys);
+    sys.size = sizeof sys;
+    if (sceKernelGetSystemInfo(&sys) >= 0) {
+      for (int c = 0; c < 4; c++) {
+        const uint64_t idle = sys.cpuInfo[c].idleClock;
+        if (window != 0 && idle >= last_idle[c]) {
+          const uint64_t d = idle - last_idle[c];
+          idle_pct[c] = static_cast<unsigned>(d * 100 / window);
+          if (idle_pct[c] > 100) idle_pct[c] = 100;
+        }
+        last_idle[c] = idle;
+      }
+    }
+    // GPU time is the layer's display-queue latency summed over the frames it
+    // flipped: from queueing a frame to the GPU finishing it. Over the wall
+    // interval that is "busy"; it passes 100% when frames queue behind each
+    // other, which is the point at which the GPU is the bottleneck.
+    unsigned gpu_pct = 0, gpu_us_per_frame = 0;
+    if (g_gl_enabled) {
+      unsigned frames = 0;
+      const unsigned gpu_us = flutter_vita_gl_gpu_us(&frames);
+      if (window != 0 && gpu_us >= last_gpu_us) {
+        const unsigned d = gpu_us - last_gpu_us;
+        gpu_pct = static_cast<unsigned>(static_cast<uint64_t>(d) * 100 / window);
+        const unsigned df = frames - last_gpu_frames;
+        if (df != 0) gpu_us_per_frame = d / df;
+      }
+      last_gpu_us = gpu_us;
+      last_gpu_frames = frames;
+    }
+    last_us = now;
+    SceKernelFreeMemorySizeInfo mem;
+    mem.size = sizeof(mem);
+    int mem_user_k = -1, mem_cdram_k = -1, mem_phycont_k = -1;
+    if (sceKernelGetFreeMemorySize(&mem) >= 0) {
+      mem_user_k = mem.size_user / 1024;
+      mem_cdram_k = mem.size_cdram / 1024;
+      mem_phycont_k = mem.size_phycont / 1024;
+    }
+    // The totals the free figures are out of: the process's budgets, fixed
+    // at launch, so read once. A free figure without its total says nothing
+    // about how close the app is to the wall; the HUD shows used / total.
+    //
+    // On 3.73 both the SceAppMgrUser wrapper and the syscall under it answer
+    // 0x8080201C to this process (gallery builds 41 and 42, launched from
+    // the receiver and from the home screen alike), so the totals fall back
+    // to the standard application budget: 256 MiB of main memory, 112 MiB
+    // of CDRAM, 26 MiB physically contiguous. The 26 is what
+    // sceKernelGetFreeMemorySize reports before anything is allocated; the
+    // other two agree with the first sample (free + the 160 MiB arena + the
+    // 22 MiB ELF under 256; free + the layer's 23 MiB of CDRAM at 112).
+    // `budget` in the reply names the source, "api" or "standard".
+    static int total_user_k = -2, total_cdram_k = -2, total_phycont_k = -2;
+    static const char* budget_source = "none";
+    if (total_user_k == -2) {
+      SceAppMgrBudgetInfo budget;
+      std::memset(&budget, 0, sizeof budget);
+      budget.size = sizeof budget;
+      // The SceAppMgrUser wrapper answered 0x8080201C on 3.73 (gallery
+      // build 41); the syscall behind it is tried second.
+      int brc = sceAppMgrGetBudgetInfo(&budget);
+      if (brc < 0) {
+        VLog("flutter-vita: sceAppMgrGetBudgetInfo: 0x%08X, trying the "
+             "syscall\n",
+             static_cast<unsigned>(brc));
+        std::memset(&budget, 0, sizeof budget);
+        budget.size = sizeof budget;
+        brc = _sceAppMgrGetBudgetInfo(&budget);
+      }
+      if (brc >= 0) {
+        total_user_k = static_cast<int>(budget.total_user_rw_mem / 1024);
+        total_cdram_k = static_cast<int>(budget.total_cdram_mem / 1024);
+        total_phycont_k = static_cast<int>(budget.total_phycont_mem / 1024);
+        budget_source = "api";
+        VLog("flutter-vita: budget user=%uK cdram=%uK phycont=%uK "
+             "extra=%s %uK (mode %d)\n",
+             budget.total_user_rw_mem / 1024, budget.total_cdram_mem / 1024,
+             budget.total_phycont_mem / 1024,
+             budget.extra_mem_allowed ? "allowed" : "no",
+             budget.total_extra_mem / 1024, budget.app_mode);
+      } else {
+        total_user_k = 256 * 1024;
+        total_cdram_k = 112 * 1024;
+        total_phycont_k = 26 * 1024;
+        budget_source = "standard";
+        VLog("flutter-vita: _sceAppMgrGetBudgetInfo: 0x%08X; the totals "
+             "are the standard budget, 256M/112M/26M\n",
+             static_cast<unsigned>(brc));
+      }
+    }
+    const HeapSample heap = HeapNow();
+    // The arena's cap is the app's, set before main; mallinfo's arena is
+    // only what malloc has taken of it so far.
+    const unsigned heap_cap_mb =
+        &_newlib_heap_size_user != nullptr
+            ? _newlib_heap_size_user / (1024 * 1024)
+            : heap.arena_mb;
+    // Battery: the only temperature user mode can read on this console. The
+    // SoC's needs the kernel (PSVshell reads it as a plugin), which this
+    // project does not do (ADR-0001), so the HUD labels this one "battery".
+    const int batt_c100 = scePowerGetBatteryTemp();
+    char reply[640];
+    const int rn = std::snprintf(
+        reply, sizeof reply,
+        "[{\"cpu_idle\":[%u,%u,%u,%u],\"gpu_pct\":%u,\"gpu_us\":%u,"
+        "\"batt_c\":%d.%02d,\"batt_pct\":%d,\"charging\":%s,"
+        "\"mem_user_k\":%d,\"mem_cdram_k\":%d,\"mem_phycont_k\":%d,"
+        "\"total_user_k\":%d,\"total_cdram_k\":%d,\"total_phycont_k\":%d,"
+        "\"budget\":\"%s\","
+        "\"heap_mb\":%u,\"heap_arena_mb\":%u,\"heap_cap_mb\":%u,"
+        "\"arm_mhz\":%d,\"bus_mhz\":%d,\"gpu_mhz\":%d,\"window_us\":%u}]",
+        idle_pct[0], idle_pct[1], idle_pct[2], idle_pct[3], gpu_pct,
+        gpu_us_per_frame, batt_c100 / 100, std::abs(batt_c100 % 100),
+        scePowerGetBatteryLifePercent(),
+        scePowerIsBatteryCharging() ? "true" : "false", mem_user_k,
+        mem_cdram_k, mem_phycont_k, total_user_k, total_cdram_k,
+        total_phycont_k, budget_source, heap.used_mb, heap.arena_mb,
+        heap_cap_mb,
+        scePowerGetArmClockFrequency(), scePowerGetBusClockFrequency(),
+        scePowerGetGpuClockFrequency(), static_cast<unsigned>(window));
+    if (message->response_handle != nullptr && g_engine != nullptr && rn > 0) {
+      FlutterEngineSendPlatformMessageResponse(
+          g_engine, message->response_handle,
+          reinterpret_cast<const uint8_t*>(reply), static_cast<size_t>(rn));
+    }
+    return;
+  }
+
+  if (message->channel != nullptr &&
+      std::strcmp(message->channel, "vita/hardware") == 0) {
+    // Hardware checks for the gallery's Hardware tab: cameras, audio, motion,
+    // touch panels, buttons, storage. The code is the app's, in
+    // templates/vita-app/hardware.c, behind this weak hook, so a shipping app
+    // drops it the way it drops the bail-out. Without the hook every method
+    // answers with an error envelope and the tab says so.
+    const char* body = reinterpret_cast<const char*>(message->message);
+    const size_t len = message->message_size;
+    const char* m = JsonFindValue(body, len, "method");
+    char method[48] = {0};
+    if (m != nullptr) JsonUnescape(m, body + len, method, sizeof method);
+    if (flutter_vita_hardware_call_async != nullptr &&
+        message->response_handle != nullptr && g_engine != nullptr) {
+      // The response handle is the context; the app's thread completes it.
+      // FlutterEngineSendPlatformMessageResponse posts the completion to
+      // the UI task runner, so any thread may call it.
+      auto respond = [](void* ctx, const char* reply, size_t n) {
+        FlutterEngineSendPlatformMessageResponse(
+            g_engine,
+            static_cast<const FlutterPlatformMessageResponseHandle*>(ctx),
+            reinterpret_cast<const uint8_t*>(reply), n);
+      };
+      if (flutter_vita_hardware_call_async(
+              method, body, len, respond,
+              const_cast<FlutterPlatformMessageResponseHandle*>(
+                  message->response_handle)) == 0) {
+        return;
+      }
+    }
+    static char reply[64 * 1024];
+    int rn = -1;
+    if (flutter_vita_hardware_call != nullptr) {
+      rn = flutter_vita_hardware_call(method, body, len, reply, sizeof reply);
+    }
+    if (rn < 0) {
+      rn = std::snprintf(reply, sizeof reply,
+                         "[\"unavailable\",\"%s: %s\",null]", method,
+                         flutter_vita_hardware_call == nullptr
+                             ? "hardware.c is not in this build"
+                             : "the check failed");
+    }
+    if (message->response_handle != nullptr && g_engine != nullptr && rn > 0) {
+      FlutterEngineSendPlatformMessageResponse(
+          g_engine, message->response_handle,
+          reinterpret_cast<const uint8_t*>(reply), static_cast<size_t>(rn));
+    }
+    return;
+  }
+
+  if (message->channel != nullptr &&
+      std::strcmp(message->channel, "vita/browser") == 0) {
+    // Opening a link means leaving.
+    //
+    // There is no in-app browser to be had: a webview needs a browser engine
+    // rendering into our frame, and this port has neither one nor room for
+    // one. What the console does have is its own browser, and
+    // sceAppUtilLaunchWebBrowser hands it a URL and switches to it -- the app
+    // stays resident and is returned to when the browser closes.
+    //
+    // So a tapped link behaves the way it does on a console rather than the
+    // way it does on a phone, and that is the platform being honest rather
+    // than a shortfall. url_launcher_vita is the Dart half; anything wanting
+    // an *embedded* browser is out of reach and should be told so plainly.
+    const char* body = reinterpret_cast<const char*>(message->message);
+    const size_t len = message->message_size;
+    const char* m = JsonFindValue(body, len, "method");
+    char method[32] = {0};
+    if (m != nullptr) JsonUnescape(m, body + len, method, sizeof method);
+
+    bool ok = false;
+    if (std::strcmp(method, "launch") == 0) {
+      const char* u = JsonFindValue(body, len, "url");
+      char url[1024] = {0};
+      if (u != nullptr) JsonUnescape(u, body + len, url, sizeof url);
+      if (url[0] != '\0') {
+        SceAppUtilWebBrowserParam param;
+        std::memset(&param, 0, sizeof param);
+        param.str = url;
+        param.strlen = static_cast<SceSize>(std::strlen(url));
+        // 0 is "open this URL". The header names no constants for the field,
+        // and the other modes are for local content we have no use for.
+        param.launchMode = 0;
+        const int r = sceAppUtilLaunchWebBrowser(&param);
+        ok = r >= 0;
+        std::printf("flutter-vita: browser launch %s -> 0x%08X\n", url,
+                    static_cast<unsigned>(r));
+      }
+    } else if (std::strcmp(method, "canLaunch") == 0) {
+      // The browser is part of the system software, so it is always there.
+      // Answering honestly here matters: url_launcher's own API asks first and
+      // apps hide UI on a false.
+      ok = true;
+    }
+
+    if (message->response_handle != nullptr && g_engine != nullptr) {
+      // JSONMethodCodec: a success envelope is a one-element list.
+      const char* reply = ok ? "[true]" : "[false]";
+      FlutterEngineSendPlatformMessageResponse(
+          g_engine, message->response_handle,
+          reinterpret_cast<const uint8_t*>(reply), std::strlen(reply));
+    }
+    return;
+  }
+
+  if (message->channel != nullptr &&
+      std::strcmp(message->channel, "vita/shell") == 0) {
+    // Handing a folder to VitaShell, which is the console's file manager and
+    // is somebody else's application.
+    //
+    // There is no deep link to it. Its main() takes argc and argv and ignores
+    // both, it registers no URI scheme, and the only launch parameter it reads
+    // is its own title id. What it *does* do, at browser.c:796, is read
+    // ux0:VitaShell/internal/lastdir.txt on startup and navigate there. So the
+    // way to open it at a path is to write that file and then launch it.
+    //
+    // Three things the source says about that, all of which this honours:
+    //
+    //   * change_to_directory() begins with checkFolderExist(), so the value
+    //     has to be a directory. A file path is rejected outright and the user
+    //     lands in `home`.
+    //   * It is written as strlen(path) + 1 bytes, NUL included, because
+    //     VitaShell's ReadFile() reads into an uninitialised stack buffer and
+    //     does not terminate a short read.
+    //   * VitaShell rewrites the file on every navigation and on exit, so this
+    //     is consumed rather than left behind.
+    //
+    // Launching it ends this process. The Vita runs one application at a time,
+    // and the shell asks "close the current application?" if we are still
+    // running when the launch lands -- so the exit is immediate and nothing
+    // goes between it and the launch. Same sequence as the crash bailout in
+    // templates/vita-app/bailout.c.
+    const char* body = reinterpret_cast<const char*>(message->message);
+    const size_t len = message->message_size;
+    const char* m = JsonFindValue(body, len, "method");
+    char method[32] = {0};
+    if (m != nullptr) JsonUnescape(m, body + len, method, sizeof method);
+
+    bool ok = false;
+    bool leaving = false;
+    char folder[512] = {0};
+
+    // Whether VitaShell is installed at all. It is homebrew; plenty of
+    // consoles have it and a caller must be able to hide the button on the
+    // ones that do not.
+    SceIoStat st;
+    std::memset(&st, 0, sizeof st);
+    const bool installed =
+        sceIoGetstat("ux0:app/VITASHELL", &st) >= 0 && SCE_S_ISDIR(st.st_mode);
+
+    if (std::strcmp(method, "available") == 0) {
+      ok = installed;
+    } else if (std::strcmp(method, "openFolder") == 0) {
+      const char* p = JsonFindValue(body, len, "path");
+      if (p != nullptr) JsonUnescape(p, body + len, folder, sizeof folder);
+      if (installed && folder[0] != '\0') {
+        // Trailing separator trimmed: checkFolderExist is happier without one
+        // and VitaShell writes its own paths back without.
+        size_t fl = std::strlen(folder);
+        while (fl > 1 && folder[fl - 1] == '/') folder[--fl] = '\0';
+
+        // Best effort. If VitaShell has ever run these exist; if the write
+        // fails the launch still happens and lands in `home`, which is a worse
+        // answer than the right folder and a much better one than nothing.
+        sceIoMkdir("ux0:VitaShell", 0777);
+        sceIoMkdir("ux0:VitaShell/internal", 0777);
+        const SceUID fd =
+            sceIoOpen("ux0:VitaShell/internal/lastdir.txt",
+                      SCE_O_WRONLY | SCE_O_CREAT | SCE_O_TRUNC, 0777);
+        if (fd >= 0) {
+          sceIoWrite(fd, folder, fl + 1);
+          sceIoClose(fd);
+        }
+        ok = true;
+        leaving = true;
+      }
+    }
+
+    if (message->response_handle != nullptr && g_engine != nullptr) {
+      const char* reply = ok ? "[true]" : "[false]";
+      FlutterEngineSendPlatformMessageResponse(
+          g_engine, message->response_handle,
+          reinterpret_cast<const uint8_t*>(reply), std::strlen(reply));
+    }
+
+    if (leaving) {
+      VLog("flutter-vita: handing off to VitaShell at %s\n", folder);
+      flutter_vita_gpu_shutdown();
+      flutter_vita_log_flush();
+      sceKernelDelayThread(200 * 1000);
+      sceAppMgrLaunchAppByUri(0xFFFFF, "psgm:play?titleid=VITASHELL");
+      // Nothing may go between the launch and this line.
+      sceKernelExitProcess(0);
+    }
+    return;
+  }
+
+  if (message->channel != nullptr &&
+      std::strcmp(message->channel, "flutter/textinput") == 0) {
+    const char* body = reinterpret_cast<const char*>(message->message);
+    const size_t len = message->message_size;
+    const char* m = JsonFindValue(body, len, "method");
+    char method[64] = {0};
+    if (m != nullptr) JsonUnescape(m, body + len, method, sizeof method);
+
+    if (std::strcmp(method, "TextInput.setClient") == 0) {
+      // args is [clientId, configuration]. The id is the first token after the
+      // opening bracket, and the two configuration keys that change the dialog
+      // are the ones read here; everything else in it describes behaviour a
+      // modal system keyboard does not have.
+      const char* a = JsonFindValue(body, len, "args");
+      if (a != nullptr) {
+        while (a < body + len && (*a == '[' || *a == ' ')) a++;
+        g_ime.client_id = std::atoi(a);
+      }
+      // The first "name" in this payload is inputType's -- the configuration
+      // puts inputType before anything else that carries one.
+      const char* name = JsonFindValue(body, len, "name");
+      g_ime.type_name[0] = '\0';
+      if (name != nullptr) {
+        JsonUnescape(name, body + len, g_ime.type_name, sizeof g_ime.type_name);
+      }
+      g_ime.multiline =
+          std::strcmp(g_ime.type_name, "TextInputType.multiline") == 0;
+      const char* act = JsonFindValue(body, len, "inputAction");
+      g_ime.action_name[0] = '\0';
+      if (act != nullptr) {
+        JsonUnescape(act, body + len, g_ime.action_name,
+                     sizeof g_ime.action_name);
+      }
+      const char* obsc = JsonFindValue(body, len, "obscureText");
+      g_ime.obscured = obsc != nullptr && std::strncmp(obsc, "true", 4) == 0;
+    } else if (std::strcmp(method, "TextInput.setEditingState") == 0) {
+      const char* t = JsonFindValue(body, len, "text");
+      if (t != nullptr) {
+        JsonUnescape(t, body + len, g_ime.pending, sizeof g_ime.pending);
+      }
+    } else if (std::strcmp(method, "TextInput.show") == 0) {
+      // Shown whenever the framework asks, autofocus included.
+      //
+      // There used to be a rule here that a show was ignored unless a finger
+      // had touched the screen within the last second. That was not caution
+      // about input, it was a workaround for the modal dialog: focusing a
+      // field and covering the whole display were the same action, so an
+      // autofocused field blanked the app before the user had seen it. An
+      // overlay keyboard takes the bottom of the screen and leaves the app
+      // visible, which is what every phone does on autofocus, so the rule has
+      // nothing left to protect.
+      OpenIme();
+    } else if (std::strcmp(method, "TextInput.hide") == 0 ||
+               std::strcmp(method, "TextInput.clearClient") == 0) {
+      CloseIme();
+      if (std::strcmp(method, "TextInput.clearClient") == 0) {
+        g_ime.client_id = -1;
+      }
+    }
+  }
+
+  if (message->channel != nullptr &&
+      std::strncmp(message->channel, "vita/", 5) == 0 &&
+      flutter_vita_channel_call != nullptr &&
+      message->response_handle != nullptr && g_engine != nullptr) {
+    const char* body = reinterpret_cast<const char*>(message->message);
+    const size_t len = message->message_size;
+    const char* m = JsonFindValue(body, len, "method");
+    char method[64] = {0};
+    if (m != nullptr) JsonUnescape(m, body + len, method, sizeof method);
+    auto respond = [](void* ctx, const char* reply, size_t n) {
+      FlutterEngineSendPlatformMessageResponse(
+          g_engine,
+          static_cast<const FlutterPlatformMessageResponseHandle*>(ctx),
+          reinterpret_cast<const uint8_t*>(reply), n);
+    };
+    if (flutter_vita_channel_call(
+            message->channel, method, body, len, respond,
+            const_cast<FlutterPlatformMessageResponseHandle*>(
+                message->response_handle)) == 0) {
+      return;
+    }
+    // Not the app's either: the empty reply below, which the framework
+    // turns into MissingPluginException, the honest answer.
+  }
+
+  if (message->response_handle != nullptr && g_engine != nullptr) {
+    FlutterEngineSendPlatformMessageResponse(g_engine,
+                                             message->response_handle,
+                                             nullptr, 0);
+  }
+}
+
+// Pump the IME, from the main loop.
+//
+// libime does its work inside sceImeUpdate: it samples touches, redraws the
+// keyboard and calls the handler for anything that happened. So it runs every
+// frame the keyboard is up, and on one thread only.
+//
+// Compositing is split by renderer, because the two paths own the display
+// differently. Under GL, the layer runs sceCommonDialogUpdate inside its
+// swap, gated on the argument to flutter_vita_gl_swap -- PresentSurface passes
+// 1 while this is open. On the software path nothing else would do it, so it
+// happens here, against the framebuffer this file allocated.
+void PumpIme(FlutterEngine engine) {
+  if (!g_ime.open && !g_ime.metrics_dirty) return;
+
+  if (g_ime.open) {
+    if (!g_gl_enabled) {
+      UpdateCommonDialog();
+    }
+    sceImeUpdate();
+  }
+
+  // After the update, not before: the handler runs inside it, so an OPEN or
+  // CHANGE_SIZE that arrives there reaches the framework this frame rather
+  // than the next one.
+  if (g_ime.metrics_dirty) {
+    g_ime.metrics_dirty = false;
+    SendWindowMetrics(engine);
+  }
+}
+
+int main(int argc, char** argv) {
+  OpenLog();
+  VLog("flutter-vita: starting\n");
+
+  // Watch every thread this process ever starts, before it starts any.
+  //
+  // 0x10027 is the process-wide target documented on
+  // sceKernelRegisterThreadEventHandler, and it is what makes the stall report
+  // cover the display queue and SceNet's workers rather than only the threads
+  // this file happens to know about. If it is refused, the report still works
+  // -- fml announces the four that matter through flutter_vita_log_affinity --
+  // so this logs and carries on rather than failing a launch over a
+  // diagnostic.
+  NoteThread(sceKernelGetThreadId(), "main");
+  const SceUID watcher = sceKernelRegisterThreadEventHandler(
+      "fvita_threads", 0x10027,
+      SCE_KERNEL_THREAD_EVENT_TYPE_START | SCE_KERNEL_THREAD_EVENT_TYPE_EXIT,
+      ThreadEvent, nullptr);
+  if (watcher < 0) {
+    VLog("flutter-vita: thread watcher refused (0x%08X); stall reports will "
+         "only list named threads\n",
+         static_cast<unsigned>(watcher));
+  }
+
+  // Before the engine, deliberately. If startup hangs or dies, the dev server
+  // is already answering and the log can be pulled without the app exiting.
+  StartDevServer();
+
+  // Clock the console up before anything is measured on it.
+  //
+  // The Vita starts an application at 333 MHz with the bus and GPU well below
+  // their maximums, and nothing in this port ever raised them -- so every
+  // number this project has recorded, back to Phase 0.5, was taken on a
+  // downclocked console. 444 MHz is what essentially every homebrew title
+  // sets, it is the hardware's rated speed rather than an overclock, and the
+  // GPU work in ADR-0014 makes the bus and GXM clocks matter too.
+  //
+  // This is on the critical path for the thing that actually hurts. The GL
+  // measurements on 2026-08-22 put localsend's frame at ~200 ms of which
+  // ~185 ms is the UI thread, and a screen transition at ~400 ms of which
+  // 95% is the UI thread. That is Dart executing on this CPU, so a third more
+  // clock is a third off the part that dominates.
+  //
+  // It costs battery and heat, which is the trade every other Vita
+  // application already makes.
+  scePowerSetArmClockFrequency(444);
+  scePowerSetBusClockFrequency(222);
+  scePowerSetGpuClockFrequency(222);
+  scePowerSetGpuXbarClockFrequency(166);
+  VLog("flutter-vita: clocks arm=%d bus=%d gpu=%d xbar=%d\n",
+       scePowerGetArmClockFrequency(), scePowerGetBusClockFrequency(),
+       scePowerGetGpuClockFrequency(), scePowerGetGpuXbarClockFrequency());
+
+  // Which backend, decided once and here.
+  //
+  // **Software by default, GL on request**, which is the opposite of what
+  // ADR-0014's measurements alone would suggest and is decided by a different
+  // fact: under GL a hard crash takes the whole console down.
+  //
+  // A data abort runs no user code. bailout.c says so in its own first
+  // paragraph -- excpmgr is kernel-only, and a fault is not an exception -- so
+  // nothing releases the GXM context or drains the display queue, and the
+  // driver the shell composites through goes with the process. The PS button
+  // stops responding and the console needs the power button. The software path
+  // has none of this: it owns a CDRAM block and a memcpy, the supervisor
+  // notices the app died, and the loader comes back.
+  //
+  // Verified on 2026-08-22, both directions: `handoff`, `relaunch` and the
+  // abort path all recover cleanly now that they release the GPU first, and a
+  // deliberate `crash` -- a write to address zero -- still wedges the console.
+  //
+  // So GL costs a power cycle per hard crash, on a port that still has them.
+  // That is a bad trade for a default and a fine trade for a deliberate
+  // measurement, so it is opt-in:
+  //
+  //   ux0:data/flutter-vita/gl.on   -- a '1' here selects the GPU path
+  //
+  // Revisit when crashes are rare enough that the cost is theoretical, or if a
+  // way is found to release the GPU from outside the faulting process.
+  // **GPU by default, software on request**, flipped 2026-08-24 from the
+  // opposite default.
+  //
+  //   ux0:data/flutter-vita/software.on   -- a '1' here forces the CPU path
+  //
+  // The benchmark decided it. Worst-frame, software over GL, on the twelve
+  // scenes of ADR-0017 with a warm shader cache: 16.67x on a hero transition,
+  // 15.13x on a backdrop blur, 7.25x on a saveLayer tint, 5.20x on image
+  // scaling. The two scenes GL loses -- transform_scale at 0.86x and
+  // list_churn at 0.90x -- lose by margins that do not pay for making every
+  // other scene slower by default.
+  //
+  // The cache matters, and the first measurement of it was wrong. The GL
+  // compiles each shader on first use and keeps it on the card (vitaGL in
+  // ux0:data/shader_cache/<TITLEID>, fvita_gles2 in ux0:data/fvita_gles2/cache),
+  // at 200-400 ms apiece. A cold-cache run
+  // charges that to whichever frame happens to need the shader, which put
+  // blur_backdrop at 0.95x and read as "the GPU cannot help a blur". Warm, it
+  // is 133 ms against software's 2017 ms. Any GL number taken on a fresh
+  // install is a number about compilation, not about rastering.
+  //
+  // What has not changed is why the old default existed: a hard crash under
+  // GL can still wedge the console, because a data abort runs no user code and
+  // nothing releases the GXM context. That risk is now taken deliberately in
+  // exchange for the numbers above, and the escape hatch is one `put` away
+  // rather than a rebuild.
+  //
+  // One thing still wants the CPU path and gets it: the loader forces it
+  // through the strong symbol below, because the component that recovers from
+  // crashes is the last one permitted to cause an unrecoverable one
+  // (ADR-0016 decision 7).
+  //
+  // Text input was the second until 2026-08-28. That was true of sceImeDialog,
+  // which took the screen under GL and never gave it back; libime composites
+  // over both paths and the reason to prefer software for a text field is
+  // gone.
