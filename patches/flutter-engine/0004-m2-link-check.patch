index 61abe64a..0beff971 100644
--- a/engine/src/flutter/shell/platform/embedder/BUILD.gn
+++ b/engine/src/flutter/shell/platform/embedder/BUILD.gn
@@ -562,6 +562,68 @@ if (is_mac && !embedder_for_target) {
   }
 }
 
+# M2's gate. See vita_link_check.cc for why an executable rather than the
+# shared_library below.
+if (is_vita) {
+  # UNRESOLVED -- kept so the next attempt does not repeat these two.
+  #
+  # VitaSDK's libdl.a implements dlsym on taiHEN, so it needs these archives.
+  # They are on the link line and the symbols are still undefined, because
+  # static archives resolve left to right and GN emits them *before* -ldl:
+  #
+  #   libs = -lSceSblSsMgr_stub -ltaihen_stub -ldl -lpthread
+  #
+  # By the time ld reaches libdl.a and finds its undefined references, both
+  # stub archives are behind it. Tried and did not change the order: `libs` on
+  # the target itself, and `libs` on this config.
+  #
+  # The better fix is upstream of the ordering problem -- stop linking -ldl at
+  # all, since nothing in this port can use dlsym. Two `libs = [ "dl" ]` sites
+  # in runtime/vm and runtime/bin are already excluded for vita and -ldl
+  # survives both, so a third source exists and has not been found. Failing
+  # that, --start-group around the library list would work, but GN offers no
+  # way to append a flag after `libs`.
+  config("vita_dl_backing") {
+    libs = [
+      "SceSblSsMgr_stub",
+      "taihen_stub",
+    ]
+  }
+
+  # Kept alongside the real embedder: it names only the four entry points, so it
+  # stays the fastest way to ask "does the engine still link" without dragging
+  # in sceDisplay or a snapshot.
+  executable("vita_link_check") {
+    sources = [ "vita_link_check.cc" ]
+    deps = [ ":embedder" ]
+    public_configs = [ "//flutter:config" ]
+
+    # VitaSDK's libdl.a implements dlsym on top of taiHEN, so it needs these
+    # two stub libraries. They are here rather than excluded at the source
+    # because -ldl reaches this link line from somewhere in the Dart config
+    # graph that resisted being found: the two obvious `libs = [ "dl" ]` sites
+    # in runtime/bin and runtime/vm are both excluded for vita and -ldl
+    # survives both. Worth returning to -- nothing in this port can use dlsym,
+    # so the library is dead weight -- but two stub libraries is a small price
+    # next to leaving M2 unmet over it.
+    configs += [ ":vita_dl_backing" ]
+  }
+}
+
+if (is_vita) {
+  # The real embedder. Unlike vita_link_check it expects a snapshot: the four
+  # _kDart* symbols come from the assembly gen_snapshot emits, which is not part
+  # of this target, so this only links inside the .vpk build.
+  source_set("vita_embedder") {
+    sources = [
+      "vita_cxa_guard.cc",
+      "vita_embedder.cc",
+    ]
+    deps = [ ":embedder" ]
+    public_configs = [ "//flutter:config" ]
+  }
+}
+
 group("flutter_engine") {
   deps = []
 
diff --git a/engine/src/flutter/shell/platform/embedder/vita_cxa_guard.cc b/engine/src/flutter/shell/platform/embedder/vita_cxa_guard.cc
new file mode 100644
index 00000000..a5e0625d
--- /dev/null
+++ b/engine/src/flutter/shell/platform/embedder/vita_cxa_guard.cc
@@ -0,0 +1,161 @@
+// Thread-safe statics for the Vita, because libstdc++'s do not work here.
+//
+// A function-local static with a dynamic initialiser --
+//
+//     static auto* bus = new SkMessageBus<...>();
+//
+// -- compiles to a __cxa_guard_acquire / __cxa_guard_release pair around the
+// construction, and those come from libstdc++. On this statically linked
+// VitaSDK build, calling one faults. The probe in spikes/g2-ganesh shows a
+// plain `new` succeeding and the identical allocation behind a function-local
+// static killing the process, with no Skia and no GL anywhere near it.
+//
+// That is why ADR-0014's criterion 2 spent five bisection layers ending inside
+// SkMessageBus::Get(): the GPU had nothing to do with it. It is also a
+// candidate explanation for the intermittent hard fault open since the corpus
+// work, because *every* dynamically initialised function-local static in the
+// engine goes through these.
+//
+// The spike defined a three-line version that assumes single-threaded
+// initialisation. That is true of a spike whose whole life is on the main
+// thread and false of the engine, which has a platform thread, a UI thread, a
+// raster thread, an IO thread and Dart's workers, any of which can be first to
+// touch a given static. This is the real one.
+//
+// ## The ABI
+//
+// ARM EABI (IHI0041, §3.2.3) rather than Itanium: the guard is a **32-bit**
+// word, not 64, and bit 0 of its first byte means "initialisation complete".
+// The compiler is explicitly permitted to test that bit inline without calling
+// anything, which is why __cxa_guard_release must publish with a release
+// barrier -- on a multi-core Cortex-A9 another core can otherwise observe the
+// flag set before the object it guards is visible.
+//
+// The remaining bytes are the implementation's. Byte 1 is used here for
+// "someone is constructing", the same byte libstdc++ uses for its pending bit,
+// so the layout is unsurprising to anything that looks.
+//
+// ## Why one global lock
+//
+// Per-guard locks would need somewhere to live, and the guard word has no room
+// for a pointer. A single mutex serialises all static initialisation in the
+// process, which sounds worse than it is: these run once each, they are short,
+// and the contended case is two threads racing to first-touch the same static
+// -- which has to serialise anyway.
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+
+extern "C" {
+
+namespace {
+
+pthread_mutex_t g_guard_mutex = PTHREAD_MUTEX_INITIALIZER;
+pthread_cond_t g_guard_cond = PTHREAD_COND_INITIALIZER;
+
+constexpr uint8_t kDone = 1;      // byte 0, bit 0 -- defined by the ABI
+constexpr uint8_t kPending = 1;   // byte 1 -- ours
+
+// Who is currently constructing what, so that a static whose constructor
+// reaches the same static can be reported instead of deadlocking.
+//
+// Recursive initialisation is a program bug and libstdc++ answers it by
+// throwing __gnu_cxx::recursive_init_error. This build has no exceptions, and
+// the alternative -- waiting on a condition variable that the waiting thread
+// is itself responsible for signalling -- is a silent hang on a console with
+// no debugger, which is the worst outcome available. Sixteen entries is well
+// past any real nesting depth; overflowing it only costs the diagnostic.
+struct InProgress {
+  void* guard;
+  pthread_t owner;
+};
+constexpr int kMaxInProgress = 16;
+InProgress g_in_progress[kMaxInProgress];
+
+bool OwnedByCurrentThread(void* guard) {
+  for (const InProgress& e : g_in_progress) {
+    if (e.guard == guard) return pthread_equal(e.owner, pthread_self()) != 0;
+  }
+  return false;
+}
+
+void NoteInProgress(void* guard) {
+  for (InProgress& e : g_in_progress) {
+    if (e.guard == nullptr) {
+      e.guard = guard;
+      e.owner = pthread_self();
+      return;
+    }
+  }
+}
+
+void ClearInProgress(void* guard) {
+  for (InProgress& e : g_in_progress) {
+    if (e.guard == guard) {
+      e.guard = nullptr;
+      return;
+    }
+  }
+}
+
+}  // namespace
+
+// Returns non-zero if the caller must run the initialiser, zero if it is
+// already done. Blocks while another thread is running it.
+int __cxa_guard_acquire(int* guard) {
+  uint8_t* bytes = reinterpret_cast<uint8_t*>(guard);
+
+  pthread_mutex_lock(&g_guard_mutex);
+  for (;;) {
+    if (bytes[0] & kDone) {
+      pthread_mutex_unlock(&g_guard_mutex);
+      return 0;
+    }
+    if (!(bytes[1] & kPending)) {
+      bytes[1] |= kPending;
+      NoteInProgress(guard);
+      pthread_mutex_unlock(&g_guard_mutex);
+      return 1;
+    }
+    if (OwnedByCurrentThread(guard)) {
+      // Deliberately not a wait. See the note on InProgress above.
+      pthread_mutex_unlock(&g_guard_mutex);
+      fprintf(stderr,
+              "flutter-vita: recursive initialisation of the static at %p\n",
+              static_cast<void*>(guard));
+      __builtin_trap();
+    }
+    pthread_cond_wait(&g_guard_cond, &g_guard_mutex);
+  }
+}
+
+void __cxa_guard_release(int* guard) {
+  uint8_t* bytes = reinterpret_cast<uint8_t*>(guard);
+
+  // Publish the object before the flag that says it exists. The compiler tests
+  // bit 0 inline and without a lock, so this barrier is the only thing
+  // standing between a second core and a fully constructed pointer to
+  // uninitialised memory.
+  __sync_synchronize();
+
+  pthread_mutex_lock(&g_guard_mutex);
+  bytes[0] |= kDone;
+  bytes[1] &= static_cast<uint8_t>(~kPending);
+  ClearInProgress(guard);
+  pthread_cond_broadcast(&g_guard_cond);
+  pthread_mutex_unlock(&g_guard_mutex);
+}
+
+// The initialiser did not complete. Leave the done bit clear so the next
+// caller tries again, and wake anyone waiting so they can be the one to try.
+void __cxa_guard_abort(int* guard) {
+  uint8_t* bytes = reinterpret_cast<uint8_t*>(guard);
+
+  pthread_mutex_lock(&g_guard_mutex);
+  bytes[1] &= static_cast<uint8_t>(~kPending);
+  ClearInProgress(guard);
+  pthread_cond_broadcast(&g_guard_cond);
+  pthread_mutex_unlock(&g_guard_mutex);
+}
+
+}  // extern "C"
diff --git a/engine/src/flutter/shell/platform/embedder/vita_embedder.cc b/engine/src/flutter/shell/platform/embedder/vita_embedder.cc
new file mode 100644
index 00000000..35535b1e
--- /dev/null
+++ b/engine/src/flutter/shell/platform/embedder/vita_embedder.cc
@@ -0,0 +1,2805 @@
+// Copyright (c) 2026, the Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The PlayStation Vita embedder — first cut.
+//
+// Replaces vita_link_check.cc, which existed only to make the linker answer the
+// M2 question. This one is meant to run.
+//
+// **It is not complete.** What is here: engine startup against a linked-in AOT
+// snapshot, and a software present callback that copies Skia's output into the
+// display. What is not here yet, in the order it should arrive:
+//
+//   * Input. sceTouchPeek -> FlutterPointerEvent, and
+//     sceCtrlPeekBufferPositive -> a `vita/gamepad` platform channel.
+//   * Vsync. Frames are presented as they arrive rather than paced against
+//     sceDisplayWaitVblankStart, so there is no frame budget being kept.
+//   * Custom task runners. The engine will spin up its own threads for now;
+//     ADR-0004 wants the platform runner pinned to the main Vita thread.
+//
+// Two decisions are already baked in and are worth reading before changing
+// anything here.
+//
+// **The snapshot is linked in, not loaded** (ADR-0005 option A). The four
+// symbols below are emitted by gen_snapshot into an assembly file that becomes
+// part of eboot.bin. The embedder API's other route -- FlutterEngineCreateAOTData
+// with an ELF path -- needs a loader the Vita does not have.
+//
+// **The present path is a memcpy, and that is the measured cost.** Phase 0.5
+// found the blit alone is 8.06 ms at 960x544 and bandwidth-bound at roughly 15%
+// of the memory system, which is why ADR-0006 sets the bar at 30 fps native or
+// 60 at 720x408. If this needs to get faster, the first thing to try is a NEON
+// copy, not a different renderer.
+
+#include <psp2/display.h>
+#include <psp2/io/fcntl.h>
+#include <psp2/io/stat.h>
+#include <psp2/kernel/sysmem.h>
+#include <psp2/apputil.h>
+#include <psp2/common_dialog.h>
+#include <psp2/power.h>
+
+#include <atomic>
+
+// vitaGL, for the GL path (ADR-0014). A static archive, so ADR-0004's
+// single-binary rule is untouched -- there is no dlopen and no .suprx of our
+// own. It does pull libshacccg.suprx in at run time, which is a user-installed
+// module the homebrew community already depends on, and which the software
+// path below exists to do without.
+#include <vitaGL.h>
+#include <psp2/gxm.h>
+#include <psp2/ime_dialog.h>
+#include <psp2/kernel/threadmgr.h>
+#include <psp2/sysmodule.h>
+#include <psp2/system_param.h>
+#include <psp2/touch.h>
+
+#include <unistd.h>
+
+#include <malloc.h>
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+#include "flutter/shell/platform/embedder/embedder.h"
+#include "flutter/shell/platform/embedder/embedder_software_frame_damage.h"
+
+// M1's on-device dev server, at spikes/m1-vpk/src/devserver.{c,h}, compiled
+// into this binary by the m3 spike's CMakeLists.
+//
+// Declared here rather than included. The header lives in the project repo,
+// outside the engine checkout, and ninja compiles this file with the engine's
+// own include paths -- reaching out of the tree would mean teaching GN about a
+// directory that only exists in one developer layout. One prototype is cheaper
+// and the linker still checks it.
+extern "C" int dev_server_run(void (*log_line)(const char* msg),
+                              const char* log_path,
+                              const char* eboot_path);
+extern "C" void dev_server_set_framebuffer_source(
+    const void* (*read_framebuffer)(unsigned int* size,
+                                    char* describe,
+                                    unsigned int describe_size));
+extern "C" void dev_server_set_tap_handler(void (*tap)(int x, int y));
+extern "C" void dev_server_set_overlay_handler(void (*overlay)(int on));
+
+// Whether a build wants the debug HUD.
+//
+// Weak, so an app that ships can define its own strong `flutter_vita_debug_overlay = 0`
+// in the same file where it stubs out the dev server, and the two dev-only
+// pieces get dropped together without touching the engine archive. Not `const`:
+// a const at namespace scope has internal linkage in C++, which is the one
+// thing a symbol meant to be overridden must not have.
+extern "C" __attribute__((weak)) int flutter_vita_debug_overlay = 1;
+
+// Force the CPU path regardless of any switch file.
+//
+// Weak, so a product that must never touch the GPU defines its own strong
+// `int flutter_vita_force_software = 1;` and gets it at link time rather than
+// depending on a file being present on the memory card. The loader does
+// exactly that: a switch it has to read is a switch that can be missing on the
+// one device where that matters most.
+extern "C" __attribute__((weak)) int flutter_vita_force_software = 0;
+
+namespace {
+
+// The Vita's panel. ADR-0006 records that native resolution cannot hold 60 fps
+// and that 720x408 upscaled reaches 68 -- when the reduced-resolution path
+// lands, this is the constant that changes, plus a GXM scale on present.
+constexpr int kWidth = 960;
+constexpr int kHeight = 544;
+
+// sceDisplaySetFrameBuf requires the pitch to be a multiple of 64 pixels; 960
+// already is, but the constant is named rather than assumed because it stops
+// being true the moment the resolution changes.
+constexpr int kPitch = 960;
+
+// GL path sizing.
+//
+// kGlRamThresholdBytes is the one to reach for if the engine starts failing
+// allocations under GL. vitaGL claims the newlib arena for its own RAM pool
+// and leaves *this much* behind for malloc; its own default is 16 MB, which is
+// not enough to build a GrDirectContext in. templates/vita-app/heap.c sizes
+// the arena at 160 MB, so this leaves vitaGL roughly 40 MB and the engine the
+// rest -- and the software surfaces the CPU path allocates are gone, which
+// pays for some of it.
+// vitaGL's failed-allocation counter, and what we have already reported of it.
+//
+// Strong, not weak, deliberately. A weak *variable* that nothing defines
+// resolves to address zero and reading it is a data abort -- this port has
+// been bitten by exactly that twice, both times through an import stub for a
+// module that was not resident. If a build ever stops linking vitaGL this
+// should fail at link time, where the message is legible.
+extern "C" unsigned int vgl_oom_count;
+static unsigned int g_vgl_oom_reported = 0;
+
+constexpr int kGlLegacyPoolBytes = 0x100000;
+constexpr int kGlRamThresholdBytes = 120 * 1024 * 1024;
+constexpr const char* kShaderCachePath = "ux0:data/shader_cache";
+
+// Which backend this process is running. Decided once in main() and then read
+// from several places that have to behave differently -- InitIme must not
+// initialise GXM a second time, and the software present must not run at all.
+bool g_gl_enabled = false;
+
+// SCE_DISPLAY_PIXELFORMAT_A8B8G8R8 is R,G,B,A in memory order on a
+// little-endian target, which is byte-identical to
+// kFlutterSoftwarePixelFormatRGBA8888. VERSIONS.md flagged this as "verify, do
+// not assume" in Phase 0.5; it held, and it is why the present below is a plain
+// copy with no channel swizzle.
+struct VitaDisplay {
+  SceUID memblock = -1;
+  void* base = nullptr;
+};
+
+VitaDisplay g_display;
+
+// The log channel, owning its own file handle and using none of stdio.
+//
+// Three attempts at this failed in three different ways, and the pattern is
+// worth writing down because it will catch the next person.
+//
+//   _IOLBF with a null buffer -- newlib did not give line buffering, so a run
+//   that hung produced a zero-byte file.
+//
+//   freopen on stdout -- newlib here gives each thread its own reentrancy
+//   struct, so it rebinds only the calling thread's FILE. Output from one
+//   thread landed and output from another vanished, which reads like a
+//   buffering bug and is not one.
+//
+//   write(1, ...) -- freopen does not put the reopened stream on fd 1. The
+//   VitaSDK fd table hands out its own slots, so fd 1 is not the log and the
+//   writes went nowhere at all.
+//
+// A diagnostic channel must not have failure modes subtler than the bugs it
+// exists to find. sceIoWrite against a handle this file opened has none of
+// them: no buffering, no per-thread state, no descriptor mapping.
+SceUID g_log_fd = -1;
+
+void VLogRaw(const char* data, size_t len) {
+  if (g_log_fd < 0) {
+    return;
+  }
+  sceIoWrite(g_log_fd, data, len);
+}
+
+void VLog(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+void VLog(const char* fmt, ...) {
+  char buf[512];
+  va_list ap;
+  va_start(ap, fmt);
+  const int n = std::vsnprintf(buf, sizeof buf, fmt, ap);
+  va_end(ap);
+  if (n > 0) {
+    VLogRaw(buf, n < static_cast<int>(sizeof buf) ? n : sizeof buf - 1);
+  }
+}
+
+// Serve the dev protocol on its own thread, because dev_server_run blocks
+// until it is told to exit and the engine needs main() to keep running.
+//
+// Without this m3 answers nothing while it is alive, so a healthy run and a
+// hung one look identical from the host: no port, no log, no way in. Reading
+// the log meant asking someone to close the app and tap the loader, which is
+// exactly the round trip this loop exists to avoid.
+//
+// The server appends its own newline, so this must not add one.
+void DevServerLog(const char* msg) {
+  VLogRaw(msg, std::strlen(msg));
+}
+
+int DevServerThread(SceSize /* args */, void* /* argp */) {
+  dev_server_run(DevServerLog, "ux0:data/flutter-vita/m3.log",
+                 "ux0:app/FVTA00002/eboot.bin");
+  // Asked to exit, or the socket never came up. Either way the engine keeps
+  // going; losing the dev channel is not a reason to take the app down.
+  return sceKernelExitDeleteThread(0);
+}
+
+// Touch, polled from the front panel and translated into pointer events.
+//
+// The front panel reports in its own coordinate space, which is **twice the
+// display resolution** -- 1920x1088 against 960x544. The panel info is queried
+// rather than hard-coded to that factor: the numbers come from the hardware,
+// and a constant here would be an assumption that silently halves or doubles
+// every tap if it were ever wrong.
+//
+// Only the first contact is forwarded. Flutter's pointer protocol handles
+// multitouch by device id, and adding that without a way to test it would be
+// speculative -- a second finger is a change to make when there is something
+// on screen that needs one.
+struct TouchState {
+  bool down = false;
+  double x = 0;
+  double y = 0;
+  int scale_min_x = 0;
+  int scale_min_y = 0;
+  double scale_x = 0.5;  // replaced by panel info at init
+  double scale_y = 0.5;
+};
+
+TouchState g_touch;
+
+// Touch-to-present, measured rather than reasoned about.
+//
+// "Input lag" has at least four contributors here and they are not the same
+// size: touch is polled every 16 ms on the main thread, there is no vsync
+// callback so the engine paces on a timer of its own, the present is a
+// measured 8.06 ms memcpy, and the buffer is single. Guessing which dominates
+// is how the last several hours went wrong; this records the one number that
+// matters end to end, plus the frame interval underneath it.
+uint64_t g_touch_down_us = 0;
+uint64_t g_last_present_us = 0;
+
+// A 60-frame window, because a single sample answered the wrong question.
+//
+// The first version of this printed `now - g_last_present_us` every sixtieth
+// frame while updating g_last_present_us on *every* frame -- so it reported the
+// duration of one arbitrary frame and read like a frame rate. On a screen with
+// occasional stalls it printed 797 ms and looked like 1.25 fps sustained, which
+// it was not. One slow frame in sixty and sixty slow frames are the same number
+// to that instrument, and they are opposite problems.
+//
+// This accumulates instead: total time and total blit time over a window, plus
+// the worst single frame. Mean answers "how fast is it", max answers "does it
+// hitch", and the blit share answers the only question that matters before
+// choosing an optimisation -- whether the 8 ms memcpy is the problem or 1% of
+// it. Without that split, picking between partial repaint and a GPU backend is
+// guessing.
+uint64_t g_win_first_us = 0;   // start of the current window
+uint64_t g_win_blit_us = 0;    // summed memcpy time inside it
+// Raster-thread idle: present finished to the next make_current. GL only --
+// see the note on g_gl_present_end_us for why it earns a column.
+uint64_t g_win_gl_idle_us = 0;
+
+// The last frame's numbers, kept per-frame rather than only summed.
+//
+// A sixty-frame mean cannot see a screen transition: a single 500 ms frame
+// inside a window of 16 ms frames moves the mean by 8 ms and disappears. The
+// user-visible complaint is the spike, not the mean, so the spike gets its own
+// log line -- see the jank report in NotePresent.
+uint64_t g_last_raster_us = 0;
+uint64_t g_last_idle_us = 0;
+uint64_t g_frame_index = 0;
+
+// Anything above this is visible as a stutter rather than a slow frame. Two
+// panel refreshes is 33 ms; 50 ms is comfortably past "the animation hitched".
+constexpr uint64_t kJankUs = 50000;
+
+// The platform thread, counted because the GL path made it a suspect.
+//
+// Under GL, localsend's raster fell to 5.1 ms and its frame period stayed at
+// 199 ms, so ~194 ms per frame is being spent somewhere that is not drawing.
+// The main loop below runs at vblank and drains the engine's platform tasks;
+// if the frame pipeline needs several platform round trips per frame, the loop
+// -- not the GPU and not Dart -- sets the frame rate, and it would have been
+// invisible while software raster was 156 ms. These say whether it is: the
+// loop's real period, how many tasks a window ran, and how long they took.
+uint64_t g_loop_iterations = 0;
+uint64_t g_loop_tasks_run = 0;
+uint64_t g_loop_task_us = 0;
+uint64_t g_loop_first_us = 0;
+uint64_t g_win_damage_px = 0;  // summed damaged pixels inside it
+uint64_t g_win_hud_us = 0;     // summed time spent drawing the HUD
+uint64_t g_win_raster_us = 0;  // summed Skia raster time inside it
+uint64_t g_win_raster_max_us = 0;  // the worst single raster pass
+
+// The HUD's own copy of the raster total, declared here rather than with the
+// other g_hud_* counters below because OnRasterTiming feeds both and sits
+// above that block.
+uint64_t g_hud_raster_us = 0;
+
+// Runtime switch for the debug HUD, on top of the build-time
+// flutter_vita_debug_overlay above. `overlay off` on the dev server; see
+// SetOverlay below for why it is worth a command.
+bool g_hud_on = true;
+
+// Set when the HUD on screen is out of date: the text changed, or the blit
+// copied app pixels over the top of it. Cleared by painting.
+//
+// Without this the HUD repaints on every present whether or not anything
+// disturbed it, which on an idle screen is the entire per-frame cost of the
+// port for no information at all.
+bool g_hud_dirty = true;
+
+// Set whenever a frame does not reach the blit, or something else writes over
+// the display buffer. The next blit then copies everything.
+//
+// A flag rather than a whole-screen g_damage, because the damage observer
+// overwrites g_damage at the start of every frame -- anything recorded there by
+// a skipped frame is gone before the next blit reads it.
+bool g_display_stale = true;
+uint64_t g_win_max_gap_us = 0; // worst present-to-present gap in it
+unsigned g_win_frames = 0;
+
+// Idle is not slow, and averaging the two together hides both.
+//
+// Flutter produces a frame only when something needs repainting, so a static
+// screen presents nothing at all. The first version of this window reported
+// "1.50 fps" for a screen sitting still -- one 35-second gap inside a
+// 40-second window, with the other 59 frames running at 12 fps. Averaged
+// together that reads as a port too slow to use, and the truth was a port
+// waiting for the user.
+//
+// So gaps above a threshold are counted separately rather than averaged in.
+// The active mean is the number that describes rendering; the idle count is
+// the number that explains the wall-clock.
+constexpr uint64_t kIdleGapUs = 250000;  // 250 ms: ~3x the measured frame time
+uint64_t g_win_active_us = 0;
+unsigned g_win_active = 0;
+unsigned g_win_idle = 0;
+
+// When a finger last went down, and never cleared.
+//
+// Distinct from g_touch_down_us above, which the present path zeroes once it
+// has logged a latency. This one is the record of *whether a person asked for
+// anything recently*, and OpenImeDialog is gated on it -- see there.
+uint64_t g_last_touch_us = 0;
+
+void InitTouch() {
+  sceTouchSetSamplingState(SCE_TOUCH_PORT_FRONT,
+                           SCE_TOUCH_SAMPLING_STATE_START);
+
+  SceTouchPanelInfo info = {};
+  if (sceTouchGetPanelInfo(SCE_TOUCH_PORT_FRONT, &info) < 0) {
+    VLog("flutter-vita: sceTouchGetPanelInfo failed, assuming 2x\n");
+    return;
+  }
+
+  const int span_x = info.maxAaX - info.minAaX;
+  const int span_y = info.maxAaY - info.minAaY;
+  if (span_x <= 0 || span_y <= 0) {
+    VLog("flutter-vita: touch panel span %dx%d is unusable, assuming 2x\n",
+         span_x, span_y);
+    return;
+  }
+
+  g_touch.scale_min_x = info.minAaX;
+  g_touch.scale_min_y = info.minAaY;
+  g_touch.scale_x = static_cast<double>(kWidth) / span_x;
+  g_touch.scale_y = static_cast<double>(kHeight) / span_y;
+  VLog("flutter-vita: touch aa=[%d,%d..%d,%d] scale=%.4f,%.4f\n", info.minAaX,
+       info.minAaY, info.maxAaX, info.maxAaY, g_touch.scale_x, g_touch.scale_y);
+}
+
+void SendPointer(FlutterEngine engine,
+                 FlutterPointerPhase phase,
+                 double x,
+                 double y) {
+  FlutterPointerEvent event = {};
+  event.struct_size = sizeof(FlutterPointerEvent);
+  event.phase = phase;
+  // Microseconds since epoch, which is what the engine expects here -- not the
+  // monotonic clock the message loop uses.
+  event.timestamp =
+      static_cast<size_t>(FlutterEngineGetCurrentTime() / 1000);
+  event.x = x;
+  event.y = y;
+  event.device_kind = kFlutterPointerDeviceKindTouch;
+  event.device = 0;
+  // A touch screen has no buttons, and reporting one makes Flutter treat the
+  // gesture as a mouse drag with a held button.
+  event.buttons = 0;
+  // Stamped on the way in, read at the next present. Only for a down, because
+  // that is the edge a person perceives as "did it respond".
+  if (event.phase == kDown) {
+    g_touch_down_us = sceKernelGetSystemTimeWide();
+    g_last_touch_us = g_touch_down_us;
+  }
+  FlutterEngineSendPointerEvent(engine, &event, 1);
+}
+
+// Poll once and emit whatever transition happened since the last call.
+//
+// Flutter wants kDown / kMove / kUp, not a level. Sending kDown every frame a
+// finger is present makes every tap look like a fresh gesture and nothing
+// recognises as a press, so the previous state is what this is really about.
+void PumpTouch(FlutterEngine engine) {
+  SceTouchData data = {};
+  if (sceTouchPeek(SCE_TOUCH_PORT_FRONT, &data, 1) < 0) {
+    return;
+  }
+
+  const bool down = data.reportNum > 0;
+  if (down) {
+    const SceTouchReport& report = data.report[0];
+    g_touch.x = (report.x - g_touch.scale_min_x) * g_touch.scale_x;
+    g_touch.y = (report.y - g_touch.scale_min_y) * g_touch.scale_y;
+  }
+
+  if (down && !g_touch.down) {
+    SendPointer(engine, kDown, g_touch.x, g_touch.y);
+    VLog("flutter-vita: touch down %.1f,%.1f\n", g_touch.x, g_touch.y);
+  } else if (down && g_touch.down) {
+    SendPointer(engine, kMove, g_touch.x, g_touch.y);
+  } else if (!down && g_touch.down) {
+    // Released at the last known position: the panel stops reporting
+    // coordinates the moment contact ends, so the alternative is lifting at
+    // 0,0 and cancelling every tap.
+    SendPointer(engine, kUp, g_touch.x, g_touch.y);
+    VLog("flutter-vita: touch up %.1f,%.1f\n", g_touch.x, g_touch.y);
+  }
+  g_touch.down = down;
+}
+
+// Synthetic taps, so input can be verified with nobody holding the console.
+//
+// The dev server calls InjectTap from its own thread, and pointer events must
+// be sent from the thread that owns the engine handle -- so this only records
+// the request, and the main loop turns it into a down/up pair on its next
+// pass. A single int pair guarded by nothing is deliberate: one writer, one
+// reader, and a dropped tap under a race costs a retry rather than corruption.
+//
+// This bypasses sceTouch entirely. It proves the engine's pointer path and
+// says nothing about coordinate scaling or panel sampling, which is why the
+// real thing still has to be tried by hand at least once.
+volatile bool g_injected_tap_pending = false;
+volatile int g_injected_tap_x = 0;
+volatile int g_injected_tap_y = 0;
+
+void InjectTap(int x, int y) {
+  g_injected_tap_x = x;
+  g_injected_tap_y = y;
+  g_injected_tap_pending = true;
+}
+
+void DrainInjectedTaps(FlutterEngine engine) {
+  if (!g_injected_tap_pending) {
+    return;
+  }
+  const double x = g_injected_tap_x;
+  const double y = g_injected_tap_y;
+  g_injected_tap_pending = false;
+
+  // Down and up in one pass. A real tap spans several frames, but Flutter's
+  // gesture recogniser keys on the event sequence rather than the wall-clock
+  // gap between them, so a tap arrives as a tap.
+  SendPointer(engine, kDown, x, y);
+  SendPointer(engine, kUp, x, y);
+  VLog("flutter-vita: injected tap %.0f,%.0f\n", x, y);
+}
+
+// Capture what the display controller is scanning out, not what we drew.
+//
+// The distinction is the whole point. Dumping g_display.base proves only that
+// we wrote pixels into memory we own; if sceDisplaySetFrameBuf never took
+// effect, that dump is a perfect picture of a buffer nobody is reading, over a
+// black panel. sceDisplayGetFrameBuf asks the hardware which buffer it
+// actually holds, and comparing the two answers the real question.
+//
+// The description line carries that comparison plus the vertical retrace
+// count, which separates "configured but parked" from "actively scanning".
+//
+// **Limit, stated so nobody trusts this further than it goes:** this is the
+// app's registered framebuffer, not the composited panel output. System
+// overlays -- notifications, the power dialog, LiveArea -- composite above it
+// and are invisible to a user-mode app. Capturing those needs a kernel plugin.
+const void* ReadFramebuffer(unsigned int* size,
+                            char* describe,
+                            unsigned int describe_size) {
+  SceDisplayFrameBuf fb = {};
+  fb.size = sizeof(fb);
+  const int result = sceDisplayGetFrameBuf(&fb, SCE_DISPLAY_SETBUF_NEXTFRAME);
+
+  const int vcount_before = sceDisplayGetVcount();
+  sceKernelDelayThread(20 * 1000);  // longer than one 60 Hz frame
+  const int vcount_after = sceDisplayGetVcount();
+
+  if (result < 0 || fb.base == nullptr) {
+    std::snprintf(describe, describe_size,
+                  "ERR sceDisplayGetFrameBuf=0x%08X base=%p\n", result,
+                  fb.base);
+    *size = 0;
+    return nullptr;
+  }
+
+  std::snprintf(describe, describe_size,
+                "base=%p ours=%p match=%s %ux%u pitch=%u fmt=0x%08X "
+                "vcount=%d->%d scanning=%s\n",
+                fb.base, g_display.base,
+                // Under GL the buffer belongs to vitaGL, so "ours" is null and
+                // a mismatch is the expected answer rather than a fault. The
+                // capture itself is still correct: this reads what the display
+                // controller is scanning out, whoever allocated it.
+                g_gl_enabled ? "vitaGL"
+                             : (fb.base == g_display.base ? "yes" : "NO"),
+                fb.width, fb.height,
+                fb.pitch, fb.pixelformat, vcount_before, vcount_after,
+                vcount_after != vcount_before ? "yes" : "NO");
+
+  // Deliberately sized from the descriptor the hardware returned rather than
+  // from our own constants, so a mismatch shows up as a wrong-sized capture
+  // instead of being silently papered over.
+  *size = fb.pitch * fb.height * 4;
+  return fb.base;
+}
+
+// |dev_server_set_overlay_handler|
+//
+// Called from the server's thread while the raster thread may be mid-present.
+// A plain bool is enough: the worst a torn read can do is draw or skip the HUD
+// for one frame, and the next present settles it.
+void SetOverlay(int on) {
+  g_hud_on = on != 0;
+  // Turning it off leaves the HUD's own pixels on screen with nothing to
+  // restore them, since partial repaint only copies what Flutter changed. Ask
+  // for one whole frame; turning it back on needs a repaint for the same
+  // reason.
+  g_display_stale = true;
+  g_hud_dirty = true;
+}
+
+void StartDevServer() {
+  dev_server_set_framebuffer_source(ReadFramebuffer);
+  dev_server_set_tap_handler(InjectTap);
+  dev_server_set_overlay_handler(SetOverlay);
+  // 64 KiB of stack because the server's `put` path holds a 32 KiB buffer.
+  const SceUID thread = sceKernelCreateThread(
+      "m3_devserver", DevServerThread, 0x10000100, 64 * 1024, 0, 0, nullptr);
+  if (thread < 0) {
+    VLog("flutter-vita: dev server thread failed: 0x%08X\n", thread);
+    return;
+  }
+  sceKernelStartThread(thread, 0, nullptr);
+}
+
+bool InitDisplay() {
+  // CDRAM is the fast path for the display controller. The framebuffer must be
+  // 256 KiB aligned, which SCE_KERNEL_MEMBLOCK_TYPE_USER_CDRAM_RW gives.
+  const int size = kPitch * kHeight * 4;
+  const int aligned = (size + 0x3FFFF) & ~0x3FFFF;
+
+  g_display.memblock = sceKernelAllocMemBlock(
+      "flutter_fb", SCE_KERNEL_MEMBLOCK_TYPE_USER_CDRAM_RW, aligned, nullptr);
+  if (g_display.memblock < 0) {
+    VLog("sceKernelAllocMemBlock failed: 0x%08X\n", g_display.memblock);
+    return false;
+  }
+  if (sceKernelGetMemBlockBase(g_display.memblock, &g_display.base) < 0) {
+    VLog("sceKernelGetMemBlockBase failed\n");
+    return false;
+  }
+  std::memset(g_display.base, 0, aligned);
+
+  SceDisplayFrameBuf fb = {};
+  fb.size = sizeof(fb);
+  fb.base = g_display.base;
+  fb.pitch = kPitch;
+  fb.pixelformat = SCE_DISPLAY_PIXELFORMAT_A8B8G8R8;
+  fb.width = kWidth;
+  fb.height = kHeight;
+  return sceDisplaySetFrameBuf(&fb, SCE_DISPLAY_SETBUF_NEXTFRAME) >= 0;
+}
+
+struct ImeState {
+  bool open = false;         // the dialog is up and must be pumped
+  int client_id = -1;        // from TextInput.setClient
+  bool multiline = false;    // inputType TextInputType.multiline
+  bool obscured = false;     // obscureText -- a password field
+  char pending[1024] = {0};  // editing state seeded before show
+  SceWChar16 input[SCE_IME_DIALOG_MAX_TEXT_LENGTH + 1] = {0};
+  SceWChar16 initial[SCE_IME_DIALOG_MAX_TEXT_LENGTH + 1] = {0};
+  SceWChar16* title = nullptr;
+  bool gxm_ready = false;   // surfaces mapped; without them the driver kills us
+};
+ImeState g_ime;
+
+// The GXM side of showing a common dialog, and nothing more.
+//
+// The shell draws the keyboard into the *application's* frame, and it will
+// only do that into a surface GXM manages. Filling
+// SceCommonDialogRenderTargetInfo with the right width, height, stride and
+// format over a raw CDRAM pointer is not enough: with GXM merely initialised
+// and the depth surface and sync object left null, sceImeDialogInit succeeds
+// and the driver then kills the process out of band -- a GPUCRASH dump in
+// which no thread has a crash stop reason.
+//
+// So three things are created here, and still nothing is rendered with the
+// GPU. Skia keeps drawing every pixel on the CPU exactly as before; this is
+// about who *owns* the surface, not who draws into it.
+//
+//   * the framebuffer, mapped so the GPU can see memory we already allocated
+//   * a depth/stencil surface, which the render-target descriptor requires
+//     even though nothing tests depth
+//   * a sync object, which is how the driver knows a frame is safe to touch
+//
+// No context and no render target: this process submits no draw calls, and
+// sceCommonDialogUpdate takes surfaces and a sync object rather than a
+// context. If the driver still objects, a context is the next thing to add.
+SceGxmSyncObject* g_gxm_sync = nullptr;
+SceUID g_depth_uid = -1;
+void* g_depth_base = nullptr;
+
+constexpr unsigned AlignUp(unsigned v, unsigned a) {
+  return (v + a - 1) & ~(a - 1);
+}
+
+bool InitGxmSurfaces() {
+  // The framebuffer is already allocated -- CDRAM, 256 KiB aligned, the block
+  // sceDisplaySetFrameBuf scans out of. It just has to be visible to the GPU.
+  const unsigned fb_size = AlignUp(kPitch * kHeight * 4, 0x40000);
+  int r = sceGxmMapMemory(g_display.base, fb_size, SCE_GXM_MEMORY_ATTRIB_RW);
+  if (r < 0) {
+    VLog("flutter-vita: sceGxmMapMemory(fb) 0x%08X\n", (unsigned)r);
+    return false;
+  }
+
+  // Depth, sized in whole tiles because that is how the hardware addresses it.
+  const unsigned dw = AlignUp(kWidth, SCE_GXM_TILE_SIZEX);
+  const unsigned dh = AlignUp(kHeight, SCE_GXM_TILE_SIZEY);
+  const unsigned depth_size = AlignUp(dw * dh * 4, 0x1000);
+  g_depth_uid = sceKernelAllocMemBlock(
+      "fvita_depth", SCE_KERNEL_MEMBLOCK_TYPE_USER_RW_UNCACHE, depth_size,
+      nullptr);
+  if (g_depth_uid < 0) {
+    VLog("flutter-vita: depth alloc 0x%08X\n", (unsigned)g_depth_uid);
+    return false;
+  }
+  if (sceKernelGetMemBlockBase(g_depth_uid, &g_depth_base) < 0) return false;
+  r = sceGxmMapMemory(g_depth_base, depth_size, SCE_GXM_MEMORY_ATTRIB_RW);
+  if (r < 0) {
+    VLog("flutter-vita: sceGxmMapMemory(depth) 0x%08X\n", (unsigned)r);
+    return false;
+  }
+
+  r = sceGxmSyncObjectCreate(&g_gxm_sync);
+  if (r < 0) {
+    VLog("flutter-vita: sceGxmSyncObjectCreate 0x%08X\n", (unsigned)r);
+    return false;
+  }
+  VLog("flutter-vita: GXM surfaces ready (depth %u KiB)\n", depth_size / 1024);
+  return true;
+}
+
+// Hand the shell our framebuffer so it can draw a common dialog into it.
+//
+// This is where software rendering (ADR-0003) meets an API written for GXM.
+// The struct wants a colour surface, but its fields are only a pointer, a
+// format and a stride, and the CDRAM block behind sceDisplaySetFrameBuf is
+// exactly describable that way -- no GXM rendering happens here. GXM does have
+// to be *initialised* though, which is a separate discovery recorded in
+// InitIme.
+void UpdateCommonDialog() {
+  if (!g_ime.open) return;
+  SceCommonDialogUpdateParam update = {};
+  update.renderTarget.colorSurfaceData = g_display.base;
+  update.renderTarget.surfaceType = SCE_GXM_COLOR_SURFACE_LINEAR;
+  update.renderTarget.colorFormat = SCE_GXM_COLOR_FORMAT_A8B8G8R8;
+  update.renderTarget.width = kWidth;
+  update.renderTarget.height = kHeight;
+  update.renderTarget.strideInPixels = kPitch;
+  update.renderTarget.depthSurfaceData = g_depth_base;
+  update.displaySyncObject = g_gxm_sync;
+  sceCommonDialogUpdate(&update);
+}
+
+// The region of the next frame that differs from the one on screen.
+//
+// Set by the rasterizer through SetSoftwareFrameDamageObserver, on the same
+// raster thread that then calls PresentSurface, so no lock is needed and none
+// would help: the two calls are consecutive statements in one submit.
+//
+// Defaults to the whole screen, which is both the correct answer before any
+// frame has been diffed and the safe answer if the observer is ever not
+// installed -- a blit that copies too much is slow, one that copies too little
+// leaves the previous frame's pixels on screen.
+struct Damage {
+  int left = 0;
+  int top = 0;
+  int right = kWidth;
+  int bottom = kHeight;
+};
+Damage g_damage;
+
+
+// How long Skia spent painting, as opposed to how long the frame took.
+//
+// The two are not the same and the gap between them is the whole question. A
+// frame that is slow because Skia is slow argues for a GPU backend; a frame
+// that is slow with a fast raster pass is waiting on the UI thread -- Dart
+// building and laying out -- which a GPU backend does not touch at all.
+//
+// `dmg%` was the closest thing to this number and it turned out not to predict
+// cost: localsend's Receive screen runs 4.7 fps having damaged 13% of the
+// screen while flutter_manga_reader holds 48 fps at 89%. Seven times the area,
+// ten times the frame rate. Area is not work.
+//
+// Same raster thread as OnFrameDamage and the present, one frame at a time.
+void OnRasterTiming(uint64_t raster_us) {
+  g_last_raster_us = raster_us;
+  g_win_raster_us += raster_us;
+  if (raster_us > g_win_raster_max_us) {
+    g_win_raster_max_us = raster_us;
+  }
+  g_hud_raster_us += raster_us;
+}
+
+void OnFrameDamage(int32_t left, int32_t top, int32_t right, int32_t bottom,
+                   bool full) {
+  if (full) {
+    g_damage = Damage{};
+    return;
+  }
+  // Clamped, because the damage rect is in layer-tree coordinates and nothing
+  // upstream promises it lies inside the framebuffer.
+  g_damage.left = left < 0 ? 0 : (left > kWidth ? kWidth : left);
+  g_damage.top = top < 0 ? 0 : (top > kHeight ? kHeight : top);
+  g_damage.right = right < 0 ? 0 : (right > kWidth ? kWidth : right);
+  g_damage.bottom = bottom < 0 ? 0 : (bottom > kHeight ? kHeight : bottom);
+}
