+
+  // Half-resolution rastering, with the layout left alone.
+  //
+  //   ux0:data/flutter-vita/halfres.on   -- a '1' here halves the surface
+  //
+  // An experiment, not a feature, and a narrow one. The GPU run on 2026-08-24
+  // dropped route_push's UI-thread build time from 164 ms to 1.25 ms while its
+  // raster time went from 2500 ms to 7.6 ms. Build time should not depend on
+  // the renderer. Thread
+  // affinity was the first explanation and pinning disproved it, which leaves
+  // memory bandwidth: the software rasteriser writes a 2 MB framebuffer every
+  // frame, and if that starves the bus then Dart slows down beside it without
+  // any two threads ever queueing for a core.
+  //
+  // Halving both dimensions and halving pixel_ratio with them keeps the
+  // logical size at 960x544, so the widget tree, the layout and every line of
+  // Dart are identical -- only the pixel count changes, to a quarter. If build
+  // time moves, the cause is the raster thread's memory traffic and nothing
+  // else. If it does not, bus contention is wrong too.
+  //
+  // The blit needs no changes: it already clamps to the smaller of the surface
+  // and the display, so a quarter-size frame lands in the top-left corner. It
+  // looks wrong on the panel, which is fine -- this measures Dart, it does not
+  // show anything to anyone.
+  const bool half_res = DevSwitchOn("ux0:data/flutter-vita/halfres.on");
+  const double surface_scale = half_res ? 0.5 : 1.0;
+  if (half_res) {
+    VLog("flutter-vita: half-resolution raster (%dx%d, logical %dx%d)\n",
+         static_cast<int>(kWidth * surface_scale),
+         static_cast<int>(kHeight * surface_scale), kWidth, kHeight);
+  }
+
+  g_surface_scale = surface_scale;
+  SendWindowMetrics(engine);
+
+  InitTouch();
+  InitIme();
+
+  // Polled input, no vsync yet. Frames are still presented as the engine
+  // produces them rather than paced against sceDisplayWaitVblankStart, so this
+  // loop's period is an input sampling rate and not a frame budget.
+  for (;;) {
+    // Paced on the panel, not on a timer.
+    //
+    // This used to be sceKernelDelayThread(16 * 1000), which free-runs at
+    // 16.000 ms against a display refreshing every 16.667 ms. The two drift
+    // through each other about forty times a second, and with a single buffer
+    // -- we write into the memory the controller is scanning out of -- that
+    // beat is visible as the IME dialog flickering.
+    //
+    // Waiting for vblank also puts the dialog composite in the right place:
+    // this returns at the *start* of the blanking interval, so the write below
+    // lands before the next scanout begins rather than partway through one.
+    //
+    // It does not make the port double-buffered, which is the real fix for
+    // tearing and is parked with the vsync work in ADR-0006.
+    sceDisplayWaitVblankStart();
+
+    // First after vblank, because it is the one thing here that writes pixels.
+    PumpIme(engine);
+    // A platform message that arrived while we were blocked should be answered
+    // before another frame's worth of input is sampled.
+    //
+    // Once per vblank, which bounds the *latency* of a platform reply at
+    // 16.6 ms however fast the reply itself is. That looked like a candidate
+    // for the ~400 ms screen transitions -- the framework issues
+    // LiveText.isLiveTextInputAvailable, Clipboard.hasStrings and
+    // ProcessText.queryTextActions on navigation, and a chain of replies that
+    // each gate the next would pay a frame apiece.
+    //
+    // Tried, on 2026-08-22: drain fifteen times a frame at 1 ms granularity.
+    // Transitions did not improve and the noisier measurements got worse.
+    // Waking this thread fifteen times a frame and taking the task mutex each
+    // time competes with the UI thread for a core, and the UI thread is what
+    // the transition is waiting on -- so the change spends the thing it was
+    // trying to save. Reverted, and recorded here so it is not retried.
+    const uint64_t task_start = sceKernelGetSystemTimeWide();
+    DrainPlatformTasks(engine);
+    g_loop_task_us += sceKernelGetSystemTimeWide() - task_start;
+    PumpTouch(engine);
+    DrainInjectedTaps(engine);
+    DrainInjectedDrag(engine);
+    // The strip on an idle screen: nothing presents, so nothing would
+    // recompose it or carry it to the display. Once a second, compose from
+    // here and ask for a frame. Costs an idle app one frame a second while
+    // the strip is up, and nothing while it is hidden.
+    if (flutter_vita_debug_overlay != 0 && g_hud_on &&
+        sceKernelGetSystemTimeWide() - g_hud_composed_us > 1000 * 1000) {
+      HudTryUpdate();
+      g_hud_frame_wanted = true;
+    }
+    if (g_hud_frame_wanted) {
+      g_hud_frame_wanted = false;
+      FlutterEngineScheduleFrame(engine);
+    }
+
+    // Cheap unless the screen has actually frozen: one subtraction against a
+    // timestamp the present path already keeps.
+    CheckForStall();
+    // And one against the last heartbeat reply.
+    CheckUiThread();
+
+    // Sixty times a second is what the M1 spike does and it costs nothing
+    // measurable; the call exists to reset a timer.
+    if (flutter_vita_keep_awake) {
+      sceKernelPowerTick(SCE_KERNEL_POWER_TICK_DEFAULT);
+    }
+
+    // Is the platform thread keeping up with the panel, and is it doing the
+    // engine's work or its own? A loop period well over 16.6 ms means this
+    // thread is the pacer and the sceDisplayWaitVblankStart above is not what
+    // it is waiting on.
+    if (g_loop_first_us == 0) g_loop_first_us = sceKernelGetSystemTimeWide();
+    if (++g_loop_iterations >= 300) {
+      const uint64_t now = sceKernelGetSystemTimeWide();
+      VLog("flutter-vita: LOOP %u iterations @ %u us mean "
+           "| %u tasks (%u us total, %u us mean)\n",
+           static_cast<unsigned>(g_loop_iterations),
+           static_cast<unsigned>((now - g_loop_first_us) / g_loop_iterations),
+           static_cast<unsigned>(g_loop_tasks_run),
+           static_cast<unsigned>(g_loop_task_us),
+           g_loop_tasks_run != 0
+               ? static_cast<unsigned>(g_loop_task_us / g_loop_tasks_run)
+               : 0u);
+      if (vita_para_count != 0) {
+        VLog("flutter-vita: PARAGRAPHS %u | ctor %u us | build %u us | "
+             "layout %u us | %u us each\n",
+             static_cast<unsigned>(vita_para_count),
+             static_cast<unsigned>(vita_para_ctor_us),
+             static_cast<unsigned>(vita_para_build_us),
+             static_cast<unsigned>(vita_para_layout_us),
+             static_cast<unsigned>((vita_para_ctor_us + vita_para_build_us +
+                                    vita_para_layout_us) /
+                                   vita_para_count));
+        vita_para_ctor_us = 0;
+        vita_para_build_us = 0;
+        vita_para_layout_us = 0;
+        vita_para_count = 0;
+      }
+
+
+
+
+
+      g_loop_iterations = 0;
+      g_loop_tasks_run = 0;
+      g_loop_task_us = 0;
+      g_loop_first_us = 0;
+    }
+  }
+
+  return 0;
+}
