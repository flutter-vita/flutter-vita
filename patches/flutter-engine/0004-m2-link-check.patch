+// Paragraph timing, defined in lib/ui/text/paragraph.cc. ADR-0017: 48 Text
+// widgets cost 41 ms of UI thread and one Text holding the same 48 glyphs
+// costs 1 ms, so the cost is flat per paragraph. These three say which part.
+extern "C" {
+extern uint64_t vita_para_ctor_us;
+extern uint64_t vita_para_build_us;
+extern uint64_t vita_para_layout_us;
+extern uint32_t vita_para_count;
+}
