+// Runs the filter on the calling isolate instead of dispatching it.
+//
+// Compiled on every platform rather than guarded to Vita, because the natives
+// table in io_natives.cc is one macro list and cannot carry a #if. Only this
+// port's dart:io calls it; everywhere else it is an unused function.
+//
+// _pushAllFilterStages normally hands this work to the IO service, so that a
+// slow cipher cannot stall the isolate. That trade is backwards here, and by a
+// wide margin. Measured on hardware with the four buffer stages timed
+// individually, one filter cycle is **427 us** of actual work -- SSL_read,
+// SSL_write and the two BIO calls, all of it -- while the round trip that
+// carries it costs **5820 us** inside IOServiceCallback, of which 3234 us is
+// Dart_PostCObject alone, and about 20 ms wall once the isolate has to be
+// scheduled to receive the reply. HTTPS ran at 129 KB/s where plain HTTP over
+// the same socket managed 1430.
+//
+// The cipher is not the reason, which was checked rather than assumed: forcing
+// ChaCha20-Poly1305, AES-128-GCM and AES-256-GCM in turn gives 127, 127 and
+// 130 KB/s. There is no slow cipher here to protect the isolate from. Paying
+// 427 us on the UI thread -- 2.5% of a 16.7 ms frame -- to avoid 20 ms of
+// round trip is the trade the numbers actually support.
+//
+// Positions are passed and returned in one List<int> of 2 * kNumBuffers,
+// starts and ends interleaved, matching the CObject layout the dispatching
+// path uses. Null comes back on success; a failure returns the same
+// [code, message] pair ProcessFilterRequest would have sent, so the Dart side
+// raises the identical exception either way.
+void FUNCTION_NAME(SecureSocket_ProcessAllBuffersSync)(
+    Dart_NativeArguments args) {
+  SSLFilter* filter = GetFilter(args);
+  const bool in_handshake =
+      DartUtils::GetNativeBooleanArgument(args, 1);
+  Dart_Handle positions = ThrowIfError(Dart_GetNativeArgument(args, 2));
+
+  int starts[SSLFilter::kNumBuffers];
+  int ends[SSLFilter::kNumBuffers];
+  for (int i = 0; i < SSLFilter::kNumBuffers; ++i) {
+    int64_t start = 0;
+    int64_t end = 0;
+    ThrowIfError(Dart_IntegerToInt64(
+        ThrowIfError(Dart_ListGetAt(positions, 2 * i)), &start));
+    ThrowIfError(Dart_IntegerToInt64(
+        ThrowIfError(Dart_ListGetAt(positions, 2 * i + 1)), &end));
+    starts[i] = static_cast<int>(start);
+    ends[i] = static_cast<int>(end);
+  }
+
+  if (filter->ProcessAllBuffers(starts, ends, in_handshake)) {
+    for (int i = 0; i < SSLFilter::kNumBuffers; ++i) {
+      ThrowIfError(
+          Dart_ListSetAt(positions, 2 * i, Dart_NewInteger(starts[i])));
+      ThrowIfError(
+          Dart_ListSetAt(positions, 2 * i + 1, Dart_NewInteger(ends[i])));
+    }
+    Dart_SetReturnValue(args, Dart_Null());
+    return;
+  }
+
+  const int32_t error_code = static_cast<int32_t>(ERR_peek_error());
+  TextBuffer error_string(SecureSocketUtils::SSL_ERROR_MESSAGE_BUFFER_SIZE);
+  SecureSocketUtils::FetchErrorString(filter->ssl(), &error_string);
+  Dart_Handle result = ThrowIfError(Dart_NewList(2));
+  ThrowIfError(Dart_ListSetAt(result, 0, Dart_NewInteger(error_code)));
+  ThrowIfError(Dart_ListSetAt(
+      result, 1, DartUtils::NewString(error_string.buffer())));
+  Dart_SetReturnValue(args, result);
+}
