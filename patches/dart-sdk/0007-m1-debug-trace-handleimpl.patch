+#if defined(DART_HOST_OS_VITA)
+// M1 debugging: the pool is null here and we need to know whether it was ever
+// non-null, and whether we are even looking at the right isolate group.
+static ObjectPoolPtr VitaTraceGlobalPool(const char* where) {
+  auto* ig = IsolateGroup::Current();
+  auto* store = ig != nullptr ? ig->object_store() : nullptr;
+  ObjectPoolPtr pool =
+      store != nullptr ? store->global_object_pool() : ObjectPool::null();
+  uword raw;
+  memcpy(&raw, &pool, sizeof(raw));
+  // Same bit-copy trick: ObjectPoolPtr is a class, not a word.
+  uword thread_pool_raw = 0;
+  if (Thread::Current() != nullptr) {
+    ObjectPoolPtr tp = Thread::Current()->global_object_pool();
+    memcpy(&thread_pool_raw, &tp, sizeof(thread_pool_raw));
+  }
+  VitaTrace("[vita] pool @%s: group=%p store=%p pool=0x%08x thread_pool=0x%08x\n",
+            where, ig, store, static_cast<unsigned>(raw),
+            static_cast<unsigned>(thread_pool_raw));
+  return pool;
+}
+#endif
+
 BareSwitchableCallPattern::BareSwitchableCallPattern(uword pc)
     : SwitchableCallPatternBase(ObjectPool::Handle(
-          IsolateGroup::Current()->object_store()->global_object_pool())) {
+#if defined(DART_HOST_OS_VITA)
+          VitaTraceGlobalPool("BareSwitchableCallPattern")
+#else
+          IsolateGroup::Current()->object_store()->global_object_pool()
+#endif
+              )) {
   // Last instruction: blx lr.
   ASSERT(*(reinterpret_cast<uint32_t*>(pc) - 1) == 0xe12fff3e);
 
