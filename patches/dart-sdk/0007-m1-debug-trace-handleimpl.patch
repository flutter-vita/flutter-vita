@@ -774,6 +780,38 @@ class Object {
                                           ObjectPtr ptr,
                                           intptr_t default_cid) {
     Object* obj = reinterpret_cast<Object*>(VMHandles::AllocateHandle(zone));
+#if defined(DART_HOST_OS_VITA)
+    // M1 debugging. setPtr immediately untags ptr and reads its header, so an
+    // ObjectPtr of 1 (nullptr | kHeapObjectTag) faults here with no way to see
+    // the caller: the crash dump gives only PC and LR, both inside this
+    // function. Name the caller before dereferencing.
+    //
+    // Remove once the ObjectPtr == 1 bug is found.
+    // Bit-copy rather than an accessor: untagged_pointer() is protected, and
+    // this must not perturb the value being diagnosed.
+    uword raw_ptr_value;
+    memcpy(&raw_ptr_value, &ptr, sizeof(raw_ptr_value));
+    if (raw_ptr_value == kHeapObjectTag) {
+      // ra(0) lands inside ObjectPool::Handle, a thin wrapper, so the real
+      // call site is further up. GCC on ARM rejects __builtin_return_address(n)
+      // for n > 0, so scan the stack instead and print anything that looks like
+      // a code address. Crude, but it needs no frame pointers and the noise is
+      // easy to filter with addr2line.
+      VitaTrace("[vita] HandleImpl: ObjectPtr==1 cid=%d ra0=%p\n",
+                static_cast<int>(default_cid), __builtin_return_address(0));
+      {
+        uword* sp = reinterpret_cast<uword*>(__builtin_frame_address(0));
+        for (intptr_t i = 0; i < 48; i++) {
+          const uword w = sp[i];
+          // Thumb return addresses are odd and live in the text range.
+          if ((w & 1) == 1 && w > 0x81000000 && w < 0x81800000) {
+            VitaTrace("[vita]   stack[%d] = 0x%08x\n", static_cast<int>(i),
+                      static_cast<unsigned>(w));
+          }
+        }
+      }
+    }
+#endif
     obj->setPtr(ptr, default_cid);
     return *obj;
   }
