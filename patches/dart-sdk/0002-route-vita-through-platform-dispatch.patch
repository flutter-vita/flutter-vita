diff --git a/runtime/vm/cpu_arm.cc b/runtime/vm/cpu_arm.cc
index d40147b2..1ad6fa23 100644
--- a/runtime/vm/cpu_arm.cc
+++ b/runtime/vm/cpu_arm.cc
@@ -137,6 +137,34 @@ void HostCPUFeatures::Init() {
   initialized_ = true;
 #endif
 }
+#elif defined(DART_HOST_OS_VITA)
+void HostCPUFeatures::Init() {
+  // The Vita is one fixed device: four ARM Cortex-A9 cores (ARMv7-A) with
+  // VFPv3 and NEON. There is no auxv to query and nothing to probe, so these
+  // are constants rather than detected values.
+  CpuInfo::Init();
+  hardware_ = CpuInfo::GetCpuModel();  // heap-allocated; Cleanup() frees it
+
+  // Cortex-A9 does NOT implement the ARMv7-A integer divide instructions
+  // (SDIV/UDIV) -- those arrive with Cortex-A7/A15. VitaSDK's compiler agrees:
+  // it does not define __ARM_FEATURE_IDIV. Claiming support here would make
+  // the compiler emit instructions that fault on the device.
+  integer_division_supported_ = false;
+  neon_supported_ = true;
+  hardfp_supported_ = true;  // VitaSDK builds --with-float=hard
+
+  // Allow flags to override, matching the other platforms.
+  if (!FLAG_use_integer_division) {
+    integer_division_supported_ = false;
+  }
+  if (!FLAG_use_neon) {
+    neon_supported_ = false;
+  }
+
+#if defined(DEBUG)
+  initialized_ = true;
+#endif
+}
 #else  // DART_HOST_OS_IOS
