@@ -21,6 +21,22 @@ using ConditionVariableImpl = absl::CondVar;
     defined(DART_HOST_OS_MACOS) || defined(DART_HOST_OS_ANDROID)
 using MutexImpl = pthread_mutex_t;
 using ConditionVariableImpl = pthread_cond_t;
+#elif defined(DART_HOST_OS_VITA)
+// The kernel's lightweight mutex and condition variable, not pthreads. The
+// pthread library on this platform builds its condition variables out of
+// semaphores and loses wakeups under broadcast: two threads parked on the
+// parallel marker's barrier stayed parked, one generation apart, on
+// 2026-09-13. See synchronization_vita.cc. The storage is the kernel's work
+// areas, spelled out so this header does not pull the SDK in.
+struct VitaLwMutex {
+  alignas(8) unsigned char work[32];  // SceKernelLwMutexWork
+};
+struct VitaLwCond {
+  alignas(8) unsigned char work[16];  // SceKernelLwCondWork
+  VitaLwMutex* bound;                 // the mutex it was created against
+};
+using MutexImpl = VitaLwMutex;
+using ConditionVariableImpl = VitaLwCond;
 #elif defined(DART_HOST_OS_WINDOWS)
 using MutexImpl = SRWLOCK;
 using ConditionVariableImpl = CONDITION_VARIABLE;
