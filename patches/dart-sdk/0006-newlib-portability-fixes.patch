diff --git a/runtime/lib/ffi_dynamic_library.cc b/runtime/lib/ffi_dynamic_library.cc
index 0aefcee4..4065b5c5 100644
--- a/runtime/lib/ffi_dynamic_library.cc
+++ b/runtime/lib/ffi_dynamic_library.cc
@@ -6,6 +6,13 @@
 
 #include "platform/globals.h"
 #include "platform/utils.h"
+#if defined(DART_HOST_OS_VITA)
+// The Vita links statically and has no dynamic loader, so there is no
+// "current process" handle to hand out and no symbol table to search. dart:ffi
+// DynamicLibrary is unsupported here by design -- see ADR-0004.
+#define DART_VITA_NO_DYNAMIC_LIBRARY 1
+#endif
+
 #if defined(DART_HOST_OS_WINDOWS)
 #include <Psapi.h>
 #include <Windows.h>
@@ -178,6 +185,9 @@ DEFINE_NATIVE_ENTRY(Ffi_dl_processLibrary, 0, 0) {
 #if defined(DART_HOST_OS_LINUX) || defined(DART_HOST_OS_MACOS) ||              \
     defined(DART_HOST_OS_ANDROID) || defined(DART_HOST_OS_FUCHSIA)
   return DynamicLibrary::New(RTLD_DEFAULT, false);
+#elif defined(DART_VITA_NO_DYNAMIC_LIBRARY)
+  Exceptions::ThrowUnsupportedError(
+      "DynamicLibrary.process is not supported on this platform");
 #else
   return DynamicLibrary::New(kWindowsDynamicLibraryProcessPtr, false);
 #endif
@@ -458,7 +468,11 @@ intptr_t FfiResolveInternal(const String& asset,
   }
 
   // Resolution in current process.
-#if !defined(DART_HOST_OS_WINDOWS)
+#if defined(DART_VITA_NO_DYNAMIC_LIBRARY)
+  void* const result = nullptr;
+  *error = Utils::StrDup(
+      "symbol lookup in the running process is not supported on this platform");
+#elif !defined(DART_HOST_OS_WINDOWS)
   void* const result = Utils::ResolveSymbolInDynamicLibrary(
       RTLD_DEFAULT, symbol.ToCString(), error);
 #else
