@@ -3,6 +3,11 @@
 // BSD-style license that can be found in the LICENSE file.
 
 #include "lib/integers.h"
+
+// LLONG_MAX / LLONG_MIN. glibc pulls <limits.h> in transitively; newlib under
+// -std=c++20 does not, so include it explicitly.
+#include <climits>
+
 #include "vm/bootstrap_natives.h"
 
 #include "include/dart_api.h"
diff --git a/runtime/platform/utils.cc b/runtime/platform/utils.cc
index 9ecd17d9..096541aa 100644
--- a/runtime/platform/utils.cc
+++ b/runtime/platform/utils.cc
@@ -375,6 +375,12 @@ void* Utils::ResolveSymbolInDynamicLibrary(void* library_handle,
     GetLastErrorAsString(error);
   }
   return result;
+#else
+  // The Vita links statically and has no dynamic loader, so there is nothing
+  // to resolve against. Reporting an error beats falling off the end of a
+  // non-void function.
+  *error = Utils::StrDup("dynamic libraries are not supported on this platform");
+  return nullptr;
 #endif
 }
 
@@ -396,7 +402,8 @@ void Utils::UnloadDynamicLibrary(void* library_handle, char** error) {
 }
 
