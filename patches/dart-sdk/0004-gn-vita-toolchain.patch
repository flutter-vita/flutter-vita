diff --git a/build/toolchain/vita/BUILD.gn b/build/toolchain/vita/BUILD.gn
new file mode 100644
index 00000000..ac6afe9c
--- /dev/null
+++ b/build/toolchain/vita/BUILD.gn
@@ -0,0 +1,57 @@
+# Copyright (c) 2024, the Dart project authors.  Please see the AUTHORS file
+# for details. All rights reserved. Use of this source code is governed by a
+# BSD-style license that can be found in the LICENSE file.
+
+# Toolchain for PlayStation Vita homebrew: VitaSDK's arm-vita-eabi GCC.
+#
+# This is modelled directly on the "arm" toolchain in ../linux/BUILD.gn, since
+# VitaSDK is GCC and Dart's gcc_toolchain template is exactly the supported way
+# to plug one in. Two differences from Linux:
+#
+#   * The prefix comes from $VITASDK rather than being on PATH by default.
+#   * is_clang is false, so the build takes Dart's GCC path throughout.
+
+import("//build/toolchain/ccache.gni")
+import("//build/toolchain/gcc_toolchain.gni")
+import("//build/toolchain/toolchain_suite.gni")
+
+declare_args() {
+  # Absolute path to the VitaSDK installation. Defaults to the conventional
+  # location; override with `gn gen --args='vitasdk_root="/path/to/vitasdk"'`.
+  vitasdk_root = getenv("VITASDK")
+}
+
+assert(vitasdk_root != "",
+       "vitasdk_root is empty: set the VITASDK environment variable or pass " +
+           "--args='vitasdk_root=\"/path/to/vitasdk\"'. See docs/dev-environment.md")
+
+template("gcc_toolchain_suite") {
+  toolchain_suite(target_name) {
+    toolchain_template = "gcc_toolchain"
+    forward_variables_from(invoker, "*")
+  }
+}
+
+if (use_ccache) {
+  compiler_prefix = "ccache "
+} else {
+  compiler_prefix = ""
+}
+
+gcc_toolchain_suite("arm") {
+  prefix = "$vitasdk_root/bin/arm-vita-eabi-"
+
+  cc = "${compiler_prefix}${prefix}gcc"
+  cxx = "${compiler_prefix}${prefix}g++"
+  asm = "${compiler_prefix}${prefix}gcc"
+
+  ar = "${prefix}ar"
+  ld = "${prefix}g++"
+  readelf = "${prefix}readelf"
+  nm = "${prefix}nm"
+  strip = "${prefix}strip"
+
+  toolchain_cpu = "arm"
+  toolchain_os = "vita"
+  is_clang = false
+}
