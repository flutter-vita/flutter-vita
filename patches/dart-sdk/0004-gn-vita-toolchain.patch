--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -626,6 +626,18 @@ config("runtime_library") {
       "dl",
       "pthread",
     ]
+  } else if (is_vita) {
+    # newlib gates its POSIX and BSD extensions behind feature-test macros, and
+    # -std=c++20 defines __STRICT_ANSI__, which hides them. Dart assumes glibc,
+    # where they are visible by default. Without this, functions like strdup and
+    # strtok_r come back "not declared in this scope" one file at a time, and
+    # patching each call site would be endless and wrong -- they do exist.
+    defines += [ "_DEFAULT_SOURCE" ]
+
+    # ICU picks its file-mapping implementation from U_HAVE_MMAP. There is no
+    # mmap on Vita, so force the stdio fallback; newlib's file IO is sceIo
+    # backed and works fine for reading icudtl.dat.
+    defines += [ "U_HAVE_MMAP=0" ]
   } else if (is_android) {
