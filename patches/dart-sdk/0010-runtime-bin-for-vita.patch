+  void* addr = malloc(length);
+  if (addr == nullptr) {
+    return nullptr;
+  }
+
+  int64_t offset = 0;
+  while (offset < length) {
+    const int64_t got = TEMP_FAILURE_RETRY(
+        pread(handle_->fd(), reinterpret_cast<char*>(addr) + offset,
+              length - offset, position + offset));
+    if (got <= 0) {
+      break;
+    }
+    offset += got;
+  }
+  if (offset != length) {
+    free(addr);
+    return nullptr;
+  }
+
+  return new MappedMemory(addr, length, /*should_unmap=*/true);
+}
