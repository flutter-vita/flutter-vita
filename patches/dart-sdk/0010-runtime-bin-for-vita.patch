+
+// `Process`, for a platform with exactly one process.
+//
+// This replaces 1203 lines of process_linux.cc with refusals, and that is the
+// implementation rather than a placeholder. The Vita has no fork, no exec, and
+// no way for an application to start another: launching is the shell's
+// business, through sceAppMgrLaunchAppByUri, which terminates the caller. There
+// is nothing here for Process.start to do that would resemble what a Dart
+// programmer means by it.
+//
+// Everything therefore reports failure with a message naming the platform, so
+// `ProcessException` says something useful instead of "operation failed".
+//
+// Three exceptions carry real implementations, because they are not about
+// starting processes at all and dart:io asks them routinely:
+//
+//   * CurrentProcessId  -- sceKernelGetProcessId
+//   * CurrentRSS/MaxRSS -- from sceKernelGetFreeMemorySize
+//
+// Signals are the other absence. There are none on this platform, so the
+// handler registry has nothing to register; ProcessSignal.watch reports that
+// rather than silently never firing, which would be the worse failure -- a
+// program waiting on SIGINT would simply hang.
+
+namespace dart {
+namespace bin {
+
+int Process::global_exit_code_ = 0;
+Mutex* Process::global_exit_code_mutex_ = new Mutex();
+Process::ExitHook Process::exit_hook_ = nullptr;
+
+static const char* kUnsupported =
+    "Starting a process is not supported on this platform";
+
+void Process::Init() {}
+
+void Process::Cleanup() {}
+
+int Process::Start(Namespace* namespc,
+                   const char* path,
+                   const char* arguments[],
+                   intptr_t arguments_length,
+                   const char* working_directory,
+                   char* environment[],
+                   intptr_t environment_length,
+                   ProcessStartMode mode,
+                   intptr_t* in,
+                   intptr_t* out,
+                   intptr_t* err,
+                   intptr_t* id,
+                   intptr_t* exit_handler,
+                   char** os_error_message) {
+  *os_error_message = Utils::StrDup(kUnsupported);
+  return ENOSYS;
+}
+
+bool Process::Wait(intptr_t id,
+                   intptr_t in,
+                   intptr_t out,
+                   intptr_t err,
+                   intptr_t exit_handler,
+                   ProcessResult* result) {
+  errno = ENOSYS;
+  return false;
+}
+
+bool Process::Kill(intptr_t id, int signal) {
+  errno = ENOSYS;
+  return false;
+}
+
+void Process::TerminateExitCodeHandler() {}
+
+intptr_t Process::CurrentProcessId() {
+  return static_cast<intptr_t>(sceKernelGetProcessId());
+}
+
+intptr_t Process::SetSignalHandler(intptr_t signal) {
+  errno = ENOSYS;
+  return -1;
+}
+
+void Process::ClearSignalHandler(intptr_t signal, Dart_Port port) {}
+
+int64_t Process::CurrentRSS() {
+  // There is no per-process accounting -- there is only the one process -- so
+  // "resident set" is read as how much of the application's heap is in use.
+  // sceKernelGetFreeMemorySize reports what remains of the partition this app
+  // was given, which is the number a developer watching for a leak wants.
+  SceKernelFreeMemorySizeInfo info;
+  info.size = sizeof(info);
+  if (sceKernelGetFreeMemorySize(&info) < 0) {
+    return -1;
+  }
+  return static_cast<int64_t>(info.size_user);
+}
+
+int64_t Process::MaxRSS() {
+  // Nothing tracks a high-water mark. Returning -1 is how dart:io spells "not
+  // available", and is better than reporting the current value as if it were
+  // the peak.
+  return -1;
+}
