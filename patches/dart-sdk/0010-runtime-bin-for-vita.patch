+
+// This is socket_base_linux.h minus <sys/un.h>, plus the declarations below.
+//
+// VitaSDK's socket layer is a thin BSD-shaped wrapper over sceNet, and it is
+// genuinely thinner than the header list suggests. What it has: IPv4 and IPv6,
+// TCP and UDP, poll/select, getaddrinfo. What it does not have, and what these
+// declarations exist to paper over just far enough to compile:
+//
+//   * No <sys/un.h> and no struct sockaddr_un, though AF_UNIX is #defined.
+//   * No struct cmsghdr and no SCM_RIGHTS, so no ancillary data at all --
+//     passing file descriptors over a socket is impossible here, not merely
+//     unimplemented.
+//   * No <ifaddrs.h>, so interfaces cannot be enumerated.
+//   * Of the IPV6_* socket options, only IPV6_V6ONLY exists. There is no
+//     multicast.
+//
+// Everything above is reported as an error at the call site rather than
+// silently doing nothing -- see socket_base_vita.cc.
+
+// Two constants the shared code names but VitaSDK does not define. Both are
+// given their standard BSD values rather than invented ones, so that if sceNet
+// ever grows support the numbers are already right, and so that reading the
+// code does not require knowing these are local.
+//
+// IPV6_MULTICAST_IF is a real socket option number that this platform will
+// reject: of the IPPROTO_IPV6 options, sceNet implements only IPV6_V6ONLY. The
+// setsockopt call therefore fails and Dart reports the error, which is the
+// correct outcome -- there is no multicast here.
+#if !defined(IPV6_MULTICAST_IF)
+#define IPV6_MULTICAST_IF 9
+#endif
+
+// SCM_RIGHTS is only ever compared against a control message's type, and
+// VitaSDK has no struct cmsghdr, so no control message can exist to compare.
+// The value is unreachable rather than wrong.
+#if !defined(SCM_RIGHTS)
+#define SCM_RIGHTS 0x01
+#endif
+
+// IPv4 multicast is real here -- sceNet defines IP_MULTICAST_IF, _TTL, _LOOP
+// and IP_ADD_MEMBERSHIP. The IPv6 equivalents are not defined at all, so they
+// get their standard values for the same reason as IPV6_MULTICAST_IF above:
+// setsockopt rejects them, and Dart reports the error.
+#if !defined(IPV6_MULTICAST_LOOP)
+#define IPV6_MULTICAST_LOOP 19
+#endif
+#if !defined(IPV6_MULTICAST_HOPS)
+#define IPV6_MULTICAST_HOPS 10
+#endif
+#if !defined(IPV6_UNICAST_HOPS)
+#define IPV6_UNICAST_HOPS 4
+#endif
+#if !defined(IPV6_JOIN_GROUP)
+#define IPV6_JOIN_GROUP 12
+#endif
+#if !defined(IPV6_LEAVE_GROUP)
+#define IPV6_LEAVE_GROUP 13
+#endif
+
+namespace dart {
+namespace bin {
+
+// dart::bin::RawAddr has a sockaddr_un member and several shared, non-platform
+// files reach into it. Rather than thread an #if through socket_base.h,
+// socket_base.cc, socket.h and socket.cc -- five files and about thirty sites,
+// each a chance to get it wrong on the next engine roll -- the type is declared
+// here so that code continues to compile unchanged.
+//
+// This is safe because nothing can construct a working AF_UNIX socket on this
+// platform: sceNet rejects the family, so socket() fails and the paths that use
+// these fields are never reached with a live descriptor. The layout below is
+// the standard BSD one, so sizeof() and offsetof() give the values the shared
+// code expects.
+struct vita_sockaddr_un {
+  unsigned char sun_len;
+  unsigned char sun_family;
+  char sun_path[104];
+};
+
+}  // namespace bin
+}  // namespace dart
+
+// Deliberately outside the namespace: the shared code spells it `sockaddr_un`
+// unqualified, as the POSIX type.
+typedef struct dart::bin::vita_sockaddr_un sockaddr_un;
+
+#endif  // RUNTIME_BIN_SOCKET_BASE_VITA_H_
