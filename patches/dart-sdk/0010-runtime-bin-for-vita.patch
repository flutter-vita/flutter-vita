+bool Crypto::GetRandomBytes(intptr_t count, uint8_t* buffer) {
+  // sceKernelGetRandomNumber rather than getrandom(2) or /dev/urandom: there is
+  // no syscall(2) here and no /dev at all. It is the kernel's CSPRNG, which is
+  // what the Linux path is reaching for by two different routes.
+  //
+  // It takes a 32-bit size and refuses large requests, so the read is chunked.
+  // Dart asks for small amounts (seeds, hash keys), but a silent short read
+  // would be a security bug rather than a correctness one, so the loop is here
+  // regardless.
+  const SceSize kMaxChunk = 64;
+  intptr_t bytes_read = 0;
+  while (bytes_read < count) {
+    SceSize chunk = static_cast<SceSize>(count - bytes_read);
+    if (chunk > kMaxChunk) {
+      chunk = kMaxChunk;
+    }
+    if (sceKernelGetRandomNumber(buffer + bytes_read, chunk) < 0) {
+      return false;
+    }
+    bytes_read += chunk;
+  }
+  return true;
+}
