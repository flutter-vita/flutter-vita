+  // No mmap. This is the third place in the port to need a mapping and the
+  // first where a heap copy is not obviously right, so the reasoning matters.
+  //
+  // Skia and fml both map read-only and only ever read through the result, so a
+  // copy is indistinguishable from a mapping there. Here the caller may pass
+  // `start`, which on Linux becomes MAP_FIXED -- "put it exactly here" -- and a
+  // copy cannot honour that. Dart's ELF loader is the caller that does so, when
+  // placing an AOT snapshot's segments.
+  //
+  // Refusing that case is correct rather than merely convenient: this port
+  // links its snapshot into eboot.bin (ADR-0005 option A) precisely because
+  // nothing on the Vita can load one at a chosen address. A caller asking for a
+  // fixed address here has already gone down a path that cannot work, and
+  // should find out now rather than through a wild pointer.
+  if (start != nullptr) {
+    errno = ENOSYS;
+    return nullptr;
+  }
+
+  // kReadExecute would need memory the Vita will let us execute, which means a
+  // VM-domain block rather than the heap -- see virtual_memory_vita.cc, and
+  // ADR-0005 for why that route was abandoned. dart:io itself never asks for
+  // it; only snapshot loading does.
+  if (type == kReadExecute) {
+    errno = ENOSYS;
+    return nullptr;
+  }
