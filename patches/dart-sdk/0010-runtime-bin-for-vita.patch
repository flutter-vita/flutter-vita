diff --git a/runtime/bin/vita_compat.h b/runtime/bin/vita_compat.h
new file mode 100644
index 00000000..e6066a18
--- /dev/null
+++ b/runtime/bin/vita_compat.h
@@ -0,0 +1,171 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#ifndef RUNTIME_BIN_VITA_COMPAT_H_
+#define RUNTIME_BIN_VITA_COMPAT_H_
+
+#include "platform/globals.h"
+
+#if defined(DART_HOST_OS_VITA)
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+// Spellings that `runtime/bin`'s Linux implementations use and VitaSDK's newlib
+// does not provide.
+//
+// This header exists so that those implementations can be shared rather than
+// forked. A compile probe over the twelve remaining modules found roughly
+// eighty lines needing attention across 4600 lines of source; copying each
+// `*_linux.cc` to a `*_vita.cc` would duplicate all 4600 and turn every engine
+// roll into a twelve-way merge. Dart already shares this way -- see
+// `socket_base_posix.cc`, which spans three operating systems.
+//
+// **Only genuinely equivalent spellings belong here.** Anything whose absence
+// changes behaviour is called out below rather than papered over, because a
+// silently wrong #define is far more expensive than a compile error.
+
+// ---------------------------------------------------------------- large file
+//
+// newlib is 64-bit-off_t by default here, so the LFS-64 names are pure
+// synonyms rather than a different API. Defining the bare identifiers covers
+// both uses: `struct stat64` becomes `struct stat`, and `stat64(...)` becomes
+// `stat(...)`.
+#define stat64 stat
+#define fstat64 fstat
+#define lstat64 lstat
+#define fstatat64 fstatat
+#define open64 open
+#define openat64 openat
+#define lseek64 lseek
+#define ftruncate64 ftruncate
+#define truncate64 truncate
+
+typedef ino_t ino64_t;
+typedef off_t off64_t;
+
+// ------------------------------------------------------------------- dirent
+//
+// VitaSDK's `struct dirent` carries a SceIoStat and a name, and has no
+// `d_type`. Rather than reach into the SceIoStat -- whose layout is a detail of
+// a different SDK -- entries report DT_UNKNOWN, which sends the caller down a
+// path Dart already maintains for "file systems where readdir does not
+// determine the entry type". That path stats the entry, which is what reading
+// d_stat would have amounted to anyway, and it is already tested.
+#define DT_UNKNOWN 0
+#define DT_FIFO 1
+#define DT_CHR 2
+#define DT_DIR 4
+#define DT_BLK 6
+#define DT_REG 8
+#define DT_LNK 10
+#define DT_SOCK 12
+
+#define DART_DIRENT_TYPE(entry) DT_UNKNOWN
+
+// -------------------------------------------------------------- retry macros
+//
+// platform/signal_blocker.h cannot be included on this platform -- there is no
+// pthread_sigmask, sigemptyset or sigaddset for ThreadSignalBlocker to use --
+// and the EINTR-retry macros live in it. There are no signals here, so the
+// blocking versions collapse to plain retries.
+#if !defined(TEMP_FAILURE_RETRY)
+#define TEMP_FAILURE_RETRY(expression)                                         \
+  ({                                                                           \
+    intptr_t __result;                                                         \
+    do {                                                                       \
+      __result = (expression);                                                 \
+    } while ((__result == -1L) && (errno == EINTR));                           \
+    __result;                                                                  \
+  })
+#define VOID_TEMP_FAILURE_RETRY(expression)                                    \
+  (static_cast<void>(TEMP_FAILURE_RETRY(expression)))
+#define TEMP_FAILURE_RETRY_NO_SIGNAL_BLOCKER(expression)                       \
+  TEMP_FAILURE_RETRY(expression)
+#define VOID_TEMP_FAILURE_RETRY_NO_SIGNAL_BLOCKER(expression)                  \
+  (static_cast<void>(TEMP_FAILURE_RETRY(expression)))
+#define NO_RETRY_EXPECTED(expression)                                          \
+  ({                                                                           \
+    intptr_t __result = (expression);                                          \
+    __result;                                                                  \
+  })
+#define VOID_NO_RETRY_EXPECTED(expression)                                     \
+  (static_cast<void>(NO_RETRY_EXPECTED(expression)))
+#endif
+
+// ------------------------------------------------------------------ st_?tim
+//
+// VitaSDK's <sys/stat.h> picks the older `time_t st_atime` layout for __vita__
+// explicitly, so `st_atim` and friends -- the nanosecond `struct timespec`
+// members -- do not exist. This is not a feature-macro that can be switched on;
+// the struct simply has second resolution.
+//
+// These helpers give the shared code the timespec it wants, with tv_nsec zero,
+// so the call sites read the same on every platform.
+static inline struct timespec DartVitaStatTime(time_t seconds) {
+  struct timespec ts;
+  ts.tv_sec = seconds;
+  ts.tv_nsec = 0;
+  return ts;
+}
+#define DART_STAT_ATIM(st) DartVitaStatTime((st).st_atime)
+#define DART_STAT_MTIM(st) DartVitaStatTime((st).st_mtime)
+#define DART_STAT_CTIM(st) DartVitaStatTime((st).st_ctime)
+
+// ------------------------------------------------------------------ sendfile
+//
+// No sendfile(2). File::Copy already carries a read/write fallback for
+// "platforms where sendfile() fails with EINVAL or ENOSYS" -- its own comment
+// -- so reporting ENOSYS routes the copy down a path Dart already maintains
+// and tests, rather than adding a second one.
+static inline ssize_t sendfile64(int out_fd,
+                                 int in_fd,
+                                 int64_t* offset,
+                                 size_t count) {
+  errno = ENOSYS;
+  return -1;
+}
+
+// ------------------------------------------------------------------- sockets
+
+// No listen() backlog constant. 128 is what Linux uses.
+#if !defined(SOMAXCONN)
+#define SOMAXCONN 128
+#endif
+
+// ENONET is Linux-specific ("machine is not on the network") and is only ever
+// compared against, never returned here.
+#if !defined(ENONET)
+#define ENONET 64
+#endif
+
+// SOCK_CLOEXEC is meaningless on this platform and 0 is the honest value: there
+// is no exec(), so no descriptor can leak across one.
+#if !defined(SOCK_CLOEXEC)
+#define SOCK_CLOEXEC 0
+#endif
+
+// **SOCK_NONBLOCK is deliberately NOT defined.**
+//
+// Defining it as 0 would compile and would be wrong in the worst way: every
+// socket dart:io creates would come back blocking, and the event loop would
+// stall on the first read that had no data ready -- a hang, at runtime, far
+// from the cause. Leaving it undefined turns each of those call sites into a
+// compile error, so every one gets an explicit FDUtils::SetNonBlocking after
+// the socket is created. That is more work and it is the only safe version.
+
+#else  // defined(DART_HOST_OS_VITA)
+
+#define DART_DIRENT_TYPE(entry) ((entry)->d_type)
+#define DART_STAT_ATIM(st) ((st).st_atim)
+#define DART_STAT_MTIM(st) ((st).st_mtim)
+#define DART_STAT_CTIM(st) ((st).st_ctim)
+
+#endif  // defined(DART_HOST_OS_VITA)
+
+#endif  // RUNTIME_BIN_VITA_COMPAT_H_
diff --git a/runtime/bin/vita_posix_shims.cc b/runtime/bin/vita_posix_shims.cc
new file mode 100644
index 00000000..0b64c6a5
--- /dev/null
+++ b/runtime/bin/vita_posix_shims.cc
@@ -0,0 +1,187 @@
+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "platform/globals.h"
+#if defined(DART_HOST_OS_VITA)
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <sys/utsname.h>
+#include <unistd.h>
+#include <utime.h>
+
+// Definitions for libc functions VitaSDK **declares but does not implement**.
+//
+// This is the pattern Phase 1 used for `__emutls_get_address`: these are plain
+// C ABI functions, so defining them in our own object overrides nothing and
+// simply supplies the missing symbol. Every one of them compiled fine across
+// 2682 objects and only appeared at the link, which is the whole reason M2 is a
+// link and not a build.
+//
+// ## Why wrappers rather than a Namespace rewrite
+//
+// Dart's `runtime/bin` uses the `*at()` family throughout, because `Namespace`
+// can hold a directory descriptor and resolve paths relative to it. The
+// alternative to these shims was to teach `Namespace` to produce absolute paths
+// on this platform and call the plain functions.
+//
+// The wrappers win because **`Namespace` is already the default almost
+// everywhere**: `NamespaceScope` yields `AT_FDCWD` unless an embedder installs
+// a namespace, and this port does not. So each shim handles the case that
+// actually occurs -- `AT_FDCWD`, delegate to the plain call -- and refuses the
+// case that does not, loudly, instead of silently resolving against the wrong
+// directory. Rewriting `Namespace` would have touched more code to reach the
+// same behaviour, and would have removed the check.
+//
+// ## Symlinks
+//
+// There are none. VitaSDK has no `symlink` or `readlink`, and sceIo has no
+// concept of one. The shims return the errors POSIX specifies for "this is not
+// a symbolic link" rather than a generic failure, so `File.resolveSymbolicLinks`
+// and friends report something a Dart programmer can act on.
+
+extern "C" {
+
+// A directory descriptor other than AT_FDCWD would need openat's real
+// semantics, which sceIo cannot express. Rather than resolve against the
+// process's cwd and quietly produce the wrong path, say so.
+static int VitaRejectDirFd(int dirfd) {
+  if (dirfd == AT_FDCWD) {
+    return 0;
+  }
+  errno = ENOTSUP;
+  return -1;
+}
+
+int openat(int dirfd, const char* path, int flags, ...) {
+  if (VitaRejectDirFd(dirfd) != 0) {
+    return -1;
+  }
+  // The mode argument only matters with O_CREAT. sceIo ignores POSIX
+  // permission bits entirely -- there is no ownership on this filesystem -- so
+  // it is not forwarded, and open()'s two-argument form is the honest call.
+  return open(path, flags, 0666);
+}
+
+int fstatat(int dirfd, const char* path, struct stat* st, int flags) {
+  if (VitaRejectDirFd(dirfd) != 0) {
+    return -1;
+  }
+  // AT_SYMLINK_NOFOLLOW is a distinction without a difference here: nothing on
+  // this filesystem is a symlink, so stat and lstat agree.
+  return stat(path, st);
+}
+
+int mkdirat(int dirfd, const char* path, mode_t mode) {
+  if (VitaRejectDirFd(dirfd) != 0) {
+    return -1;
+  }
+  return mkdir(path, mode);
+}
+
+int unlinkat(int dirfd, const char* path, int flags) {
+  if (VitaRejectDirFd(dirfd) != 0) {
+    return -1;
+  }
+  return ((flags & AT_REMOVEDIR) != 0) ? rmdir(path) : unlink(path);
+}
+
+int renameat(int olddirfd,
+             const char* oldpath,
+             int newdirfd,
+             const char* newpath) {
+  if (VitaRejectDirFd(olddirfd) != 0 || VitaRejectDirFd(newdirfd) != 0) {
+    return -1;
+  }
+  return rename(oldpath, newpath);
+}
+
+int faccessat(int dirfd, const char* path, int mode, int flags) {
+  if (VitaRejectDirFd(dirfd) != 0) {
+    return -1;
+  }
+  return access(path, mode);
+}
+
+int utimensat(int dirfd,
+              const char* path,
+              const struct timespec times[2],
+              int flags) {
+  if (VitaRejectDirFd(dirfd) != 0) {
+    return -1;
+  }
+  if (times == nullptr) {
+    return utime(path, nullptr);
+  }
+  // Nanoseconds are dropped, which is not a shim's discretion but the
+  // platform's: VitaSDK's struct stat carries time_t, not timespec, so the
+  // resolution was already one second on the way in.
+  struct utimbuf buf;
+  buf.actime = times[0].tv_sec;
+  buf.modtime = times[1].tv_sec;
+  return utime(path, &buf);
+}
+
+// -------------------------------------------------------------- no symlinks
+
+int symlinkat(const char* target, int newdirfd, const char* linkpath) {
+  errno = ENOSYS;
+  return -1;
+}
+
+ssize_t readlink(const char* path, char* buf, size_t bufsize) {
+  // EINVAL is what POSIX specifies for "the named file is not a symbolic
+  // link", which is true of every file here. Callers that probe with readlink
+  // to decide whether a path is a link get the right answer.
+  errno = EINVAL;
+  return -1;
+}
+
+ssize_t readlinkat(int dirfd, const char* path, char* buf, size_t bufsize) {
+  errno = EINVAL;
+  return -1;
+}
+
+// ------------------------------------------------------------------- misc
+
+int dup2(int oldfd, int newfd) {
+  // VitaSDK has dup() but not dup2(), and dup() cannot be told which
+  // descriptor to produce. The only caller in runtime/bin is process
+  // redirection, which does not exist on this platform -- so rather than
+  // return a descriptor with the wrong number and corrupt whatever was at
+  // newfd, refuse.
+  if (oldfd == newfd) {
+    return newfd;
+  }
+  errno = ENOSYS;
+  return -1;
+}
+
+}  // extern "C"
+
+// Outside the extern "C" block on purpose. VitaSDK's <sys/utsname.h> declares
+// uname without an extern "C" guard, so under C++ it has C++ linkage -- the
+// mangled name is what the link was asking for. Defining it as C would add a
+// second, unrelated symbol and leave the original undefined.
+int uname(struct utsname* name) {
+  if (name == nullptr) {
+    errno = EFAULT;
+    return -1;
+  }
+  memset(name, 0, sizeof(*name));
+  // Dart surfaces these through Platform.operatingSystemVersion and
+  // Platform.localHostname. There is no kernel version to report that would
+  // mean anything, and no hostname at all.
+  strncpy(name->sysname, "Vita", sizeof(name->sysname) - 1);
+  strncpy(name->nodename, "localhost", sizeof(name->nodename) - 1);
+  strncpy(name->release, "3.60", sizeof(name->release) - 1);
+  strncpy(name->version, "VitaSDK", sizeof(name->version) - 1);
+  strncpy(name->machine, "armv7l", sizeof(name->machine) - 1);
+  return 0;
+}
+
+#endif  // defined(DART_HOST_OS_VITA)
diff --git a/runtime/vm/BUILD.gn b/runtime/vm/BUILD.gn
index 39749fad..e65d0e77 100644
--- a/runtime/vm/BUILD.gn
+++ b/runtime/vm/BUILD.gn
@@ -56,14 +56,31 @@ config("libdart_vm_config") {
       libs += [ "dbghelp.lib" ]
     }
   } else {
-    libs = [ "dl" ]
+    # No -ldl on Vita. There is no dynamic loader, LoadDynamicLibrary already
+    # reports unsupported, and linking it is not merely useless: VitaSDK's
+    # libdl.a implements dlsym on top of taiGetModuleInfo and
+    # sceSblDmac5HashTransform, so it drags in two stub libraries to support a
+    # function that can never succeed. Those arrived at the link as two
+    # undefined symbols with no obvious owner.
+    if (is_vita) {
+      libs = []
+    } else {
+      libs = [ "dl" ]
+    }
     if (!is_android) {
       libs += [ "pthread" ]
     }
 
     # Clang with libc++ does not require an explicit atomic library reference.
     # (similar to https://github.com/flutter/buildroot/blob/master/build/config/compiler/BUILD.gn#L562)
-    if (!is_clang) {
+    #
+    # Nor does VitaSDK, which simply has no libatomic: GCC 15.2 targeting
+    # armv7-a emits the atomic operations Dart uses inline, so there is nothing
+    # for a support library to provide. Asking for it fails the link outright
+    # with "cannot find -latomic". If a future change does need an out-of-line
+    # atomic, it will show up as an undefined __atomic_* symbol, which is a
+    # clearer error than this one.
+    if (!is_clang && !is_vita) {
       libs += [ "atomic" ]
     }
   }
