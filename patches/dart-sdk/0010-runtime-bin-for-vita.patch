+#include "bin/dartutils.h"
+
+// There is no inotify, no kqueue and no sceIo equivalent: the Vita's filesystem
+// layer reports nothing when a file changes.
+//
+// `IsSupported()` returning false is the whole point of this file. dart:io asks
+// it first and raises a clear `FileSystemException` when it is false, so
+// `Directory.watch` and `File.watch` fail with a real explanation. The
+// alternative -- returning a watcher that never fires -- would look like the
+// filesystem was simply idle, and a program waiting on a change would hang.
+
+namespace dart {
+namespace bin {
+
+void FileSystemWatcher::InitOnce() {}
+
+void FileSystemWatcher::Cleanup() {}
+
+bool FileSystemWatcher::IsSupported() {
+  return false;
+}
+
+intptr_t FileSystemWatcher::Init() {
+  errno = ENOSYS;
+  return -1;
+}
+
+void FileSystemWatcher::Close(intptr_t id) {}
+
+intptr_t FileSystemWatcher::WatchPath(intptr_t id,
+                                      Namespace* namespc,
+                                      const char* path,
+                                      int events,
+                                      bool recursive) {
+  errno = ENOSYS;
+  return -1;
+}
+
+void FileSystemWatcher::UnwatchPath(intptr_t id, intptr_t path_id) {}
+
+intptr_t FileSystemWatcher::GetSocketId(intptr_t id, intptr_t path_id) {
+  errno = ENOSYS;
+  return -1;
+}
+
+Dart_Handle FileSystemWatcher::ReadEvents(intptr_t id, intptr_t path_id) {
+  // Unreachable in practice -- IsSupported() gates every path that leads here
+  // -- but an empty list is the right shape if anything ever does arrive, and
+  // it is safer than returning an error Dart is not expecting at this point.
+  return Dart_NewList(0);
+}
+
+}  // namespace bin
+}  // namespace dart
+
