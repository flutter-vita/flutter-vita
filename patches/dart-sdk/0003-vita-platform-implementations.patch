+// Copyright (c) 2012, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#include "vm/globals.h"
+#if defined(DART_HOST_OS_VITA)
+
+#include "platform/assert.h"
+#include "vm/cpuinfo.h"
+
+#include <string.h>
+
+// The Vita is a single fixed device: a Sony CXD5315GG with four ARM Cortex-A9
+// cores (ARMv7-A), VFPv3 and NEON. There is nothing to probe -- no /proc, no
+// cpuid, no auxv -- so the answers are constants.
+
+namespace dart {
+
+CpuInfoMethod CpuInfo::method_ = kCpuInfoNone;
+const char* CpuInfo::fields_[kCpuInfoMax] = {};
+
+void CpuInfo::Init() {
+  method_ = kCpuInfoNone;
+  fields_[kCpuInfoProcessor] = "Processor";
+  fields_[kCpuInfoModel] = "model name";
+  fields_[kCpuInfoHardware] = "Hardware";
+  fields_[kCpuInfoFeatures] = "Features";
+  fields_[kCpuInfoArchitecture] = "CPU architecture";
+}
+
+void CpuInfo::Cleanup() {}
+
+bool CpuInfo::FieldContains(CpuInfoIndices idx, const char* search_string) {
+  const char* value = ExtractField(idx);
+  const bool result = strstr(value, search_string) != nullptr;
+  free(const_cast<char*>(value));
+  return result;
+}
+
+const char* CpuInfo::ExtractField(CpuInfoIndices idx) {
+  // Callers own the result -- see CpuInfo::GetCpuModel.
+  switch (idx) {
+    case kCpuInfoProcessor:
+      return strdup("ARMv7 Processor rev 10 (v7l)");
+    case kCpuInfoModel:
+    case kCpuInfoHardware:
+      return strdup("Sony PlayStation Vita (Cortex-A9)");
+    case kCpuInfoFeatures:
+      // Deliberately no "idiva"/"idivt": Cortex-A9 does not implement the
+      // ARMv7-A integer divide instructions. See cpu_arm.cc.
+      return strdup("half thumb fastmult vfp edsp neon vfpv3 tls");
+    case kCpuInfoArchitecture:
+      return strdup("7");
+    default:
+      return strdup("");
+  }
+}
+
+bool CpuInfo::HasField(const char* field) {
+  return (strcmp(field, fields_[kCpuInfoProcessor]) == 0) ||
+         (strcmp(field, fields_[kCpuInfoModel]) == 0) ||
+         (strcmp(field, fields_[kCpuInfoHardware]) == 0) ||
+         (strcmp(field, fields_[kCpuInfoFeatures]) == 0) ||
+         (strcmp(field, fields_[kCpuInfoArchitecture]) == 0);
+}
+
+}  // namespace dart
+
+#endif  // defined(DART_HOST_OS_VITA)
