--- /dev/null
+++ b/runtime/platform/utils_vita.h
@@ -0,0 +1,54 @@
+// Copyright (c) 2012, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+#ifndef RUNTIME_PLATFORM_UTILS_VITA_H_
+#define RUNTIME_PLATFORM_UTILS_VITA_H_
+
+#if !defined(RUNTIME_PLATFORM_UTILS_H_)
+#error Do not include utils_vita.h directly; use utils.h instead.
+#endif
+
+#include <stdio.h>
+#include <string.h>
+
+// Unlike utils_linux.h, this does not include <endian.h>: newlib does not
+// provide it. The Vita is little-endian ARMv7, so the little-endian conversions
+// are the identity and the big-endian ones are byte swaps.
+
+namespace dart {
+
+inline uint16_t Utils::HostToBigEndian16(uint16_t value) {
+  return __builtin_bswap16(value);
+}
+
+inline uint32_t Utils::HostToBigEndian32(uint32_t value) {
+  return __builtin_bswap32(value);
+}
+
+inline uint64_t Utils::HostToBigEndian64(uint64_t value) {
+  return __builtin_bswap64(value);
+}
+
+inline uint16_t Utils::HostToLittleEndian16(uint16_t value) {
+  return value;
+}
+
+inline uint32_t Utils::HostToLittleEndian32(uint32_t value) {
+  return value;
+}
+
+inline uint64_t Utils::HostToLittleEndian64(uint64_t value) {
+  return value;
+}
+
+inline char* Utils::StrError(int err, char* buffer, size_t bufsize) {
+  // newlib does not expose the POSIX strerror_r under VitaSDK's feature-test
+  // defaults, so copy out of strerror(). Only used on error paths.
+  snprintf(buffer, bufsize, "%s", strerror(err));
+  return buffer;
+}
+
+}  // namespace dart
+
+#endif  // RUNTIME_PLATFORM_UTILS_VITA_H_
