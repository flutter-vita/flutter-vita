diff --git a/runtime/platform/globals.h b/runtime/platform/globals.h
index 66c3f273..d87ba988 100644
--- a/runtime/platform/globals.h
+++ b/runtime/platform/globals.h
@@ -138,6 +138,11 @@
 #elif defined(__Fuchsia__)
 #define DART_HOST_OS_FUCHSIA
 
+#elif defined(__vita__)
+
+// PlayStation Vita (homebrew, VitaSDK / arm-vita-eabi, newlib).
+#define DART_HOST_OS_VITA 1
+
 #elif !defined(DART_HOST_OS_FUCHSIA)
 #error Automatic target os detection failed.
 #endif
@@ -418,7 +423,8 @@ struct simd128_value_t {
 
 #if !defined(DART_TARGET_OS_ANDROID) && !defined(DART_TARGET_OS_FUCHSIA) &&    \
     !defined(DART_TARGET_OS_MACOS_IOS) && !defined(DART_TARGET_OS_LINUX) &&    \
-    !defined(DART_TARGET_OS_MACOS) && !defined(DART_TARGET_OS_WINDOWS)
+    !defined(DART_TARGET_OS_MACOS) && !defined(DART_TARGET_OS_WINDOWS) &&      \
+    !defined(DART_TARGET_OS_VITA)
 // No target OS specified; pick the one matching the host OS.
 #if defined(DART_HOST_OS_ANDROID)
 #define DART_TARGET_OS_ANDROID 1
@@ -433,6 +439,8 @@ struct simd128_value_t {
 #define DART_TARGET_OS_MACOS 1
 #elif defined(DART_HOST_OS_WINDOWS)
 #define DART_TARGET_OS_WINDOWS 1
+#elif defined(DART_HOST_OS_VITA)
+#define DART_TARGET_OS_VITA 1
 #else
 #error Automatic target OS detection failed.
 #endif
@@ -697,6 +705,14 @@ DART_FORCE_INLINE D bit_copy(const S& source) {
 #define STDERR_FILENO 2
 #endif
 
+#if defined(DART_HOST_OS_VITA)
+// newlib keeps PATH_MAX in <sys/syslimits.h>. VitaSDK does ship a <limits.h>
+// defining it, but GCC's own limits.h shadows that one and the include_next
+// chain never reaches it -- so the <limits.h> above leaves PATH_MAX undefined
+// and the fallback below would expand it to the Windows-only MAX_PATH.
+#include <sys/syslimits.h>
+#endif
+
 #ifndef PATH_MAX
 // Most platforms use PATH_MAX, but in Windows it's called MAX_PATH.
 #define PATH_MAX MAX_PATH
@@ -717,6 +733,37 @@ DART_FORCE_INLINE D bit_copy(const S& source) {
 #define kHostOperatingSystemName "macos"
 #elif defined(DART_HOST_OS_WINDOWS)
 #define kHostOperatingSystemName "windows"
+#elif defined(DART_HOST_OS_VITA)
+// Reported as "linux", not "vita", and the reason is the Flutter framework
+// rather than Dart.
+//
+// `defaultTargetPlatform` in package:flutter/src/foundation/_platform_io.dart
+// is a chain of Platform.isAndroid / isIOS / isLinux / ... and it *throws*
+// when none match:
+//
+//     Unhandled Exception: Unknown platform.
+//     #0  defaultTargetPlatform (_platform_io.dart:39)
+//     ...
+//     #16 runApp (binding.dart:1884)
+//
+// That fires inside `new FocusManager`, before the first frame, so with an
+// honest "vita" no Flutter app can start at all. The override is not
+// available: `debugDefaultTargetPlatformOverride` is ignored in release, and
+// this port only builds AOT release.
+//
+// TargetPlatform.linux is also the right *behavioural* answer -- it selects
+// desktop text-editing shortcuts, desktop scrollbars, and no mobile overscroll
+// glow, which is what a handheld with buttons and a touchscreen but no mobile
+// OS should get. flutter-pi and flutter-elinux report linux for the same
+// reason.
+//
+// The cost is real and belongs written down: `Platform.operatingSystem` now
+// lies to application code, and anything that branches on it -- including
+// packages reaching for /proc or /sys -- will take the Linux path. The honest
+// fix is a TargetPlatform.vita in the framework, which means a case in every
+// switch over TargetPlatform; that is a framework patch, not an engine one,
+// and it is tracked as its own piece of work.
+#define kHostOperatingSystemName "linux"
 #else
 #error Host operating system detection failed.
 #endif
@@ -769,6 +816,8 @@ DART_FORCE_INLINE D bit_copy(const S& source) {
 #define kTargetOperatingSystemName "macos"
 #elif defined(DART_TARGET_OS_WINDOWS)
 #define kTargetOperatingSystemName "windows"
+#elif defined(DART_TARGET_OS_VITA)
+#define kTargetOperatingSystemName "vita"
 #else
 #error Target operating system detection failed.
 #endif
