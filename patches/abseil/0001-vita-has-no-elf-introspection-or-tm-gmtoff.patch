diff --git a/absl/debugging/internal/elf_mem_image.h b/absl/debugging/internal/elf_mem_image.h
index c8a1036..1ab87f3 100644
--- a/absl/debugging/internal/elf_mem_image.h
+++ b/absl/debugging/internal/elf_mem_image.h
@@ -32,10 +32,14 @@
 #error ABSL_HAVE_ELF_MEM_IMAGE cannot be directly set
 #endif
 
+// __vita__ is in this exclusion list for the reason the comment above gives:
+// the file needs glibc's ELF symbol extensions. VitaSDK's newlib has no
+// <link.h> and no dl_iterate_phdr, and homebrew binaries are statically linked
+// with nothing to introspect anyway.
 #if defined(__ELF__) && !defined(__OpenBSD__) && !defined(__QNX__) &&    \
     !defined(__asmjs__) && !defined(__wasm__) && !defined(__HAIKU__) &&  \
     !defined(__sun) && !defined(__VXWORKS__) && !defined(__hexagon__) && \
-    !defined(__XTENSA__)
+    !defined(__XTENSA__) && !defined(__vita__)
 #define ABSL_HAVE_ELF_MEM_IMAGE 1
 #endif
 
diff --git a/absl/time/internal/cctz/src/time_zone_libc.cc b/absl/time/internal/cctz/src/time_zone_libc.cc
index 362da1a..6262d37 100644
--- a/absl/time/internal/cctz/src/time_zone_libc.cc
+++ b/absl/time/internal/cctz/src/time_zone_libc.cc
@@ -61,8 +61,15 @@ auto tm_zone(const std::tm& tm) -> decltype(tzname[0]) {
   return tzname[is_dst];
 }
 #elif defined(__native_client__) || defined(__myriad2__) || \
-    defined(__EMSCRIPTEN__)
+    defined(__EMSCRIPTEN__) || defined(__vita__)
 // Uses the globals: '_timezone' and 'tzname'.
+//
+// The Vita belongs in this branch and not the default one below: newlib only
+// gives struct tm the tm_gmtoff and tm_zone extension fields when __TM_GMTOFF
+// and __TM_ZONE are defined, and VitaSDK's build defines neither. It does
+// export _timezone and _tzname, which is exactly what this branch wants. The
+// DST offset is therefore assumed to be one hour, as it is for the platforms
+// already listed here.
 auto tm_gmtoff(const std::tm& tm) -> decltype(_timezone + 0) {
   const bool is_dst = tm.tm_isdst > 0;
   return _timezone + (is_dst ? 60 * 60 : 0);
