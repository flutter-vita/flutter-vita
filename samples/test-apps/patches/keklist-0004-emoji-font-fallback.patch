index 8436200..0000dc7 100644
--- a/lib/domain/constants.dart
+++ b/lib/domain/constants.dart
@@ -5,7 +5,14 @@ import 'package:intl/intl.dart';
 import 'package:keklist/domain/repositories/tabs/models/tabs_settings.dart';
 
 final class Themes {
+  // fontFamilyFallback carries emoji on the Vita port, where nothing else can:
+  // see the note in pubspec.yaml. Harmless everywhere else -- the platform font
+  // stack answers first on Android and iOS, so this is only ever consulted when
+  // the primary family has no glyph.
+  static const List<String> _emojiFallback = <String>['NotoColorEmoji'];
+
   static final ThemeData light = ThemeData(
+    fontFamilyFallback: _emojiFallback,
     scaffoldBackgroundColor: Colors.white,
     colorScheme: const ColorScheme.light(
       primary: Colors.black,
